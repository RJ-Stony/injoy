---
import 'katex/dist/katex.min.css';
import { Image } from 'astro:assets';
import ThemeToggle from '../components/ThemeToggle.astro';
import { withBase } from '../utils/url';
import { getCategories } from '../utils/post';
import profile from '../assets/profile.jpg';

interface Props {
  title: string;
  description: string;
  /** OG 타입 — 글 상세는 'article', 그 외 'website' */
  ogType?: 'website' | 'article';
  /** OG 이미지 경로 (사이트 기준 절대 경로 또는 빌드된 에셋 경로) */
  ogImage?: string;
  /** true면 본문 컨테이너를 넓혀 사이드바(목차 등)를 둘 수 있다 */
  wide?: boolean;
}

const { title, description, ogType = 'website', ogImage, wide = false } = Astro.props;
// 커버가 있으면 그걸, 없으면 기본 공유 카드(scripts/make-og.mjs 산출)를 OG 이미지로.
const ogImageURL = new URL(ogImage ?? withBase('/og-default.png'), Astro.site);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = 'Injoy';
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
// 헤더 카테고리 메뉴 — 데스크톱 드롭다운과 모바일 햄버거가 함께 쓴다(빌드 시 1회).
const categories = await getCategories();
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- FOUC 방지: 저장된 테마 선택을 첫 페인트 전에 적용 -->
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
        }
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="64x64" href={withBase('/favicon-64.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteName}
      href={withBase('/rss.xml')}
    />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <!-- Open Graph -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="ko_KR" />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    <meta name="twitter:card" content={ogImageURL ? 'summary_large_image' : 'summary'} />

    <!-- 본문·제목 : Wanted Sans (Variable) -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/wanteddev/wanted-sans@v1.0.3/packages/wanted-sans/fonts/webfonts/variable/split/WantedSansVariable.min.css"
    />
    <!-- 코드 : JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <!-- 이모지 포인트 (선택) : Tossface -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/toss/tossface/dist/tossface.css" />

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>

    <header class="site-header">
      <div class:list={['site-header-inner', { wide }]}>
        <a class="logo" href={withBase('/')}>
          <Image class="logo-avatar" src={profile} alt="" width={64} height={64} loading="eager" />
          <span>Injoy</span>
        </a>
        <div class="header-actions">
          <nav class="nav-desktop" aria-label="주 메뉴">
            <a class="write-link" href={withBase('/write/')} hidden>글쓰기</a>
            <a href={withBase('/search/')}>검색</a>
            <a href={withBase('/graph/')}>그래프</a>
            <div class="cat-dd">
              <button type="button" class="cat-dd-btn" aria-haspopup="true" aria-expanded="false">
                카테고리<span class="caret" aria-hidden="true"></span>
              </button>
              <div class="cat-dd-menu" role="menu" hidden>
                {
                  categories.map((c) => (
                    <a role="menuitem" href={withBase(`/categories/${c.name}/`)}>
                      <span>{c.name}</span>
                      <span class="cat-count">{c.count}</span>
                    </a>
                  ))
                }
              </div>
            </div>
            <a href={withBase('/about/')}>About</a>
          </nav>

          <button
            type="button"
            class="nav-toggle"
            aria-label="메뉴 열기"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </button>

          <ThemeToggle />
        </div>
      </div>

      <!-- 모바일: 메뉴 + 카테고리를 한 패널에 모은다(헤더 밖 absolute라 폭을 늘리지 않는다) -->
      <div id="mobile-menu" class="mobile-menu" role="navigation" aria-label="모바일 메뉴" hidden>
        <a class="write-link" href={withBase('/write/')} hidden>글쓰기</a>
        <a href={withBase('/search/')}>검색</a>
        <a href={withBase('/graph/')}>그래프</a>
        <a href={withBase('/about/')}>About</a>
        <div class="mm-sep"></div>
        <p class="mm-label">카테고리</p>
        {
          categories.map((c) => (
            <a href={withBase(`/categories/${c.name}/`)}>
              <span>{c.name}</span>
              <span class="cat-count">{c.count}</span>
            </a>
          ))
        }
      </div>
    </header>

    <!-- 글쓰기 링크: 이 기기에 발행 토큰이 있을 때만 보인다(운영자 전용). 두 메뉴 모두 적용. -->
    <script is:inline>
      try {
        if (localStorage.getItem('injoy-gh-token')) {
          document.querySelectorAll('a.write-link').forEach((a) => {
            a.hidden = false;
          });
        }
      } catch {}
    </script>

    <script>
      // 헤더 메뉴 토글: 카테고리 드롭다운(데스크톱) + 햄버거(모바일).
      // 바깥 클릭·Esc·패널 내부 링크 클릭 시 닫는다.
      function wire(btn: HTMLElement | null, panel: HTMLElement | null) {
        if (!btn || !panel) return;
        const close = () => {
          panel.hidden = true;
          btn.setAttribute('aria-expanded', 'false');
        };
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const willOpen = panel.hidden;
          panel.hidden = !willOpen;
          btn.setAttribute('aria-expanded', String(willOpen));
        });
        panel.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) close();
        });
        document.addEventListener('click', (e) => {
          const t = e.target as Node;
          if (!panel.hidden && !panel.contains(t) && !btn.contains(t)) close();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') close();
        });
      }
      wire(
        document.querySelector<HTMLElement>('.cat-dd-btn'),
        document.querySelector<HTMLElement>('.cat-dd-menu'),
      );
      wire(
        document.querySelector<HTMLElement>('.nav-toggle'),
        document.querySelector<HTMLElement>('#mobile-menu'),
      );
    </script>

    <main id="main" class:list={[{ wide }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class:list={['site-footer-inner', { wide }]}>
        <p>© {new Date().getFullYear()} Injoy. 즐거움 안에서.</p>
        <p class="footer-links">
          <span id="site-visits" hidden></span>
          <a href={withBase('/rss.xml')}>RSS</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<script>
  import { enhanceSmoothDetails } from '../scripts/smooth-details';
  import { watchPendingDeploy } from '../scripts/deploy-toast';
  // 접이식 요소(시리즈 폴더·시리즈 내비·만듦새 패널)를 데스크톱·모바일 어디서나 부드럽게 펼친다
  enhanceSmoothDetails();
  // 발행 후 페이지를 떠나도 배포가 끝나면 완료 토스트를 띄운다(작성자 브라우저 한정).
  watchPendingDeploy();

  // 전체 방문 수 — 세션당 1회만 카운트하고(Abacus), 실패하면 조용히 숨긴다
  const visits = document.getElementById('site-visits');
  if (visits) {
    const isLocal = ['localhost', '127.0.0.1'].includes(location.hostname);
    const counted = sessionStorage.getItem('injoy-visited') === '1';
    const mode = isLocal || counted ? 'get' : 'hit';
    fetch(`https://abacus.jasoncameron.dev/${mode}/injoy-rjstony/site-visits`)
      .then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
      .then((data: { value: number }) => {
        if (typeof data.value !== 'number') return;
        if (!isLocal) sessionStorage.setItem('injoy-visited', '1');
        visits.textContent = `방문 ${data.value.toLocaleString('ko-KR')}`;
        visits.hidden = false;
      })
      .catch(() => {
        /* 카운터 불가 시 표시 생략 */
      });
  }
</script>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 100;
    padding: 0.5rem 1rem;
    background-color: var(--accent);
    color: #fff;
    border-radius: 0 0 8px 8px;
  }

  .skip-link:focus-visible {
    top: 0;
  }

  /* 헤더는 상단에 고정 — 스크롤 중에도 로고·토글 접근 가능 */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    background-color: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    /* 페이지 전환 시 헤더는 깜빡이지 않고 그대로 — 본문만 페이드 */
    view-transition-name: site-header;
  }

  .site-header-inner {
    max-width: var(--width-wide);
    margin-inline: auto;
    padding: 0.9rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* wide 페이지(글 상세)에서는 헤더·푸터도 본문 그리드 폭에 맞춰 정렬 */
  @media (min-width: 1100px) {
    .site-header-inner.wide,
    .site-footer-inner.wide {
      max-width: 1080px;
    }
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .logo-avatar {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    object-fit: cover;
    /* 흰 배경 위에서 사진이 둥둥 뜨지 않게 토큰 색 얇은 링 */
    box-shadow: 0 0 0 1px var(--border);
    transition: box-shadow 0.15s ease;
  }

  .logo:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .logo:hover .logo-avatar {
    box-shadow: 0 0 0 2px var(--accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .site-header nav {
    display: flex;
    gap: 1.25rem;
  }

  .site-header nav a {
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .site-header nav a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  /* 글쓰기 링크는 JS로 삽입되어 Astro 스코프 클래스가 없으므로
     다른 내비 링크(그래프·About)와 같은 모양을 :global로 전부 지정한다 */
  .site-header nav :global(a.write-link) {
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .site-header nav :global(a.write-link:hover) {
    color: var(--accent);
    text-decoration: none;
  }

  /* ---------- 카테고리 드롭다운(데스크톱) ---------- */
  .site-header .cat-dd {
    position: relative;
    display: inline-flex;
  }

  .site-header .cat-dd-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    font: inherit;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .site-header .cat-dd-btn:hover {
    color: var(--accent);
  }

  .site-header .cat-dd-btn .caret {
    width: 0.42em;
    height: 0.42em;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 0.15s ease;
  }

  .site-header .cat-dd-btn[aria-expanded='true'] .caret {
    transform: translateY(1px) rotate(-135deg);
  }

  .site-header .cat-dd-menu {
    position: absolute;
    top: calc(100% + 0.7rem);
    right: 0;
    min-width: 11rem;
    max-height: 60vh;
    overflow-y: auto;
    padding: 0.4rem;
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    z-index: 60;
  }

  .site-header .cat-dd-menu a,
  .site-header .mobile-menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0.6rem;
    border-radius: 7px;
    color: var(--text);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .site-header .cat-dd-menu a:hover,
  .site-header .mobile-menu a:hover {
    background-color: var(--accent-weak);
    color: var(--accent);
    text-decoration: none;
  }

  /* display:flex가 hidden 속성을 덮지 않도록 — 글쓰기 링크는 토큰 있을 때만 보인다 */
  .site-header .cat-dd-menu a[hidden],
  .site-header .mobile-menu a[hidden] {
    display: none;
  }

  .site-header .cat-dd-menu .cat-count,
  .site-header .mobile-menu .cat-count {
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  /* ---------- 햄버거(모바일) ---------- */
  .site-header .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0.2rem;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--text);
  }

  .site-header .nav-toggle svg {
    width: 1.45rem;
    height: 1.45rem;
  }

  .site-header .mobile-menu {
    position: absolute;
    top: calc(100% + 0.4rem);
    right: 0.8rem;
    min-width: 12rem;
    max-width: calc(100vw - 1.6rem);
    max-height: calc(100vh - 5rem);
    overflow-y: auto;
    padding: 0.5rem;
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.14);
    z-index: 60;
  }

  .site-header .mobile-menu a {
    font-size: 0.95rem;
    padding: 0.55rem 0.7rem;
  }

  .site-header .mobile-menu .mm-sep {
    height: 1px;
    margin: 0.4rem 0.3rem;
    background-color: var(--border);
  }

  .site-header .mobile-menu .mm-label {
    margin: 0.3rem 0.7rem 0.15rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  /* 좁은 화면: 인라인 메뉴를 햄버거로 접는다(카테고리가 늘어도 헤더가 안 깨진다) */
  @media (max-width: 640px) {
    .site-header .nav-desktop {
      display: none;
    }

    .site-header .nav-toggle {
      display: inline-flex;
    }
  }

  /* 넓은 화면에선 모바일 패널이 떠 있지 않게 확실히 숨긴다 */
  @media (min-width: 641px) {
    .site-header .mobile-menu {
      display: none !important;
    }
  }

  main {
    max-width: var(--width-wide);
    margin-inline: auto;
    padding: 2.5rem 1.25rem 5rem;
    /* body가 flex column이므로 본문이 남는 세로 공간을 채워 푸터를 아래로 민다.
       (width: 100%로 두어 max-width와 가운데 정렬이 그대로 유지되게) */
    flex: 1 0 auto;
    width: 100%;
  }

  /* 글 상세처럼 사이드바가 필요한 페이지는 와이드 화면에서만 넓어진다 */
  @media (min-width: 1100px) {
    main.wide {
      max-width: 1080px;
    }
  }

  .site-footer {
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .site-footer-inner {
    max-width: var(--width-wide);
    margin-inline: auto;
    padding: 1.5rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .site-footer p {
    /* 세로 마진만 제거 — 가로는 .footer-links의 margin-left: auto가 쓸 수 있게 둔다 */
    margin-block: 0;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 1rem;
    /* 좁은 화면에서 줄바꿈돼도 푸터 오른쪽에 붙도록 — 없으면 왼쪽으로 몰린다 */
    margin-left: auto;
  }
</style>
