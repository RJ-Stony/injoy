---
import 'katex/dist/katex.min.css';
import { Image } from 'astro:assets';
import ThemeToggle from '../components/ThemeToggle.astro';
import { withBase } from '../utils/url';
import { getCategories } from '../utils/post';
import profile from '../assets/profile.jpg';
import { getViews } from '../utils/views';

interface Props {
  title: string;
  description: string;
  /** OG 타입 — 글 상세는 'article', 그 외 'website' */
  ogType?: 'website' | 'article';
  /** OG 이미지 경로 (사이트 기준 절대 경로 또는 빌드된 에셋 경로) */
  ogImage?: string;
  /** true면 본문 컨테이너를 넓혀 사이드바(목차 등)를 둘 수 있다 */
  wide?: boolean;
}

const { title, description, ogType = 'website', ogImage, wide = false } = Astro.props;
// 커버가 있으면 그걸, 없으면 기본 공유 카드(scripts/make-og.mjs 산출)를 OG 이미지로.
const ogImageURL = new URL(ogImage ?? withBase('/og-default.png'), Astro.site);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = 'Injoy';
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
// 헤더 카테고리 메뉴 — 데스크톱 드롭다운과 모바일 햄버거가 함께 쓴다(빌드 시 1회).
const categories = await getCategories();
// 이 빌드의 커밋 sha — '보러 가기'가 새 빌드가 실제로 떴는지 확인하는 표식(deploy-toast.confirmLive).
// GitHub Actions 빌드에선 GITHUB_SHA가 곧 발행 커밋이고, 로컬 dev에선 빈 값(확인은 라이브에서만 의미).
const buildSha = process.env.GITHUB_SHA ?? '';
// 꼬리말의 방문 수(예전 계수기의 값 + GA4가 센 값). 빌드할 때 박는다
const siteVisits = (await getViews()).site.toLocaleString('ko-KR');
// Google Tag Manager 컨테이너 ID(GTM-XXXXXXX). 비어 있으면 태그를 붙이지 않는다.
// 배포할 때는 저장소 변수 GTM_ID가 PUBLIC_GTM_ID로 들어온다(.github/workflows/deploy.yml). GA4는 GTM 안에서 붙인다.
const gtmId = (import.meta.env.PUBLIC_GTM_ID ?? '').trim();
// 지금 보고 있는 메뉴에 표시를 한다
const here = (path: string) => (Astro.url.pathname.startsWith(withBase(path)) ? 'page' : undefined);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="injoy:build" content={buildSha} />

    <!-- FOUC 방지: 저장된 테마 + 집중 읽기 모드를 첫 페인트 전에 적용.
         집중모드는 글 상세(article)에서만 복원한다(목록·그래프에서 헤더가 사라지면 안 됨). -->
    <script is:inline define:vars={{ isArticle: ogType === 'article' }}>
      (() => {
        const stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
        }
        if (isArticle && localStorage.getItem('focus-read') === '1') {
          document.documentElement.dataset.focus = 'true';
        }
        // 책장을 넘기듯 넘어온 화면(떠나기 직전에 injoy:turn 기록을 남긴다)과 뒤로/앞으로 이동에서는
        // 글이 한 줄씩 올라오게 표시를 남긴다(global.css의 sheet-rise, src/scripts/page-turn.ts).
        try {
          const turn = JSON.parse(sessionStorage.getItem('injoy:turn') || 'null');
          const nav = performance.getEntriesByType('navigation')[0];
          if ((turn && Date.now() - turn.t < 6000) || (nav && nav.type === 'back_forward')) {
            document.documentElement.dataset.arrive = 'page';
          }
        } catch {}
        // 나란히 읽기의 옆 칸(iframe, ?pane=1)으로 열렸을 때: 머리말과 꼬리말을 숨기고(global.css),
        // 다른 글로 가는 링크는 칸 안에서 열고, 그 밖의 링크는 바깥 창에서 연다.
        if (window.self !== window.top && new URLSearchParams(location.search).has('pane')) {
          document.documentElement.dataset.pane = 'true';
          document.addEventListener('click', (e) => {
            const a = e.target.closest && e.target.closest('a[href]');
            const href = a && a.getAttribute('href');
            if (!href || href.startsWith('#') || e.defaultPrevented) return;
            const url = new URL(href, location.href);
            if (url.origin === location.origin && url.pathname.includes('/posts/')) {
              // 주소만 칸 안의 것으로 바꿔 둔다. 글이 빠지는 효과와 이동은 page-turn.ts가 맡는다
              url.searchParams.set('pane', '1');
              a.setAttribute('href', url.href);
            } else {
              a.setAttribute('target', '_top');
            }
          });
        }
      })();
    </script>

    <!-- 날짜를 '4개월 전'처럼 바꿔 적는 함수. 날짜 바로 뒤의 인라인 스크립트가 불러서(PostMeta.astro)
         화면이 그려지기 전에 채운다. 늦게 도는 스크립트에 두면 날짜가 먼저 보였다가 바뀐다. -->
    <script is:inline>
      window.injoyRel = (el) => {
        const t = new Date(el.getAttribute('datetime') || '').getTime();
        if (Number.isNaN(t)) return;
        const now = Date.now();
        const sec = Math.floor((now - t) / 1000);
        let out;
        // 시각이 있는 수정(24시간 안)은 지난 초로 잰다
        if (el.dataset.fine === '1' && sec >= 0 && sec < 86400) {
          out = sec < 5 ? '방금' : sec < 60 ? sec + '초 전' : sec < 3600 ? Math.floor(sec / 60) + '분 전' : Math.floor(sec / 3600) + '시간 전';
        } else {
          // 날짜 단위는 이곳 시각의 자정을 기준으로 달력 날짜의 차이를 잰다
          const a = new Date(now);
          a.setHours(0, 0, 0, 0);
          const b = new Date(t);
          b.setHours(0, 0, 0, 0);
          const day = Math.round((a.getTime() - b.getTime()) / 86400000);
          if (day <= 0) out = '오늘';
          else if (day === 1) out = '어제';
          else if (day < 7) out = day + '일 전';
          else if (day < 30) out = Math.floor(day / 7) + '주 전';
          else if (day < 365) out = Math.floor(day / 30) + '개월 전';
          else {
            const d = new Date(t);
            out = d.getFullYear() + '.' + String(d.getMonth() + 1).padStart(2, '0') + '.' + String(d.getDate()).padStart(2, '0');
          }
        }
        el.textContent = (el.dataset.prefix || '') + out;
      };
    </script>

    {
      gtmId && (
        <script is:inline define:vars={{ gtmId }}>
          // 옆 칸(iframe) 안의 글은 따로 세지 않는다. 바깥 화면이 이미 센다.
          if (window.self === window.top) {
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
            const tag = document.createElement('script');
            tag.async = true;
            tag.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;
            document.head.append(tag);
          }
        </script>
      )
    }

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="64x64" href={withBase('/favicon-64.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />

    <!-- 홈 화면 앱(PWA). 오프라인 캐싱(서비스 워커)은 필요 없어 뺐다. iOS는 아래 메타 + apple-touch-icon으로 standalone 실행. -->
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16181c" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Injoy" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteName}
      href={withBase('/rss.xml')}
    />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <!-- Open Graph -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="ko_KR" />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    <meta name="twitter:card" content={ogImageURL ? 'summary_large_image' : 'summary'} />

    <!-- 본문·제목 : Wanted Sans (Variable) -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/wanteddev/wanted-sans@v1.0.3/packages/wanted-sans/fonts/webfonts/variable/split/WantedSansVariable.min.css"
    />
    <!-- 코드 : JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <!-- 이모지 포인트 (선택) : Tossface -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/toss/tossface/dist/tossface.css" />

    <slot name="head" />
  </head>
  <body>
    {
      gtmId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>

    <header class="site-header">
      <div class:list={['site-header-inner', { wide }]}>
        <a class="logo" href={withBase('/')}>
          <Image class="logo-avatar" src={profile} alt="" width={64} height={64} loading="eager" />
          <span class="logo-text">
            <b>Injoy</b>
            <small>즐거움 안에서</small>
          </span>
        </a>
        <div class="header-actions">
          <nav class="nav-desktop" aria-label="주 메뉴">
            <a class="write-link" href={withBase('/write/')} hidden>글쓰기</a>
            <a href={withBase('/search/')} aria-current={here('/search/')}>검색</a>
            <a href={withBase('/graph/')} aria-current={here('/graph/')}>그래프</a>
            <a href={withBase('/glossary/')} aria-current={here('/glossary/')}>용어 사전</a>
            <div class="cat-dd">
              <button type="button" class="cat-dd-btn" aria-haspopup="true" aria-expanded="false" data-current={here('/categories/')}>
                카테고리<span class="caret" aria-hidden="true"></span>
              </button>
              <div class="cat-dd-menu" role="menu" hidden>
                {
                  categories.map((c) => (
                    <a role="menuitem" href={withBase(`/categories/${c.name}/`)}>
                      <span>{c.name}</span>
                      <span class="cat-count">{c.count}</span>
                    </a>
                  ))
                }
              </div>
            </div>
            <a href={withBase('/about/')} aria-current={here('/about/')}>About</a>
          </nav>

          <button
            type="button"
            class="nav-toggle"
            aria-label="메뉴 열기"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <path class="l1" d="M4 7h16"></path>
              <path class="l2" d="M4 12h16"></path>
              <path class="l3" d="M4 17h16"></path>
            </svg>
          </button>

          <ThemeToggle />
        </div>
      </div>

      <!-- 모바일: 메뉴 + 카테고리를 한 패널에 모은다(헤더 밖 absolute라 폭을 늘리지 않는다) -->
      <div id="mobile-menu" class="mobile-menu" role="navigation" aria-label="모바일 메뉴" hidden>
        <a class="write-link" href={withBase('/write/')} hidden>글쓰기</a>
        <a href={withBase('/search/')} aria-current={here('/search/')}>검색</a>
        <a href={withBase('/graph/')} aria-current={here('/graph/')}>그래프</a>
        <a href={withBase('/glossary/')} aria-current={here('/glossary/')}>용어 사전</a>
        <a href={withBase('/about/')} aria-current={here('/about/')}>About</a>
        <div class="mm-sep"></div>
        <p class="mm-label">카테고리</p>
        {
          categories.map((c) => (
            <a href={withBase(`/categories/${c.name}/`)}>
              <span>{c.name}</span>
              <span class="cat-count">{c.count}</span>
            </a>
          ))
        }
      </div>
    </header>

    <!-- 글쓰기 링크: 이 기기에 발행 토큰이 있을 때만 보인다(운영자 전용). 두 메뉴 모두 적용.
         토큰이 없는 웹앱(standalone)에서 처음 들어갈 땐 푸터 'Injoy'를 길게 눌러 /write로 간다(아래 스크립트). -->
    <script is:inline>
      try {
        if (localStorage.getItem('injoy-gh-token')) {
          document.querySelectorAll('a.write-link').forEach((a) => {
            a.hidden = false;
          });
        }
      } catch {}
    </script>

    <script>
      import '../scripts/page-turn';

      // 헤더 메뉴 토글: 카테고리 드롭다운(데스크톱) + 햄버거(모바일).
      // 바깥 클릭·Esc·패널 내부 링크 클릭 시 닫는다.
      function wire(btn: HTMLElement | null, panel: HTMLElement | null) {
        if (!btn || !panel) return;
        const close = () => {
          panel.hidden = true;
          btn.setAttribute('aria-expanded', 'false');
        };
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const willOpen = panel.hidden;
          panel.hidden = !willOpen;
          btn.setAttribute('aria-expanded', String(willOpen));
        });
        panel.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) close();
        });
        document.addEventListener('click', (e) => {
          const t = e.target as Node;
          if (!panel.hidden && !panel.contains(t) && !btn.contains(t)) close();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') close();
        });
      }
      wire(
        document.querySelector<HTMLElement>('.cat-dd-btn'),
        document.querySelector<HTMLElement>('.cat-dd-menu'),
      );
      wire(
        document.querySelector<HTMLElement>('.nav-toggle'),
        document.querySelector<HTMLElement>('#mobile-menu'),
      );

      // 숨은 진입: 푸터 'Injoy'를 길게(약 600ms) 누르면 글쓰기로 간다. 웹앱(standalone)엔 주소창이
      // 없어 /write로 갈 길이 막히는데, 링크를 노출하지 않고도 주인만 아는 제스처로 연다.
      // 'Injoy'는 일반 텍스트(링크 아님)라 iOS 링크 미리보기가 안 뜬다. /write는 토큰 게이트라 안전.
      const key = document.querySelector<HTMLElement>('.write-key');
      if (key) {
        let holdTimer: number | undefined;
        const cancel = () => {
          if (holdTimer) {
            clearTimeout(holdTimer);
            holdTimer = undefined;
          }
        };
        key.addEventListener('pointerdown', () => {
          holdTimer = window.setTimeout(() => {
            const href =
              document.querySelector<HTMLAnchorElement>('a.write-link')?.getAttribute('href') ||
              '/write/';
            location.href = href;
          }, 600);
        });
        key.addEventListener('pointerup', cancel);
        key.addEventListener('pointerleave', cancel);
        key.addEventListener('pointercancel', cancel);
        key.addEventListener('contextmenu', (e) => e.preventDefault());
      }
    </script>

    <main id="main" class:list={[{ wide }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class:list={['site-footer-inner', { wide }]}>
        <p>© {new Date().getFullYear()} <span class="write-key">Injoy</span>.</p>
        <p class="footer-links">
          <span id="site-visits">방문 {siteVisits}</span>
          <a href={withBase('/stats/')}>통계</a>
          <a href={withBase('/rss.xml')}>RSS</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<script>
  import { enhanceSmoothDetails } from '../scripts/smooth-details';
  import { watchPendingDeploy } from '../scripts/deploy-toast';
  // 접이식 요소(시리즈 폴더·시리즈 내비·만듦새 패널·연결 목록)를 데스크톱·모바일 어디서나 부드럽게 펼친다
  enhanceSmoothDetails('details.series, .makeup, .connections-fold');
  // 발행 후 페이지를 떠나도 배포가 끝나면 완료 토스트를 띄운다(작성자 브라우저 한정).
  watchPendingDeploy();

</script>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 100;
    padding: 0.5rem 1rem;
    background-color: var(--accent);
    color: #fff;
    border-radius: 0 0 8px 8px;
  }

  .skip-link:focus-visible {
    top: 0;
  }

  /* 헤더는 상단에 고정 — 스크롤 중에도 로고·토글 접근 가능 */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    background-color: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    /* 페이지 전환 시 헤더는 깜빡이지 않고 그대로 — 본문만 페이드 */
    view-transition-name: site-header;
  }

  .site-header-inner {
    max-width: var(--width-wide);
    margin-inline: auto;
    padding: 0.9rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* wide 페이지(글 상세)에서는 헤더·푸터도 본문 그리드 폭에 맞춰 정렬 */
  @media (min-width: 1100px) {
    .site-header-inner.wide,
    .site-footer-inner.wide {
      max-width: 1080px;
    }
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  /* 푸터 'Injoy' 롱프레스(→ 글쓰기)에서 iOS 텍스트 선택·콜아웃 팝오버가 뜨지 않게 한다.
     일반 텍스트라 링크 미리보기(peek)는 애초에 안 뜬다(로고 <a>와 달리). */
  .write-key {
    -webkit-touch-callout: none;
    user-select: none;
  }

  .logo-avatar {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    object-fit: cover;
    /* 흰 배경 위에서 사진이 둥둥 뜨지 않게 토큰 색 얇은 링 */
    box-shadow: 0 0 0 1px var(--border);
    transition: box-shadow 0.15s ease;
  }

  .logo:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .logo:hover .logo-avatar {
    box-shadow: 0 0 0 2px var(--accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .site-header nav {
    display: flex;
    gap: 1.25rem;
  }

  .site-header nav a {
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .site-header nav a:hover {
    color: var(--accent);
    text-decoration: none;
  }

