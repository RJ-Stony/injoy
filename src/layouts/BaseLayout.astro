---
import 'katex/dist/katex.min.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  description: string;
  /** OG 타입 — 글 상세는 'article', 그 외 'website' */
  ogType?: 'website' | 'article';
  /** OG 이미지 경로 (사이트 기준 절대 경로 또는 빌드된 에셋 경로) */
  ogImage?: string;
  /** true면 본문 컨테이너를 넓혀 사이드바(목차 등)를 둘 수 있다 */
  wide?: boolean;
}

const { title, description, ogType = 'website', ogImage, wide = false } = Astro.props;
const ogImageURL = ogImage ? new URL(ogImage, Astro.site) : undefined;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = 'Injoy';
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- FOUC 방지: 저장된 테마 선택을 첫 페인트 전에 적용 -->
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
        }
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteName}
      href={withBase('/rss.xml')}
    />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <!-- Open Graph -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="ko_KR" />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    <meta name="twitter:card" content={ogImageURL ? 'summary_large_image' : 'summary'} />

    <!-- 본문·제목 : Wanted Sans (Variable) -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/wanteddev/wanted-sans@v1.0.3/packages/wanted-sans/fonts/webfonts/variable/split/WantedSansVariable.min.css"
    />
    <!-- 코드 : JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <!-- 이모지 포인트 (선택) : Tossface -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/toss/tossface/dist/tossface.css" />

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>

    <header class="site-header">
      <div class:list={['site-header-inner', { wide }]}>
        <a class="logo" href={withBase('/')}>Injoy</a>
        <div class="header-actions">
          <nav aria-label="주 메뉴">
            <a href={withBase('/graph/')}>그래프</a>
            <a href={withBase('/about/')}>About</a>
          </nav>
          <!-- 글쓰기 버튼: 이 기기에 발행 토큰이 있을 때만 보인다 (운영자 전용) -->
          <script is:inline define:vars={{ writeUrl: withBase('/write/') }}>
            try {
              if (localStorage.getItem('injoy-gh-token')) {
                const nav = document.currentScript.previousElementSibling;
                const link = document.createElement('a');
                link.href = writeUrl;
                link.textContent = '글쓰기';
                link.className = 'write-link';
                nav.prepend(link);
              }
            } catch {}
          </script>
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main id="main" class:list={[{ wide }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class:list={['site-footer-inner', { wide }]}>
        <p>© {new Date().getFullYear()} Injoy. 마크다운으로 쓰고, 즐겁게 기록합니다.</p>
        <p class="footer-links">
          <span id="site-visits" hidden></span>
          <a href={withBase('/rss.xml')}>RSS</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<script>
  // 전체 방문 수 — 세션당 1회만 카운트하고(Abacus), 실패하면 조용히 숨긴다
  const visits = document.getElementById('site-visits');
  if (visits) {
    const isLocal = ['localhost', '127.0.0.1'].includes(location.hostname);
    const counted = sessionStorage.getItem('injoy-visited') === '1';
    const mode = isLocal || counted ? 'get' : 'hit';
    fetch(`https://abacus.jasoncameron.dev/${mode}/injoy-rjstony/site-visits`)
      .then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
      .then((data: { value: number }) => {
        if (typeof data.value !== 'number') return;
        if (!isLocal) sessionStorage.setItem('injoy-visited', '1');
        visits.textContent = `방문 ${data.value.toLocaleString('ko-KR')}`;
        visits.hidden = false;
      })
      .catch(() => {
        /* 카운터 불가 시 표시 생략 */
      });
  }
</script>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 100;
    padding: 0.5rem 1rem;
    background-color: var(--accent);
    color: #fff;
    border-radius: 0 0 8px 8px;
  }

  .skip-link:focus-visible {
    top: 0;
  }

  /* 헤더는 상단에 고정 — 스크롤 중에도 로고·토글 접근 가능 */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    background-color: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    /* 페이지 전환 시 헤더는 깜빡이지 않고 그대로 — 본문만 페이드 */
    view-transition-name: site-header;
  }

  .site-header-inner {
    max-width: var(--width-wide);
    margin-inline: auto;
    padding: 0.9rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* wide 페이지(글 상세)에서는 헤더·푸터도 본문 그리드 폭에 맞춰 정렬 */
  @media (min-width: 1100px) {
    .site-header-inner.wide,
    .site-footer-inner.wide {
      max-width: 1080px;
    }
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .logo:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .site-header nav {
    display: flex;
    gap: 1.25rem;
  }

  .site-header nav a {
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .site-header nav a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  /* 글쓰기 링크는 JS로 삽입되어 Astro 스코프 클래스가 없으므로
     다른 내비 링크(그래프·About)와 같은 모양을 :global로 전부 지정한다 */
  .site-header nav :global(a.write-link) {
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .site-header nav :global(a.write-link:hover) {
    color: var(--accent);
    text-decoration: none;
  }

  main {
    max-width: var(--width-wide);
    margin-inline: auto;
    padding: 2.5rem 1.25rem 5rem;
  }

  /* 글 상세처럼 사이드바가 필요한 페이지는 와이드 화면에서만 넓어진다 */
  @media (min-width: 1100px) {
    main.wide {
      max-width: 1080px;
    }
  }

  .site-footer {
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .site-footer-inner {
    max-width: var(--width-wide);
    margin-inline: auto;
    padding: 1.5rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .site-footer p {
    margin: 0;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
</style>
