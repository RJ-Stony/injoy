---
import BaseLayout from './BaseLayout.astro';
import Sheet from '../components/Sheet.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
  };
}

const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description.replace(/\s*\n\s*/g, ' ')} wide>
  <Sheet title={frontmatter.title}>
    <p slot="meta" class="lead">{frontmatter.description}</p>
    <article class="prose">
      <slot />
    </article>
  </Sheet>
</BaseLayout>

<style>
  /* 설명에 적은 줄바꿈을 그대로 보여 준다 */
  .lead {
    white-space: pre-line;
  }

  /* 제목 옆에서 바로 시작하게 첫 문단의 위 여백을 없앤다 */
  .prose > :global(:first-child) {
    margin-top: 0;
  }
</style>
