---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sheet from '../../../components/Sheet.astro';
import PostRows from '../../../components/PostRows.astro';
import Pagination from '../../../components/Pagination.astro';
import { getPublishedPosts } from '../../../utils/post';

// 카테고리별 10개씩 페이지. 1페이지 /categories/foo/, 2페이지부터 /categories/foo/2.
export async function getStaticPaths({ paginate }) {
  const posts = await getPublishedPosts();
  const categories = [...new Set(posts.map((post) => post.data.category))];
  return categories.flatMap((category) =>
    paginate(
      posts.filter((post) => post.data.category === category),
      { pageSize: 10, params: { category } },
    ),
  );
}

const { category } = Astro.params;
const { page } = Astro.props;
---

<BaseLayout title={category} description={`'${category}' 카테고리의 글 ${page.total}편`} wide>
  <Sheet rows title={category} eyebrow="카테고리">
    <p slot="meta">{page.total}개의 글</p>
    <section aria-label={`${category} 카테고리 글 목록`}>
      <PostRows posts={page.data} numbered start={page.start + 1} />
    </section>
    <Pagination currentPage={page.currentPage} lastPage={page.lastPage} prefix={`/categories/${category}/`} />
  </Sheet>
</BaseLayout>
