---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { getPublishedPosts } from '../../../utils/post';

// 카테고리별 10개씩 페이지. 1페이지 /categories/foo/, 2페이지부터 /categories/foo/2.
export async function getStaticPaths({ paginate }) {
  const posts = await getPublishedPosts();
  const categories = [...new Set(posts.map((post) => post.data.category))];
  return categories.flatMap((category) =>
    paginate(
      posts.filter((post) => post.data.category === category),
      { pageSize: 10, params: { category } },
    ),
  );
}

const { category } = Astro.params;
const { page } = Astro.props;
---

<BaseLayout title={category} description={`'${category}' 카테고리의 글 ${page.total}편`}>
  <section class="cat-head">
    <p class="cat-eyebrow">카테고리</p>
    <h1>{category}</h1>
    <p>{page.total}편의 글</p>
  </section>

  <section class="post-list" aria-label={`${category} 카테고리 글 목록`}>
    {page.data.map((post) => <PostCard post={post} />)}
  </section>

  <Pagination
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    prefix={`/categories/${category}/`}
  />
</BaseLayout>

<style>
  .cat-head {
    padding: 1rem 0 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .cat-head .cat-eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .cat-head h1 {
    margin: 0;
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--accent);
  }

  .cat-head p {
    margin: 0.4rem 0 0;
    color: var(--text-muted);
  }
</style>
