---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostMeta from '../../components/PostMeta.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getPublishedPosts, readingMinutes } from '../../utils/post';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const minutes = readingMinutes(post);
const cover = post.data.cover;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={cover?.src}
  wide
>
  <div class="post-grid">
  <article class="post">
    <header class="post-header">
      <PostMeta category={post.data.category} pubDate={post.data.pubDate} minutes={minutes} />
      <h1>{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
      {cover && <Image class="cover" src={cover} alt="" loading="eager" />}
    </header>

    <div class="toc-inline">
      <TableOfContents headings={headings} />
    </div>

    <div class="prose">
      <Content />
    </div>

    {
      post.data.tags.length > 0 && (
        <footer class="post-footer">
          <ul class="tag-list" aria-label="태그">
            {post.data.tags.map((tag) => (
              <li>
                <a href={withBase(`/tags/${tag}/`)}>#{tag}</a>
              </li>
            ))}
          </ul>
        </footer>
      )
    }
  </article>

  <aside class="toc-aside">
    <div class="toc-sticky">
      <TableOfContents headings={headings} variant="rail" />
    </div>
  </aside>
  </div>
</BaseLayout>

<script>
  // ```mermaid 코드블록 → 다이어그램 렌더 (라이트/다크 테마 연동, CDN 지연 로드)
  const mermaidBlocks = document.querySelectorAll<HTMLPreElement>(
    '.prose pre.astro-code[data-language="mermaid"]',
  );
  if (mermaidBlocks.length > 0) {
    const containers: HTMLDivElement[] = [];
    for (const pre of mermaidBlocks) {
      const div = document.createElement('div');
      div.className = 'mermaid-diagram';
      div.dataset.source = pre.textContent ?? '';
      (pre.closest('.code-block') ?? pre).replaceWith(div);
      containers.push(div);
    }

    const effectiveTheme = () => {
      const explicit = document.documentElement.dataset.theme;
      if (explicit === 'light' || explicit === 'dark') return explicit;
      return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    };

    let seq = 0;
    const renderAll = async () => {
      const { default: mermaid } = await import(
        /* @vite-ignore */ 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs'
      );
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: effectiveTheme() === 'dark' ? 'dark' : 'neutral',
        fontFamily: 'inherit',
      });
      for (const container of containers) {
        try {
          const { svg } = await mermaid.render(`injoy-mmd-${seq++}`, container.dataset.source ?? '');
          container.innerHTML = svg;
        } catch {
          container.textContent = '다이어그램을 렌더링하지 못했어요.';
        }
      }
    };

    renderAll();
    window.addEventListener('injoy:theme-change', renderAll);
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', renderAll);
  }

  // 코드블록 복사 버튼 — 언어 지정 시 Shiki가 만든 pre.astro-code에 부착
  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
    const code = pre.querySelector('code');
    if (!code) continue;

    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    pre.replaceWith(wrapper);
    wrapper.appendChild(pre);

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-button';
    button.textContent = '복사';
    button.setAttribute('aria-label', '코드 복사');
    wrapper.appendChild(button);

    let timer: ReturnType<typeof setTimeout>;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code.innerText);
        button.textContent = '복사됨';
        clearTimeout(timer);
        timer = setTimeout(() => {
          button.textContent = '복사';
        }, 2000);
      } catch {
        button.textContent = '실패';
      }
    });
  }
</script>

<style>
  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
  }

  .post {
    max-width: var(--width-content);
    width: 100%;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* 좁은 화면: 인라인 목차, 사이드바 숨김 */
  .toc-aside {
    display: none;
  }

  /* 와이드 화면: 목차를 우측 sticky 사이드바로 */
  @media (min-width: 1100px) {
    .post-grid {
      grid-template-columns: minmax(0, var(--width-content)) 220px;
      justify-content: center;
      justify-items: stretch;
      column-gap: 3.5rem;
    }

    .toc-inline {
      display: none;
    }

    .toc-aside {
      display: block;
    }

    .toc-sticky {
      /* sticky 헤더 높이만큼 내려서 고정 */
      position: sticky;
      top: 5.5rem;
      max-height: calc(100vh - 7rem);
      overflow-y: auto;
    }
  }

  .post-header h1 {
    margin: 0.8rem 0 0.5rem;
    font-size: clamp(1.7rem, 5vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.35;
  }

  .post-header .description {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .post-header .cover {
    margin-top: 1.5rem;
    border-radius: var(--radius);
    width: 100%;
    height: auto;
  }

  .post-footer {
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }

  .tag-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 0.9rem;
  }

  .tag-list a {
    color: var(--text-muted);
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15em 0.8em;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .tag-list a:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }
</style>

<style is:global>
  /* 복사 버튼은 스크립트로 만들어지므로 전역 스타일로 정의 */
  .code-block {
    position: relative;
  }

  .code-block .copy-button {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.25em 0.8em;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .code-block:hover .copy-button,
  .code-block .copy-button:focus-visible {
    opacity: 1;
  }

  .code-block .copy-button:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* 터치 환경에서는 항상 노출 */
  @media (hover: none) {
    .code-block .copy-button {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .code-block .copy-button {
      opacity: 1;
    }
  }
</style>
