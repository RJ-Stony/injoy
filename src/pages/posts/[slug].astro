---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostMeta from '../../components/PostMeta.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ViewCount from '../../components/ViewCount.astro';
import { getPublishedPosts, readingMinutes } from '../../utils/post';
import { getConnections } from '../../utils/graph';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const posts = await getPublishedPosts(); // 최신순 정렬
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const minutes = readingMinutes(post);
const cover = post.data.cover;
const connections = await getConnections(post.id);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={cover?.src}
  wide
>
  <div class="post-grid">
  <article class="post">
    <header class="post-header">
      <div class="meta-row">
        <PostMeta
          category={post.data.category}
          pubDate={post.data.pubDate}
          minutes={minutes}
          connections={connections.length}
          updatedDate={post.data.updatedDate}
        />
        <ViewCount slug={post.id} />
      </div>
      <h1>{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
      {cover && <Image class="cover" src={cover} alt="" loading="eager" />}
    </header>

    <div class="toc-inline">
      <TableOfContents headings={headings} />
    </div>

    <div class="prose">
      <Content />
    </div>

    {
      post.data.tags.length > 0 && (
        <footer class="post-footer">
          <ul class="tag-list" aria-label="태그">
            {post.data.tags.map((tag) => (
              <li>
                <a href={withBase(`/tags/${tag}/`)}>#{tag}</a>
              </li>
            ))}
          </ul>
        </footer>
      )
    }

    {
      connections.length > 0 && (
        <section id="connections" class="connections" aria-label="연결된 글">
          <div class="connections-head">
            <h2>연결된 글</h2>
            <a class="to-graph" href={withBase(`/graph/?focus=${post.id}`)}>그래프에서 보기 →</a>
          </div>
          <ul>
            {connections.map((c) => (
              <li>
                <span class:list={['edge-chip', c.type]}>{c.phrase}</span>
                <a href={withBase(`/posts/${c.slug}/`)}>{c.title}</a>
                {c.note && <p class="edge-note">{c.note}</p>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      (older || newer) && (
        <nav class="post-nav" aria-label="이전·다음 글">
          {older ? (
            <a class="nav-card older" href={withBase(`/posts/${older.id}/`)}>
              <span class="label">← 이전 글</span>
              <span class="nav-title">{older.data.title}</span>
            </a>
          ) : (
            <span class="nav-spacer" />
          )}
          {newer ? (
            <a class="nav-card newer" href={withBase(`/posts/${newer.id}/`)}>
              <span class="label">다음 글 →</span>
              <span class="nav-title">{newer.data.title}</span>
            </a>
          ) : (
            <span class="nav-spacer" />
          )}
        </nav>
      )
    }
  </article>

  <aside class="toc-aside">
    <div class="toc-sticky">
      <TableOfContents headings={headings} variant="rail" />
    </div>
  </aside>
  </div>
</BaseLayout>

<script>
  // ```mermaid 코드블록 → 다이어그램 렌더 (라이트/다크 테마 연동, CDN 지연 로드)
  // 렌더 설정은 /write 미리보기와 공유한다 (src/scripts/mermaid-render.ts)
  import { renderMermaidDiagrams } from '../../scripts/mermaid-render';

  const mermaidBlocks = document.querySelectorAll<HTMLPreElement>(
    '.prose pre.astro-code[data-language="mermaid"]',
  );
  if (mermaidBlocks.length > 0) {
    const containers: HTMLDivElement[] = [];
    for (const pre of mermaidBlocks) {
      const div = document.createElement('div');
      div.className = 'mermaid-diagram';
      div.dataset.source = pre.textContent ?? '';
      (pre.closest('.code-block') ?? pre).replaceWith(div);
      containers.push(div);
    }

    const renderAll = () => renderMermaidDiagrams(containers);
    renderAll();
    window.addEventListener('injoy:theme-change', renderAll);
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', renderAll);
  }

  // 코드블록 복사 버튼 — 언어 지정 시 Shiki가 만든 pre.astro-code에 부착
  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
    const code = pre.querySelector('code');
    if (!code) continue;

    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    pre.replaceWith(wrapper);
    wrapper.appendChild(pre);

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-button';
    button.textContent = '복사';
    button.setAttribute('aria-label', '코드 복사');
    wrapper.appendChild(button);

    let timer: ReturnType<typeof setTimeout>;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code.innerText);
        button.textContent = '복사됨';
        clearTimeout(timer);
        timer = setTimeout(() => {
          button.textContent = '복사';
        }, 2000);
      } catch {
        button.textContent = '실패';
      }
    });
  }
</script>

<style>
  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
  }

  .post {
    max-width: var(--width-content);
    width: 100%;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* 좁은 화면: 인라인 목차, 사이드바 숨김 */
  .toc-aside {
    display: none;
  }

  /* 와이드 화면: 목차를 우측 sticky 사이드바로 */
  @media (min-width: 1100px) {
    .post-grid {
      grid-template-columns: minmax(0, var(--width-content)) 220px;
      justify-content: center;
      justify-items: stretch;
      column-gap: 3.5rem;
    }

    .toc-inline {
      display: none;
    }

    .toc-aside {
      display: block;
    }

    .toc-sticky {
      /* sticky 헤더 높이만큼 내려서 고정 */
      position: sticky;
      top: 5.5rem;
      max-height: calc(100vh - 7rem);
      overflow-y: auto;
    }
  }

  .meta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4em 0.5em;
  }

  /* PostMeta·ViewCount의 박스를 풀어 모든 항목을 한 흐름으로 합친다.
     안 그러면 '조회'가 별도 컨테이너라 좁은 화면에서 혼자 줄을 차지한다.
     ViewCount는 집계 성공 전까지 [hidden]이라 그때는 합치지 않는다. */
  .meta-row :global(.post-meta),
  .meta-row :global(.view-count:not([hidden])) {
    display: contents;
  }

  .post-header h1 {
    margin: 0.8rem 0 0.5rem;
    font-size: clamp(1.7rem, 5vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.35;
  }

  .post-header .description {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .post-header .cover {
    margin-top: 1.5rem;
    border-radius: var(--radius);
    width: 100%;
    height: auto;
  }

  .post-footer {
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }

  .tag-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 0.9rem;
  }

  .tag-list a {
    color: var(--text-muted);
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15em 0.8em;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .tag-list a:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }

  .connections {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background-color: var(--surface);
    padding: 1.1rem 1.4rem;
    /* 헤더 메타의 '연결 N개'에서 #connections로 점프할 때 고정 헤더에 안 가리게 */
    scroll-margin-top: 5.5rem;
  }

  .connections-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .connections h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
  }

  .to-graph {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .to-graph:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .connections ul {
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
  }

  .connections li {
    padding: 0.5rem 0;
    border-top: 1px solid var(--border);
  }

  .connections li:first-child {
    border-top: 0;
  }

  .edge-chip {
    --chip: var(--accent);
    display: inline-block;
    margin-inline-end: 0.6em;
    padding: 0.08em 0.7em;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--chip) 12%, var(--bg));
    color: var(--chip);
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
  }

  /* 타입별 색 — global.css의 --edge-* 단일 출처를 칩에 입힌다 */
  .edge-chip.extends { --chip: var(--edge-extends); }
  .edge-chip.supports { --chip: var(--edge-supports); }
  .edge-chip.refines { --chip: var(--edge-refines); }
  .edge-chip.instantiates { --chip: var(--edge-instantiates); }
  .edge-chip.requires { --chip: var(--edge-requires); }
  .edge-chip.triggered-by { --chip: var(--edge-triggered-by); }
  .edge-chip.contradicts { --chip: var(--edge-contradicts); }
  .edge-chip.related { --chip: var(--edge-related); }
  .edge-chip.mentions { --chip: var(--text-muted); }

  .connections li a {
    font-weight: 600;
    color: var(--text);
  }

  .connections li a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .edge-note {
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
  }

  .nav-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background-color: var(--surface);
    transition: border-color 0.15s ease, transform 0.15s ease;
    min-width: 0;
  }

  .nav-card:hover {
    border-color: var(--accent);
    text-decoration: none;
    transform: translateY(-2px);
  }

  .nav-card.newer {
    text-align: right;
    align-items: flex-end;
  }

  .nav-card .label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .nav-card .nav-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }

  @media (max-width: 540px) {
    .post-nav {
      grid-template-columns: 1fr;
    }

    .nav-card.newer {
      text-align: left;
      align-items: flex-start;
    }

    .nav-spacer {
      display: none;
    }
  }
</style>

<style is:global>
  /* 복사 버튼은 스크립트로 만들어지므로 전역 스타일로 정의 */
  .code-block {
    position: relative;
  }

  .code-block .copy-button {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.25em 0.8em;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .code-block:hover .copy-button,
  .code-block .copy-button:focus-visible {
    opacity: 1;
  }

  .code-block .copy-button:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* 터치 환경에서는 항상 노출 */
  @media (hover: none) {
    .code-block .copy-button {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .code-block .copy-button {
      opacity: 1;
    }
  }
</style>
