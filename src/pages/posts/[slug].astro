---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostMeta from '../../components/PostMeta.astro';
import PostStats from '../../components/PostStats.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ViewCount from '../../components/ViewCount.astro';
import ReadingPath from '../../components/ReadingPath.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import Comments from '../../components/Comments.astro';
import TransparencyPanel from '../../components/TransparencyPanel.astro';
import PostReading from '../../components/PostReading.astro';
import DiagramModal from '../../components/DiagramModal.astro';
import { getPublishedPosts, readingMinutes } from '../../utils/post';
import { getConnections } from '../../utils/graph';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const posts = await getPublishedPosts(); // 최신순 정렬
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const minutes = readingMinutes(post);
const cover = post.data.cover;
const connections = await getConnections(post.id);

// JSON-LD(BlogPosting) — 검색엔진이 제목·날짜·작성자를 또박또박 읽도록.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(cover?.src ?? withBase('/og-default.png'), Astro.site).href;
const isEdited =
  !!post.data.updatedDate &&
  post.data.updatedDate.getTime() !== post.data.pubDate.getTime();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(isEdited ? { dateModified: post.data.updatedDate!.toISOString() } : {}),
  author: { '@type': 'Person', name: '노준석' },
  publisher: { '@type': 'Organization', name: 'Injoy' },
  image: ogImageURL,
  url: canonical,
  mainEntityOfPage: canonical,
  inLanguage: 'ko-KR',
};

// 검색 결과를 최신 글 먼저로 정렬하기 위한 Pagefind 정렬 키.
// 값 = 발행일(YYYY-MM-DD)/슬러그 → 내림차순이면 날짜 최신순, 같은 날이면 슬러그 역순
// (홈 목록의 pubDate desc + 슬러그 타이브레이크와 같은 순서).
// 주의: search.astro가 sort:{date:'desc'}를 거는 순간, 이 정렬 키가 없는 인덱스 본문은
// 검색 결과에서 통째로 빠진다. data-pagefind-body를 새로 붙이는 곳마다 date 키를 반드시 함께 둘 것.
const pagefindSort = `${post.data.pubDate.toISOString().slice(0, 10)}/${post.id}`;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={cover?.src}
  wide
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

  <PostReading />
  <DiagramModal />

  <div class="post-grid">
  <article class="post" data-pagefind-body data-pagefind-sort={`date:${pagefindSort}`}>
    <header class="post-header">
      <div class="meta-line" data-pagefind-ignore>
        <PostMeta
          category={post.data.category}
          pubDate={post.data.pubDate}
          minutes={minutes}
          updatedDate={post.data.updatedDate}
          showStats={false}
        />
      </div>
      <div class="meta-stats" data-pagefind-ignore>
        <PostStats minutes={minutes} connections={connections.length} />
        <ViewCount slug={post.id} />
      </div>
      <h1>{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
      {cover && <Image class="cover" src={cover} alt="" loading="eager" />}
    </header>

    <div class="toc-inline" data-pagefind-ignore>
      <TableOfContents headings={headings} />
    </div>

    <div class="prose">
      <Content />
    </div>

    {
      post.data.tags.length > 0 && (
        <footer class="post-footer">
          <ul class="tag-list" aria-label="태그">
            {post.data.tags.map((tag) => (
              <li>
                <a href={withBase(`/tags/${tag}/`)}>#{tag}</a>
              </li>
            ))}
          </ul>
        </footer>
      )
    }

    <SeriesNav post={post} />

    {/* 읽기 경로는 시리즈가 아닌 글에만 — 시리즈 글의 순서는 위 SeriesNav가 담당(중복 방지) */}
    {!post.data.series && <ReadingPath slug={post.id} title={post.data.title} />}

    {
      connections.length > 0 && (
        <section id="connections" class="connections" aria-label="연결된 글" data-pagefind-ignore>
          <div class="connections-head">
            <h2>연결된 글</h2>
            <a class="to-graph" href={withBase(`/graph/?focus=${post.id}`)}>그래프에서 보기 →</a>
          </div>
          <ul id="connections-list">
            {connections.map((c) => (
              <li>
                <span class:list={['edge-chip', c.type]}>{c.phrase}</span>
                <a href={withBase(`/posts/${c.slug}/`)}>{c.title}</a>
                {c.note && <p class="edge-note">{c.note}</p>}
              </li>
            ))}
          </ul>
          {connections.length > 3 && (
            <button
              type="button"
              class="connections-more"
              aria-expanded="false"
              aria-controls="connections-list"
            >
              <span class="cm-label">{`+${connections.length - 3}개 더 보기`}</span>
              <svg class="cm-caret" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" /></svg>
            </button>
          )}
        </section>
      )
    }

    <TransparencyPanel post={post} connections={connections} />

    {
      (older || newer) && (
        <nav class="post-nav" aria-label="이전·다음 글" data-pagefind-ignore>
          {older ? (
            <a class="nav-card older" href={withBase(`/posts/${older.id}/`)}>
              <span class="label">← 이전 글</span>
              <span class="nav-title">{older.data.title}</span>
            </a>
          ) : (
            <span class="nav-spacer" />
          )}
          {newer ? (
            <a class="nav-card newer" href={withBase(`/posts/${newer.id}/`)}>
              <span class="label">다음 글 →</span>
              <span class="nav-title">{newer.data.title}</span>
            </a>
          ) : (
            <span class="nav-spacer" />
          )}
        </nav>
      )
    }

    <Comments />
  </article>

  <aside class="toc-aside">
    <div class="toc-sticky">
      <TableOfContents headings={headings} variant="rail" />
    </div>
  </aside>

  {/* 모바일·태블릿: 스크롤해도 늘 보이는 우측 가장자리 세로 라인 인디케이터(현재 섹션 강조) */}
  <TableOfContents headings={headings} variant="line" />
  </div>
</BaseLayout>

<script>
  // ```mermaid 코드블록 → 다이어그램 렌더 (라이트/다크 테마 연동, CDN 지연 로드)
  // 렌더 설정은 /write 미리보기와 공유한다 (src/scripts/mermaid-render.ts)
  import { renderMermaidDiagrams, isSequenceSource } from '../../scripts/mermaid-render';
  import { attachSequencePlayer, type SequencePlayer } from '../../scripts/sequence-player';
  import { SMOOTH_DURATION, SMOOTH_EASING } from '../../scripts/smooth-details';
  import { initHoverCards } from '../../scripts/hover-card';

  initHoverCards();

  const mermaidBlocks = document.querySelectorAll<HTMLPreElement>(
    '.prose pre.astro-code[data-language="mermaid"]',
  );
  if (mermaidBlocks.length > 0) {
    const containers: HTMLDivElement[] = [];
    for (const pre of mermaidBlocks) {
      // 래퍼로 감싸 '확대' 버튼을 다이어그램의 형제로 둔다 —
      // renderMermaidDiagrams가 다이어그램 innerHTML을 갈아끼워도 버튼이 지워지지 않게.
      const wrap = document.createElement('div');
      wrap.className = 'diagram-wrap';
      const div = document.createElement('div');
      div.className = 'mermaid-diagram';
      div.dataset.source = pre.textContent ?? '';

      const expand = document.createElement('button');
      expand.type = 'button';
      expand.className = 'diagram-expand';
      expand.setAttribute('aria-label', '다이어그램 확대');
      expand.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4H4v5M15 4h5v5M9 20H4v-5M15 20h5v-5"/></svg>';
      expand.addEventListener('click', () =>
        (window as any).__injoyDiagramModal?.open(div.dataset.source ?? ''),
      );

      wrap.append(div, expand);
      (pre.closest('.code-block') ?? pre).replaceWith(wrap);
      containers.push(div);
    }

    const players = new Map<HTMLElement, SequencePlayer>();
    const renderAll = () =>
      renderMermaidDiagrams(containers).then(() => {
        for (const c of containers) {
          if (!isSequenceSource(c.dataset.source ?? '')) continue;
          const existing = players.get(c);
          if (existing) existing.refresh();
          else {
            // 트랜스포트 바는 .mermaid-diagram의 형제(.diagram-wrap 자식)로 - innerHTML 교체에 안 지워진다
            const p = attachSequencePlayer(c.parentElement as HTMLElement, c);
            if (p) players.set(c, p);
          }
        }
      });
    renderAll();
    window.addEventListener('injoy:theme-change', () => void renderAll());
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => void renderAll());

    // 엣지 흐름 애니메이션 — 화면에 보이는 다이어그램만 방향대로 대시가 흐른다(off-screen은 일시정지).
    // 클래스만 토글하고 실제 모션은 CSS가 담당(모션 줄이기면 CSS가 정지). 테마 재렌더로 svg가 갈려도
    // 클래스는 컨테이너에 남아 CSS가 새 엣지에 자동 적용된다.
    if ('IntersectionObserver' in window) {
      const flowObserver = new IntersectionObserver(
        (entries) => {
          for (const e of entries) e.target.classList.toggle('flow-on', e.isIntersecting);
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      for (const c of containers) flowObserver.observe(c);
    }
  }

  // 코드블록 재설계: 헤더 바(언어 칩 + 파일명 / 접기·복사) + 높이제한 내부 스크롤.
  // Shiki가 만든 pre.astro-code를 .code-block으로 감싼다. (mermaid는 위에서 이미 div로 치환돼 제외)
  const escapeHtml = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  // 언어/확장자 칩 — 브랜드 색 라벨(자체 배경이라 라이트·다크 모두 또렷). 미정의는 중립 칩으로 폴백.
  // 키는 펜스 언어와 파일 확장자를 함께 받는다(둘이 다르면 파일명 확장자를 우선해 잡는다).
  const Y = '#1a1a1a'; // 밝은 배경(노랑·주황)에 쓰는 어두운 글자색
  const LANG_CHIP: Record<string, { label: string; bg: string; fg: string }> = {
    ts: { label: 'TS', bg: '#3178c6', fg: '#fff' },
    mts: { label: 'TS', bg: '#3178c6', fg: '#fff' },
    cts: { label: 'TS', bg: '#3178c6', fg: '#fff' },
    tsx: { label: 'TSX', bg: '#3178c6', fg: '#fff' },
    js: { label: 'JS', bg: '#f7df1e', fg: Y },
    mjs: { label: 'JS', bg: '#f7df1e', fg: Y },
    cjs: { label: 'JS', bg: '#f7df1e', fg: Y },
    jsx: { label: 'JSX', bg: '#f7df1e', fg: Y },
    json: { label: 'JSON', bg: '#5b6470', fg: '#fff' },
    jsonc: { label: 'JSONC', bg: '#5b6470', fg: '#fff' },
    css: { label: 'CSS', bg: '#2965f1', fg: '#fff' },
    scss: { label: 'SCSS', bg: '#cc6699', fg: '#fff' },
    sass: { label: 'SASS', bg: '#cc6699', fg: '#fff' },
    less: { label: 'LESS', bg: '#1d365d', fg: '#fff' },
    html: { label: 'HTML', bg: '#e34f26', fg: '#fff' },
    xml: { label: 'XML', bg: '#0060ac', fg: '#fff' },
    svg: { label: 'SVG', bg: '#ffb13b', fg: Y },
    astro: { label: 'ASTRO', bg: '#ff5d01', fg: '#fff' },
    vue: { label: 'VUE', bg: '#42b883', fg: '#fff' },
    svelte: { label: 'SVELTE', bg: '#ff3e00', fg: '#fff' },
    bash: { label: 'SH', bg: '#4f5b66', fg: '#fff' },
    shell: { label: 'SH', bg: '#4f5b66', fg: '#fff' },
    sh: { label: 'SH', bg: '#4f5b66', fg: '#fff' },
    zsh: { label: 'SH', bg: '#4f5b66', fg: '#fff' },
    ps1: { label: 'PS', bg: '#012456', fg: '#fff' },
    yaml: { label: 'YAML', bg: '#cb171e', fg: '#fff' },
    yml: { label: 'YAML', bg: '#cb171e', fg: '#fff' },
    md: { label: 'MD', bg: '#519aba', fg: '#fff' },
    markdown: { label: 'MD', bg: '#519aba', fg: '#fff' },
    mdx: { label: 'MDX', bg: '#fcb32c', fg: Y },
    py: { label: 'PY', bg: '#3776ab', fg: '#fff' },
    python: { label: 'PY', bg: '#3776ab', fg: '#fff' },
    go: { label: 'GO', bg: '#00add8', fg: '#fff' },
    rust: { label: 'RS', bg: '#b7410e', fg: '#fff' },
    rs: { label: 'RS', bg: '#b7410e', fg: '#fff' },
    c: { label: 'C', bg: '#283593', fg: '#fff' },
    cpp: { label: 'CPP', bg: '#00599c', fg: '#fff' },
    cc: { label: 'CPP', bg: '#00599c', fg: '#fff' },
    h: { label: 'H', bg: '#00599c', fg: '#fff' },
    hpp: { label: 'HPP', bg: '#00599c', fg: '#fff' },
    cs: { label: 'C#', bg: '#239120', fg: '#fff' },
    java: { label: 'JAVA', bg: '#b07219', fg: '#fff' },
    kt: { label: 'KT', bg: '#7f52ff', fg: '#fff' },
    kotlin: { label: 'KT', bg: '#7f52ff', fg: '#fff' },
    swift: { label: 'SWIFT', bg: '#fa7343', fg: '#fff' },
    scala: { label: 'SCALA', bg: '#dc322f', fg: '#fff' },
    php: { label: 'PHP', bg: '#777bb4', fg: '#fff' },
    rb: { label: 'RB', bg: '#cc342d', fg: '#fff' },
    ruby: { label: 'RB', bg: '#cc342d', fg: '#fff' },
    ex: { label: 'EX', bg: '#4b275f', fg: '#fff' },
    exs: { label: 'EX', bg: '#4b275f', fg: '#fff' },
    lua: { label: 'LUA', bg: '#2c2d72', fg: '#fff' },
    dart: { label: 'DART', bg: '#0175c2', fg: '#fff' },
    r: { label: 'R', bg: '#276dc3', fg: '#fff' },
    hs: { label: 'HS', bg: '#5e5086', fg: '#fff' },
    clj: { label: 'CLJ', bg: '#5881d8', fg: '#fff' },
    sql: { label: 'SQL', bg: '#336791', fg: '#fff' },
    graphql: { label: 'GQL', bg: '#e10098', fg: '#fff' },
    gql: { label: 'GQL', bg: '#e10098', fg: '#fff' },
    proto: { label: 'PROTO', bg: '#5b6470', fg: '#fff' },
    prisma: { label: 'PRISMA', bg: '#0c344b', fg: '#fff' },
    toml: { label: 'TOML', bg: '#9c4221', fg: '#fff' },
    ini: { label: 'INI', bg: '#6d6d6d', fg: '#fff' },
    env: { label: 'ENV', bg: '#ecd53f', fg: Y },
    dockerfile: { label: 'DOCKER', bg: '#2496ed', fg: '#fff' },
    docker: { label: 'DOCKER', bg: '#2496ed', fg: '#fff' },
    makefile: { label: 'MAKE', bg: '#6d8086', fg: '#fff' },
    make: { label: 'MAKE', bg: '#6d8086', fg: '#fff' },
    nginx: { label: 'NGINX', bg: '#009639', fg: '#fff' },
    zig: { label: 'ZIG', bg: '#f7a41d', fg: Y },
    nim: { label: 'NIM', bg: '#ffe953', fg: Y },
    sol: { label: 'SOL', bg: '#363636', fg: '#fff' },
    tf: { label: 'HCL', bg: '#7b42bc', fg: '#fff' },
    hcl: { label: 'HCL', bg: '#7b42bc', fg: '#fff' },
    vim: { label: 'VIM', bg: '#019733', fg: '#fff' },
    gitignore: { label: 'GIT', bg: '#f05032', fg: '#fff' },
    diff: { label: 'DIFF', bg: '#4f5b66', fg: '#fff' },
    text: { label: 'TXT', bg: '#8a8f98', fg: '#fff' },
    plaintext: { label: 'TXT', bg: '#8a8f98', fg: '#fff' },
    txt: { label: 'TXT', bg: '#8a8f98', fg: '#fff' },
  };

  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
    if (pre.closest('.code-block')) continue; // 재진입 가드(view-transition 등 재실행 시 중복 래핑 방지)
    const code = pre.querySelector('code');
    if (!code) continue;

    const lang = (pre.dataset.language || 'text').toLowerCase();
    const title = pre.dataset.title || '';
    // 칩은 파일 확장자를 우선한다 — 파일명이 `agents/x.md`면 하이라이트 언어가 yaml이어도 MD로.
    // 확장자가 테이블에 없으면(또는 파일명이 없으면) 하이라이트 언어로 폴백한다.
    const ext = (title.match(/\.([a-z0-9]+)$/i)?.[1] || '').toLowerCase();
    const key = ext && LANG_CHIP[ext] ? ext : lang;
    const chip = LANG_CHIP[key] ?? { label: (key || 'text').toUpperCase().slice(0, 6), bg: '', fg: '' };

    const block = document.createElement('div');
    block.className = 'code-block';
    pre.replaceWith(block);

    const head = document.createElement('div');
    head.className = 'code-head';
    const chipStyle = chip.bg ? ` style="background:${chip.bg};color:${chip.fg}"` : '';
    head.innerHTML =
      `<span class="code-lang${chip.bg ? '' : ' code-lang-plain'}"${chipStyle}>${escapeHtml(chip.label)}</span>` +
      (title ? `<span class="code-file">${escapeHtml(title)}</span>` : '');

    const actions = document.createElement('div');
    actions.className = 'code-actions';

    const collapseBtn = document.createElement('button');
    collapseBtn.type = 'button';
    collapseBtn.className = 'code-btn collapse-button';
    collapseBtn.setAttribute('aria-expanded', 'true');
    collapseBtn.setAttribute('aria-label', '코드 접기');
    collapseBtn.innerHTML = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 10l4-4 4 4"/></svg>';

    const copyBtn = document.createElement('button');
    copyBtn.type = 'button';
    copyBtn.className = 'code-btn copy-button';
    copyBtn.textContent = '복사';
    copyBtn.setAttribute('aria-label', '코드 복사');

    actions.append(collapseBtn, copyBtn);
    head.appendChild(actions);

    const scroll = document.createElement('div');
    scroll.className = 'code-scroll';
    scroll.appendChild(pre);

    block.append(head, scroll);

    // 접기/펴기 — smooth-details와 같은 결(높이 WAAPI)로 스르륵. 모션 줄이기면 즉시 토글.
    let collapseAnim: Animation | null = null;
    collapseBtn.addEventListener('click', () => {
      const willCollapse = block.getAttribute('data-collapsed') !== 'true';
      block.setAttribute('data-collapsed', String(willCollapse));
      collapseBtn.setAttribute('aria-expanded', String(!willCollapse));
      collapseBtn.setAttribute('aria-label', willCollapse ? '코드 펼치기' : '코드 접기');

      if (
        matchMedia('(prefers-reduced-motion: reduce)').matches ||
        !('animate' in Element.prototype)
      ) {
        scroll.style.display = willCollapse ? 'none' : '';
        return;
      }
      collapseAnim?.cancel();
      const opts = { duration: SMOOTH_DURATION, easing: SMOOTH_EASING };
      if (willCollapse) {
        const start = scroll.offsetHeight;
        scroll.style.overflow = 'hidden';
        collapseAnim = scroll.animate([{ height: `${start}px` }, { height: '0px' }], opts);
        collapseAnim.onfinish = () => {
          scroll.style.display = 'none'; // 접힌 뒤엔 완전히 숨겨 0높이 사선도 안 남게
          scroll.style.overflow = '';
          scroll.style.height = '';
          collapseAnim = null;
        };
        collapseAnim.oncancel = () => {
          scroll.style.overflow = '';
          scroll.style.height = '';
        };
      } else {
        scroll.style.display = '';
        scroll.style.height = 'auto';
        const end = scroll.offsetHeight; // max-height(34rem)로 클램프된 펼친 높이
        scroll.style.height = '0px';
        scroll.style.overflow = 'hidden';
        collapseAnim = scroll.animate([{ height: '0px' }, { height: `${end}px` }], opts);
        collapseAnim.onfinish = () => {
          scroll.style.overflow = '';
          scroll.style.height = ''; // 자연 높이로 되돌려 내부 스크롤 복원
          collapseAnim = null;
        };
        collapseAnim.oncancel = () => {
          scroll.style.overflow = '';
          scroll.style.height = '';
        };
      }
    });

    let timer: ReturnType<typeof setTimeout>;
    copyBtn.addEventListener('click', async () => {
      // diff 블록이면 지운 줄(-- 표시)은 빼고, 남는 최종 코드만 복사한다
      const lines = code.querySelectorAll<HTMLElement>('.line');
      const text = lines.length
        ? [...lines].filter((l) => !l.classList.contains('remove')).map((l) => l.textContent).join('\n')
        : code.innerText;
      try {
        await navigator.clipboard.writeText(text);
        copyBtn.textContent = '복사됨';
        clearTimeout(timer);
        timer = setTimeout(() => {
          copyBtn.textContent = '복사';
        }, 2000);
      } catch {
        copyBtn.textContent = '실패';
      }
    });
  }

  // 표: 접근성 role 부여(모바일 카드 레이아웃에서 display:block이라 표 시맨틱이 사라지므로 복원) +
  //     모바일 카드용 data-label(헤더 텍스트를 각 셀에 붙여 '라벨:값'으로 보이게).
  for (const table of document.querySelectorAll<HTMLTableElement>('.prose table')) {
    const headers = [...table.querySelectorAll('thead th')].map((th) => th.textContent?.trim() ?? '');
    table.setAttribute('role', 'table');
    for (const g of table.querySelectorAll('thead, tbody')) g.setAttribute('role', 'rowgroup');
    for (const tr of table.querySelectorAll('tr')) {
      tr.setAttribute('role', 'row');
      let i = 0;
      for (const cell of Array.from(tr.children) as HTMLElement[]) {
        if (cell.tagName === 'TH') {
          cell.setAttribute('role', 'columnheader');
        } else {
          cell.setAttribute('role', 'cell');
          if (headers[i]) cell.dataset.label = headers[i];
        }
        i++;
      }
    }
  }

  // 연결된 글 '처음 3개 + 더 보기' — 코드블록·smooth-details와 같은 WAAPI 높이 애니로 스르륵 펼침.
  (() => {
    const list = document.getElementById('connections-list');
    const moreBtn = document.querySelector<HTMLButtonElement>('.connections-more');
    if (!list || !moreBtn) return;
    const items = list.children;
    if (items.length <= 3) {
      moreBtn.remove();
      return;
    }
    const labelEl = moreBtn.querySelector('.cm-label')!;
    const hiddenCount = items.length - 3;
    // 접힌 높이 = 3번째 항목 바닥까지(목록이 펼쳐진 상태에서 재서야 정확)
    const collapsedHeight = () =>
      items[2].getBoundingClientRect().bottom - list.getBoundingClientRect().top;
    const reduce =
      matchMedia('(prefers-reduced-motion: reduce)').matches || !('animate' in Element.prototype);

    let expanded = false;
    let anim: Animation | null = null;
    // 초기 접힘(높이 측정은 펼친 상태에서)
    list.style.overflow = 'hidden';
    list.style.height = `${collapsedHeight()}px`;

    const sync = () => {
      labelEl.textContent = expanded ? '접기' : `+${hiddenCount}개 더 보기`;
      moreBtn.setAttribute('aria-expanded', String(expanded));
    };
    sync();

    moreBtn.addEventListener('click', () => {
      expanded = !expanded;
      sync();
      if (reduce) {
        list.style.height = expanded ? 'auto' : `${collapsedHeight()}px`;
        list.style.overflow = expanded ? '' : 'hidden';
        return;
      }
      anim?.cancel();
      const from = list.offsetHeight;
      const to = expanded ? list.scrollHeight : collapsedHeight();
      list.style.overflow = 'hidden';
      anim = list.animate([{ height: `${from}px` }, { height: `${to}px` }], {
        duration: SMOOTH_DURATION,
        easing: SMOOTH_EASING,
      });
      anim.onfinish = () => {
        if (expanded) {
          list.style.height = 'auto'; // 펼침: 자연 높이로 해제
          list.style.overflow = '';
        } else {
          list.style.height = `${to}px`; // 접힘: 3개 높이 유지
        }
        anim = null;
      };
    });
  })();
</script>

