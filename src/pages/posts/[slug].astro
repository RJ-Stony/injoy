---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostMeta from '../../components/PostMeta.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getPublishedPosts, readingMinutes } from '../../utils/post';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const minutes = readingMinutes(post);
const cover = post.data.cover;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={cover?.src}
>
  <article class="post">
    <header class="post-header">
      <PostMeta category={post.data.category} pubDate={post.data.pubDate} minutes={minutes} />
      <h1>{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
      {cover && <Image class="cover" src={cover} alt="" loading="eager" />}
    </header>

    <TableOfContents headings={headings} />

    <div class="prose">
      <Content />
    </div>

    {
      post.data.tags.length > 0 && (
        <footer class="post-footer">
          <ul class="tag-list" aria-label="태그">
            {post.data.tags.map((tag) => (
              <li>
                <a href={`/tags/${tag}/`}>#{tag}</a>
              </li>
            ))}
          </ul>
        </footer>
      )
    }
  </article>
</BaseLayout>

<script>
  // 코드블록 복사 버튼 — 언어 지정 시 Shiki가 만든 pre.astro-code에 부착
  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
    const code = pre.querySelector('code');
    if (!code) continue;

    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    pre.replaceWith(wrapper);
    wrapper.appendChild(pre);

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-button';
    button.textContent = '복사';
    button.setAttribute('aria-label', '코드 복사');
    wrapper.appendChild(button);

    let timer: ReturnType<typeof setTimeout>;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code.innerText);
        button.textContent = '복사됨';
        clearTimeout(timer);
        timer = setTimeout(() => {
          button.textContent = '복사';
        }, 2000);
      } catch {
        button.textContent = '실패';
      }
    });
  }
</script>

<style>
  .post {
    max-width: var(--width-content);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .post-header h1 {
    margin: 0.8rem 0 0.5rem;
    font-size: clamp(1.7rem, 5vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.35;
  }

  .post-header .description {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .post-header .cover {
    margin-top: 1.5rem;
    border-radius: var(--radius);
    width: 100%;
    height: auto;
  }

  .post-footer {
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }

  .tag-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 0.9rem;
  }

  .tag-list a {
    color: var(--text-muted);
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15em 0.8em;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .tag-list a:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }
</style>

<style is:global>
  /* 복사 버튼은 스크립트로 만들어지므로 전역 스타일로 정의 */
  .code-block {
    position: relative;
  }

  .code-block .copy-button {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.25em 0.8em;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .code-block:hover .copy-button,
  .code-block .copy-button:focus-visible {
    opacity: 1;
  }

  .code-block .copy-button:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* 터치 환경에서는 항상 노출 */
  @media (hover: none) {
    .code-block .copy-button {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .code-block .copy-button {
      opacity: 1;
    }
  }
</style>
