---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostMeta from '../../components/PostMeta.astro';
import PostStats from '../../components/PostStats.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ViewCount from '../../components/ViewCount.astro';
import ReadingPath from '../../components/ReadingPath.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import Comments from '../../components/Comments.astro';
import TransparencyPanel from '../../components/TransparencyPanel.astro';
import PostReading from '../../components/PostReading.astro';
import DiagramModal from '../../components/DiagramModal.astro';
import { getPublishedPosts, readingMinutes } from '../../utils/post';
import { getConnections } from '../../utils/graph';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const posts = await getPublishedPosts(); // 최신순 정렬
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const minutes = readingMinutes(post);
const cover = post.data.cover;
const connections = await getConnections(post.id);

// JSON-LD(BlogPosting) — 검색엔진이 제목·날짜·작성자를 또박또박 읽도록.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(cover?.src ?? withBase('/og-default.png'), Astro.site).href;
const isEdited =
  !!post.data.updatedDate &&
  post.data.updatedDate.getTime() !== post.data.pubDate.getTime();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(isEdited ? { dateModified: post.data.updatedDate!.toISOString() } : {}),
  author: { '@type': 'Person', name: '노준석' },
  publisher: { '@type': 'Organization', name: 'Injoy' },
  image: ogImageURL,
  url: canonical,
  mainEntityOfPage: canonical,
  inLanguage: 'ko-KR',
};

// 검색 결과를 최신 글 먼저로 정렬하기 위한 Pagefind 정렬 키.
// 값 = 발행일(YYYY-MM-DD)/슬러그 → 내림차순이면 날짜 최신순, 같은 날이면 슬러그 역순
// (홈 목록의 pubDate desc + 슬러그 타이브레이크와 같은 순서).
// 주의: search.astro가 sort:{date:'desc'}를 거는 순간, 이 정렬 키가 없는 인덱스 본문은
// 검색 결과에서 통째로 빠진다. data-pagefind-body를 새로 붙이는 곳마다 date 키를 반드시 함께 둘 것.
const pagefindSort = `${post.data.pubDate.toISOString().slice(0, 10)}/${post.id}`;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={cover?.src}
  wide
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

  <PostReading />
  <DiagramModal />

  <div class="post-grid">
  <article class="post" data-pagefind-body data-pagefind-sort={`date:${pagefindSort}`}>
    <header class="post-header">
      <div class="meta-line" data-pagefind-ignore>
        <PostMeta
          category={post.data.category}
          pubDate={post.data.pubDate}
          minutes={minutes}
          updatedDate={post.data.updatedDate}
          showStats={false}
        />
      </div>
      <div class="meta-stats" data-pagefind-ignore>
        <PostStats minutes={minutes} connections={connections.length} />
        <ViewCount slug={post.id} />
      </div>
      <h1>{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
      {cover && <Image class="cover" src={cover} alt="" loading="eager" />}
    </header>

    <div class="toc-inline" data-pagefind-ignore>
      <TableOfContents headings={headings} />
    </div>

    <div class="prose">
      <Content />
    </div>

    {
      post.data.tags.length > 0 && (
        <footer class="post-footer">
          <ul class="tag-list" aria-label="태그">
            {post.data.tags.map((tag) => (
              <li>
                <a href={withBase(`/tags/${tag}/`)}>#{tag}</a>
              </li>
            ))}
          </ul>
        </footer>
      )
    }

    <SeriesNav post={post} />

    {/* 읽기 경로는 시리즈가 아닌 글에만 — 시리즈 글의 순서는 위 SeriesNav가 담당(중복 방지) */}
    {!post.data.series && <ReadingPath slug={post.id} title={post.data.title} />}

    {
      connections.length > 0 && (
        <section id="connections" class="connections" aria-label="연결된 글" data-pagefind-ignore>
          <div class="connections-head">
            <h2>연결된 글</h2>
            <a class="to-graph" href={withBase(`/graph/?focus=${post.id}`)}>그래프에서 보기 →</a>
          </div>
          <ul>
            {connections.map((c) => (
              <li>
                <span class:list={['edge-chip', c.type]}>{c.phrase}</span>
                <a href={withBase(`/posts/${c.slug}/`)}>{c.title}</a>
                {c.note && <p class="edge-note">{c.note}</p>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <TransparencyPanel post={post} connections={connections} />

    {
      (older || newer) && (
        <nav class="post-nav" aria-label="이전·다음 글" data-pagefind-ignore>
          {older ? (
            <a class="nav-card older" href={withBase(`/posts/${older.id}/`)}>
              <span class="label">← 이전 글</span>
              <span class="nav-title">{older.data.title}</span>
            </a>
          ) : (
            <span class="nav-spacer" />
          )}
          {newer ? (
            <a class="nav-card newer" href={withBase(`/posts/${newer.id}/`)}>
              <span class="label">다음 글 →</span>
              <span class="nav-title">{newer.data.title}</span>
            </a>
          ) : (
            <span class="nav-spacer" />
          )}
        </nav>
      )
    }

    <Comments />
  </article>

  <aside class="toc-aside">
    <div class="toc-sticky">
      <TableOfContents headings={headings} variant="rail" />
    </div>
  </aside>

  {/* 모바일·태블릿: 스크롤해도 늘 보이는 우측 가장자리 세로 라인 인디케이터(현재 섹션 강조) */}
  <TableOfContents headings={headings} variant="line" />
  </div>
</BaseLayout>

<script>
  // ```mermaid 코드블록 → 다이어그램 렌더 (라이트/다크 테마 연동, CDN 지연 로드)
  // 렌더 설정은 /write 미리보기와 공유한다 (src/scripts/mermaid-render.ts)
  import { renderMermaidDiagrams } from '../../scripts/mermaid-render';

  const mermaidBlocks = document.querySelectorAll<HTMLPreElement>(
    '.prose pre.astro-code[data-language="mermaid"]',
  );
  if (mermaidBlocks.length > 0) {
    const containers: HTMLDivElement[] = [];
    for (const pre of mermaidBlocks) {
      // 래퍼로 감싸 '확대' 버튼을 다이어그램의 형제로 둔다 —
      // renderMermaidDiagrams가 다이어그램 innerHTML을 갈아끼워도 버튼이 지워지지 않게.
      const wrap = document.createElement('div');
      wrap.className = 'diagram-wrap';
      const div = document.createElement('div');
      div.className = 'mermaid-diagram';
      div.dataset.source = pre.textContent ?? '';

      const expand = document.createElement('button');
      expand.type = 'button';
      expand.className = 'diagram-expand';
      expand.setAttribute('aria-label', '다이어그램 확대');
      expand.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4H4v5M15 4h5v5M9 20H4v-5M15 20h5v-5"/></svg>';
      expand.addEventListener('click', () =>
        (window as any).__injoyDiagramModal?.open(div.dataset.source ?? ''),
      );

      wrap.append(div, expand);
      (pre.closest('.code-block') ?? pre).replaceWith(wrap);
      containers.push(div);
    }

    const renderAll = () => renderMermaidDiagrams(containers);
    renderAll();
    window.addEventListener('injoy:theme-change', renderAll);
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', renderAll);
  }

  // 코드블록 재설계: 헤더 바(언어 칩 + 파일명 / 접기·복사) + 높이제한 내부 스크롤.
  // Shiki가 만든 pre.astro-code를 .code-block으로 감싼다. (mermaid는 위에서 이미 div로 치환돼 제외)
  const escapeHtml = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  // 언어 칩 — 브랜드 색 라벨(자체 배경이라 라이트·다크 모두 또렷). 미정의 언어는 중립 칩으로 폴백.
  const LANG_CHIP: Record<string, { label: string; bg: string; fg: string }> = {
    ts: { label: 'TS', bg: '#3178c6', fg: '#fff' },
    tsx: { label: 'TSX', bg: '#3178c6', fg: '#fff' },
    js: { label: 'JS', bg: '#f7df1e', fg: '#1a1a1a' },
    jsx: { label: 'JSX', bg: '#f7df1e', fg: '#1a1a1a' },
    json: { label: 'JSON', bg: '#5b6470', fg: '#fff' },
    css: { label: 'CSS', bg: '#2965f1', fg: '#fff' },
    html: { label: 'HTML', bg: '#e34f26', fg: '#fff' },
    astro: { label: 'ASTRO', bg: '#ff5d01', fg: '#fff' },
    bash: { label: 'SH', bg: '#4f5b66', fg: '#fff' },
    shell: { label: 'SH', bg: '#4f5b66', fg: '#fff' },
    sh: { label: 'SH', bg: '#4f5b66', fg: '#fff' },
    yaml: { label: 'YAML', bg: '#cb171e', fg: '#fff' },
    yml: { label: 'YAML', bg: '#cb171e', fg: '#fff' },
    md: { label: 'MD', bg: '#519aba', fg: '#fff' },
    markdown: { label: 'MD', bg: '#519aba', fg: '#fff' },
    py: { label: 'PY', bg: '#3776ab', fg: '#fff' },
    python: { label: 'PY', bg: '#3776ab', fg: '#fff' },
    go: { label: 'GO', bg: '#00add8', fg: '#fff' },
    rust: { label: 'RS', bg: '#b7410e', fg: '#fff' },
    rs: { label: 'RS', bg: '#b7410e', fg: '#fff' },
    sql: { label: 'SQL', bg: '#336791', fg: '#fff' },
    diff: { label: 'DIFF', bg: '#4f5b66', fg: '#fff' },
    text: { label: 'TXT', bg: '#8a8f98', fg: '#fff' },
    plaintext: { label: 'TXT', bg: '#8a8f98', fg: '#fff' },
  };

  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
    if (pre.closest('.code-block')) continue; // 재진입 가드(view-transition 등 재실행 시 중복 래핑 방지)
    const code = pre.querySelector('code');
    if (!code) continue;

    const lang = (pre.dataset.language || 'text').toLowerCase();
    const title = pre.dataset.title || '';
    const chip = LANG_CHIP[lang] ?? { label: lang.toUpperCase().slice(0, 6), bg: '', fg: '' };

    const block = document.createElement('div');
    block.className = 'code-block';
    pre.replaceWith(block);

    const head = document.createElement('div');
    head.className = 'code-head';
    const chipStyle = chip.bg ? ` style="background:${chip.bg};color:${chip.fg}"` : '';
    head.innerHTML =
      `<span class="code-lang${chip.bg ? '' : ' code-lang-plain'}"${chipStyle}>${escapeHtml(chip.label)}</span>` +
      (title ? `<span class="code-file">${escapeHtml(title)}</span>` : '');

    const actions = document.createElement('div');
    actions.className = 'code-actions';

    const collapseBtn = document.createElement('button');
    collapseBtn.type = 'button';
    collapseBtn.className = 'code-btn collapse-button';
    collapseBtn.setAttribute('aria-expanded', 'true');
    collapseBtn.setAttribute('aria-label', '코드 접기');
    collapseBtn.innerHTML = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4"/></svg>';

    const copyBtn = document.createElement('button');
    copyBtn.type = 'button';
    copyBtn.className = 'code-btn copy-button';
    copyBtn.textContent = '복사';
    copyBtn.setAttribute('aria-label', '코드 복사');

    actions.append(collapseBtn, copyBtn);
    head.appendChild(actions);

    const scroll = document.createElement('div');
    scroll.className = 'code-scroll';
    scroll.appendChild(pre);

    block.append(head, scroll);

    collapseBtn.addEventListener('click', () => {
      const collapsed = block.getAttribute('data-collapsed') === 'true';
      block.setAttribute('data-collapsed', String(!collapsed));
      collapseBtn.setAttribute('aria-expanded', String(collapsed));
      collapseBtn.setAttribute('aria-label', collapsed ? '코드 접기' : '코드 펼치기');
    });

    let timer: ReturnType<typeof setTimeout>;
    copyBtn.addEventListener('click', async () => {
      // diff 블록이면 지운 줄(-- 표시)은 빼고, 남는 최종 코드만 복사한다
      const lines = code.querySelectorAll<HTMLElement>('.line');
      const text = lines.length
        ? [...lines].filter((l) => !l.classList.contains('remove')).map((l) => l.textContent).join('\n')
        : code.innerText;
      try {
        await navigator.clipboard.writeText(text);
        copyBtn.textContent = '복사됨';
        clearTimeout(timer);
        timer = setTimeout(() => {
          copyBtn.textContent = '복사';
        }, 2000);
      } catch {
        copyBtn.textContent = '실패';
      }
    });
  }
</script>

<style>
  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
  }

  .post {
    max-width: var(--width-content);
    width: 100%;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* 좁은 화면: 인라인 목차, 사이드바 숨김 */
  .toc-aside {
    display: none;
  }

  /* 와이드 화면: 목차를 우측 sticky 사이드바로 */
  @media (min-width: 1100px) {
    .post-grid {
      grid-template-columns: minmax(0, var(--width-content)) 220px;
      justify-content: center;
      justify-items: stretch;
      column-gap: 3.5rem;
    }

    .toc-inline {
      display: none;
    }

    .toc-aside {
      display: block;
    }

    .toc-sticky {
      /* sticky 헤더 높이만큼 내려서 고정 */
      position: sticky;
      top: 5.5rem;
      max-height: calc(100vh - 7rem);
      overflow-y: auto;
    }
  }

  /* 글 머리: 데스크톱은 한 줄에 [날짜 | 통계], 그 아래 제목·설명·커버.
     모바일은 통계를 제목 아래로 내려 위 날짜·카테고리와 위계를 분리한다. */
  .post-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 0.75rem;
  }

  .meta-line {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
  }

  .meta-stats {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4em 0.85em;
  }

  /* 통계 그룹 안에서는 간격을 gap이 책임지므로 칩의 기본 좌여백을 없앤다 */
  .meta-stats :global(.meta-stat) {
    margin-left: 0;
  }

  .post-header h1 {
    grid-column: 1 / -1;
    grid-row: 2;
    margin: 0.8rem 0 0.5rem;
    font-size: clamp(1.7rem, 5vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.35;
  }

  .post-header .description {
    grid-column: 1 / -1;
    grid-row: 3;
    margin: 0;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .post-header .cover {
    grid-column: 1 / -1;
    grid-row: 4;
    margin-top: 1.5rem;
    border-radius: var(--radius);
    width: 100%;
    height: auto;
  }

  /* 좁은 화면: 통계를 제목 아래 줄로 내린다(날짜·카테고리는 위에 그대로). */
  @media (max-width: 540px) {
    .post-header {
      grid-template-columns: 1fr;
    }

    .meta-line {
      grid-column: 1;
      grid-row: 1;
    }

    .post-header h1 {
      grid-column: 1;
      grid-row: 2;
    }

    .post-header .description {
      grid-column: 1;
      grid-row: 3;
    }

    .meta-stats {
      grid-column: 1;
      grid-row: 4;
      justify-self: start;
      /* 부제와 제목↔부제 간격만큼 띄워 통계 줄을 살짝 분리한다 */
      margin-top: 0.5rem;
    }

    .post-header .cover {
      grid-column: 1;
      grid-row: 5;
    }
  }

  .post-footer {
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }

  .tag-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 0.9rem;
  }

  .tag-list a {
    color: var(--text-muted);
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15em 0.8em;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .tag-list a:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }

  .connections {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background-color: var(--surface);
    padding: 1.1rem 1.4rem;
    /* 헤더 메타의 '연결 N개'에서 #connections로 점프할 때 고정 헤더에 안 가리게 */
    scroll-margin-top: 5.5rem;
  }

  .connections-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .connections h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
  }

  .to-graph {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .to-graph:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .connections ul {
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
  }

  .connections li {
    padding: 0.5rem 0;
    border-top: 1px solid var(--border);
  }

  .connections li:first-child {
    border-top: 0;
  }

  .edge-chip {
    --chip: var(--accent);
    display: inline-block;
    margin-inline-end: 0.6em;
    padding: 0.08em 0.7em;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--chip) 12%, var(--bg));
    color: var(--chip);
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
  }

  /* 타입별 색 — global.css의 --edge-* 단일 출처를 칩에 입힌다 */
  .edge-chip.extends { --chip: var(--edge-extends); }
  .edge-chip.supports { --chip: var(--edge-supports); }
  .edge-chip.refines { --chip: var(--edge-refines); }
  .edge-chip.instantiates { --chip: var(--edge-instantiates); }
  .edge-chip.requires { --chip: var(--edge-requires); }
  .edge-chip.triggered-by { --chip: var(--edge-triggered-by); }
  .edge-chip.contradicts { --chip: var(--edge-contradicts); }
  .edge-chip.related { --chip: var(--edge-related); }
  .edge-chip.mentions { --chip: var(--text-muted); }

  .connections li a {
    font-weight: 600;
    color: var(--text);
  }

  .connections li a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .edge-note {
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
  }

  .nav-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background-color: var(--surface);
    transition: border-color 0.15s ease, transform 0.15s ease;
    min-width: 0;
  }

  .nav-card:hover {
    border-color: var(--accent);
    text-decoration: none;
    transform: translateY(-2px);
  }

  .nav-card.newer {
    text-align: right;
    align-items: flex-end;
  }

  .nav-card .label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .nav-card .nav-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }

  @media (max-width: 540px) {
    .post-nav {
      grid-template-columns: 1fr;
