---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="페이지를 찾을 수 없어요" description="요청하신 페이지가 존재하지 않습니다.">
  <section class="not-found">
    <p class="code">404</p>
    <h1>페이지를 찾을 수 없어요</h1>
    <p>주소가 바뀌었거나 삭제된 글일 수 있어요.</p>
    <p><a href="/">홈으로 돌아가기</a></p>
  </section>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    padding: 4rem 0;
  }

  .code {
    margin: 0;
    font-size: 3rem;
    font-weight: 800;
    color: var(--accent);
    letter-spacing: -0.02em;
  }

  .not-found h1 {
    margin: 0.5rem 0 1rem;
    font-size: 1.4rem;
  }

  .not-found p {
    color: var(--text-muted);
  }
</style>
