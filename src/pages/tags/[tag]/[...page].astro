---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { getPublishedPosts } from '../../../utils/post';

// 태그별 10개씩 페이지. 1페이지 /tags/foo/, 2페이지부터 /tags/foo/2.
export async function getStaticPaths({ paginate }) {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.flatMap((tag) =>
    paginate(
      posts.filter((post) => post.data.tags.includes(tag)),
      { pageSize: 10, params: { tag } },
    ),
  );
}

const { tag } = Astro.params;
const { page } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`#${tag} 태그가 달린 글 ${page.total}편`}>
  <section class="tag-head">
    <h1>#{tag}</h1>
    <p>{page.total}편의 글</p>
  </section>

  <section class="post-list" aria-label={`#${tag} 태그 글 목록`}>
    {page.data.map((post) => <PostCard post={post} />)}
  </section>

  <Pagination currentPage={page.currentPage} lastPage={page.lastPage} prefix={`/tags/${tag}/`} />
</BaseLayout>

<style>
  .tag-head {
    padding: 1rem 0 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .tag-head h1 {
    margin: 0;
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--accent);
  }

  .tag-head p {
    margin: 0.4rem 0 0;
    color: var(--text-muted);
  }
</style>
