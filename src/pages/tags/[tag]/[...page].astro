---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sheet from '../../../components/Sheet.astro';
import PostRows from '../../../components/PostRows.astro';
import Pagination from '../../../components/Pagination.astro';
import { getPublishedPosts } from '../../../utils/post';

// 태그별 10개씩 페이지. 1페이지 /tags/foo/, 2페이지부터 /tags/foo/2.
export async function getStaticPaths({ paginate }) {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.flatMap((tag) =>
    paginate(
      posts.filter((post) => post.data.tags.includes(tag)),
      { pageSize: 10, params: { tag } },
    ),
  );
}

const { tag } = Astro.params;
const { page } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`#${tag} 태그가 달린 글 ${page.total}편`} wide>
  <Sheet rows title={`#${tag}`} eyebrow="태그">
    <p slot="meta">{page.total}개의 글</p>
    <section aria-label={`#${tag} 태그 글 목록`}>
      <PostRows posts={page.data} />
    </section>
    <Pagination currentPage={page.currentPage} lastPage={page.lastPage} prefix={`/tags/${tag}/`} />
  </Sheet>
</BaseLayout>
