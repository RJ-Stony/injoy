---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../utils/post';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`#${tag} 태그가 달린 글 ${posts.length}편`}>
  <section class="tag-head">
    <h1>#{tag}</h1>
    <p>{posts.length}편의 글</p>
  </section>

  <section class="post-list" aria-label={`#${tag} 태그 글 목록`}>
    {posts.map((post) => <PostCard post={post} />)}
  </section>
</BaseLayout>

<style>
  .tag-head {
    padding: 1rem 0 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .tag-head h1 {
    margin: 0;
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--accent);
  }

  .tag-head p {
    margin: 0.4rem 0 0;
    color: var(--text-muted);
  }
</style>
