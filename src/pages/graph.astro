---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGraph, EDGE_TYPES, AUTO_EDGE_TYPES } from '../utils/graph';
import { withBase } from '../utils/url';

const graph = await getGraph();

// 클라이언트로 보내는 직렬화 데이터 — url에 배포 base를 미리 적용한다
const data = {
  nodes: graph.nodes.map((n) => ({ ...n, url: withBase(n.url) })),
  edges: graph.edges,
  // 필터 칩에 쓸 연결 타입 라벨(EDGE_TYPES 단일 출처)
  edgeLabels: Object.fromEntries(Object.entries(EDGE_TYPES).map(([k, t]) => [k, t.label])),
};
---

<BaseLayout
  title="그래프"
  description="Injoy의 글과 태그가 어떻게 연결되어 있는지 한눈에 보는 지식 그래프."
>
  <section class="graph-head">
    <h1>그래프</h1>
    <p class="lead">글은 쌓이기만 하지 않고 서로 연결됩니다. 노드를 끌어 옮기고 눌러서 이동하세요. 오른쪽 아래 버튼으로 확대·축소할 수 있어요.</p>
    <p class="stats">
      <span><strong>{graph.stats.posts}</strong> 글</span>
      <span class="divider" aria-hidden="true">·</span>
      <span><strong>{graph.stats.edges}</strong> 연결</span>
      <span class="divider" aria-hidden="true">·</span>
      <span><strong>{graph.stats.tags}</strong> 태그</span>
    </p>
  </section>

  <div class="graph-filterbar" id="graph-filterbar" role="group" aria-label="그래프 필터"></div>

  <div class="graph-wrap">
    <canvas
      id="graph-canvas"
      tabindex="0"
      aria-label="글 연결 그래프. 노드를 끌거나 눌러 글로 이동할 수 있어요. 키보드는 화살표로 노드를 옮기고 엔터로 그 글로 이동합니다"
    ></canvas>
    <div id="graph-tooltip" hidden></div>
    <div class="graph-tools">
      <button type="button" class="gt-btn" id="gt-play" aria-label="글이 쌓인 순서대로 재생">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5l12 7-12 7z"></path></svg>
        <span class="gt-label">재생</span>
      </button>
    </div>
    <div class="graph-zoom">
      <button type="button" class="gz-btn" data-zoom="in" aria-label="확대">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
      </button>
      <button type="button" class="gz-btn" data-zoom="out" aria-label="축소">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"></path></svg>
      </button>
      <button type="button" class="gz-btn gz-reset" data-zoom="reset" aria-label="처음 크기로">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path></svg>
      </button>
    </div>
  </div>

  <ul class="legend" aria-label="범례">
    <li><span class="dot post" aria-hidden="true"></span>글</li>
    <li><span class="dot tag" aria-hidden="true"></span>태그</li>
    <li><span class="line solid" aria-hidden="true"></span>연결(타입별 색)</li>
    <li><span class="line dashed" aria-hidden="true"></span>언급·태그</li>
  </ul>

  <details class="edge-list">
    <summary>연결 타입 안내</summary>
    <ul class="type-guide">
      {
        Object.entries(EDGE_TYPES).map(([key, t]) => (
          <li>
            <span class:list={['edge-type', key]}>{t.label}</span>
            <span class="note">{t.criteria}</span>
          </li>
        ))
      }
      <li>
        <span class="edge-type mentions">{AUTO_EDGE_TYPES.mentions.label}</span>
        <span class="note">{AUTO_EDGE_TYPES.mentions.criteria}</span>
      </li>
    </ul>
  </details>

  <noscript>
    <p class="noscript-note">
      자바스크립트가 꺼져 있으면 그래프가 보이지 않아요. 각 글 아래 '연결된 글'에서 같은 연결을 따라갈 수 있어요.
    </p>
  </noscript>
</BaseLayout>

<script is:inline define:vars={{ data }}>
  (() => {
    const canvas = document.getElementById('graph-canvas');
    const tooltip = document.getElementById('graph-tooltip');
    if (!canvas || !tooltip) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const focusId = new URLSearchParams(location.search).get('focus');

    // 노드·엣지 준비
    const nodes = data.nodes.map((n) => ({ ...n, x: 0, y: 0, vx: 0, vy: 0 }));
    const byId = new Map(nodes.map((n) => [n.id, n]));
    const edges = data.edges
      .map((e) => ({ ...e, a: byId.get(e.from), b: byId.get(e.to) }))
      .filter((e) => e.a && e.b);
    const neighbors = new Map(nodes.map((n) => [n.id, new Set()]));
    edges.forEach((e) => {
      neighbors.get(e.a.id).add(e.b.id);
      neighbors.get(e.b.id).add(e.a.id);
    });

    let W = 0;
    let H = 0;
    let dpr = 1;
    // ---- 팬·줌 뷰 변환: 화면(CSS px) = 레이아웃좌표 * view.scale + view.t ----
    const view = { scale: 1, tx: 0, ty: 0 };
    const baseView = { scale: 1, tx: 0, ty: 0 }; // 마지막으로 맞춘 기준(리셋·줌 한계의 기준)
    let pendingFit = true; // 다음 '정착' 때 딱 한 번 노드에 꼭 맞춘다(매 프레임이 아니라)
    // 냉각 계수 — 힘을 alpha로 스케일하고 매 틱 줄여, 에너지가 점점 잦아들며 부드럽게 멈춘다(d3-force식).
    // 상수 감쇠만으론 매 wake가 풀 에너지로 진동(오버슈트)했다. 냉각으로 진입·드래그 모두 출렁임 없이 가라앉는다.
    let alpha = 1;
    const ALPHA_DECAY = 0.0228; // ≈300틱에 수렴(d3 기본 alphaDecay)
    const ALPHA_MIN = 0.0015; // 이보다 식으면 정착으로 보고 루프 종료
    const ALPHA_DRAG = 0.2; // 드래그 중 유지할 온기(이웃이 따라오되 과하지 않게 — 낮을수록 잔잔)
    const MAX_V = 26; // 노드 한 틱 최대 이동(속도 상한) — 가까운 점의 척력 스파이크에 튕겨 나가는 것 방지
    // 레이아웃을 담는 고정 박스(원점 중심 반너비·반높이). 글이 많이 늘면 살짝 키워 덜 겹치게.
    const spread = Math.min(2.2, Math.max(1, Math.sqrt(nodes.length / 28)));
    let BX = 0, BY = 0;
    const LBL = 48; // 라벨이 노드 밖으로 삐져나가는 여유(박스 가장자리 패딩)
    const toWorldX = (sx) => (sx - view.tx) / view.scale;
    const toWorldY = (sy) => (sy - view.ty) / view.scale;
    const clampScale = (s) => Math.min(baseView.scale * 6, Math.max(baseView.scale * 0.5, s));
    const radius = (n) =>
      n.kind === 'post' ? Math.min(9 + n.degree * 1.5, 17) : 5 + Math.min(n.degree, 3);

    // CSS 토큰에서 색을 읽는다 — 테마가 바뀌면 다시 읽어 다시 그린다
    const EDGE_KINDS = [
      'extends', 'supports', 'refines', 'instantiates',
      'requires', 'triggered-by', 'contradicts', 'related',
    ];
    const colors = { edge: {} };
    // CSS 색(hex)을 [r,g,b]로. 토큰은 #rrggbb 형식이지만, 혹시 다른 형식이면 canvas로 정규화해 읽는다.
    const toRGB = (css) => {
      const hex = css.replace(/^#/, '');
      if (/^[0-9a-f]{6}$/i.test(hex)) {
        const n = parseInt(hex, 16);
        return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
      }
      if (/^[0-9a-f]{3}$/i.test(hex)) {
        return [parseInt(hex[0] + hex[0], 16), parseInt(hex[1] + hex[1], 16), parseInt(hex[2] + hex[2], 16)];
      }
      ctx.fillStyle = '#000';
      ctx.fillStyle = css;
      const m = ctx.fillStyle.match(/[\d.]+/g);
      return m ? [+m[0], +m[1], +m[2]] : [47, 111, 237];
    };
    const readColors = () => {
      const s = getComputedStyle(document.documentElement);
      colors.accent = s.getPropertyValue('--accent').trim();
      colors.accentWeak = s.getPropertyValue('--accent-weak').trim();
      colors.text = s.getPropertyValue('--text').trim();
      colors.muted = s.getPropertyValue('--text-muted').trim();
      colors.border = s.getPropertyValue('--border').trim();
      colors.surface = s.getPropertyValue('--surface').trim();
      // 글 노드 나이 그라데이션 끝점 — 가장 옛 글은 surface 쪽으로 희석(옅게), 최신은 full accent.
      colors.accentRGB = toRGB(colors.accent);
      colors.surfaceRGB = toRGB(colors.surface);
      // 엣지 타입별 색 — global.css의 --edge-* 단일 출처를 캔버스가 공유한다
      for (const k of EDGE_KINDS) colors.edge[k] = s.getPropertyValue(`--edge-${k}`).trim();
      // 라벨 폰트도 여기서 한 번만 읽어 캐시한다 — draw()에서 매 프레임 읽지 않게
      colors.fontFamily = getComputedStyle(document.body).fontFamily;
    };

    // 글 노드 채움색 — 나이(0~1)를 surface↔accent 보간으로. 바닥선 0.5라 가장 옛 글도
    // 50% accent를 유지해 빈 원(태그 노드)과 헷갈리지 않는다. 최신(age=1)=full accent.
    const lerp = (a, b, t) => Math.round(a + (b - a) * t);
    const nodeFill = (age) => {
      const t = 0.5 + 0.5 * (typeof age === 'number' ? age : 1);
      const [sr, sg, sb] = colors.surfaceRGB;
      const [ar, ag, ab] = colors.accentRGB;
      return `rgb(${lerp(sr, ar, t)}, ${lerp(sg, ag, t)}, ${lerp(sb, ab, t)})`;
    };

    // 모바일 등 작은 화면 판정 — 시뮬레이션 부하·정착을 가볍게 조정하는 데 쓴다.
    const isSmall = () => Math.min(window.innerWidth, window.innerHeight) < 700;

    const resize = () => {
      const rect = canvas.parentElement.getBoundingClientRect();
      W = rect.width;
      H = Math.max(360, Math.min(560, Math.round(rect.width * 0.62)));
      BX = (W / 2) * spread; // 레이아웃 박스 반너비·반높이(원점 중심)
      BY = (H / 2) * spread;
      // 고DPR(모바일 2~3배) 백킹스토어가 매 프레임 칠하는 픽셀을 폭주시키지 않게 2배로 캡
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      canvas.style.height = `${H}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const seed = (n, i) => {
      // 결정적 초기 배치(원형, 원점 중심·박스 안) — 새로고침마다 모양이 안 널뛰게.
      const angle = (i / nodes.length) * Math.PI * 2;
      const r = Math.min(BX, BY) * 0.62;
      n.x = Math.cos(angle) * r * (n.kind === 'tag' ? 1.1 : 0.8);
      n.y = Math.sin(angle) * r * (n.kind === 'tag' ? 1.1 : 0.8);
    };

    // 힘 시뮬레이션 한 스텝. 노드 간 척력은 O(n²)라 글이 수십 개로 늘면
    // 공간 분할(Barnes-Hut류)로 근사해 줄일 수 있다. 지금 규모에선 단순 계산으로 충분.
    const tick = () => {
      const REPULSION = 2600;
      const SPRING = 0.012;
      const REST = 110;
      const GRAVITY = 0.012;
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          let dx = a.x - b.x;
          let dy = a.y - b.y;
          let d2 = dx * dx + dy * dy;
          if (d2 < 1) d2 = 1;
          const f = (REPULSION / d2) * alpha; // 냉각 스케일 — alpha가 줄면 힘도 잦아든다
          const d = Math.sqrt(d2);
          dx /= d;
          dy /= d;
          a.vx += dx * f;
          a.vy += dy * f;
          b.vx -= dx * f;
          b.vy -= dy * f;
        }
      }
      for (const e of edges) {
        const dx = e.b.x - e.a.x;
        const dy = e.b.y - e.a.y;
        const d = Math.sqrt(dx * dx + dy * dy) || 1;
        const rest = e.to.startsWith('tag:') ? REST * 0.6 : REST;
        const f = (d - rest) * SPRING * alpha;
        e.a.vx += (dx / d) * f;
        e.a.vy += (dy / d) * f;
        e.b.vx -= (dx / d) * f;
        e.b.vy -= (dy / d) * f;
      }
      const damp = isSmall() ? 0.78 : 0.82; // 작은 화면은 감쇠를 키워 더 빨리 정착(데스크톱 0.82 유지)
      for (const n of nodes) {
        // 중력은 좌표 원점(레이아웃 중심)으로 — 화면 중심이 아니다
        n.vx += (0 - n.x) * GRAVITY * alpha;
        n.vy += (0 - n.y) * GRAVITY * alpha;
        if (n === dragging) {
          n.vx = 0;
          n.vy = 0;
          continue;
        }
        n.vx *= damp;
        n.vy *= damp;
        // 속도 상한 — 두 점이 가까워져 척력이 순간 치솟아도 노드가 튕겨 나가지 않게 막는다(가끔 튐 방지).
        const sp = Math.hypot(n.vx, n.vy);
        if (sp > MAX_V) {
          n.vx *= MAX_V / sp;
          n.vy *= MAX_V / sp;
        }
        n.x += n.vx;
        n.y += n.vy;
        // 벽에 닿으면 그 방향 속도를 죽인다 — 안 그러면 벽으로 미는 힘에 눌려 가장자리에서 영영 떤다(에너지 누수).
        if (n.x <= -BX || n.x >= BX) n.vx = 0;
        if (n.y <= -BY || n.y >= BY) n.vy = 0;
        // 노드를 고정 박스(원점 중심) 안에 가둔다 — 박스 안 노드는 항상 화면 안(가장자리 잘림 0).
        n.x = Math.max(-BX, Math.min(BX, n.x));
        n.y = Math.max(-BY, Math.min(BY, n.y));
      }
      // 냉각: alpha를 목표로 끌어내린다. 드래그 중엔 ALPHA_DRAG로 데워 이웃이 계속 따라오고, 놓으면 0으로 식는다.
      alpha += ((dragging ? ALPHA_DRAG : 0) - alpha) * ALPHA_DECAY;
    };

    let hovered = null;
    let dragging = null;
    let selected = null; // 키보드로 고른 노드

    const highlightSet = () => {
      const pivot = hovered ?? selected ?? (focusTouched ? null : byId.get(focusId));
      if (!pivot) return null;
      const set = new Set([pivot.id, ...(neighbors.get(pivot.id) ?? [])]);
      return { pivot, set };
    };

    let focusTouched = false;

    // ---- 타임랩스(성장 재생): 물리는 안 건드리고, 정착된 좌표 위에 나이순으로 노드를 팝인만 시킨다 ----
    // 등장 순서: 글은 나이 오름차순(옛→새), 태그는 가장 먼저 등장하는 이웃 글 바로 뒤.
    const orderKey = new Map();
    const postsByAge = nodes
      .filter((n) => n.kind === 'post')
      .sort((a, b) => (a.age ?? 1) - (b.age ?? 1));
    postsByAge.forEach((n, i) => orderKey.set(n.id, i));
    for (const n of nodes) {
      if (orderKey.has(n.id)) continue;
      let min = Infinity;
      for (const nb of neighbors.get(n.id) ?? []) {
        const o = orderKey.get(nb);
        if (typeof o === 'number' && o < min) min = o;
      }
      orderKey.set(n.id, (min === Infinity ? postsByAge.length : min) + 0.5);
    }
    const appearIndex = new Map(
      [...nodes].sort((a, b) => orderKey.get(a.id) - orderKey.get(b.id)).map((n, i) => [n.id, i]),
    );
    let playing = false;
    let playStart = 0;
    let playMs = 12000;
    // 등장 진행도(0~1) — 노드 i는 progress*N이 i를 지날 때 1칸에 걸쳐 서서히 나타난다.
    const revealOf = (id) => {
      if (!playing) return 1;
      const p = (performance.now() - playStart) / playMs;
      return Math.max(0, Math.min(1, p * nodes.length - appearIndex.get(id)));
    };

    // ---- 필터: 카테고리/연결 타입으로 거르기(다중 선택·합집합, 그래프 위 바에 항상 노출) ----
    const ekey = (x, y) => (x < y ? `${x}|${y}` : `${y}|${x}`);
    const activeCats = new Set(); // 선택된 카테고리들
    const activeEdges = new Set(); // 선택된 연결 타입들
    let ovSet = null; // 밝게 유지할 노드 id 집합. null이면 필터 없음
    let ovEdgeKeys = null; // 밝게 유지할 엣지 키 집합
    const filterBar = document.getElementById('graph-filterbar');
    let syncChips = () => {};

    // 선택된 칩들로 밝게 유지할 노드·엣지를 다시 계산한다.
    //  · 카테고리: 그 카테고리 '글만'(이웃은 제외) + 같은 선택 안에서 글끼리 잇는 엣지.
    //  · 연결 타입: 그 타입 엣지 + 양 끝 노드. 여러 개는 합집합.
    const recomputeFilter = () => {
      if (activeCats.size === 0 && activeEdges.size === 0) {
        ovSet = null;
        ovEdgeKeys = null;
        return;
      }
      ovSet = new Set();
      ovEdgeKeys = new Set();
      const catBright = new Set(
        nodes.filter((n) => n.kind === 'post' && activeCats.has(n.category)).map((n) => n.id),
      );
      for (const id of catBright) ovSet.add(id);
      for (const e of edges) {
        if (activeEdges.has(e.type)) {
          ovEdgeKeys.add(ekey(e.a.id, e.b.id));
          ovSet.add(e.a.id);
          ovSet.add(e.b.id);
        } else if (catBright.has(e.a.id) && catBright.has(e.b.id)) {
          ovEdgeKeys.add(ekey(e.a.id, e.b.id)); // 선택 카테고리 글끼리의 연결
        }
      }
    };

    // dim 전환 애니 — 필터를 걸/풀 때 흐림을 툭 끊지 않고 부드럽게 오간다(0=전체 선명, 1=필터 적용).
    let dimT = 0;
    let dimTarget = 0;
    let dimRAF = 0;
    let filterActive = false; // 하나라도 선택돼 있나(dim 애니 목표 판단용 — fade-out 동안 집합 유지)
    const animateDim = () => {
      dimTarget = filterActive ? 1 : 0;
      if (reduceMotion) {
        dimT = dimTarget;
        if (!dimTarget) recomputeFilter(); // 즉시 정리(빈 선택이면 ovSet=null)
        draw();
        return;
      }
      if (dimRAF) return; // 이미 진행 중이면 목표만 바꿔 이어 달린다
      const stepD = () => {
        dimT += (dimTarget - dimT) * 0.22;
        if (Math.abs(dimTarget - dimT) < 0.008) {
          dimT = dimTarget;
          dimRAF = 0;
          if (dimTarget === 0) { ovSet = null; ovEdgeKeys = null; } // 다 풀린 뒤 정리(fade-out 후)
          draw();
          return;
        }
        draw();
        dimRAF = requestAnimationFrame(stepD);
      };
      dimRAF = requestAnimationFrame(stepD);
    };

    const clearFilter = () => {
      activeCats.clear();
      activeEdges.clear();
      filterActive = false;
      syncChips();
      // ovSet/ovEdgeKeys는 animateDim이 fade-out 끝에 정리(스냅 방지)
    };
    const toggleFilter = (kind, val) => {
      if (kind === 'all') {
        clearFilter();
        animateDim();
        return;
      }
      playing = false; // 재생 중이면 멈춘다
      const set = kind === 'category' ? activeCats : activeEdges;
      if (set.has(val)) set.delete(val);
      else set.add(val);
      filterActive = activeCats.size > 0 || activeEdges.size > 0;
      if (filterActive) recomputeFilter(); // 켜는 중엔 즉시 계산(fade-in). 다 끄면 집합 유지하다 fade-out 끝에 정리
      syncChips();
      animateDim();
    };

    const draw = () => {
      // 매 프레임 변환을 새로 깐다: device 픽셀 전체를 지우고, dpr·팬·줌을 합친 변환으로 그린다.
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.setTransform(dpr * view.scale, 0, 0, dpr * view.scale, dpr * view.tx, dpr * view.ty);
      // 우선순위: 재생(등장 연출) > 필터(dimT 전환) > hover 강조.
      const hoverHl = !playing && dimT <= 0 ? highlightSet() : null;
      const fade = (id) => {
        if (playing) return revealOf(id);
        if (dimT > 0) {
          const member = !ovSet || ovSet.has(id); // 밝게 유지할 집합
          return 1 + ((member ? 1 : 0.14) - 1) * dimT; // dimT 0→1: 1 → (member?1:0.14)
        }
        return hoverHl && !hoverHl.set.has(id) ? 0.14 : 1;
      };

      for (const e of edges) {
        const isTag = e.to.startsWith('tag:');
        const isMention = e.type === 'mentions';
        const faint = isTag || isMention;
        // 색: 타입별 단일 토큰. 태그·언급은 약한 회색(흰 배경에서도 보이게 muted), 명시 타입은 제 색.
        const stroke = faint ? colors.muted : colors.edge[e.type] || colors.accent;
        // 형태: 언급·태그는 잔점선, 반박(contradicts)은 긴 점선(색 없이도 '긴장'을 구분), 그 외 실선.
        const dash = faint ? [4, 4] : e.type === 'contradicts' ? [9, 5] : [];
        // 필터 모드면 필터에 든 엣지만 강조, 아니면 강조집합 양끝이 걸린 엣지.
        const strong = ovEdgeKeys
          ? ovEdgeKeys.has(ekey(e.a.id, e.b.id))
          : hoverHl && hoverHl.set.has(e.a.id) && hoverHl.set.has(e.b.id);
        let alpha = Math.min(fade(e.a.id), fade(e.b.id)) * (faint ? 0.45 : 0.95);
        // 필터에 안 든 엣지는 더 흐리게 — dimT로 부드럽게 전환(스냅 방지). 재생 중엔 fade가 이미 등장도 반영.
        if (ovEdgeKeys && !strong && dimT > 0) {
          alpha = alpha * (1 - dimT) + Math.min(alpha, 0.06) * dimT;
        }
        ctx.save();
        ctx.globalAlpha = alpha;
        ctx.strokeStyle = stroke;
        ctx.lineWidth = (dash.length ? 1 : 1.6) + (strong ? 0.8 : 0);
        ctx.setLineDash(dash);
        ctx.beginPath();
        ctx.moveTo(e.a.x, e.a.y);
        ctx.lineTo(e.b.x, e.b.y);
        ctx.stroke();
        ctx.restore();
      }

      for (const n of nodes) {
        const r = radius(n);
        ctx.save();
        ctx.globalAlpha = fade(n.id);
        ctx.beginPath();
        ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
        if (n.kind === 'post') {
          ctx.fillStyle = nodeFill(n.age); // 나이별 진하기(옛→옅게, 최신→진하게)
          ctx.fill();
        } else {
          ctx.fillStyle = colors.surface;
          ctx.fill();
          ctx.strokeStyle = colors.muted;
          ctx.lineWidth = 1.2;
          ctx.stroke();
        }
        // 강조 링 — 호버·키보드 선택·URL 포커스된 노드(글·태그 공통)
        if (
          (hovered && hovered.id === n.id) ||
          (selected && selected.id === n.id) ||
          (!focusTouched && focusId === n.id)
        ) {
          ctx.strokeStyle = colors.accent;
          ctx.lineWidth = 2;
          ctx.setLineDash([]);
          ctx.beginPath();
          ctx.arc(n.x, n.y, r + 4, 0, Math.PI * 2);
          ctx.stroke();
        }
        // 라벨
        ctx.fillStyle = n.kind === 'post' ? colors.text : colors.muted;
        ctx.font = `${n.kind === 'post' ? 600 : 400} ${n.kind === 'post' ? 12.5 : 11.5}px ${colors.fontFamily}`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'top';
        const label =
          n.kind === 'post' && n.label.length > 16 ? `${n.label.slice(0, 15)}…` : n.label;
        ctx.fillText(label, n.x, n.y + r + 5);
        ctx.restore();
      }
    };

    // 고정 박스(+라벨 여유)를 캔버스에 한 번 맞춘다(원점→캔버스 중앙). 박스가 불변이라
    // 이 뷰도 불변 → 시뮬레이션이 도는 동안 화면이 흔들리지 않는다(애니메이션용 기본 뷰).
    const homeView = () => {
      if (W <= 0 || H <= 0) return;
      const pad = 8;
      const s = Math.max(
        Math.min((W / 2 - pad) / (BX + LBL), (H / 2 - pad) / (BY + LBL)),
        0.05,
      );
      baseView.scale = s;
      baseView.tx = W / 2;
      baseView.ty = H / 2;
      view.scale = s;
      view.tx = W / 2;
      view.ty = H / 2;
    };

    // 실제 노드들의 경계상자에 꼭 맞춘다 — '정착했을 때 한 번만' 호출(매 프레임 아님).
    const fitToBbox = () => {
      if (!nodes.length || W <= 0 || H <= 0) return;
      let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
      for (const n of nodes) {
        const r = radius(n);
        const fs = n.kind === 'post' ? 12.5 : 11.5;
        const halfLabel = (Math.min(n.label.length, 16) * fs * 0.55) / 2; // 라벨 반너비 추정
        const ext = Math.max(r, halfLabel);
        if (n.x - ext < minX) minX = n.x - ext;
        if (n.x + ext > maxX) maxX = n.x + ext;
        if (n.y - r < minY) minY = n.y - r;
        if (n.y + r + fs + 6 > maxY) maxY = n.y + r + fs + 6; // 라벨은 노드 아래
      }
      const bw = Math.max(maxX - minX, 1);
      const bh = Math.max(maxY - minY, 1);
      const pad = 12;
      // 음수·0 스케일(거울상·0으로 나눔) 방지용 작은 양수 하한
      const s = Math.max(Math.min((W - pad * 2) / bw, (H - pad * 2) / bh), 0.05);
      baseView.scale = s;
      baseView.tx = (W - bw * s) / 2 - minX * s;
      baseView.ty = (H - bh * s) / 2 - minY * s;
      view.scale = baseView.scale;
      view.tx = baseView.tx;
      view.ty = baseView.ty;
    };

    // 한 점(화면 px)을 기준으로 줌 — 그 점 아래 좌표가 제자리에 남도록 tx,ty를 다시 잡는다.
    const zoomAtPoint = (cx, cy, targetScale) => {
      const ns = clampScale(targetScale);
      const wx = (cx - view.tx) / view.scale;
      const wy = (cy - view.ty) / view.scale;
      view.scale = ns;
      view.tx = cx - wx * ns;
      view.ty = cy - wy * ns;
      pendingFit = false; // 사용자가 줌했으니 정착 시 자동 맞춤이 덮어쓰지 않게
      draw();
    };

    // 선택한 노드가 화면 밖이면 화면 안으로 살짝 끌어온다(스케일 유지) — 키보드 탐색용.
    const ensureVisible = (n) => {
      const margin = 44;
      const sx = n.x * view.scale + view.tx;
      const sy = n.y * view.scale + view.ty;
      let dx = 0, dy = 0;
      if (sx < margin) dx = margin - sx;
      else if (sx > W - margin) dx = W - margin - sx;
      if (sy < margin) dy = margin - sy;
      else if (sy > H - margin) dy = H - margin - sy;
      if (dx || dy) {
        view.tx += dx;
        view.ty += dy;
        pendingFit = false; // 직접 옮겼으니 정착 시 자동 맞춤이 덮어쓰지 않게
      }
    };

    let running = false;
    let frames = 0;
    const loop = () => {
      frames++;
      tick();
      draw();
      // alpha가 충분히 식으면(또는 안전 상한까지) 정착으로 보고 루프를 끝낸다(무한 rAF·발열 방지). 드래그 중엔 유지.
      // 냉각이 정상 작동하면 alpha<ALPHA_MIN이 먼저 와서 maxFrames 전에 멈춘다(maxFrames는 backstop).
      const maxFrames = isSmall() ? 400 : 500;
      if ((alpha < ALPHA_MIN || frames > maxFrames) && !dragging) {
        running = false;
        if (pendingFit) { // 정착했을 때 딱 한 번 노드에 꼭 맞춘다(이후 hover로 wake돼도 다시 안 함)
          fitToBbox();
          pendingFit = false;
        }
        return;
      }
      requestAnimationFrame(loop);
    };
    const wake = () => {
      alpha = Math.max(alpha, 0.3); // 깨우면 살짝 데워 부드럽게 재정착(드래그 후 등 — 너무 높으면 튄다)
      if (reduceMotion) {
        for (let i = 0; i < 320; i++) tick(); // 냉각이 그 안에서 작동해 정착(애니 없이)
        if (pendingFit) { fitToBbox(); pendingFit = false; }
        draw();
        return;
      }
      frames = 0;
      if (!running) {
        running = true;
        requestAnimationFrame(loop);
      }
    };

    const nodeAt = (sx, sy) => {
      const x = toWorldX(sx);
      const y = toWorldY(sy);
      for (let i = nodes.length - 1; i >= 0; i--) {
        const n = nodes[i];
        const r = radius(n) + 6 / view.scale; // 6px 슬롭을 레이아웃 단위로 환산
        if ((n.x - x) ** 2 + (n.y - y) ** 2 <= r * r) return n;
      }
      return null;
    };

    const pos = (ev) => {
      const rect = canvas.getBoundingClientRect();
      return { x: ev.clientX - rect.left, y: ev.clientY - rect.top };
    };

    let moved = false;
    let dragStart = null; // 노드 드래그: { x, y, pointerId, slop }
    let panStart = null; // 빈 곳 팬: { x, y, tx, ty, pointerId }
    let pinchStart = null; // 두 손가락 확대: { dist, cx, cy, scale, tx, ty }
    const pointers = new Map(); // 활성 포인터 id → 화면좌표(두 손가락 판정용)

    canvas.addEventListener('pointerdown', (ev) => {
      if (ev.pointerType === 'mouse' && ev.button !== 0) return; // 마우스는 주 버튼만
      const { x, y } = pos(ev);
      pointers.set(ev.pointerId, { x, y });
      if (playing) { playing = false; draw(); } // 상호작용하면 타임랩스 중단(중간 프레임에 안 얼게 다시 그린다)

      // 두 포인터 → 두 손가락 확대(+이동). 진행 중이던 노드드래그·팬은 취소.
      if (pointers.size === 2) {
        dragging = null;
        dragStart = null;
        panStart = null;
        const p = [...pointers.values()];
        pinchStart = {
          dist: Math.hypot(p[0].x - p[1].x, p[0].y - p[1].y) || 1,
          cx: (p[0].x + p[1].x) / 2,
          cy: (p[0].y + p[1].y) / 2,
          scale: view.scale,
          tx: view.tx,
          ty: view.ty,
        };
        try { canvas.setPointerCapture(ev.pointerId); } catch {}
        return;
      }
      if (pointers.size !== 1) return;

      const n = nodeAt(x, y);
      if (n) {
        dragging = n;
        moved = false;
        dragStart = { x, y, pointerId: ev.pointerId, slop: ev.pointerType === 'touch' ? 10 : 5 };
        focusTouched = true;
        // 잡은 노드를 강조로 고정 — 모바일(호버 없음)에서도 데스크톱 호버처럼 노드+연결이 강조된다.
        // 터치에서만: 데스크톱은 호버가 강조를 담당하므로, 드래그 재배치 후 강조가 고착되지 않게 둔다.
        if (ev.pointerType === 'touch') selected = n;
        try { canvas.setPointerCapture(ev.pointerId); } catch {}
        wake();
        draw();
      } else {
        // 빈 곳 탭 = 강조 해제(모바일 포함).
        if (selected) {
          selected = null;
          draw();
        }
        if (ev.pointerType !== 'touch') {
          // 빈 곳 드래그 = 팬. 단 터치 한 손가락은 페이지 세로 스크롤을 위해 팬하지 않는다.
          panStart = { x, y, tx: view.tx, ty: view.ty, pointerId: ev.pointerId };
          try { canvas.setPointerCapture(ev.pointerId); } catch {}
        }
      }
    });

    canvas.addEventListener('pointermove', (ev) => {
      const { x, y } = pos(ev);
      if (pointers.has(ev.pointerId)) pointers.set(ev.pointerId, { x, y });

      // 두 손가락 확대 + 이동
      if (pinchStart && pointers.size === 2) {
        const p = [...pointers.values()];
        const dist = Math.hypot(p[0].x - p[1].x, p[0].y - p[1].y) || 1;
        const mx = (p[0].x + p[1].x) / 2;
        const my = (p[0].y + p[1].y) / 2;
        const ns = clampScale((pinchStart.scale * dist) / pinchStart.dist);
        // 시작 중점 아래 좌표를 현재 중점으로 옮긴다(벌림=줌, 함께 이동=팬)
        const wx = (pinchStart.cx - pinchStart.tx) / pinchStart.scale;
        const wy = (pinchStart.cy - pinchStart.ty) / pinchStart.scale;
        view.scale = ns;
        view.tx = mx - wx * ns;
        view.ty = my - wy * ns;
        pendingFit = false;
        draw();
        return;
      }

      // 노드 드래그
      if (dragging && dragStart && ev.pointerId === dragStart.pointerId) {
        // 슬롭 이내의 미세 이동은 탭으로 취급 — 노드도 밀리지 않게 보류
        if (!moved && Math.hypot(x - dragStart.x, y - dragStart.y) < dragStart.slop) return;
        moved = true;
        pendingFit = false; // 손으로 옮기기 시작하면 자동 맞춤을 멈춘다
        dragging.x = toWorldX(x);
        dragging.y = toWorldY(y);
        wake();
        return;
      }

      // 빈 곳 팬
      if (panStart && ev.pointerId === panStart.pointerId) {
        view.tx = panStart.tx + (x - panStart.x);
        view.ty = panStart.ty + (y - panStart.y);
        pendingFit = false;
        draw();
        return;
      }

      if (dragging || panStart || pinchStart) return;

      const n = nodeAt(x, y);
      if (n !== hovered) {
        hovered = n;
        focusTouched = focusTouched || n !== null;
        canvas.style.cursor = n ? 'pointer' : 'default';
        if (n) {
          tooltip.textContent =
            n.kind === 'post' ? `${n.label}${n.category ? ` · ${n.category}` : ''}` : n.label;
          tooltip.hidden = false;
          tooltip.style.left = `${Math.min(x + 14, W - 160)}px`;
          tooltip.style.top = `${y + 14}px`;
        } else {
          tooltip.hidden = true;
        }
        // 배치는 이미 정착했으니 hover는 강조만 다시 그린다 — 물리(wake) 금지.
        // (hover마다 wake하면 마우스를 올릴 때마다 시뮬이 재시동돼 노드가 계속 출렁였다. 키보드 탐색과 동일하게 draw만.)
        draw();
      } else if (n && !tooltip.hidden) {
        tooltip.style.left = `${Math.min(x + 14, W - 160)}px`;
        tooltip.style.top = `${y + 14}px`;
      }
    });

    const dropPointer = (ev) => {
      pointers.delete(ev.pointerId);
      if (pointers.size < 2) pinchStart = null;
    };
    canvas.addEventListener('pointerup', (ev) => {
      const wasDrag = dragStart && ev.pointerId === dragStart.pointerId;
      const wasPan = panStart && ev.pointerId === panStart.pointerId;
      dropPointer(ev);
      if (wasDrag) {
        if (dragging && !moved) location.href = dragging.url; // 안 움직였으면 탭 = 글로 이동
        dragging = null;
        dragStart = null;
        wake();
      } else if (wasPan) {
        panStart = null;
      }
    });
    // 드래그·이동·두 손가락 동작이 시스템 제스처로 끊겨도 상태가 고착되지 않게
    const endGesture = (ev) => {
      if (ev) dropPointer(ev);
      dragging = null;
      dragStart = null;
      panStart = null;
      wake();
    };
    canvas.addEventListener('pointercancel', endGesture);
    canvas.addEventListener('lostpointercapture', endGesture);

    // 줌은 Ctrl+휠(또는 트랙패드 오므렸다 펴기=ctrlKey)로만 — 일반 휠은 페이지 스크롤로 흘려보낸다.
    // (캔버스가 화면을 크게 차지해서, 무조건 줌으로 먹으면 그래프 위에서 스크롤이 갇힌다.)
    canvas.addEventListener(
      'wheel',
      (ev) => {
        if (!ev.ctrlKey && !ev.metaKey) return;
        ev.preventDefault();
        const { x, y } = pos(ev);
        zoomAtPoint(x, y, view.scale * Math.exp(-ev.deltaY * 0.0015));
      },
      { passive: false },
    );

    // 빈 곳 더블클릭 = 처음 크기로 되돌리기(자동 맞춤 재개)
    canvas.addEventListener('dblclick', (ev) => {
      const { x, y } = pos(ev);
      if (nodeAt(x, y)) return;
      ev.preventDefault();
      fitToBbox(); // 현재 노드들에 꼭 맞춰 되돌린다
      pendingFit = false;
      draw();
    });

    // 터치: 한 손가락이 노드 위면(=드래그) 또는 두 손가락이면 제스처를 가져온다.
    // 빈 곳 한 손가락은 페이지 세로 스크롤을 위해 그대로 흘려보낸다(touch-action: pan-y).
    canvas.addEventListener(
      'touchstart',
      (ev) => {
        if (ev.touches.length >= 2) {
          ev.preventDefault();
          return;
        }
        const t = ev.touches[0];
        if (!t) return;
        const rect = canvas.getBoundingClientRect();
        if (nodeAt(t.clientX - rect.left, t.clientY - rect.top)) ev.preventDefault();
      },
      { passive: false },
    );
    canvas.addEventListener('pointerleave', () => {
      if (dragging || panStart || pinchStart) return;
      hovered = null;
      tooltip.hidden = true;
      draw(); // 강조 해제만 다시 그린다(물리 재시동 없이)
    });

    // 키보드 탐색 — 화살표로 노드 순회, Enter로 그 글로 이동, Esc로 선택 해제.
    // 배치는 이미 정착해 있으니 물리(wake)는 다시 돌리지 않고 draw()만 다시 그린다.
    const showTipAt = (n) => {
      tooltip.textContent =
        n.kind === 'post' ? `${n.label}${n.category ? ` · ${n.category}` : ''}` : n.label;
      tooltip.hidden = false;
      const sx = n.x * view.scale + view.tx;
      const sy = n.y * view.scale + view.ty;
      tooltip.style.left = `${Math.min(sx + 14, W - 160)}px`;
      tooltip.style.top = `${sy + 14}px`;
    };
    canvas.addEventListener('keydown', (ev) => {
      const k = ev.key;
      if (k === 'ArrowRight' || k === 'ArrowDown' || k === 'ArrowLeft' || k === 'ArrowUp') {
        ev.preventDefault();
        if (!nodes.length) return;
        const dir = k === 'ArrowRight' || k === 'ArrowDown' ? 1 : -1;
        const i = selected ? nodes.indexOf(selected) : -1;
        selected = nodes[(i + dir + nodes.length) % nodes.length];
        focusTouched = true;
        ensureVisible(selected);
        showTipAt(selected);
        draw();
      } else if (k === 'Enter') {
        if (selected) {
          ev.preventDefault();
          location.href = selected.url;
        }
      } else if (k === 'Escape') {
        if (!selected) return;
        selected = null;
        tooltip.hidden = true;
        draw();
      }
    });
    canvas.addEventListener('blur', () => {
      // 포커스를 잃으면 키보드 선택 강조·툴팁을 정리(마우스 호버와 섞이지 않게)
      if (!selected) return;
      selected = null;
      tooltip.hidden = true;
      draw();
    });

    const restart = () => {
      readColors();
      resize();
      nodes.forEach(seed);
      // 애니로 정착시키되 alpha 냉각으로 *식으며* 멈춘다 — 진입 시 부드럽게 자리잡고 출렁이지 않는다.
      homeView(); // 애니 동안 쓸 고정 뷰. 정착하면 노드에 꼭 맞춘다(loop의 pendingFit).
      pendingFit = true;
      alpha = 1; // 다시 데워 처음부터 냉각 시작
      wake();
    };

    window.addEventListener('injoy:theme-change', () => {
      readColors();
      draw();
    });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      readColors();
      draw();
    });
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        // 모바일 주소창 접힘 등 높이만 변하는 resize에서는 배치를 보존한다
        const w = canvas.parentElement.getBoundingClientRect().width;
        if (Math.abs(w - W) < 1) return;
        restart();
      }, 150);
    });

    // 화면 +/− 확대 버튼 — 모바일·데스크톱 공통(제스처를 몰라도 됨). 캔버스 가운데 기준으로 줌.
    canvas.parentElement.querySelectorAll('.gz-btn').forEach((b) => {
      b.addEventListener('click', () => {
        const k = b.dataset.zoom;
        if (k === 'reset') {
          fitToBbox();
          pendingFit = false;
          draw();
          return;
        }
        zoomAtPoint(W / 2, H / 2, view.scale * (k === 'in' ? 1.3 : 1 / 1.3));
      });
    });

    // 성장 재생(타임랩스) — 정착 레이아웃 위에 나이순으로 노드가 팝인. 물리는 안 건드린다.
    const playBtn = document.getElementById('gt-play');
    playBtn?.addEventListener('click', () => {
      if (playing) { playing = false; draw(); return; }
      clearFilter();
      if (dimRAF) { cancelAnimationFrame(dimRAF); dimRAF = 0; }
      dimT = 0; ovSet = null; ovEdgeKeys = null; // 필터 흔적 즉시 제거(재생은 전체 등장)
      hovered = null;
      selected = null;
      focusTouched = true; // URL focus 강조도 끄고 순수 등장만
      fitToBbox(); // 재생 동안 모든 노드가 보이도록 뷰를 고정
      pendingFit = false;
      if (reduceMotion) { draw(); return; } // 모션 줄이기: 애니 없이 전체 표시
      playing = true;
      playStart = performance.now();
      playMs = Math.min(16000, Math.max(6000, nodes.length * 260));
      const step = () => {
        if (!playing) return;
        draw();
        // 마지막 노드까지 다 나타나고(+한 칸 여유) 나면 종료
        if ((performance.now() - playStart) / playMs >= 1 + 1 / nodes.length) {
          playing = false;
          draw();
          return;
        }
        requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });

    // 그래프 위 필터 바 만들기(카테고리 + 연결 타입 칩, 항상 노출·다중 선택). 색은 readColors 뒤라야 하므로 restart 뒤.
    const buildFilterBar = () => {
      if (!filterBar) return;
      const cats = [...new Set(nodes.filter((n) => n.kind === 'post' && n.category).map((n) => n.category))];
      const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      let html = '<div class="gf-group"><span class="gf-title">카테고리</span><div class="gf-chips">';
      html += '<button type="button" class="gf-chip gf-all" data-kind="all" data-val="">전체</button>';
      for (const c of cats)
        html += `<button type="button" class="gf-chip" data-kind="category" data-val="${esc(c)}" aria-pressed="false">${esc(c)}</button>`;
      html += '</div></div><div class="gf-group"><span class="gf-title">연결 타입</span><div class="gf-chips">';
      for (const k of EDGE_KINDS)
        html += `<button type="button" class="gf-chip gf-edge" data-kind="edge" data-val="${k}" aria-pressed="false" style="--chip:${colors.edge[k] || colors.accent}"><span class="gf-sw" aria-hidden="true"></span>${esc(data.edgeLabels?.[k] || k)}</button>`;
      html += '</div></div>';
      filterBar.innerHTML = html;
      syncChips = () => {
        for (const chip of filterBar.querySelectorAll('.gf-chip')) {
          if (chip.dataset.kind === 'all') {
            // '전체'는 아무것도 선택 안 됐을 때 활성으로 보인다
            chip.setAttribute('aria-pressed', String(activeCats.size === 0 && activeEdges.size === 0));
            continue;
          }
          const set = chip.dataset.kind === 'category' ? activeCats : activeEdges;
          chip.setAttribute('aria-pressed', String(set.has(chip.dataset.val)));
        }
      };
    };
    filterBar?.addEventListener('click', (ev) => {
      const chip = ev.target.closest('.gf-chip');
      if (chip) toggleFilter(chip.dataset.kind, chip.dataset.val);
    });

    restart();
    buildFilterBar();
    syncChips(); // '전체' 초기 활성 표시

    // 개발·테스트용 좌표 핸들 (외부 의존 없음)
    window.__injoyGraph = {
      nodes, view, baseView, homeView, fit: () => { fitToBbox(); draw(); },
      // 테스트 훅
      _filter: (kind, val) => toggleFilter(kind, val),
      _play: () => playBtn?.click(),
      _state: () => ({ playing, cats: [...activeCats], edges: [...activeEdges], bright: ovSet ? ovSet.size : null }),
    };
  })();
</script>

<style>
