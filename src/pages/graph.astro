---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGraph, EDGE_TYPES, AUTO_EDGE_TYPES } from '../utils/graph';
import { withBase } from '../utils/url';

const graph = await getGraph();

// 클라이언트로 보내는 직렬화 데이터 — url에 배포 base를 미리 적용한다
const data = {
  nodes: graph.nodes.map((n) => ({ ...n, url: withBase(n.url) })),
  edges: graph.edges,
};
---

<BaseLayout
  title="그래프"
  description="Injoy의 글과 태그가 어떻게 연결되어 있는지 한눈에 보는 지식 그래프."
>
  <section class="graph-head">
    <h1>그래프</h1>
    <p class="lead">글은 쌓이기만 하지 않고 서로 연결됩니다. 노드를 끌어 보고, 눌러서 이동하세요.</p>
    <p class="stats">
      <span><strong>{graph.stats.posts}</strong> 글</span>
      <span class="divider" aria-hidden="true">·</span>
      <span><strong>{graph.stats.edges}</strong> 연결</span>
      <span class="divider" aria-hidden="true">·</span>
      <span><strong>{graph.stats.tags}</strong> 태그</span>
    </p>
  </section>

  <div class="graph-wrap">
    <canvas id="graph-canvas" aria-label="글 연결 그래프. 노드를 끌거나 눌러 글로 이동할 수 있어요"></canvas>
    <div id="graph-tooltip" hidden></div>
  </div>

  <ul class="legend" aria-label="범례">
    <li><span class="dot post" aria-hidden="true"></span>글</li>
    <li><span class="dot tag" aria-hidden="true"></span>태그</li>
    <li><span class="line solid" aria-hidden="true"></span>연결(타입별 색)</li>
    <li><span class="line dashed" aria-hidden="true"></span>언급·태그</li>
  </ul>

  <details class="edge-list">
    <summary>연결 타입 안내</summary>
    <ul class="type-guide">
      {
        Object.entries(EDGE_TYPES).map(([key, t]) => (
          <li>
            <span class:list={['edge-type', key]}>{t.label}</span>
            <span class="note">{t.criteria}</span>
          </li>
        ))
      }
      <li>
        <span class="edge-type mentions">{AUTO_EDGE_TYPES.mentions.label}</span>
        <span class="note">{AUTO_EDGE_TYPES.mentions.criteria}</span>
      </li>
    </ul>
  </details>

  <noscript>
    <p class="noscript-note">
      자바스크립트가 꺼져 있으면 그래프가 보이지 않아요. 각 글 아래 '연결된 글'에서 같은 연결을 따라갈 수 있어요.
    </p>
  </noscript>
</BaseLayout>

<script is:inline define:vars={{ data }}>
  (() => {
    const canvas = document.getElementById('graph-canvas');
    const tooltip = document.getElementById('graph-tooltip');
    if (!canvas || !tooltip) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const focusId = new URLSearchParams(location.search).get('focus');

    // 노드·엣지 준비
    const nodes = data.nodes.map((n) => ({ ...n, x: 0, y: 0, vx: 0, vy: 0 }));
    const byId = new Map(nodes.map((n) => [n.id, n]));
    const edges = data.edges
      .map((e) => ({ ...e, a: byId.get(e.from), b: byId.get(e.to) }))
      .filter((e) => e.a && e.b);
    const neighbors = new Map(nodes.map((n) => [n.id, new Set()]));
    edges.forEach((e) => {
      neighbors.get(e.a.id).add(e.b.id);
      neighbors.get(e.b.id).add(e.a.id);
    });

    let W = 0;
    let H = 0;
    const radius = (n) =>
      n.kind === 'post' ? Math.min(9 + n.degree * 1.5, 17) : 5 + Math.min(n.degree, 3);

    // CSS 토큰에서 색을 읽는다 — 테마가 바뀌면 다시 읽어 다시 그린다
    const EDGE_KINDS = [
      'extends', 'supports', 'refines', 'instantiates',
      'requires', 'triggered-by', 'contradicts', 'related',
    ];
    const colors = { edge: {} };
    const readColors = () => {
      const s = getComputedStyle(document.documentElement);
      colors.accent = s.getPropertyValue('--accent').trim();
      colors.accentWeak = s.getPropertyValue('--accent-weak').trim();
      colors.text = s.getPropertyValue('--text').trim();
      colors.muted = s.getPropertyValue('--text-muted').trim();
      colors.border = s.getPropertyValue('--border').trim();
      colors.surface = s.getPropertyValue('--surface').trim();
      // 엣지 타입별 색 — global.css의 --edge-* 단일 출처를 캔버스가 공유한다
      for (const k of EDGE_KINDS) colors.edge[k] = s.getPropertyValue(`--edge-${k}`).trim();
      // 라벨 폰트도 여기서 한 번만 읽어 캐시한다 — draw()에서 매 프레임 읽지 않게
      colors.fontFamily = getComputedStyle(document.body).fontFamily;
    };

    // 모바일 등 작은 화면 판정 — 시뮬레이션 부하·정착을 가볍게 조정하는 데 쓴다.
    const isSmall = () => Math.min(window.innerWidth, window.innerHeight) < 700;

    const resize = () => {
      const rect = canvas.parentElement.getBoundingClientRect();
      W = rect.width;
      H = Math.max(360, Math.min(560, Math.round(rect.width * 0.62)));
      // 고DPR(모바일 2~3배) 백킹스토어가 매 프레임 칠하는 픽셀을 폭주시키지 않게 2배로 캡
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      canvas.style.height = `${H}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const seed = (n, i) => {
      // 결정적 초기 배치(원형) — 새로고침마다 모양이 널뛰지 않게
      const angle = (i / nodes.length) * Math.PI * 2;
      const r = Math.min(W, H) * 0.32;
      n.x = W / 2 + Math.cos(angle) * r * (n.kind === 'tag' ? 1.15 : 0.85);
      n.y = H / 2 + Math.sin(angle) * r * (n.kind === 'tag' ? 1.15 : 0.85);
    };

    // 힘 시뮬레이션 한 스텝. 노드 간 척력은 O(n²)라 글이 수십 개로 늘면
    // 공간 분할(Barnes-Hut류)로 근사해 줄일 수 있다. 지금 규모에선 단순 계산으로 충분.
    const tick = () => {
      const REPULSION = 2600;
      const SPRING = 0.012;
      const REST = 110;
      const GRAVITY = 0.012;
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          let dx = a.x - b.x;
          let dy = a.y - b.y;
          let d2 = dx * dx + dy * dy;
          if (d2 < 1) d2 = 1;
          const f = REPULSION / d2;
          const d = Math.sqrt(d2);
          dx /= d;
          dy /= d;
          a.vx += dx * f;
          a.vy += dy * f;
          b.vx -= dx * f;
          b.vy -= dy * f;
        }
      }
      for (const e of edges) {
        const dx = e.b.x - e.a.x;
        const dy = e.b.y - e.a.y;
        const d = Math.sqrt(dx * dx + dy * dy) || 1;
        const rest = e.to.startsWith('tag:') ? REST * 0.6 : REST;
        const f = (d - rest) * SPRING;
        e.a.vx += (dx / d) * f;
        e.a.vy += (dy / d) * f;
        e.b.vx -= (dx / d) * f;
        e.b.vy -= (dy / d) * f;
      }
      const damp = isSmall() ? 0.78 : 0.82; // 작은 화면은 감쇠를 키워 더 빨리 정착(데스크톱 0.82 유지)
      for (const n of nodes) {
        n.vx += (W / 2 - n.x) * GRAVITY;
        n.vy += (H / 2 - n.y) * GRAVITY;
        if (n === dragging) {
          n.vx = 0;
          n.vy = 0;
          continue;
        }
        n.vx *= damp;
        n.vy *= damp;
        n.x += n.vx;
        n.y += n.vy;
        const m = 24;
        n.x = Math.max(m, Math.min(W - m, n.x));
        n.y = Math.max(m, Math.min(H - m, n.y));
      }
    };

    let hovered = null;
    let dragging = null;

    const highlightSet = () => {
      const pivot = hovered ?? (focusTouched ? null : byId.get(focusId));
      if (!pivot) return null;
      const set = new Set([pivot.id, ...(neighbors.get(pivot.id) ?? [])]);
      return { pivot, set };
    };

    let focusTouched = false;

    const draw = () => {
      ctx.clearRect(0, 0, W, H);
      const hl = highlightSet();
      const fade = (id) => (hl && !hl.set.has(id) ? 0.14 : 1);

      for (const e of edges) {
        const isTag = e.to.startsWith('tag:');
        const isMention = e.type === 'mentions';
        const faint = isTag || isMention;
        // 색: 타입별 단일 토큰. 태그·언급은 약하게(회색), 명시 타입은 제 색.
        const stroke = isTag
          ? colors.border
          : isMention
            ? colors.muted
            : colors.edge[e.type] || colors.accent;
        // 형태: 언급·태그는 잔점선, 반박(contradicts)은 긴 점선(색 없이도 '긴장'을 구분), 그 외 실선.
        const dash = faint ? [4, 4] : e.type === 'contradicts' ? [9, 5] : [];
        const strong = hl && hl.set.has(e.a.id) && hl.set.has(e.b.id);
        const alpha = Math.min(fade(e.a.id), fade(e.b.id)) * (faint ? 0.55 : 0.95);
        ctx.save();
        ctx.globalAlpha = alpha;
        ctx.strokeStyle = stroke;
        ctx.lineWidth = (dash.length ? 1 : 1.6) + (strong ? 0.8 : 0);
        ctx.setLineDash(dash);
        ctx.beginPath();
        ctx.moveTo(e.a.x, e.a.y);
        ctx.lineTo(e.b.x, e.b.y);
        ctx.stroke();
        ctx.restore();
      }

      for (const n of nodes) {
        const r = radius(n);
        ctx.save();
        ctx.globalAlpha = fade(n.id);
        ctx.beginPath();
        ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
        if (n.kind === 'post') {
          ctx.fillStyle = colors.accent;
          ctx.fill();
          if ((hovered && hovered.id === n.id) || (!focusTouched && focusId === n.id)) {
            ctx.strokeStyle = colors.accent;
            ctx.lineWidth = 2;
            ctx.setLineDash([]);
            ctx.beginPath();
            ctx.arc(n.x, n.y, r + 4, 0, Math.PI * 2);
            ctx.stroke();
          }
        } else {
          ctx.fillStyle = colors.surface;
          ctx.fill();
          ctx.strokeStyle = colors.muted;
          ctx.lineWidth = 1.2;
          ctx.stroke();
        }
        // 라벨
        ctx.fillStyle = n.kind === 'post' ? colors.text : colors.muted;
        ctx.font = `${n.kind === 'post' ? 600 : 400} ${n.kind === 'post' ? 12.5 : 11.5}px ${colors.fontFamily}`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'top';
        const label =
          n.kind === 'post' && n.label.length > 16 ? `${n.label.slice(0, 15)}…` : n.label;
        ctx.fillText(label, n.x, n.y + r + 5);
        ctx.restore();
      }
    };

    let running = false;
    let calmFrames = 0;
    let frames = 0;
    const loop = () => {
      frames++;
      tick();
      draw();
      const energy = nodes.reduce((s, n) => s + Math.abs(n.vx) + Math.abs(n.vy), 0);
      calmFrames = energy < 0.5 ? calmFrames + 1 : 0;
      const calmLimit = isSmall() ? 18 : 30; // 작은 화면은 더 일찍 멈춰 rAF 루프를 끝낸다
      // 중력·척력 균형 탓에 에너지가 0까지 안 떨어질 수 있다 → 프레임 상한을 backstop으로 둬
      // 배치가 자리 잡으면 루프를 끝낸다(무한 rAF·모바일 발열/미세 떨림 방지). 드래그 중엔 유지.
      const maxFrames = isSmall() ? 180 : 300;
      if ((calmFrames > calmLimit || frames > maxFrames) && !dragging) {
        running = false;
        return;
      }
      requestAnimationFrame(loop);
    };
    const wake = () => {
      if (reduceMotion) {
        for (let i = 0; i < 60; i++) tick();
        draw();
        return;
      }
      calmFrames = 0;
      frames = 0;
      if (!running) {
        running = true;
        requestAnimationFrame(loop);
      }
    };

    const nodeAt = (x, y) => {
      for (let i = nodes.length - 1; i >= 0; i--) {
        const n = nodes[i];
        const r = radius(n) + 6;
        if ((n.x - x) ** 2 + (n.y - y) ** 2 <= r * r) return n;
      }
      return null;
    };

    const pos = (ev) => {
      const rect = canvas.getBoundingClientRect();
      return { x: ev.clientX - rect.left, y: ev.clientY - rect.top };
    };

    let moved = false;
    let dragStart = null; // { x, y, pointerId, slop }
    canvas.addEventListener('pointerdown', (ev) => {
      // 주 버튼·주 포인터만 드래그/탐색 대상 (휠클릭·우클릭·멀티터치 제외)
      if (ev.button !== 0 || ev.isPrimary === false) return;
      const { x, y } = pos(ev);
      const n = nodeAt(x, y);
      if (n) {
        dragging = n;
        moved = false;
        dragStart = {
          x,
          y,
          pointerId: ev.pointerId,
          slop: ev.pointerType === 'touch' ? 10 : 5, // 탭 떨림 허용 범위
        };
        focusTouched = true;
        try {
          canvas.setPointerCapture(ev.pointerId);
        } catch {
          /* 일부 환경의 합성 포인터는 캡처 불가 — 드래그 품질만 떨어질 뿐 동작엔 지장 없음 */
        }
        wake();
      }
    });
    canvas.addEventListener('pointermove', (ev) => {
      const { x, y } = pos(ev);
      if (dragging && dragStart && ev.pointerId === dragStart.pointerId) {
        // 슬롭 이내의 미세 이동은 탭으로 취급 — 노드도 밀리지 않게 보류
        if (!moved && Math.hypot(x - dragStart.x, y - dragStart.y) < dragStart.slop) return;
        moved = true;
        dragging.x = x;
        dragging.y = y;
        wake();
        return;
      }
      if (dragging) return;
      const n = nodeAt(x, y);
      if (n !== hovered) {
        hovered = n;
        focusTouched = focusTouched || n !== null;
        canvas.style.cursor = n ? 'pointer' : 'default';
        if (n) {
          tooltip.textContent =
            n.kind === 'post' ? `${n.label}${n.category ? ` · ${n.category}` : ''}` : n.label;
          tooltip.hidden = false;
          tooltip.style.left = `${Math.min(x + 14, W - 160)}px`;
          tooltip.style.top = `${y + 14}px`;
        } else {
          tooltip.hidden = true;
        }
        if (reduceMotion) draw();
        else wake();
      } else if (n && !tooltip.hidden) {
        tooltip.style.left = `${Math.min(x + 14, W - 160)}px`;
        tooltip.style.top = `${y + 14}px`;
      }
    });
    canvas.addEventListener('pointerup', (ev) => {
      if (dragStart && ev.pointerId !== dragStart.pointerId) return;
      if (dragging && !moved) {
        location.href = dragging.url;
      }
      dragging = null;
      dragStart = null;
      wake();
    });
    // 드래그가 시스템 제스처 등으로 끊겨도 상태가 고착되지 않게 (탐색은 하지 않음)
    const endDrag = () => {
      dragging = null;
      dragStart = null;
      wake();
    };
    canvas.addEventListener('pointercancel', endDrag);
    canvas.addEventListener('lostpointercapture', endDrag);
    // 세로 스크롤은 통과시키고, 노드를 잡았을 때만 제스처를 캔버스가 가져간다
    canvas.addEventListener(
      'touchstart',
      (ev) => {
        const t = ev.touches[0];
        if (!t) return;
        const rect = canvas.getBoundingClientRect();
        if (nodeAt(t.clientX - rect.left, t.clientY - rect.top)) ev.preventDefault();
      },
      { passive: false },
    );
    canvas.addEventListener('pointerleave', () => {
      hovered = null;
      tooltip.hidden = true;
      if (reduceMotion) draw();
    });

    const restart = () => {
      readColors();
      resize();
      nodes.forEach(seed);
      if (reduceMotion) {
        for (let i = 0; i < 400; i++) tick();
        draw();
      } else {
        wake();
      }
    };

    window.addEventListener('injoy:theme-change', () => {
      readColors();
      draw();
    });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      readColors();
      draw();
    });
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        // 모바일 주소창 접힘 등 높이만 변하는 resize에서는 배치를 보존한다
        const w = canvas.parentElement.getBoundingClientRect().width;
        if (Math.abs(w - W) < 1) return;
        restart();
      }, 150);
    });

    restart();

    // 개발·테스트용 좌표 핸들 (외부 의존 없음)
    window.__injoyGraph = { nodes };
  })();
</script>

<style>
  .graph-head {
    padding: 1rem 0 1.5rem;
  }

  .graph-head h1 {
    margin: 0;
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .graph-head .lead {
    margin: 0.4rem 0 0;
    color: var(--text-muted);
  }

  .stats {
    margin: 0.8rem 0 0;
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .stats strong {
    color: var(--accent);
    font-weight: 700;
  }

  .stats .divider {
    color: var(--border);
  }

  .graph-wrap {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background-color: var(--surface);
    overflow: hidden;
  }

  #graph-canvas {
    display: block;
    width: 100%;
    /* 세로 스크롤은 허용 — 노드 드래그 시작 시에만 JS가 제스처를 가져간다 */
    touch-action: pan-y;
  }

  #graph-tooltip {
    position: absolute;
    pointer-events: none;
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.3em 0.7em;
    font-size: 0.8rem;
    color: var(--text);
    box-shadow: 0 2px 10px rgb(0 0 0 / 8%);
    max-width: 220px;
  }

  .legend {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }

  .legend .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .legend .dot.post {
    background-color: var(--accent);
  }

  .legend .dot.tag {
    background-color: var(--surface);
    border: 1.2px solid var(--text-muted);
  }

  .legend .line {
    width: 18px;
    border-top: 1.6px solid var(--text-muted);
  }

  .legend .line.dashed {
    border-top-style: dashed;
  }

  .edge-list {
    margin-top: 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.9rem 1.2rem;
    font-size: 0.92rem;
  }

  .edge-list summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--text-muted);
  }

  .edge-list summary:hover {
    color: var(--accent);
  }

  .edge-list ul {
    margin: 0.8rem 0 0.2rem;
    padding-inline-start: 1.2em;
  }

  .edge-list li {
    margin-block: 0.45em;
    line-height: 1.7;
  }

  .edge-type {
    --chip: var(--accent);
    display: inline-block;
    margin-inline: 0.4em;
    padding: 0.05em 0.6em;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--chip) 12%, var(--bg));
    color: var(--chip);
    font-size: 0.8em;
    font-weight: 600;
  }

  /* 타입별 색 — global.css의 --edge-* 단일 출처를 칩·범례에 입힌다 */
  .edge-type.extends { --chip: var(--edge-extends); }
  .edge-type.supports { --chip: var(--edge-supports); }
  .edge-type.refines { --chip: var(--edge-refines); }
