</style>

<style is:global>
  /* 그래프 필터 바 — 칩은 JS(innerHTML)라 Astro 스코프가 안 붙으므로 전역으로 정의한다.
     그래프 위에 항상 노출(팝오버로 캔버스를 가리지 않음), 다중 선택. */
