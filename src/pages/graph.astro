---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGraph, EDGE_TYPES, AUTO_EDGE_TYPES } from '../utils/graph';
import { withBase } from '../utils/url';

const graph = await getGraph();

// 클라이언트로 보내는 직렬화 데이터 — url에 배포 base를 미리 적용한다
const data = {
  nodes: graph.nodes.map((n) => ({ ...n, url: withBase(n.url) })),
  edges: graph.edges,
};
---

<BaseLayout
  title="그래프"
  description="Injoy의 글과 태그가 어떻게 연결되어 있는지 한눈에 보는 지식 그래프."
>
  <section class="graph-head">
    <h1>그래프</h1>
    <p class="lead">글은 쌓이기만 하지 않고 서로 연결됩니다. 노드를 끌어 옮기고 눌러서 이동하세요. 오른쪽 아래 버튼으로 확대·축소할 수 있어요.</p>
    <p class="stats">
      <span><strong>{graph.stats.posts}</strong> 글</span>
      <span class="divider" aria-hidden="true">·</span>
      <span><strong>{graph.stats.edges}</strong> 연결</span>
      <span class="divider" aria-hidden="true">·</span>
      <span><strong>{graph.stats.tags}</strong> 태그</span>
    </p>
  </section>

  <div class="graph-wrap">
    <canvas
      id="graph-canvas"
      tabindex="0"
      aria-label="글 연결 그래프. 노드를 끌거나 눌러 글로 이동할 수 있어요. 키보드는 화살표로 노드를 옮기고 엔터로 그 글로 이동합니다"
    ></canvas>
    <div id="graph-tooltip" hidden></div>
    <div class="graph-zoom">
      <button type="button" class="gz-btn" data-zoom="in" aria-label="확대">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
      </button>
      <button type="button" class="gz-btn" data-zoom="out" aria-label="축소">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"></path></svg>
      </button>
      <button type="button" class="gz-btn gz-reset" data-zoom="reset" aria-label="처음 크기로">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path></svg>
      </button>
    </div>
  </div>

  <ul class="legend" aria-label="범례">
    <li><span class="dot post" aria-hidden="true"></span>글</li>
    <li><span class="dot tag" aria-hidden="true"></span>태그</li>
    <li><span class="line solid" aria-hidden="true"></span>연결(타입별 색)</li>
    <li><span class="line dashed" aria-hidden="true"></span>언급·태그</li>
  </ul>

  <details class="edge-list">
    <summary>연결 타입 안내</summary>
    <ul class="type-guide">
      {
        Object.entries(EDGE_TYPES).map(([key, t]) => (
          <li>
            <span class:list={['edge-type', key]}>{t.label}</span>
            <span class="note">{t.criteria}</span>
          </li>
        ))
      }
      <li>
        <span class="edge-type mentions">{AUTO_EDGE_TYPES.mentions.label}</span>
        <span class="note">{AUTO_EDGE_TYPES.mentions.criteria}</span>
      </li>
    </ul>
  </details>

  <noscript>
    <p class="noscript-note">
      자바스크립트가 꺼져 있으면 그래프가 보이지 않아요. 각 글 아래 '연결된 글'에서 같은 연결을 따라갈 수 있어요.
    </p>
  </noscript>
</BaseLayout>

<script is:inline define:vars={{ data }}>
  (() => {
    const canvas = document.getElementById('graph-canvas');
    const tooltip = document.getElementById('graph-tooltip');
    if (!canvas || !tooltip) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const focusId = new URLSearchParams(location.search).get('focus');

    // 노드·엣지 준비
    const nodes = data.nodes.map((n) => ({ ...n, x: 0, y: 0, vx: 0, vy: 0 }));
    const byId = new Map(nodes.map((n) => [n.id, n]));
    const edges = data.edges
      .map((e) => ({ ...e, a: byId.get(e.from), b: byId.get(e.to) }))
      .filter((e) => e.a && e.b);
    const neighbors = new Map(nodes.map((n) => [n.id, new Set()]));
    edges.forEach((e) => {
      neighbors.get(e.a.id).add(e.b.id);
      neighbors.get(e.b.id).add(e.a.id);
    });

    let W = 0;
    let H = 0;
    let dpr = 1;
    // ---- 팬·줌 뷰 변환: 화면(CSS px) = 레이아웃좌표 * view.scale + view.t ----
    const view = { scale: 1, tx: 0, ty: 0 };
    const baseView = { scale: 1, tx: 0, ty: 0 }; // 마지막으로 맞춘 기준(리셋·줌 한계의 기준)
    let pendingFit = true; // 다음 '정착' 때 딱 한 번 노드에 꼭 맞춘다(매 프레임이 아니라)
    // 레이아웃을 담는 고정 박스(원점 중심 반너비·반높이). 글이 많이 늘면 살짝 키워 덜 겹치게.
    const spread = Math.min(2.2, Math.max(1, Math.sqrt(nodes.length / 28)));
    let BX = 0, BY = 0;
    const LBL = 48; // 라벨이 노드 밖으로 삐져나가는 여유(박스 가장자리 패딩)
    const toWorldX = (sx) => (sx - view.tx) / view.scale;
    const toWorldY = (sy) => (sy - view.ty) / view.scale;
    const clampScale = (s) => Math.min(baseView.scale * 6, Math.max(baseView.scale * 0.5, s));
    const radius = (n) =>
      n.kind === 'post' ? Math.min(9 + n.degree * 1.5, 17) : 5 + Math.min(n.degree, 3);

    // CSS 토큰에서 색을 읽는다 — 테마가 바뀌면 다시 읽어 다시 그린다
    const EDGE_KINDS = [
      'extends', 'supports', 'refines', 'instantiates',
      'requires', 'triggered-by', 'contradicts', 'related',
    ];
    const colors = { edge: {} };
    // CSS 색(hex)을 [r,g,b]로. 토큰은 #rrggbb 형식이지만, 혹시 다른 형식이면 canvas로 정규화해 읽는다.
    const toRGB = (css) => {
      const hex = css.replace(/^#/, '');
      if (/^[0-9a-f]{6}$/i.test(hex)) {
        const n = parseInt(hex, 16);
        return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
      }
      if (/^[0-9a-f]{3}$/i.test(hex)) {
        return [parseInt(hex[0] + hex[0], 16), parseInt(hex[1] + hex[1], 16), parseInt(hex[2] + hex[2], 16)];
      }
      ctx.fillStyle = '#000';
      ctx.fillStyle = css;
      const m = ctx.fillStyle.match(/[\d.]+/g);
      return m ? [+m[0], +m[1], +m[2]] : [47, 111, 237];
    };
    const readColors = () => {
      const s = getComputedStyle(document.documentElement);
      colors.accent = s.getPropertyValue('--accent').trim();
      colors.accentWeak = s.getPropertyValue('--accent-weak').trim();
      colors.text = s.getPropertyValue('--text').trim();
      colors.muted = s.getPropertyValue('--text-muted').trim();
      colors.border = s.getPropertyValue('--border').trim();
      colors.surface = s.getPropertyValue('--surface').trim();
      // 글 노드 나이 그라데이션 끝점 — 가장 옛 글은 surface 쪽으로 희석(옅게), 최신은 full accent.
      colors.accentRGB = toRGB(colors.accent);
      colors.surfaceRGB = toRGB(colors.surface);
      // 엣지 타입별 색 — global.css의 --edge-* 단일 출처를 캔버스가 공유한다
      for (const k of EDGE_KINDS) colors.edge[k] = s.getPropertyValue(`--edge-${k}`).trim();
      // 라벨 폰트도 여기서 한 번만 읽어 캐시한다 — draw()에서 매 프레임 읽지 않게
      colors.fontFamily = getComputedStyle(document.body).fontFamily;
    };

    // 글 노드 채움색 — 나이(0~1)를 surface↔accent 보간으로. 바닥선 0.5라 가장 옛 글도
    // 50% accent를 유지해 빈 원(태그 노드)과 헷갈리지 않는다. 최신(age=1)=full accent.
    const lerp = (a, b, t) => Math.round(a + (b - a) * t);
    const nodeFill = (age) => {
      const t = 0.5 + 0.5 * (typeof age === 'number' ? age : 1);
      const [sr, sg, sb] = colors.surfaceRGB;
      const [ar, ag, ab] = colors.accentRGB;
      return `rgb(${lerp(sr, ar, t)}, ${lerp(sg, ag, t)}, ${lerp(sb, ab, t)})`;
    };

    // 모바일 등 작은 화면 판정 — 시뮬레이션 부하·정착을 가볍게 조정하는 데 쓴다.
    const isSmall = () => Math.min(window.innerWidth, window.innerHeight) < 700;

    const resize = () => {
      const rect = canvas.parentElement.getBoundingClientRect();
      W = rect.width;
      H = Math.max(360, Math.min(560, Math.round(rect.width * 0.62)));
      BX = (W / 2) * spread; // 레이아웃 박스 반너비·반높이(원점 중심)
      BY = (H / 2) * spread;
      // 고DPR(모바일 2~3배) 백킹스토어가 매 프레임 칠하는 픽셀을 폭주시키지 않게 2배로 캡
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      canvas.style.height = `${H}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const seed = (n, i) => {
      // 결정적 초기 배치(원형, 원점 중심·박스 안) — 새로고침마다 모양이 안 널뛰게.
      const angle = (i / nodes.length) * Math.PI * 2;
      const r = Math.min(BX, BY) * 0.62;
      n.x = Math.cos(angle) * r * (n.kind === 'tag' ? 1.1 : 0.8);
      n.y = Math.sin(angle) * r * (n.kind === 'tag' ? 1.1 : 0.8);
    };

    // 힘 시뮬레이션 한 스텝. 노드 간 척력은 O(n²)라 글이 수십 개로 늘면
    // 공간 분할(Barnes-Hut류)로 근사해 줄일 수 있다. 지금 규모에선 단순 계산으로 충분.
    const tick = () => {
      const REPULSION = 2600;
      const SPRING = 0.012;
      const REST = 110;
      const GRAVITY = 0.012;
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          let dx = a.x - b.x;
          let dy = a.y - b.y;
          let d2 = dx * dx + dy * dy;
          if (d2 < 1) d2 = 1;
          const f = REPULSION / d2;
          const d = Math.sqrt(d2);
          dx /= d;
          dy /= d;
          a.vx += dx * f;
          a.vy += dy * f;
          b.vx -= dx * f;
          b.vy -= dy * f;
        }
      }
      for (const e of edges) {
        const dx = e.b.x - e.a.x;
        const dy = e.b.y - e.a.y;
        const d = Math.sqrt(dx * dx + dy * dy) || 1;
        const rest = e.to.startsWith('tag:') ? REST * 0.6 : REST;
        const f = (d - rest) * SPRING;
        e.a.vx += (dx / d) * f;
        e.a.vy += (dy / d) * f;
        e.b.vx -= (dx / d) * f;
        e.b.vy -= (dy / d) * f;
      }
      const damp = isSmall() ? 0.78 : 0.82; // 작은 화면은 감쇠를 키워 더 빨리 정착(데스크톱 0.82 유지)
      for (const n of nodes) {
        // 중력은 좌표 원점(레이아웃 중심)으로 — 화면 중심이 아니다
        n.vx += (0 - n.x) * GRAVITY;
        n.vy += (0 - n.y) * GRAVITY;
        if (n === dragging) {
          n.vx = 0;
          n.vy = 0;
          continue;
        }
        n.vx *= damp;
        n.vy *= damp;
        n.x += n.vx;
        n.y += n.vy;
        // 노드를 고정 박스(원점 중심) 안에 가둔다 — 화면엔 박스를 한 번 맞춰 두니
        // 박스 안 노드는 시뮬레이션이 움직여도 항상 화면 안(가장자리 잘림 0).
        n.x = Math.max(-BX, Math.min(BX, n.x));
        n.y = Math.max(-BY, Math.min(BY, n.y));
      }
    };

    let hovered = null;
    let dragging = null;
    let selected = null; // 키보드로 고른 노드

    const highlightSet = () => {
      const pivot = hovered ?? selected ?? (focusTouched ? null : byId.get(focusId));
      if (!pivot) return null;
      const set = new Set([pivot.id, ...(neighbors.get(pivot.id) ?? [])]);
      return { pivot, set };
    };

    let focusTouched = false;

    const draw = () => {
      // 매 프레임 변환을 새로 깐다: device 픽셀 전체를 지우고, dpr·팬·줌을 합친 변환으로 그린다.
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.setTransform(dpr * view.scale, 0, 0, dpr * view.scale, dpr * view.tx, dpr * view.ty);
      const hl = highlightSet();
      const fade = (id) => (hl && !hl.set.has(id) ? 0.14 : 1);

      for (const e of edges) {
        const isTag = e.to.startsWith('tag:');
        const isMention = e.type === 'mentions';
        const faint = isTag || isMention;
        // 색: 타입별 단일 토큰. 태그·언급은 약한 회색(흰 배경에서도 보이게 muted), 명시 타입은 제 색.
        const stroke = faint ? colors.muted : colors.edge[e.type] || colors.accent;
        // 형태: 언급·태그는 잔점선, 반박(contradicts)은 긴 점선(색 없이도 '긴장'을 구분), 그 외 실선.
        const dash = faint ? [4, 4] : e.type === 'contradicts' ? [9, 5] : [];
        const strong = hl && hl.set.has(e.a.id) && hl.set.has(e.b.id);
        const alpha = Math.min(fade(e.a.id), fade(e.b.id)) * (faint ? 0.45 : 0.95);
        ctx.save();
        ctx.globalAlpha = alpha;
        ctx.strokeStyle = stroke;
        ctx.lineWidth = (dash.length ? 1 : 1.6) + (strong ? 0.8 : 0);
        ctx.setLineDash(dash);
        ctx.beginPath();
        ctx.moveTo(e.a.x, e.a.y);
        ctx.lineTo(e.b.x, e.b.y);
        ctx.stroke();
        ctx.restore();
      }

      for (const n of nodes) {
        const r = radius(n);
        ctx.save();
        ctx.globalAlpha = fade(n.id);
        ctx.beginPath();
        ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
        if (n.kind === 'post') {
          ctx.fillStyle = nodeFill(n.age); // 나이별 진하기(옛→옅게, 최신→진하게)
          ctx.fill();
        } else {
          ctx.fillStyle = colors.surface;
          ctx.fill();
          ctx.strokeStyle = colors.muted;
          ctx.lineWidth = 1.2;
          ctx.stroke();
        }
        // 강조 링 — 호버·키보드 선택·URL 포커스된 노드(글·태그 공통)
        if (
          (hovered && hovered.id === n.id) ||
          (selected && selected.id === n.id) ||
          (!focusTouched && focusId === n.id)
        ) {
          ctx.strokeStyle = colors.accent;
          ctx.lineWidth = 2;
          ctx.setLineDash([]);
          ctx.beginPath();
          ctx.arc(n.x, n.y, r + 4, 0, Math.PI * 2);
          ctx.stroke();
        }
        // 라벨
        ctx.fillStyle = n.kind === 'post' ? colors.text : colors.muted;
        ctx.font = `${n.kind === 'post' ? 600 : 400} ${n.kind === 'post' ? 12.5 : 11.5}px ${colors.fontFamily}`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'top';
        const label =
          n.kind === 'post' && n.label.length > 16 ? `${n.label.slice(0, 15)}…` : n.label;
        ctx.fillText(label, n.x, n.y + r + 5);
        ctx.restore();
      }
    };

    // 고정 박스(+라벨 여유)를 캔버스에 한 번 맞춘다(원점→캔버스 중앙). 박스가 불변이라
    // 이 뷰도 불변 → 시뮬레이션이 도는 동안 화면이 흔들리지 않는다(애니메이션용 기본 뷰).
    const homeView = () => {
      if (W <= 0 || H <= 0) return;
      const pad = 8;
      const s = Math.max(
        Math.min((W / 2 - pad) / (BX + LBL), (H / 2 - pad) / (BY + LBL)),
        0.05,
      );
      baseView.scale = s;
      baseView.tx = W / 2;
      baseView.ty = H / 2;
      view.scale = s;
      view.tx = W / 2;
      view.ty = H / 2;
    };

    // 실제 노드들의 경계상자에 꼭 맞춘다 — '정착했을 때 한 번만' 호출(매 프레임 아님).
    const fitToBbox = () => {
      if (!nodes.length || W <= 0 || H <= 0) return;
      let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
      for (const n of nodes) {
        const r = radius(n);
        const fs = n.kind === 'post' ? 12.5 : 11.5;
        const halfLabel = (Math.min(n.label.length, 16) * fs * 0.55) / 2; // 라벨 반너비 추정
        const ext = Math.max(r, halfLabel);
        if (n.x - ext < minX) minX = n.x - ext;
        if (n.x + ext > maxX) maxX = n.x + ext;
        if (n.y - r < minY) minY = n.y - r;
        if (n.y + r + fs + 6 > maxY) maxY = n.y + r + fs + 6; // 라벨은 노드 아래
      }
      const bw = Math.max(maxX - minX, 1);
      const bh = Math.max(maxY - minY, 1);
      const pad = 12;
      // 음수·0 스케일(거울상·0으로 나눔) 방지용 작은 양수 하한
      const s = Math.max(Math.min((W - pad * 2) / bw, (H - pad * 2) / bh), 0.05);
      baseView.scale = s;
      baseView.tx = (W - bw * s) / 2 - minX * s;
      baseView.ty = (H - bh * s) / 2 - minY * s;
      view.scale = baseView.scale;
      view.tx = baseView.tx;
      view.ty = baseView.ty;
    };

    // 한 점(화면 px)을 기준으로 줌 — 그 점 아래 좌표가 제자리에 남도록 tx,ty를 다시 잡는다.
    const zoomAtPoint = (cx, cy, targetScale) => {
      const ns = clampScale(targetScale);
      const wx = (cx - view.tx) / view.scale;
      const wy = (cy - view.ty) / view.scale;
      view.scale = ns;
      view.tx = cx - wx * ns;
      view.ty = cy - wy * ns;
      pendingFit = false; // 사용자가 줌했으니 정착 시 자동 맞춤이 덮어쓰지 않게
      draw();
    };

    // 선택한 노드가 화면 밖이면 화면 안으로 살짝 끌어온다(스케일 유지) — 키보드 탐색용.
    const ensureVisible = (n) => {
      const margin = 44;
      const sx = n.x * view.scale + view.tx;
      const sy = n.y * view.scale + view.ty;
      let dx = 0, dy = 0;
      if (sx < margin) dx = margin - sx;
      else if (sx > W - margin) dx = W - margin - sx;
      if (sy < margin) dy = margin - sy;
      else if (sy > H - margin) dy = H - margin - sy;
      if (dx || dy) {
        view.tx += dx;
        view.ty += dy;
        pendingFit = false; // 직접 옮겼으니 정착 시 자동 맞춤이 덮어쓰지 않게
      }
    };

    let running = false;
    let calmFrames = 0;
    let frames = 0;
    const loop = () => {
      frames++;
      tick();
      draw();
      const energy = nodes.reduce((s, n) => s + Math.abs(n.vx) + Math.abs(n.vy), 0);
      // 정착 임계값은 노드 수에 비례 — 노드당 속도가 충분히 작아지면 정착으로 본다.
      // (절대값 0.5 고정이면 글이 늘수록 합 에너지가 커져 정착 판정이 안 돼 매번 maxFrames까지 떨었다.
      //  분리된 서브그래프가 생겨 노드가 늘면 특히 그랬다.)
      const calmEnergy = Math.max(0.5, nodes.length * 0.05);
      calmFrames = energy < calmEnergy ? calmFrames + 1 : 0;
      const calmLimit = isSmall() ? 18 : 30; // 작은 화면은 더 일찍 멈춰 rAF 루프를 끝낸다
      // 중력·척력 균형 탓에 에너지가 0까지 안 떨어질 수 있다 → 프레임 상한을 backstop으로 둬
      // 배치가 자리 잡으면 루프를 끝낸다(무한 rAF·모바일 발열/미세 떨림 방지). 드래그 중엔 유지.
      const maxFrames = isSmall() ? 180 : 300;
      if ((calmFrames > calmLimit || frames > maxFrames) && !dragging) {
        running = false;
        if (pendingFit) { // 정착했을 때 딱 한 번 노드에 꼭 맞춘다(이후 hover로 wake돼도 다시 안 함)
          fitToBbox();
          pendingFit = false;
        }
        return;
      }
      requestAnimationFrame(loop);
    };
    const wake = () => {
      if (reduceMotion) {
        for (let i = 0; i < 60; i++) tick();
        draw();
        return;
      }
      calmFrames = 0;
      frames = 0;
      if (!running) {
        running = true;
        requestAnimationFrame(loop);
      }
    };

    const nodeAt = (sx, sy) => {
      const x = toWorldX(sx);
      const y = toWorldY(sy);
      for (let i = nodes.length - 1; i >= 0; i--) {
        const n = nodes[i];
        const r = radius(n) + 6 / view.scale; // 6px 슬롭을 레이아웃 단위로 환산
        if ((n.x - x) ** 2 + (n.y - y) ** 2 <= r * r) return n;
      }
      return null;
    };

    const pos = (ev) => {
      const rect = canvas.getBoundingClientRect();
      return { x: ev.clientX - rect.left, y: ev.clientY - rect.top };
    };

    let moved = false;
    let dragStart = null; // 노드 드래그: { x, y, pointerId, slop }
    let panStart = null; // 빈 곳 팬: { x, y, tx, ty, pointerId }
    let pinchStart = null; // 두 손가락 확대: { dist, cx, cy, scale, tx, ty }
    const pointers = new Map(); // 활성 포인터 id → 화면좌표(두 손가락 판정용)

    canvas.addEventListener('pointerdown', (ev) => {
      if (ev.pointerType === 'mouse' && ev.button !== 0) return; // 마우스는 주 버튼만
      const { x, y } = pos(ev);
      pointers.set(ev.pointerId, { x, y });

      // 두 포인터 → 두 손가락 확대(+이동). 진행 중이던 노드드래그·팬은 취소.
      if (pointers.size === 2) {
        dragging = null;
        dragStart = null;
        panStart = null;
        const p = [...pointers.values()];
        pinchStart = {
          dist: Math.hypot(p[0].x - p[1].x, p[0].y - p[1].y) || 1,
          cx: (p[0].x + p[1].x) / 2,
          cy: (p[0].y + p[1].y) / 2,
          scale: view.scale,
          tx: view.tx,
          ty: view.ty,
        };
        try { canvas.setPointerCapture(ev.pointerId); } catch {}
        return;
      }
      if (pointers.size !== 1) return;

      const n = nodeAt(x, y);
      if (n) {
        dragging = n;
        moved = false;
        dragStart = { x, y, pointerId: ev.pointerId, slop: ev.pointerType === 'touch' ? 10 : 5 };
        focusTouched = true;
        try { canvas.setPointerCapture(ev.pointerId); } catch {}
        wake();
      } else if (ev.pointerType !== 'touch') {
        // 빈 곳 드래그 = 팬. 단 터치 한 손가락은 페이지 세로 스크롤을 위해 팬하지 않는다.
        panStart = { x, y, tx: view.tx, ty: view.ty, pointerId: ev.pointerId };
        try { canvas.setPointerCapture(ev.pointerId); } catch {}
      }
    });

    canvas.addEventListener('pointermove', (ev) => {
      const { x, y } = pos(ev);
      if (pointers.has(ev.pointerId)) pointers.set(ev.pointerId, { x, y });

      // 두 손가락 확대 + 이동
      if (pinchStart && pointers.size === 2) {
        const p = [...pointers.values()];
        const dist = Math.hypot(p[0].x - p[1].x, p[0].y - p[1].y) || 1;
        const mx = (p[0].x + p[1].x) / 2;
        const my = (p[0].y + p[1].y) / 2;
        const ns = clampScale((pinchStart.scale * dist) / pinchStart.dist);
        // 시작 중점 아래 좌표를 현재 중점으로 옮긴다(벌림=줌, 함께 이동=팬)
        const wx = (pinchStart.cx - pinchStart.tx) / pinchStart.scale;
        const wy = (pinchStart.cy - pinchStart.ty) / pinchStart.scale;
        view.scale = ns;
        view.tx = mx - wx * ns;
        view.ty = my - wy * ns;
        pendingFit = false;
        draw();
        return;
      }

      // 노드 드래그
      if (dragging && dragStart && ev.pointerId === dragStart.pointerId) {
        // 슬롭 이내의 미세 이동은 탭으로 취급 — 노드도 밀리지 않게 보류
        if (!moved && Math.hypot(x - dragStart.x, y - dragStart.y) < dragStart.slop) return;
        moved = true;
        pendingFit = false; // 손으로 옮기기 시작하면 자동 맞춤을 멈춘다
        dragging.x = toWorldX(x);
        dragging.y = toWorldY(y);
        wake();
        return;
      }

      // 빈 곳 팬
      if (panStart && ev.pointerId === panStart.pointerId) {
        view.tx = panStart.tx + (x - panStart.x);
        view.ty = panStart.ty + (y - panStart.y);
        pendingFit = false;
        draw();
        return;
      }

      if (dragging || panStart || pinchStart) return;

      const n = nodeAt(x, y);
      if (n !== hovered) {
        hovered = n;
        focusTouched = focusTouched || n !== null;
        canvas.style.cursor = n ? 'pointer' : 'default';
        if (n) {
          tooltip.textContent =
            n.kind === 'post' ? `${n.label}${n.category ? ` · ${n.category}` : ''}` : n.label;
          tooltip.hidden = false;
          tooltip.style.left = `${Math.min(x + 14, W - 160)}px`;
          tooltip.style.top = `${y + 14}px`;
        } else {
          tooltip.hidden = true;
        }
        // 배치는 이미 정착했으니 hover는 강조만 다시 그린다 — 물리(wake) 금지.
        // (hover마다 wake하면 마우스를 올릴 때마다 시뮬이 재시동돼 노드가 계속 출렁였다. 키보드 탐색과 동일하게 draw만.)
        draw();
      } else if (n && !tooltip.hidden) {
        tooltip.style.left = `${Math.min(x + 14, W - 160)}px`;
        tooltip.style.top = `${y + 14}px`;
      }
    });

    const dropPointer = (ev) => {
      pointers.delete(ev.pointerId);
      if (pointers.size < 2) pinchStart = null;
    };
    canvas.addEventListener('pointerup', (ev) => {
      const wasDrag = dragStart && ev.pointerId === dragStart.pointerId;
      const wasPan = panStart && ev.pointerId === panStart.pointerId;
      dropPointer(ev);
      if (wasDrag) {
        if (dragging && !moved) location.href = dragging.url; // 안 움직였으면 탭 = 글로 이동
        dragging = null;
        dragStart = null;
        wake();
      } else if (wasPan) {
        panStart = null;
      }
    });
    // 드래그·이동·두 손가락 동작이 시스템 제스처로 끊겨도 상태가 고착되지 않게
    const endGesture = (ev) => {
      if (ev) dropPointer(ev);
      dragging = null;
      dragStart = null;
      panStart = null;
      wake();
    };
    canvas.addEventListener('pointercancel', endGesture);
    canvas.addEventListener('lostpointercapture', endGesture);

    // 줌은 Ctrl+휠(또는 트랙패드 오므렸다 펴기=ctrlKey)로만 — 일반 휠은 페이지 스크롤로 흘려보낸다.
    // (캔버스가 화면을 크게 차지해서, 무조건 줌으로 먹으면 그래프 위에서 스크롤이 갇힌다.)
    canvas.addEventListener(
      'wheel',
      (ev) => {
        if (!ev.ctrlKey && !ev.metaKey) return;
        ev.preventDefault();
        const { x, y } = pos(ev);
        zoomAtPoint(x, y, view.scale * Math.exp(-ev.deltaY * 0.0015));
      },
      { passive: false },
    );

    // 빈 곳 더블클릭 = 처음 크기로 되돌리기(자동 맞춤 재개)
    canvas.addEventListener('dblclick', (ev) => {
      const { x, y } = pos(ev);
      if (nodeAt(x, y)) return;
      ev.preventDefault();
      fitToBbox(); // 현재 노드들에 꼭 맞춰 되돌린다
      pendingFit = false;
      draw();
    });

    // 터치: 한 손가락이 노드 위면(=드래그) 또는 두 손가락이면 제스처를 가져온다.
    // 빈 곳 한 손가락은 페이지 세로 스크롤을 위해 그대로 흘려보낸다(touch-action: pan-y).
    canvas.addEventListener(
      'touchstart',
      (ev) => {
        if (ev.touches.length >= 2) {
          ev.preventDefault();
          return;
        }
        const t = ev.touches[0];
        if (!t) return;
        const rect = canvas.getBoundingClientRect();
        if (nodeAt(t.clientX - rect.left, t.clientY - rect.top)) ev.preventDefault();
      },
      { passive: false },
    );
    canvas.addEventListener('pointerleave', () => {
      if (dragging || panStart || pinchStart) return;
      hovered = null;
      tooltip.hidden = true;
      draw(); // 강조 해제만 다시 그린다(물리 재시동 없이)
    });

    // 키보드 탐색 — 화살표로 노드 순회, Enter로 그 글로 이동, Esc로 선택 해제.
    // 배치는 이미 정착해 있으니 물리(wake)는 다시 돌리지 않고 draw()만 다시 그린다.
    const showTipAt = (n) => {
      tooltip.textContent =
        n.kind === 'post' ? `${n.label}${n.category ? ` · ${n.category}` : ''}` : n.label;
      tooltip.hidden = false;
      const sx = n.x * view.scale + view.tx;
      const sy = n.y * view.scale + view.ty;
      tooltip.style.left = `${Math.min(sx + 14, W - 160)}px`;
      tooltip.style.top = `${sy + 14}px`;
    };
    canvas.addEventListener('keydown', (ev) => {
      const k = ev.key;
      if (k === 'ArrowRight' || k === 'ArrowDown' || k === 'ArrowLeft' || k === 'ArrowUp') {
        ev.preventDefault();
        if (!nodes.length) return;
        const dir = k === 'ArrowRight' || k === 'ArrowDown' ? 1 : -1;
        const i = selected ? nodes.indexOf(selected) : -1;
        selected = nodes[(i + dir + nodes.length) % nodes.length];
        focusTouched = true;
        ensureVisible(selected);
        showTipAt(selected);
        draw();
      } else if (k === 'Enter') {
        if (selected) {
          ev.preventDefault();
          location.href = selected.url;
        }
      } else if (k === 'Escape') {
        if (!selected) return;
        selected = null;
        tooltip.hidden = true;
        draw();
      }
    });
    canvas.addEventListener('blur', () => {
      // 포커스를 잃으면 키보드 선택 강조·툴팁을 정리(마우스 호버와 섞이지 않게)
      if (!selected) return;
      selected = null;
      tooltip.hidden = true;
      draw();
    });

    const restart = () => {
      readColors();
      resize();
      nodes.forEach(seed);
      homeView(); // 애니메이션 동안 쓸 기본 뷰(고정 박스 맞춤). 정착하면 노드에 꼭 맞춘다.
      pendingFit = true;
      if (reduceMotion) {
        for (let i = 0; i < 400; i++) tick();
        fitToBbox();
        pendingFit = false;
        draw();
      } else {
        wake();
      }
    };

    window.addEventListener('injoy:theme-change', () => {
      readColors();
      draw();
    });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      readColors();
      draw();
    });
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        // 모바일 주소창 접힘 등 높이만 변하는 resize에서는 배치를 보존한다
        const w = canvas.parentElement.getBoundingClientRect().width;
        if (Math.abs(w - W) < 1) return;
        restart();
      }, 150);
    });

    // 화면 +/− 확대 버튼 — 모바일·데스크톱 공통(제스처를 몰라도 됨). 캔버스 가운데 기준으로 줌.
    canvas.parentElement.querySelectorAll('.gz-btn').forEach((b) => {
      b.addEventListener('click', () => {
        const k = b.dataset.zoom;
        if (k === 'reset') {
          fitToBbox();
          pendingFit = false;
          draw();
          return;
        }
        zoomAtPoint(W / 2, H / 2, view.scale * (k === 'in' ? 1.3 : 1 / 1.3));
      });
    });

    restart();

    // 개발·테스트용 좌표 핸들 (외부 의존 없음)
    window.__injoyGraph = { nodes, view, baseView, homeView, fit: () => { fitToBbox(); draw(); } };
  })();
</script>

<style>
  .graph-head {
    padding: 1rem 0 1.5rem;
  }

  .graph-head h1 {
    margin: 0;
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .graph-head .lead {
    margin: 0.4rem 0 0;
    color: var(--text-muted);
  }

  .stats {
    margin: 0.8rem 0 0;
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .stats strong {
    color: var(--accent);
    font-weight: 700;
  }

  .stats .divider {
    color: var(--border);
  }

  .graph-wrap {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background-color: var(--surface);
    overflow: hidden;
  }

  #graph-canvas {
    display: block;
    width: 100%;
    /* 세로 스크롤은 허용 — 노드 드래그 시작 시에만 JS가 제스처를 가져간다 */
    touch-action: pan-y;
  }

  /* 키보드 포커스 — 캔버스에 또렷한 아웃라인(화살표·엔터로 노드 탐색) */
  #graph-canvas:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  #graph-tooltip {
    position: absolute;
    pointer-events: none;
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.3em 0.7em;
    font-size: 0.8rem;
    color: var(--text);
    box-shadow: 0 2px 10px rgb(0 0 0 / 8%);
    max-width: 220px;
  }

  /* 확대·축소 버튼 — 모바일·데스크톱 공통. 캔버스 우하단에 겹쳐 둔다(정적 DOM이라 스코프 CSS 적용) */
  .graph-zoom {
    position: absolute;
    right: 10px;
    bottom: 10px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .graph-zoom .gz-btn {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text);
    cursor: pointer;
    box-shadow: 0 1px 5px rgb(0 0 0 / 10%);
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .graph-zoom .gz-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .graph-zoom .gz-btn svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .graph-zoom .gz-reset svg {
    width: 16px;
    height: 16px;
  }

  .legend {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }

  .legend .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .legend .dot.post {
    background-color: var(--accent);
  }

  .legend .dot.tag {
    background-color: var(--surface);
    border: 1.2px solid var(--text-muted);
  }

  .legend .line {
    width: 18px;
    border-top: 1.6px solid var(--text-muted);
  }

  .legend .line.dashed {
    border-top-style: dashed;
  }

  .edge-list {
    margin-top: 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.9rem 1.2rem;
    font-size: 0.92rem;
  }

  .edge-list summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--text-muted);
    list-style: none;
  }

  .edge-list summary::-webkit-details-marker {
    display: none;
  }

  /* 셰브론과 문구 사이 반 em 간격 — 사이트 전반(.makeup) 마커와 통일 */
  .edge-list summary::before {
    content: '▸';
    margin-inline-end: 0.5em;
    font-size: 0.8em;
  }

  .edge-list[open] summary::before {
    content: '▾';
  }

  .edge-list summary:hover {
    color: var(--accent);
  }

  .edge-list ul {
    margin: 0.8rem 0 0.2rem;
