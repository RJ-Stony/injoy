    color: var(--chip);
    font-size: 0.8em;
    font-weight: 600;
  }

  /* 타입별 색 — global.css의 --edge-* 단일 출처를 칩·범례에 입힌다 */
  .edge-type.extends { --chip: var(--edge-extends); }
  .edge-type.supports { --chip: var(--edge-supports); }
  .edge-type.refines { --chip: var(--edge-refines); }
  .edge-type.instantiates { --chip: var(--edge-instantiates); }
  .edge-type.requires { --chip: var(--edge-requires); }
  .edge-type.triggered-by { --chip: var(--edge-triggered-by); }
  .edge-type.contradicts { --chip: var(--edge-contradicts); }
  .edge-type.related { --chip: var(--edge-related); }
  .edge-type.mentions { --chip: var(--text-muted); }

  .edge-list .note {
    color: var(--text-muted);
    font-size: 0.88em;
  }

  .type-guide {
    list-style: none;
    padding-inline-start: 0 !important;
  }

  .type-guide li {
    display: flex;
    align-items: baseline;
    gap: 0.6em;
