---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/url';
import { EDGE_TYPES, AUTO_EDGE_TYPES } from '../utils/graph';
import { alertOptions } from '../utils/callout-config.mjs';

/**
 * 인-블로그 글쓰기 에디터.
 * 이 페이지 자체는 정적 HTML이라 누구나 열 수 있지만, 모든 동작은
 * 브라우저 localStorage에 저장된 GitHub 토큰(나만 보유)으로만 가능하다.
 * 발행 = GitHub API로 main에 커밋 → Actions가 자동 배포.
 *
 * 스타일은 의도적으로 is:global + .write-root 프리픽스를 쓴다 —
 * 점검 결과·연결 제안·달력처럼 JS로 만들어지는 요소에는 Astro 스코프
 * 클래스가 붙지 않아 스코프 스타일이 적용되지 않기 때문.
 */
const config = {
  owner: 'RJ-Stony',
  repo: 'injoy',
  branch: 'main',
  base: withBase('/'),
  siteIndexUrl: withBase('/site-index.json'),
  postsDir: 'src/content/posts',
  edgesPath: 'src/data/edges.json',
};

const edgeTypeOptions = Object.entries(EDGE_TYPES).map(([value, v]) => ({
  value,
  label: v.label,
  criteria: v.criteria,
}));

// 툴바 콜아웃 삽입용 — 빌드 콜아웃 설정과 단일 출처 공유
const calloutOptions = alertOptions.alerts.map((a) => ({ keyword: a.keyword, title: a.title }));
---

<BaseLayout title="글쓰기" description="Injoy 운영자 전용 글쓰기 공간." wide>
  <meta slot="head" name="robots" content="noindex" />

  <div class="write-root">
    <!-- 인증 전 -->
    <section id="auth-card" class="card auth-card" hidden>
      <h1>글쓰기 공간</h1>
      <p>
        여기는 운영자 전용 에디터예요. 글을 쓰고 <strong>발행</strong>을 누르면 GitHub에
        커밋되고, 1~2분 안에 블로그에 올라가요. 동작하려면 이 기기에 GitHub 토큰을 한 번
        저장해야 해요. 토큰은 <strong>이 브라우저에만</strong> 남고, GitHub API 호출 말고는
        어디에도 전송되지 않아요.
      </p>
      <ol class="setup-steps">
        <li>
          <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">
            GitHub fine-grained 토큰 만들기 ↗</a>
          에서 Repository access를 <code>RJ-Stony/injoy</code>로 제한하고, Permissions에서
          <code>Contents: Read and write</code>만 켜세요.
        </li>
        <li>발급된 토큰을 아래에 붙여넣고 저장하세요.</li>
      </ol>
      <div class="token-row">
        <input id="token-input" type="password" placeholder="github_pat_..." autocomplete="off" />
        <button id="token-save" type="button" class="primary">이 기기에 저장</button>
      </div>
      <p id="auth-error" class="error" hidden></p>
    </section>

    <!-- 에디터 -->
    <section id="editor" hidden>
      <header class="editor-top">
        <div class="editor-heading">
          <h1 id="editor-title">새 글</h1>
          <p class="editor-sub">마크다운으로 쓰고 발행을 누르면 1~2분 안에 블로그에 반영돼요.</p>
        </div>
        <div class="top-actions">
          <span class="select-wrap">
            <select id="post-picker" aria-label="기존 글 불러오기">
              <option value="">기존 글 수정…</option>
            </select>
          </span>
          <button id="new-post" type="button">새 글</button>
          <button id="delete-post" type="button" class="danger" hidden>삭제</button>
        </div>
      </header>

      <section class="card section">
        <h2 class="section-title">글 정보</h2>
        <div class="fm-grid">
          <label class="field">
            <span class="field-name">제목</span>
            <input id="fm-title" type="text" placeholder="글 제목" />
          </label>
          <label class="field">
            <span class="field-name">슬러그(주소)</span>
            <input id="fm-slug" type="text" placeholder="my-post (영문 소문자·하이픈)" />
          </label>
          <label class="field span2">
            <span class="field-name">한 줄 요약</span>
            <input id="fm-description" type="text" placeholder="목록·검색·공유 미리보기에 쓰여요" />
          </label>
          <label class="field">
            <span class="field-name">카테고리</span>
            <input id="fm-category" type="text" value="개발" />
          </label>
          <label class="field">
            <span class="field-name">태그(쉼표로 구분)</span>
            <input id="fm-tags" type="text" placeholder="astro, blog" />
          </label>
          <label class="field">
            <span class="field-name">시리즈(선택)</span>
            <input id="fm-series" type="text" list="series-options" placeholder="여러 글을 묶는 이름" />
            <datalist id="series-options"></datalist>
          </label>
          <div class="field date-field">
            <span class="field-name">발행일</span>
            <input type="hidden" id="fm-date" />
            <button
              type="button"
              id="date-trigger"
              class="date-trigger"
              aria-haspopup="dialog"
              aria-expanded="false"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
              <span class="date-label">날짜 선택</span>
            </button>
            <div id="date-popover" class="date-popover" role="dialog" aria-label="발행일 선택" hidden></div>
          </div>
          <label class="field switch-field">
            <span class="field-name">초안으로 저장</span>
            <span class="switch-row">
              <input id="fm-draft" type="checkbox" role="switch" checked />
              <span class="switch-hint">켜 두면 사이트에 보이지 않아요</span>
            </span>
          </label>
          <div class="field span2">
            <span class="field-name">대표 이미지(썸네일)</span>
            <div class="cover-row">
              <button type="button" id="cover-pick">이미지 선택</button>
              <img id="cover-thumb" class="cover-thumb" alt="" hidden />
              <span id="cover-name" class="muted">아직 선택한 이미지가 없어요</span>
              <button type="button" id="cover-remove" class="linklike" hidden>지우기</button>
            </div>
            <input id="fm-cover" type="file" accept="image/*" hidden />
          </div>
        </div>
      </section>

      <section class="card section">
        <div class="section-head">
          <div>
            <h2 class="section-title">본문</h2>
            <p class="section-sub">노션처럼 쓰면 바로 보여요. 이미지는 복사해서 붙여넣어도 됩니다.</p>
          </div>
          <div class="body-actions">
            <span id="char-count" class="muted"></span>
          </div>
          <input id="body-image" type="file" accept="image/*" hidden />
        </div>

        <!-- 삽입 툴바: 문법을 외우지 않아도 버튼으로 블록을 넣는다 (모바일에서도 동작) -->
        <!-- pending: 에디터 마운트 완료 전까지 비활성(그 사이 삽입분이 증발하지 않게) -->
        <!-- 센티넬: 툴바가 sticky로 '고정됐는지' 감지해 .stuck 스타일을 켠다(IntersectionObserver) -->
        <div class="md-toolbar-sentinel" aria-hidden="true"></div>
        <div class="md-toolbar pending" role="toolbar" aria-label="삽입 도구" aria-disabled="true">
          <div class="md-tools">
          <button type="button" data-md="heading" title="제목">제목</button>
          <button type="button" data-md="quote" title="인용">인용</button>
          <button type="button" data-pop="callout" title="콜아웃" aria-haspopup="true">콜아웃 ▾</button>
          <button type="button" data-pop="code" title="코드블록" aria-haspopup="true">코드 ▾</button>
          <button type="button" data-md="math" title="수식">수식</button>
          <button type="button" data-pop="mermaid" title="다이어그램" aria-haspopup="true">다이어그램 ▾</button>
          <button type="button" data-md="table" title="표">표</button>
          <button type="button" data-md="list" title="목록">목록</button>
          <button type="button" data-md="check" title="체크리스트">체크</button>
          <button type="button" data-md="divider" title="구분선">구분선</button>
          <button type="button" data-pop="wiki" title="글 연결" aria-haspopup="true">글 연결 ▾</button>
          <button type="button" data-pop="emoji" title="이모지" aria-haspopup="true">이모지 ▾</button>
          <button type="button" data-md="footnote" title="각주">각주</button>
          <button type="button" id="toolbar-image" title="이미지">이미지</button>
          <button type="button" data-pop="latex" title="수식 도움말" aria-haspopup="true">수식 도움 ▾</button>
          </div>
          <!-- 팝오버: 툴바 기준(position:relative) 절대배치 — 버튼 행(.md-tools) 밖에 둬야 가로 스크롤에 안 잘린다 -->
          <div id="md-popover" class="md-popover" role="menu" hidden></div>
        </div>

        <!-- 노션식 에디터가 마운트되는 곳. 로드 전에는 안내 문구를 보여 준다. -->
        <div id="md-editor" class="md-editor" aria-label="본문 편집기">
          <p class="md-loading muted">에디터를 불러오는 중…</p>
        </div>

        <!-- 숨은 mirror: 에디터 내용을 마크다운으로 받아 발행·점검 로직이 그대로 읽는다 -->
        <textarea id="fm-body" spellcheck="false" hidden></textarea>

        <details class="precise-preview">
          <summary>발행 결과 정밀 미리보기 (콜아웃·수식·다이어그램까지 빌드와 동일하게 확인)</summary>
          <div id="preview" class="prose"></div>
        </details>
      </section>

      <section class="card section">
        <div class="section-head">
          <div>
            <h2 class="section-title">연결</h2>
            <p class="section-sub">발행하면 지식 그래프에 함께 기록돼요.</p>
          </div>
        </div>
        <ul id="suggestions" class="suggestions"></ul>
        <div class="manual-edge">
          <span class="select-wrap">
            <select id="edge-target" aria-label="연결할 글"><option value="">글 선택…</option></select>
          </span>
          <span class="select-wrap">
            <select id="edge-type" aria-label="연결 타입">
              {edgeTypeOptions.map((o) => <option value={o.value}>{o.label}</option>)}
            </select>
          </span>
          <input id="edge-note" type="text" placeholder="메모(선택)" />
          <button id="edge-add" type="button">연결 추가</button>
        </div>
        <p id="edge-hint" class="edge-hint"></p>
        <details class="edge-guide">
          <summary>어떤 타입을 골라야 할까요?</summary>
          <ul>
            {edgeTypeOptions.map((o) => (
              <li>
                <strong class={o.value}>{o.label}</strong>
                <span>{o.criteria}</span>
              </li>
            ))}
            <li>
              <strong class="mentions">{AUTO_EDGE_TYPES.mentions.label}</strong>
              <span>{AUTO_EDGE_TYPES.mentions.criteria}</span>
            </li>
          </ul>
        </details>
      </section>

      <section class="card section">
        <h2 class="section-title">점검</h2>
        <ul id="lint-results" class="lint"></ul>
      </section>

      <div class="publish-bar">
        <span id="publish-status" role="status"></span>
        <button id="publish" type="button" class="primary big">발행하기</button>
      </div>
      <p class="settings">
        <button id="token-clear" type="button" class="linklike">이 기기에서 토큰 지우기</button>
      </p>
    </section>
  </div>

  <script type="application/json" id="write-config" set:html={JSON.stringify(config)} />
  <script type="application/json" id="edge-type-meta" set:html={JSON.stringify(edgeTypeOptions)} />
  <script type="application/json" id="callout-meta" set:html={JSON.stringify(calloutOptions)} />
</BaseLayout>

<script>
  import { createPreviewRenderer, enhancePreview } from '../scripts/write-preview';
  import { createDatePicker, todayISO } from '../scripts/date-picker';
  import type { EditorHandle } from '../scripts/milkdown-editor';

  // ---------- 설정·상태 ----------
  const CFG = JSON.parse(document.getElementById('write-config')!.textContent!);
  const TOKEN_KEY = 'injoy-gh-token';
  const API = 'https://api.github.com';
  const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
    document.getElementById(id) as T;

  interface PendingFile {
    b64: string;
    dataUrl: string;
  }

  const state = {
    mode: 'new' as 'new' | 'edit',
    editingSlug: null as string | null,
    pendingFiles: new Map<string, PendingFile>(), // repo path -> 파일 내용
    coverPath: null as string | null,
    coverPendingPath: null as string | null,
    acceptedEdges: [] as { to: string; type: string; note?: string }[],
    // 이 글로 '들어오는' 수동 연결의 메모만 고친 것(키 `from→to`, 값은 새 메모 또는 비우면 undefined).
    // 들어오는 엣지는 상대 글 소유라 타입·존재는 안 건드리고, reconcile에서 note만 갈아끼운다.
    incomingNoteEdits: new Map<string, string | undefined>(),
    // acceptedEdges가 '이 글의 완전한 나가는 연결 집합'을 반영하는지. false면 reconcile가 삭제하지 않는다(데이터 보호).
    edgesLoaded: true,
    index: { posts: [] as any[], edges: [] as any[] },
  };

  const token = () => localStorage.getItem(TOKEN_KEY);

  const gh = async (path: string, init: RequestInit = {}) => {
    const res = await fetch(`${API}${path}`, {
      ...init,
      headers: {
        Authorization: `Bearer ${token()}`,
        Accept: 'application/vnd.github+json',
        'X-GitHub-Api-Version': '2022-11-28',
        ...(init.headers ?? {}),
      },
    });
    if (!res.ok) {
      const body = await res.text();
      throw new Error(`GitHub API ${res.status}: ${body.slice(0, 200)}`);
    }
    return res.status === 204 ? null : res.json();
  };

  // ---------- 발행일 달력 ----------
  const datePicker = createDatePicker({
    input: $('fm-date') as HTMLInputElement,
    trigger: $('date-trigger') as HTMLButtonElement,
    panel: $('date-popover'),
  });

  // ---------- 본문 에디터(Milkdown) ----------
  // 본문 편집 표면. 내용이 바뀌면 마크다운을 숨은 textarea(#fm-body)로 흘려보내고,
  // 기존 발행·점검 로직은 그 textarea만 읽는다. ProseMirror는 무거우므로 인증
  // 통과 후 dynamic import로만 로드한다(방문자 비용 0, SSR 회피).
  let mdEditor: EditorHandle | null = null;

  /** 에디터 → mirror textarea 동기화. 기존 input 파이프라인을 그대로 깨운다. */
  const syncMirror = (markdown: string) => {
    const ta = $('fm-body') as HTMLTextAreaElement;
    if (ta.value === markdown) return;
    ta.value = markdown;
    ta.dispatchEvent(new Event('input', { bubbles: true }));
  };

  async function mountBodyEditor() {
    if (mdEditor) return;
    const host = $('md-editor');
    try {
      const { mountEditor } = await import('../scripts/milkdown-editor');
      host.innerHTML = '';
      mdEditor = await mountEditor(host, {
        onChange: syncMirror,
        initialValue: '',
        onImageFile: (file) => stageImage(file), // 붙여넣기·드롭 이미지 스테이징
        resolveImageSrc: resolveImage, // 에디터 안에서 이미지를 바로 보이게(dataURL/raw)
        slashItems: SLASH_ITEMS, // 데스크톱 '/' 메뉴 — 흔한 블록을 캐럿에서 바로 삽입
        onSlashInsert: (md) => (md === FOOTNOTE ? insertFootnote() : insertBlock(md)), // 툴바와 같은 삽입 경로(각주는 자동 번호)
      });
      // 개발·테스트용 핸들 (graph.astro의 __injoyGraph와 같은 선례). 운영자 전용 페이지.
      (window as any).__injoyEditor = mdEditor;
      // 마운트 완료 — 이제 툴바를 활성화한다(그 전 클릭은 비활성으로 막혀 증발 방지).
      const tb = document.querySelector('.md-toolbar');
      tb?.classList.remove('pending');
      tb?.removeAttribute('aria-disabled');
    } catch (e) {
      host.innerHTML = '';
      host.append(
        Object.assign(document.createElement('p'), {
          className: 'md-loading error',
          textContent: `에디터를 불러오지 못했어요: ${e}`,
        }),
      );
    }
  }

  /** 본문을 마크다운으로 채운다(에디터가 있으면 에디터로, 없으면 textarea로 폴백). */
  const setBody = (markdown: string) => {
    if (mdEditor) mdEditor.setMarkdown(markdown);
    else syncMirror(markdown);
  };

  // ---------- 인증 ----------
  const showEditor = async () => {
    $('auth-card').hidden = true;
    $('editor').hidden = false;
    await mountBodyEditor();
    // 순차로: loadPostList가 최신순·제목 정렬에 state.index(loadIndex 결과)를 쓰므로 먼저 채운다.
    await loadIndex();
    await loadPostList();
    resetForm();
  };

  const init = async () => {
    if (!token()) {
      $('auth-card').hidden = false;
      return;
    }
    try {
      await gh(`/repos/${CFG.owner}/${CFG.repo}`);
      await showEditor();
    } catch {
      localStorage.removeItem(TOKEN_KEY);
      $('auth-card').hidden = false;
      const err = $('auth-error');
      err.textContent = '저장돼 있던 토큰이 더 이상 유효하지 않아요. 새 토큰을 저장해 주세요.';
      err.hidden = false;
    }
  };

  $('token-save').addEventListener('click', async () => {
    const value = ($('token-input') as HTMLInputElement).value.trim();
    if (!value) return;
    localStorage.setItem(TOKEN_KEY, value);
    try {
      await gh(`/repos/${CFG.owner}/${CFG.repo}`);
      await showEditor();
    } catch (e) {
      localStorage.removeItem(TOKEN_KEY);
      const err = $('auth-error');
      err.textContent = `토큰을 확인하지 못했어요. 권한(Contents 읽기·쓰기)과 레포 지정을 확인해 주세요. ${e}`;
      err.hidden = false;
    }
  });

  $('token-clear').addEventListener('click', () => {
    if (!confirm('이 기기에서 발행 토큰을 지울까요? 헤더의 글쓰기 버튼도 함께 사라져요.')) return;
    localStorage.removeItem(TOKEN_KEY);
    location.reload();
  });

  // ---------- 인덱스·글 목록 ----------
  /** 위키링크 미리보기용 슬러그 → 제목 (참조를 파이프라인과 공유 — 재생성 없이 갱신) */
  const wikiTitles: Record<string, string> = {};

  async function loadIndex() {
    try {
      const res = await fetch(CFG.siteIndexUrl, { cache: 'no-store' });
      state.index = await res.json();
    } catch {
      state.index = { posts: [], edges: [] };
    }
    for (const key of Object.keys(wikiTitles)) delete wikiTitles[key];
    const target = $('edge-target') as HTMLSelectElement;
    target.length = 1;
    for (const p of state.index.posts) {
      target.add(new Option(p.title, p.slug));
      wikiTitles[p.slug] = p.title;
    }
    // 시리즈 입력 자동완성 — 기존 시리즈 이름을 datalist로(오타·중복 방지, 새 시리즈는 자유 입력)
    const dl = $('series-options') as HTMLDataListElement | null;
    if (dl) {
      dl.innerHTML = '';
      const seen = new Set<string>();
      for (const p of state.index.posts as any[]) {
        if (p.series && !seen.has(p.series)) {
          seen.add(p.series);
          dl.appendChild(Object.assign(document.createElement('option'), { value: p.series }));
        }
      }
    }
  }

  async function loadPostList() {
    const picker = $('post-picker') as HTMLSelectElement;
    picker.length = 1;
    try {
      const list = await gh(`/repos/${CFG.owner}/${CFG.repo}/contents/${CFG.postsDir}?ref=${CFG.branch}`);
      const files = list
        .filter((f: any) => f.type === 'file' && /\.mdx?$/.test(f.name))
        .map((f: any) => ({ name: f.name, slug: f.name.replace(/\.mdx?$/, '') }));
      // 표시는 슬러그 대신 제목, 순서는 site-index(발행 최신순)를 따른다.
      // 색인에 없는 글(초안 등)은 제목을 모르니 슬러그로, 목록 맨 뒤에 둔다(수정은 그대로 가능).
      const order = new Map<string, number>(state.index.posts.map((p: any, i: number) => [p.slug, i]));
      const titleOf = new Map<string, string>(state.index.posts.map((p: any) => [p.slug, p.title]));
      files.sort((a: any, b: any) => {
        const ia = order.has(a.slug) ? (order.get(a.slug) as number) : Infinity;
        const ib = order.has(b.slug) ? (order.get(b.slug) as number) : Infinity;
        return ia !== ib ? ia - ib : a.name.localeCompare(b.name);
      });
      // value는 파일명 그대로 유지한다(수정 로드가 파일명에 의존).
      for (const f of files) picker.add(new Option(titleOf.get(f.slug) ?? f.slug, f.name));
    } catch {
      /* 목록 실패 시 새 글만 가능 */
    }
  }

  // ---------- frontmatter 직렬화·파싱 ----------
  const yamlEscape = (s: string) => s.replace(/\\/g, '\\\\').replace(/"/g, '\\"');

  function buildFile(): { slug: string; content: string } {
    const slug = ($('fm-slug') as HTMLInputElement).value.trim();
    const tags = ($('fm-tags') as HTMLInputElement).value
      .split(',')
      .map((t) => t.trim())
      .filter(Boolean);
    const series = ($('fm-series') as HTMLInputElement).value.trim();
    const lines = [
      '---',
      `title: "${yamlEscape(($('fm-title') as HTMLInputElement).value.trim())}"`,
      `description: "${yamlEscape(($('fm-description') as HTMLInputElement).value.trim())}"`,
      `pubDate: ${($('fm-date') as HTMLInputElement).value}`,
      `category: "${yamlEscape(($('fm-category') as HTMLInputElement).value.trim())}"`,
      `tags: [${tags.map((t) => `"${yamlEscape(t)}"`).join(', ')}]`,
      `draft: ${($('fm-draft') as HTMLInputElement).checked}`,
    ];
    // 수정 발행이면 수정일을 오늘로 기록(발행일과 다를 때만) — 헤더 '수정' 메타로 노출
    if (state.mode === 'edit') {
      const d = new Date();
      const today = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      if (today !== ($('fm-date') as HTMLInputElement).value) lines.splice(4, 0, `updatedDate: ${today}`);
    }
    if (series) lines.push(`series: "${yamlEscape(series)}"`);
    if (state.coverPath) lines.push(`cover: "${state.coverPath}"`);
    lines.push('---', '', ($('fm-body') as HTMLTextAreaElement).value.trimEnd(), '');
    return { slug, content: lines.join('\n') };
  }

  function parseFile(raw: string) {
    const m = raw.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
    const fm = m?.[1] ?? '';
    const body = (m?.[2] ?? raw).replace(/^\r?\n/, '');
    const pick = (key: string) =>
      fm.match(new RegExp(`^${key}:\\s*["']?(.*?)["']?\\s*$`, 'm'))?.[1] ?? '';
    const tags = (fm.match(/^tags:\s*\[(.*)\]\s*$/m)?.[1] ?? '')
      .split(',')
      .map((t) => t.trim().replace(/^["']|["']$/g, ''))
      .filter(Boolean);
    return {
      title: pick('title'),
      description: pick('description'),
      pubDate: pick('pubDate').slice(0, 10),
      category: pick('category'),
      tags,
      series: pick('series'),
      draft: /^draft:\s*true/m.test(fm),
      cover: pick('cover') || null,
      body,
    };
  }

  // ---------- 미리보기 (빌드와 같은 파이프라인) ----------
  const renderMarkdown = createPreviewRenderer({ base: CFG.base, titles: wikiTitles });
  const RAW_BASE = `https://raw.githubusercontent.com/${CFG.owner}/${CFG.repo}/${CFG.branch}`;

  /** ./_images/ 경로를 미리볼 수 있는 URL로 — 커밋 전 파일은 data URL, 레포 파일은 raw URL */
  const resolveImage = (src: string): string | null => {
    if (!src.startsWith('./_images/')) return null;
    const name = src.slice('./_images/'.length);
    const pending = state.pendingFiles.get(`${CFG.postsDir}/_images/${name}`);
    if (pending) return pending.dataUrl;
    return `${RAW_BASE}/${CFG.postsDir}/_images/${encodeURIComponent(name)}`;
  };

  let renderGen = 0;
  async function renderPreview() {
    const preview = $('preview');
    const src = ($('fm-body') as HTMLTextAreaElement).value;
    $('char-count').textContent = src.length ? `${src.length.toLocaleString('ko-KR')}자` : '';
    // 정밀 미리보기 패널이 닫혀 있으면 무거운 렌더(Shiki·Mermaid)를 건너뛴다.
    // 에디터 자체가 이미 노션식 미리보기이므로, 이 패널은 펼쳤을 때만 그린다.
    const panel = document.querySelector('.precise-preview') as HTMLDetailsElement | null;
    if (panel && !panel.open) return;
    const gen = ++renderGen;
    if (!src.trim()) {
      preview.innerHTML =
        '<p class="preview-empty">본문을 쓰면 발행했을 때 모습이 여기에 그대로 보여요.</p>';
      return;
    }
    try {
      const html = await renderMarkdown(src);
      if (gen !== renderGen) return; // 그 사이 더 새로운 입력이 들어옴
      preview.innerHTML = html;
      await enhancePreview(preview, { resolveImage });
    } catch (e) {
      if (gen === renderGen) preview.textContent = `미리보기를 그리지 못했어요: ${e}`;
    }
  }

  let previewTimer: ReturnType<typeof setTimeout>;
  const scheduleRefresh = () => {
    clearTimeout(previewTimer);
    previewTimer = setTimeout(() => {
      renderPreview();
      renderSuggestions();
      runLint();
    }, 400);
  };
  $('fm-body').addEventListener('input', scheduleRefresh);

  // 테마가 바뀌면 다이어그램 팔레트도 따라가야 하므로 미리보기를 다시 그린다
  window.addEventListener('injoy:theme-change', () => renderPreview());
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => renderPreview());

  // ---------- 슬러그 자동 ----------
  $('fm-title').addEventListener('input', () => {
    const slugEl = $('fm-slug') as HTMLInputElement;
    if (state.mode === 'edit' || slugEl.dataset.touched) return;
    const ascii = ($('fm-title') as HTMLInputElement).value
      .toLowerCase()
      .replace(/[^a-z0-9\s-]/g, '')
      .trim()
      .replace(/\s+/g, '-');
    if (ascii) slugEl.value = ascii;
    runLint();
  });
  $('fm-slug').addEventListener('input', () => {
    ($('fm-slug') as HTMLInputElement).dataset.touched = '1';
    runLint();
  });

  // ---------- 이미지 업로드 (발행 시 같은 커밋에 포함) ----------
  const fileData = (file: File) =>
    new Promise<PendingFile>((resolve, reject) => {
      const r = new FileReader();
      r.onload = () => {
        const dataUrl = String(r.result);
        resolve({ b64: dataUrl.split(',')[1], dataUrl });
      };
      r.onerror = reject;
      r.readAsDataURL(file);
    });

  const safeName = (name: string) =>
    name.toLowerCase().replace(/[^a-z0-9.-]+/g, '-').replace(/-+/g, '-');

  function setCoverUI(thumbSrc: string | null, nameText: string, removable: boolean) {
    const thumb = $('cover-thumb') as HTMLImageElement;
    if (thumbSrc) {
      thumb.src = thumbSrc;
      thumb.hidden = false;
    } else {
      thumb.removeAttribute('src');
      thumb.hidden = true;
    }
    $('cover-name').textContent = nameText;
    $('cover-remove').hidden = !removable;
  }

  $('cover-pick').addEventListener('click', () => $('fm-cover').click());
  $('fm-cover').addEventListener('change', async (ev) => {
    const inputEl = ev.target as HTMLInputElement;
    const file = inputEl.files?.[0];
    if (!file) return;
    const slug = ($('fm-slug') as HTMLInputElement).value.trim() || 'post';
    const name = `${slug}-cover-${safeName(file.name)}`;
    if (state.coverPendingPath) state.pendingFiles.delete(state.coverPendingPath);
    const path = `${CFG.postsDir}/_images/${name}`;
    const data = await fileData(file);
    state.pendingFiles.set(path, data);
    state.coverPendingPath = path;
    state.coverPath = `./_images/${name}`;
    setCoverUI(data.dataUrl, `발행 시 업로드: ${name}`, true);
    inputEl.value = ''; // 같은 파일을 다시 골라도 change가 일어나게
  });
  $('cover-remove').addEventListener('click', () => {
    if (state.coverPendingPath) state.pendingFiles.delete(state.coverPendingPath);
    state.coverPendingPath = null;
    state.coverPath = null;
    setCoverUI(null, '아직 선택한 이미지가 없어요', false);
  });

  /** 첨부 이미지를 pendingFiles에 등록하고 본문에 넣을 경로(./_images/...)를 돌려준다. */
  async function stageImage(file: File): Promise<string> {
    const slug = ($('fm-slug') as HTMLInputElement).value.trim() || 'post';
    // 같은 파일명이 겹치면 덮어쓰지 않게 짧은 구분자를 붙인다(붙여넣기는 대개 'image.png').
    const base = safeName(file.name) || 'image.png';
    const name = state.pendingFiles.has(`${CFG.postsDir}/_images/${slug}-${base}`)
      ? `${slug}-${state.pendingFiles.size}-${base}`
      : `${slug}-${base}`;
    state.pendingFiles.set(`${CFG.postsDir}/_images/${name}`, await fileData(file));
    return `./_images/${name}`;
  }

  // 이미지 넣기는 툴바의 '이미지' 버튼(#toolbar-image)이 #body-image를 연다.
  $('body-image').addEventListener('change', async (ev) => {
    const inputEl = ev.target as HTMLInputElement;
    const file = inputEl.files?.[0];
    if (!file) return;
    const path = await stageImage(file);
    const md = `![설명을 적어 주세요](${path})`;
    if (mdEditor) mdEditor.insertMarkdown(md);
    else {
      const ta = $('fm-body') as HTMLTextAreaElement;
      ta.setRangeText(`\n${md}\n`, ta.selectionStart, ta.selectionStart, 'end');
      ta.dispatchEvent(new Event('input'));
    }
    inputEl.value = '';
  });

  // ---------- 연결 제안 ----------
  const bigrams = (s: string) => {
    const grams = new Set<string>();
    for (const word of s.toLowerCase().replace(/[^0-9a-z가-힣\s]/g, ' ').split(/\s+/)) {
      if (word.length < 2) continue;
      for (let i = 0; i < word.length - 1; i++) grams.add(word.slice(i, i + 2));
    }
    return grams;
  };
  const jaccard = (a: Set<string>, b: Set<string>) => {
    if (!a.size || !b.size) return 0;
    let inter = 0;
    for (const g of a) if (b.has(g)) inter++;
    return inter / (a.size + b.size - inter);
  };

  function suggestEdges() {
    const slug = ($('fm-slug') as HTMLInputElement).value.trim();
    const tags = ($('fm-tags') as HTMLInputElement).value.split(',').map((t) => t.trim()).filter(Boolean);
    const text = `${($('fm-title') as HTMLInputElement).value} ${($('fm-description') as HTMLInputElement).value} ${($('fm-body') as HTMLTextAreaElement).value.slice(0, 1500)}`;
    const mine = bigrams(text);
    const existing = new Set(
      state.index.edges.flatMap((e: any) => [`${e.from}→${e.to}`, `${e.to}→${e.from}`]),
    );
    return state.index.posts
      .filter((p: any) => p.slug !== slug && !existing.has(`${slug}→${p.slug}`))
      .map((p: any) => {
        const sim = jaccard(mine, bigrams(`${p.title} ${p.description} ${p.tags.join(' ')}`));
        const tagOverlap = p.tags.filter((t: string) => tags.includes(t)).length;
        return { post: p, score: sim + tagOverlap * 0.15 };
      })
      .filter((s) => s.score >= 0.08)
      .sort((a, b) => b.score - a.score)
      .slice(0, 3);
  }

  const EDGE_META = JSON.parse(document.getElementById('edge-type-meta')!.textContent!);
  const labelOf = (t: string) => EDGE_META.find((m: any) => m.value === t)?.label ?? t;

  function renderSuggestions() {
    const ul = $('suggestions');
    const picked = new Set(state.acceptedEdges.map((e) => e.to));
    const items = suggestEdges();
    ul.innerHTML = '';
    for (const { post, score } of items) {
      if (picked.has(post.slug)) continue;
      const li = document.createElement('li');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = '+ 연결';
      btn.addEventListener('click', () => {
        state.acceptedEdges.push({ to: post.slug, type: 'related', note: '자동 제안(유사도)' });
        renderSuggestions();
      });
      const main = document.createElement('div');
      main.className = 'sug-main';
      main.append(
        Object.assign(document.createElement('span'), { textContent: post.title, className: 'sug-title' }),
        Object.assign(document.createElement('span'), {
          textContent: `유사도 ${(score * 100).toFixed(0)}%`,
          className: 'muted',
        }),
      );
      li.append(main, btn);
      ul.appendChild(li);
    }
    for (const [i, e] of state.acceptedEdges.entries()) {
      const p = state.index.posts.find((p: any) => p.slug === e.to);
      const li = document.createElement('li');
      li.className = 'accepted';

      // 수락한 연결의 타입은 바로 고칠 수 있게 — 기준은 아래 가이드 참고
      const wrap = document.createElement('span');
      wrap.className = 'select-wrap';
      const sel = document.createElement('select');
      sel.className = 'mini';
      sel.setAttribute('aria-label', '연결 타입');
      for (const m of EDGE_META) sel.add(new Option(m.label, m.value));
      sel.value = e.type;
      sel.addEventListener('change', () => {
        e.type = sel.value;
      });
      wrap.appendChild(sel);

      const rm = document.createElement('button');
      rm.type = 'button';
      rm.textContent = '빼기';
      rm.addEventListener('click', () => {
        state.acceptedEdges.splice(i, 1);
        renderSuggestions();
      });

      // 한 줄(타입·제목·빼기) + 그 아래 편집 가능한 메모칸. 기존 메모도 여기서 바로 고친다.
      const row = document.createElement('div');
      row.className = 'sug-row';
      row.append(
        wrap,
        Object.assign(document.createElement('span'), {
          textContent: p?.title ?? e.to,
          className: 'sug-title',
        }),
        rm,
      );

      const note = document.createElement('textarea');
      note.className = 'sug-note';
      note.rows = 1;
      note.placeholder = '메모(선택)';
      note.setAttribute('aria-label', '연결 메모');
      note.value = e.note ?? '';
      const grow = () => {
        note.style.height = 'auto';
        if (note.scrollHeight) note.style.height = `${note.scrollHeight}px`;
      };
      note.addEventListener('input', () => {
        e.note = note.value.trim() || undefined;
        grow();
      });

      li.append(row, note);
      ul.appendChild(li);
      grow();
    }

    // 읽기 전용: 이 글로 '들어오는' 명시 연결 + 위키링크 '언급'(양방향).
    // 편집은 못 하지만 전체 연결 그림을 보여 줘 중복·승격 판단을 돕는다.
    if (state.mode === 'edit' && state.editingSlug) {
      const slug = state.editingSlug;
      const ownedOut = new Set(state.acceptedEdges.map((e) => e.to));
      const info = state.index.edges.filter((e: any) => {
        if (e.from !== slug && e.to !== slug) return false;
        // 편집 목록에 이미 있는 대상은 제외 — 위키링크를 명시 연결로 승격해도 중복 안 뜨게(mention 포함).
        if (e.from === slug && ownedOut.has(e.to)) return false;
        return true;
      });
      const shown = new Set<string>();
      for (const e of info) {
        const incoming = e.to === slug;
        const other = incoming ? e.from : e.to;
        if (shown.has(other)) continue; // 상호 언급 등 같은 글이 두 번 뜨지 않게
        shown.add(other);
        const p = state.index.posts.find((q: any) => q.slug === other);
        const meta = EDGE_META.find((m: any) => m.value === e.type);
        const title = p?.title ?? other;

        // 들어온 수동 연결: 메모만 그 자리에서 고친다(타입·삭제는 상대 글 소유라 없음).
        if (incoming && e.type !== 'mentions') {
          const key = `${e.from}→${e.to}`;
          const li = document.createElement('li');
          li.className = 'incoming-edge';
          const row = document.createElement('div');
          row.className = 'sug-row';
          row.append(
            Object.assign(document.createElement('span'), {
              className: 'ro-chip',
              textContent: `${meta?.label ?? e.type} 받음`,
            }),
            Object.assign(document.createElement('span'), { textContent: title, className: 'sug-title' }),
          );
          const note = document.createElement('textarea');
          note.className = 'sug-note';
          note.rows = 1;
          note.placeholder = '메모(선택)';
          note.setAttribute('aria-label', '연결 메모');
          note.value = state.incomingNoteEdits.has(key)
            ? state.incomingNoteEdits.get(key) ?? ''
            : e.note ?? '';
          const grow = () => {
            note.style.height = 'auto';
            if (note.scrollHeight) note.style.height = `${note.scrollHeight}px`;
          };
          note.addEventListener('input', () => {
            state.incomingNoteEdits.set(key, note.value.trim() || undefined);
            grow();
          });
          li.append(row, note);
          ul.appendChild(li);
          grow();
          continue;
        }

        // 그 밖(언급, 또는 연결을 못 불러온 경우의 나가는 연결)은 읽기 전용.
        const li = document.createElement('li');
        li.className = 'readonly-edge';
        li.append(
          Object.assign(document.createElement('span'), {
            className: 'ro-chip',
            textContent:
              e.type === 'mentions' ? '언급' : `${meta?.label ?? e.type}${incoming ? ' 받음' : ''}`,
          }),
          Object.assign(document.createElement('span'), {
            textContent: title,
            className: 'sug-title',
          }),
        );
        ul.appendChild(li);
      }
    }

    // 제안·수락·읽기 전용 어느 것도 없을 때만 빈 안내(읽기 전용 위에 모순되게 뜨지 않게).
    if (ul.childElementCount === 0) {
      ul.innerHTML = '<li class="empty">아직 비슷한 글이 없어요. 본문을 쓰면 자동으로 제안돼요.</li>';
    }
  }

  const updateEdgeHint = () => {
    const t = ($('edge-type') as HTMLSelectElement).value;
    $('edge-hint').textContent = EDGE_META.find((m: any) => m.value === t)?.criteria ?? '';
  };
  $('edge-type').addEventListener('change', updateEdgeHint);
  updateEdgeHint();

  $('edge-add').addEventListener('click', () => {
    const to = ($('edge-target') as HTMLSelectElement).value;
    if (!to) return;
    // 두 글 사이 연결은 하나면 충분 — 이미 연결됐거나 수락 목록에 있으면 막는다.
    // 단, mention(위키링크 자동 연결)은 명시 연결로 '승격'할 수 있어야 하므로 제외한다.
    const slug = ($('fm-slug') as HTMLInputElement).value.trim();
    const connected = new Set(
      state.index.edges
        .filter((e: any) => e.type !== 'mentions')
        .flatMap((e: any) => [`${e.from}→${e.to}`, `${e.to}→${e.from}`]),
    );
    if (connected.has(`${slug}→${to}`) || state.acceptedEdges.some((e) => e.to === to)) {
      $('edge-hint').textContent = '이미 연결된 글이에요. 두 글 사이 연결은 하나면 충분해요.';
      return;
    }
    state.acceptedEdges.push({
      to,
      type: ($('edge-type') as HTMLSelectElement).value,
      note: ($('edge-note') as HTMLInputElement).value.trim() || undefined,
    });
    ($('edge-note') as HTMLInputElement).value = '';
    renderSuggestions();
  });

  // ---------- 점검 ----------
  function stripFences(body: string) {
    const out: string[] = [];
    let fence: string | null = null;
    for (const line of body.split('\n')) {
      const run = line.match(/^\s*(`{3,})/)?.[1];
      if (fence) {
        if (run && run.length >= fence.length) fence = null;
        continue;
      }
      if (run) {
        fence = run;
        continue;
      }
      out.push(line);
    }
    return out.join('\n').replace(/`[^`\n]*`/g, ' ');
  }

  function runLint(): { errors: string[]; warnings: string[] } {
    const errors: string[] = [];
    const warnings: string[] = [];
    const title = ($('fm-title') as HTMLInputElement).value.trim();
    const slug = ($('fm-slug') as HTMLInputElement).value.trim();
    const desc = ($('fm-description') as HTMLInputElement).value.trim();
    const body = ($('fm-body') as HTMLTextAreaElement).value;

    if (!title) errors.push('제목이 비어 있어요.');
    if (!slug) errors.push('슬러그가 비어 있어요.');
    else if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) errors.push('슬러그는 영문 소문자·숫자·하이픈만 쓸 수 있어요.');
    else if (state.mode === 'new' && state.index.posts.some((p: any) => p.slug === slug))
      errors.push(`이미 같은 슬러그의 글이 있어요: ${slug}`);
    if (!desc) errors.push('한 줄 요약이 비어 있어요.');
    else if (desc.length > 160) warnings.push(`한 줄 요약이 길어요(${desc.length}자). 160자 이하를 권장해요.`);
    if (!($('fm-date') as HTMLInputElement).value) errors.push('발행일을 선택해 주세요.');
    if (!body.trim()) errors.push('본문이 비어 있어요.');

    const prose = stripFences(body);
    for (const m of prose.matchAll(/\[\[([^\[\]|\n]+?)(?:\|[^\[\]\n]+?)?\]\]/g)) {
      const target = m[1].trim();
      if (target !== slug && !state.index.posts.some((p: any) => p.slug === target))
        warnings.push(`위키링크 [[${target}]] 대상 글을 찾을 수 없어요(초안이면 발행 후 연결됩니다).`);
    }
    if (/!\[\]\(/.test(body)) warnings.push('alt 텍스트가 빈 이미지가 있어요. 설명을 적어 주세요.');
    // 코드·인라인 코드를 걷어낸 prose에서만 센다 — 본문에 적은 `$$` 예시까지 짝으로 세면 오탐이 난다.
    if (((prose.match(/\$\$/g) ?? []).length % 2) === 1) warnings.push('$$ 수식 블록이 닫히지 않은 것 같아요.');
    if (($('fm-draft') as HTMLInputElement).checked) warnings.push('초안 상태예요. 발행해도 사이트에는 보이지 않아요.');

    const ul = $('lint-results');
    ul.innerHTML = '';
    for (const e of errors) ul.insertAdjacentHTML('beforeend', `<li class="err">✕ ${e}</li>`);
    for (const w of warnings) ul.insertAdjacentHTML('beforeend', `<li class="warn">△ ${w}</li>`);
    if (!errors.length && !warnings.length) ul.innerHTML = '<li class="ok">✓ 모두 통과했어요. 발행할 준비가 됐어요.</li>';
    return { errors, warnings };
  }
  ['fm-title', 'fm-description', 'fm-tags', 'fm-date', 'fm-category'].forEach((id) =>
    $(id).addEventListener('input', () => {
      runLint();
      renderSuggestions();
    }),
  );
  $('fm-draft').addEventListener('change', runLint);

  // ---------- 발행 (Git Data API — 단일 커밋) ----------
  const b64encodeUtf8 = (s: string) => {
    const bytes = new TextEncoder().encode(s);
    let bin = '';
    bytes.forEach((b) => (bin += String.fromCharCode(b)));
    return btoa(bin);
  };
  const b64decodeUtf8 = (b64: string) => {
    const bin = atob(b64.replace(/\n/g, ''));
    const bytes = Uint8Array.from(bin, (c) => c.charCodeAt(0));
    return new TextDecoder().decode(bytes);
  };

  async function commitFiles(
    files: { path: string; contentBase64: string }[],
    deletions: string[],
    message: string,
  ): Promise<string> {
    const repo = `/repos/${CFG.owner}/${CFG.repo}`;
    const ref = await gh(`${repo}/git/ref/heads/${CFG.branch}`);
    const baseSha = ref.object.sha;
    const baseCommit = await gh(`${repo}/git/commits/${baseSha}`);

    const tree: any[] = [];
    for (const f of files) {
      const blob = await gh(`${repo}/git/blobs`, {
        method: 'POST',
        body: JSON.stringify({ content: f.contentBase64, encoding: 'base64' }),
      });
      tree.push({ path: f.path, mode: '100644', type: 'blob', sha: blob.sha });
    }
    for (const path of deletions) {
      tree.push({ path, mode: '100644', type: 'blob', sha: null });
    }

    const newTree = await gh(`${repo}/git/trees`, {
      method: 'POST',
      body: JSON.stringify({ base_tree: baseCommit.tree.sha, tree }),
    });
    const commit = await gh(`${repo}/git/commits`, {
      method: 'POST',
      body: JSON.stringify({ message, tree: newTree.sha, parents: [baseSha] }),
    });
    await gh(`${repo}/git/refs/heads/${CFG.branch}`, {
      method: 'PATCH',
      body: JSON.stringify({ sha: commit.sha }),
    });
    return commit.sha;
  }

  async function fetchEdges() {
    try {
      const file = await gh(
        `/repos/${CFG.owner}/${CFG.repo}/contents/${CFG.edgesPath}?ref=${CFG.branch}`,
      );
      return JSON.parse(b64decodeUtf8(file.content));
    } catch (e) {
      if (String(e).includes('404')) return { edges: [] }; // 아직 연결 파일이 없는 레포
      throw e;
    }
  }
  const edgesToString = (data: any) => JSON.stringify(data, null, 2) + '\n';

  async function mergedEdgesFile(slug: string): Promise<string | null> {
    // 연결을 못 불러온 상태(edit-load 실패)면 reconcile로 기존 연결을 지울 위험이 있으므로
    // edges.json을 아예 건드리지 않는다(데이터 보호). 새 글·정상 로드는 edgesLoaded=true.
    if (!state.edgesLoaded) return null;
    const data = await fetchEdges();
    // 이 글이 '소유한' 나가는 엣지(from===slug)를 acceptedEdges로 통째로 교체(reconcile)한다.
    // 다른 글의 엣지와 이 글로 '들어오는' 엣지(to===slug, from!==slug)는 건드리지 않는다 —
    // 그건 상대 글의 소유라 여기서 지우거나 바꾸면 안 된다.
    // 들어오는 역방향 엣지(bar→foo)와 이 글의 정방향 엣지(foo→bar)는 별개의 정당한 엣지다.
    // 그래서 '같은 방향'만 중복으로 보고, 이 글이 소유한 나가는 엣지는 역방향 존재와 무관하게 보존한다.
    const desired = new Map<string, { type: string; note?: string }>();
    for (const e of state.acceptedEdges) {
      if (e.to === slug) continue; // 자기참조 방지
      if (!desired.has(e.to)) desired.set(e.to, { type: e.type, note: e.note });
    }
    // 기존 순서를 보존하며 제자리 reconcile — 남은 건 타입·노트만 갱신, 빠진 건 제거.
    const seen = new Set<string>();
    const next: any[] = [];
    for (const e of data.edges) {
      if (e.from === slug) {
        const d = desired.get(e.to);
        if (d && !seen.has(e.to)) {
          next.push({ from: slug, to: e.to, type: d.type, ...(d.note ? { note: d.note } : {}) });
          seen.add(e.to);
        }
        // desired에 없으면 제거(drop)
      } else {
        // 다른 글의 엣지·이 글로 들어오는 엣지는 그대로 보존하되,
        // 들어온 연결의 메모만 고쳤으면 그 note만 갈아끼운다(타입·존재·방향은 불변).
        const key = `${e.from}→${e.to}`;
        if (e.to === slug && state.incomingNoteEdits.has(key)) {
          const note = state.incomingNoteEdits.get(key);
          next.push({ from: e.from, to: e.to, type: e.type, ...(note ? { note } : {}) });
        } else {
          next.push(e);
        }
      }
    }
    // 기존 edges.json에 없던 새 연결만 끝에 추가한다.
    for (const [to, d] of desired) {
      if (seen.has(to)) continue;
      next.push({ from: slug, to, type: d.type, ...(d.note ? { note: d.note } : {}) });
      seen.add(to);
    }
    // 제자리 reconcile라 순서까지 같으면 무변경 — 재발행 멱등(불필요한 커밋 방지).
    if (JSON.stringify(next) === JSON.stringify(data.edges)) return null;
    return edgesToString({ ...data, edges: next });
  }

  /** 삭제되는 글을 가리키는 연결을 함께 정리 — 남겨 두면 다음 빌드가 실패한다 */
  async function edgesFileWithout(slug: string): Promise<string | null> {
    const data = await fetchEdges();
    const kept = data.edges.filter((e: any) => e.from !== slug && e.to !== slug);
    if (kept.length === data.edges.length) return null;
    return edgesToString({ ...data, edges: kept });
  }

  // 배포(GitHub Actions) 결과만 조용히 폴링해 돌려준다 — 화면 표시는 trackDeploy가 맡는다.
  async function waitForDeploy(sha: string) {
    for (let i = 0; i < 60; i++) {
      await new Promise((r) => setTimeout(r, 4000));
      try {
        const runs = await gh(
          `/repos/${CFG.owner}/${CFG.repo}/actions/runs?head_sha=${sha}&per_page=1`,
        );
        const run = runs.workflow_runs?.[0];
        if (!run) continue;
        if (run.status !== 'completed') continue;
        // 취소·건너뜀은 실패가 아니라 '더 최신 발행으로 대체됨' — 별도 신호로 구분한다.
        if (run.conclusion === 'cancelled' || run.conclusion === 'skipped') return 'superseded';
        return run.conclusion === 'success';
      } catch {
        /* 일시 오류 무시 */
      }
    }
    return null;
  }

  // 발행은 커밋 순간 끝난다. 배포(빌드)는 사이트에 퍼지는 시간일 뿐이라 기다리게 하지 않는다.
  // 바로 성공을 알리고, 배포 확인은 백그라운드에서 — 그동안 즐거운 진행 표시를 보여 준다(논블로킹).
  // 동시에 두 번 발행해도 옛 진행표시가 최신 것을 덮거나 인터벌이 겹치지 않게 세대 토큰으로 가드.
  let deployRun = 0;
  let deployRot: ReturnType<typeof setInterval> | null = null;
  function trackDeploy(sha: string, url: string, verbPast: string) {
    const gen = ++deployRun;
    if (deployRot) clearInterval(deployRot);
    const status = $('publish-status');
    const link = `<a href="${url}">글 보러 가기</a>`;
    const msgs = ['GitHub에 올렸어요', '사이트 짓는 중…', '거의 다 됐어요'];
    let step = 0;
    status.innerHTML =
      `<span class="pub-ok">✓ ${verbPast}!</span>` +
      `<span class="pub-progress"><span class="pub-spin" aria-hidden="true"></span>` +
      `<span class="pub-msg">${msgs[0]}</span></span>` +
      `<span class="pub-sep" aria-hidden="true">·</span>${link}`;
    deployRot = setInterval(() => {
      if (gen !== deployRun) return;
      step = (step + 1) % msgs.length;
      const m = status.querySelector('.pub-msg');
      if (m) m.textContent = msgs[step];
    }, 5000);
    const stop = () => {
      if (deployRot) {
        clearInterval(deployRot);
        deployRot = null;
      }
    };
    waitForDeploy(sha)
      .then((ok) => {
        if (gen !== deployRun) return; // 더 최신 발행이 있으면 이 결과는 버린다
        stop();
        // 인라인으로 완료를 봤으니 전역 토스트(watchPendingDeploy)는 안 뜨게 대기 기록을 지운다.
        try { localStorage.removeItem('injoy-pending-deploy'); } catch {}
        if (ok === true) {
          status.innerHTML = `<span class="pub-ok pub-done"><span aria-hidden="true">✓</span> 사이트에 반영됐어요</span><span class="pub-sep" aria-hidden="true">·</span>${link} <span class="tossface pub-sprout">🌱</span>`;
        } else if (ok === 'superseded') {
          status.innerHTML = `<span class="pub-ok">✓ ${verbPast}.</span> 더 최신 발행으로 대체됐어요. 최신 내용이 곧 반영됩니다.`;
        } else if (ok === false) {
          status.innerHTML = `⚠ ${verbPast}(커밋은 됐어요)만 배포가 실패했어요. GitHub Actions 로그를 확인해 주세요.`;
        } else {
          status.innerHTML = `<span class="pub-ok">✓ ${verbPast}.</span> 배포 확인이 늦어지고 있어요 · ${link}`;
        }
      })
      .catch(() => {
        if (gen !== deployRun) return;
        stop();
        try { localStorage.removeItem('injoy-pending-deploy'); } catch {}
        status.innerHTML = `<span class="pub-ok">✓ ${verbPast}</span> · ${link}`;
      });
  }

  $('publish').addEventListener('click', async () => {
    // 에디터 listener는 200ms 디바운스라, 입력 직후 발행하면 mirror가 stale일 수 있다.
    // 발행 직전 에디터의 현재 내용을 강제로 mirror에 반영한 뒤 점검·빌드를 읽는다.
    if (mdEditor) syncMirror(mdEditor.getMarkdown());
    const { errors, warnings } = runLint();
    if (errors.length) {
      $('publish-status').textContent = '점검에서 막힌 항목을 먼저 해결해 주세요.';
      return;
    }
    if (warnings.length && !confirm(`경고 ${warnings.length}건이 있어요. 그래도 발행할까요?`)) return;

    const btn = $('publish') as HTMLButtonElement;
    btn.disabled = true;
    const status = $('publish-status');
    status.textContent = '커밋 만드는 중…';

    try {
      const { slug, content } = buildFile();
      const isDraft = ($('fm-draft') as HTMLInputElement).checked;
      const files: { path: string; contentBase64: string }[] = [
        { path: `${CFG.postsDir}/${slug}.md`, contentBase64: b64encodeUtf8(content) },
      ];
      for (const [path, f] of state.pendingFiles) files.push({ path, contentBase64: f.b64 });
      // draft 글의 연결은 보류 — 그래프 검증이 발행 글만 알기 때문에 빌드가 깨진다.
      // draft를 해제하고 다시 발행할 때 함께 저장하면 된다.
      if (!isDraft) {
        const edgesContent = await mergedEdgesFile(slug);
        if (edgesContent) files.push({ path: CFG.edgesPath, contentBase64: b64encodeUtf8(edgesContent) });
      } else if (state.acceptedEdges.length > 0) {
        status.textContent = '초안이라 연결은 이번 커밋에 저장하지 않아요. 발행으로 전환할 때 함께 저장돼요.';
      }

      const verb = state.mode === 'edit' ? '수정' : '발행';
      const sha = await commitFiles(files, [], `post: ${($('fm-title') as HTMLInputElement).value.trim()} ${verb} (/write)`);

      // 커밋이 곧 발행이다 — 바로 성공을 알리고 에디터를 풀어 준다. 발행 후 상태 정리도 여기서.
      const url = `${CFG.base}posts/${slug}/`;
      state.pendingFiles.clear();
      state.coverPendingPath = null;
      // acceptedEdges는 비우지 않는다 — 방금 쓴 '이 글의 연결' 상태라, 재발행 reconcile가 멱등이게.
      state.mode = 'edit';
      state.editingSlug = slug;
      // 발행되면 슬러그를 잠근다(이름 변경은 새 글로 — 옛 .md 고아 방지).
      ($('fm-slug') as HTMLInputElement).disabled = true;
      $('delete-post').hidden = false;
      btn.disabled = false;
      // 배포 확인은 백그라운드 + 즐거운 진행 표시(논블로킹) — 끝나면 '반영됐어요'로 바뀐다.
      trackDeploy(sha, url, verb === '수정' ? '수정됐어요' : '발행됐어요');
      // '글 보러 가기'로 이 페이지를 떠나도 배포 완료를 알 수 있게 대기 기록을 남긴다(watchPendingDeploy가 잡는다).
      try {
        localStorage.setItem(
          'injoy-pending-deploy',
          JSON.stringify({ sha, url, title: ($('fm-title') as HTMLInputElement).value.trim(), verb, ts: Date.now() }),
        );
      } catch {}
      // 목록·인덱스 갱신은 발행과 별개라 따로 감싼다(여기서 실패해도 '발행 실패'로 오인하지 않게).
      try {
        await loadIndex();
        await loadPostList();
      } catch {
        /* 목록 갱신 실패는 다음 로드에서 회복 */
      }
    } catch (e) {
      $('publish-status').textContent = `✕ 발행 실패: ${e}`;
      btn.disabled = false;
    }
  });

  // ---------- 글 불러오기·삭제·초기화 ----------
  $('post-picker').addEventListener('change', async (ev) => {
    const filename = (ev.target as HTMLSelectElement).value;
    if (!filename) return;
    const file = await gh(
      `/repos/${CFG.owner}/${CFG.repo}/contents/${CFG.postsDir}/${filename}?ref=${CFG.branch}`,
    );
    const parsed = parseFile(b64decodeUtf8(file.content));
    state.mode = 'edit';
    state.editingSlug = filename.replace(/\.mdx?$/, '');
    state.pendingFiles.clear();
    state.incomingNoteEdits.clear();
    // 기존 연결을 GitHub의 현재 edges.json에서 직접 불러온다(빌드 인덱스보다 최신).
    // 이 글이 소유한 '나가는' 명시 엣지만 편집 대상 — 들어오는 엣지·언급은 아래에서 읽기 전용으로 보여 준다.
    try {
      const existingEdges = await fetchEdges();
      state.acceptedEdges = existingEdges.edges
        .filter((e: any) => e.from === state.editingSlug)
        .map((e: any) => ({ to: e.to, type: e.type, note: e.note }));
      state.edgesLoaded = true;
    } catch {
      // 연결을 못 불러오면 reconcile가 기존 연결을 지우지 않도록 막는다(데이터 보호).
      // 연결은 아래 읽기 전용 목록(state.index 기반)으로는 여전히 보인다.
      state.acceptedEdges = [];
      state.edgesLoaded = false;
    }
    state.coverPath = parsed.cover;
    state.coverPendingPath = null;

    $('editor-title').textContent = '글 수정';
    ($('fm-title') as HTMLInputElement).value = parsed.title;
    const slugEl = $('fm-slug') as HTMLInputElement;
    slugEl.value = state.editingSlug;
    slugEl.disabled = true;
    ($('fm-description') as HTMLInputElement).value = parsed.description;
    ($('fm-category') as HTMLInputElement).value = parsed.category;
    ($('fm-tags') as HTMLInputElement).value = parsed.tags.join(', ');
    ($('fm-series') as HTMLInputElement).value = parsed.series ?? '';
    datePicker.set(parsed.pubDate);
    ($('fm-draft') as HTMLInputElement).checked = parsed.draft;
    setBody(parsed.body);
    setCoverUI(
      parsed.cover ? resolveImage(parsed.cover) : null,
      parsed.cover ? `현재: ${parsed.cover}` : '아직 선택한 이미지가 없어요',
      Boolean(parsed.cover),
    );
    $('delete-post').hidden = false;
    renderPreview();
    renderSuggestions();
    runLint();
  });

  $('delete-post').addEventListener('click', async () => {
    if (!state.editingSlug) return;
    if (!confirm(`"${state.editingSlug}" 글을 정말 삭제할까요? 커밋으로 기록되어 되돌릴 수 있어요.`)) return;
    const status = $('publish-status');
    try {
      status.textContent = '삭제 커밋 만드는 중…';
      const cleanedEdges = await edgesFileWithout(state.editingSlug);
      await commitFiles(
        cleanedEdges
          ? [{ path: CFG.edgesPath, contentBase64: b64encodeUtf8(cleanedEdges) }]
          : [],
        [`${CFG.postsDir}/${state.editingSlug}.md`],
        `post: ${state.editingSlug} 삭제 (/write)`,
      );
      resetForm(); // resetForm이 상태 문구를 비우므로 성공 메시지는 그 뒤에
      status.textContent = '✓ 삭제 커밋 완료. 곧 사이트에서 사라져요(관련 연결도 함께 정리했어요).';
      await loadIndex();
      await loadPostList();
    } catch (e) {
      status.textContent = `✕ 삭제 실패: ${e}`;
    }
  });

  function resetForm() {
    state.mode = 'new';
    state.editingSlug = null;
    state.pendingFiles.clear();
    state.acceptedEdges = [];
    state.incomingNoteEdits.clear();
    state.edgesLoaded = true; // 새 글은 빈 집합이 곧 완전한 집합
    state.coverPath = null;
    state.coverPendingPath = null;
    $('editor-title').textContent = '새 글';
    ($('post-picker') as HTMLSelectElement).value = '';
    const slugEl = $('fm-slug') as HTMLInputElement;
    slugEl.disabled = false;
    slugEl.value = '';
    delete slugEl.dataset.touched;
    for (const id of ['fm-title', 'fm-description', 'fm-tags', 'fm-series'])
      ($(id) as HTMLInputElement).value = '';
    ($('fm-category') as HTMLInputElement).value = '개발';
    datePicker.set(todayISO());
    ($('fm-draft') as HTMLInputElement).checked = true;
    setBody('');
    setCoverUI(null, '아직 선택한 이미지가 없어요', false);
    $('delete-post').hidden = true;
    $('publish-status').textContent = '';
    renderPreview();
    renderSuggestions();
    runLint();
  }

  $('new-post').addEventListener('click', resetForm);

  // 정밀 미리보기를 펼치면 그때 한 번 그린다(닫혀 있을 땐 렌더 생략).
  document
    .querySelector('.precise-preview')
    ?.addEventListener('toggle', (ev) => {
      if ((ev.target as HTMLDetailsElement).open) renderPreview();
    });

  // ---------- 삽입 툴바 ----------
  const CALLOUT_META = JSON.parse(document.getElementById('callout-meta')!.textContent!) as {
    keyword: string;
    title: string;
  }[];

  /** 커서 위치에 마크다운 삽입(에디터 없으면 textarea 폴백). */
  const insertBlock = (md: string) => {
    if (mdEditor) {
      mdEditor.insertMarkdown(md);
      mdEditor.focus();
    } else {
      const ta = $('fm-body') as HTMLTextAreaElement;
      ta.setRangeText(`\n${md}\n`, ta.selectionStart, ta.selectionStart, 'end');
      ta.dispatchEvent(new Event('input'));
    }
  };

  // 각주 버튼: 본문에서 가장 큰 [^N] 번호를 찾아 다음 번호로 자동 증가시킨다.
  // 참조 [^N]과 하단 정의 [^N]: 를 함께 넣어, 발행하면 글 맨 아래 각주로 모인다.
  const FOOTNOTE = '␀footnote'; // 슬래시 메뉴에서 각주를 자동 번호 경로로 보내는 표식
  const nextFootnoteNumber = () => {
    const md = mdEditor ? mdEditor.getMarkdown() : ($('fm-body') as HTMLTextAreaElement).value;
    let max = 0;
    for (const m of md.matchAll(/\[\^(\d+)\]/g)) max = Math.max(max, parseInt(m[1], 10));
    return max + 1;
  };
  const insertFootnote = () => {
    if (mdEditor) {
      mdEditor.insertFootnote(); // 참조는 커서에, 정의는 글 끝에 자동 번호로
      mdEditor.focus();
    } else {
      const n = nextFootnoteNumber();
      insertBlock(`[^${n}]\n\n[^${n}]: 각주 내용을 적어요.`);
    }
  };

  // data-md 버튼: 정해진 마크다운 조각을 삽입
  const SNIPPETS: Record<string, string> = {
    heading: '## 제목',
    quote: '> 인용문',
    math: '$$\na^2 + b^2 = c^2\n$$',
    table: '| 머리 1 | 머리 2 |\n| --- | --- |\n| 값 1 | 값 2 |',
    list: '- 항목 1\n- 항목 2',
    check: '- [ ] 할 일',
    divider: '---',
  };

  // mermaid 예시 갤러리
  const MERMAID_EXAMPLES: { label: string; code: string }[] = [
    { label: '순서도', code: 'flowchart LR\n  A[시작] --> B{조건}\n  B -- 예 --> C[처리]\n  B -- 아니오 --> D[종료]' },
    { label: '시퀀스', code: 'sequenceDiagram\n  participant 나\n  participant 서버\n  나->>서버: 요청\n  서버-->>나: 응답' },
    { label: 'ER 다이어그램', code: 'erDiagram\n  USER ||--o{ POST : writes\n  POST ||--o{ COMMENT : has\n  USER {\n    int id\n    string name\n  }' },
    { label: '클래스', code: 'classDiagram\n  class Animal {\n    +String name\n    +eat()\n  }\n  Animal <|-- Dog' },
    { label: '상태', code: 'stateDiagram-v2\n  [*] --> 대기\n  대기 --> 진행: 시작\n  진행 --> 완료: 끝\n  완료 --> [*]' },
    { label: '간트', code: 'gantt\n  title 일정\n  section 준비\n  기획 :a1, 2026-06-01, 7d\n  설계 :after a1, 5d' },
    { label: '파이', code: 'pie title 비율\n  "개발" : 50\n  "회고" : 30\n  "데이터" : 20' },
  ];

  // 코드블록 언어 (검색 가능)
  const CODE_LANGS = ['text', 'js', 'ts', 'tsx', 'jsx', 'json', 'html', 'css', 'astro', 'bash', 'shell', 'python', 'go', 'rust', 'java', 'c', 'cpp', 'kotlin', 'swift', 'ruby', 'php', 'sql', 'yaml', 'toml', 'markdown', 'diff', 'mermaid'];

  // 이모지 피커 (검색 가능) — :숏코드: 텍스트를 넣는다(빌드에서 글리프로 변환)
  const EMOJIS: { code: string; glyph: string; kw: string }[] = [
    { code: 'smile', glyph: '😄', kw: '웃음 미소' }, { code: 'rocket', glyph: '🚀', kw: '로켓 발사' },
    { code: 'sparkles', glyph: '✨', kw: '반짝 새로움' }, { code: 'seedling', glyph: '🌱', kw: '새싹 시작' },
    { code: 'fire', glyph: '🔥', kw: '불 인기' }, { code: 'tada', glyph: '🎉', kw: '축하 완료' },
    { code: 'bulb', glyph: '💡', kw: '아이디어 팁' }, { code: 'memo', glyph: '📝', kw: '메모 기록' },
    { code: 'pushpin', glyph: '📌', kw: '핀 고정' }, { code: 'white_check_mark', glyph: '✅', kw: '체크 완료' },
    { code: 'warning', glyph: '⚠️', kw: '경고 주의' }, { code: 'heart', glyph: '❤️', kw: '하트 좋아요' },
    { code: '+1', glyph: '👍', kw: '따봉 좋아요' }, { code: 'eyes', glyph: '👀', kw: '눈 주목' },
    { code: 'dog', glyph: '🐶', kw: '강아지 개' }, { code: 'star', glyph: '⭐', kw: '별 즐겨찾기' },
    { code: 'zap', glyph: '⚡', kw: '번개 빠름' }, { code: 'wrench', glyph: '🔧', kw: '도구 수정' },
    { code: 'books', glyph: '📚', kw: '책 공부' }, { code: 'coffee', glyph: '☕', kw: '커피 휴식' },
    { code: 'thinking', glyph: '🤔', kw: '고민 생각' }, { code: 'tada', glyph: '🎊', kw: '파티' },
    { code: 'rainbow', glyph: '🌈', kw: '무지개' }, { code: 'package', glyph: '📦', kw: '패키지 배포' },
  ];

  // LaTeX 치트시트
  const LATEX_SNIPPETS: { label: string; code: string }[] = [
    { label: '분수', code: '\\frac{a}{b}' }, { label: '제곱', code: 'x^{2}' },
    { label: '아래첨자', code: 'x_{i}' }, { label: '루트', code: '\\sqrt{x}' },
    { label: '합', code: '\\sum_{i=1}^{n}' }, { label: '적분', code: '\\int_{a}^{b}' },
    { label: '극한', code: '\\lim_{x \\to 0}' }, { label: '벡터', code: '\\vec{v}' },
    { label: '그리스 α', code: '\\alpha' }, { label: '그리스 π', code: '\\pi' },
    { label: '곱하기', code: '\\times' }, { label: '나누기', code: '\\div' },
    { label: '≤', code: '\\leq' }, { label: '≥', code: '\\geq' }, { label: '≠', code: '\\neq' },
    { label: '화살표', code: '\\rightarrow' }, { label: '무한대', code: '\\infty' },
  ];

  // 슬래시(/) 메뉴 항목 — 위 데이터 재사용. 코드 언어·이모지·머메이드 갤러리 같은 정교한
  // 피커는 툴바에 남기고, 슬래시는 흔한 블록을 캐럿에서 바로 꽂는다(데스크톱 보조 삽입).
  const SLASH_ITEMS = [
    { label: '제목', keywords: 'heading h2 title 제목', md: SNIPPETS.heading },
    { label: '인용', keywords: 'quote blockquote 인용', md: SNIPPETS.quote },
    ...CALLOUT_META.map((c) => ({
      label: `콜아웃 · ${c.title}`,
      keywords: `callout 콜아웃 ${c.keyword} ${c.title}`,
      md: `> [!${c.keyword}]\n> 내용을 적어요.`,
    })),
    { label: '표', keywords: 'table 표', md: SNIPPETS.table },
    { label: '목록', keywords: 'list bullet 목록', md: SNIPPETS.list },
    { label: '체크리스트', keywords: 'check todo task 체크 할일', md: SNIPPETS.check },
    { label: '구분선', keywords: 'divider hr rule 구분선', md: SNIPPETS.divider },
    { label: '코드블록', keywords: 'code 코드 fence', md: '```\n\n```' },
    { label: '수식 블록', keywords: 'math latex 수식', md: SNIPPETS.math },
    { label: '각주', keywords: 'footnote 각주', md: FOOTNOTE },
    {
      label: '다이어그램',
      keywords: 'mermaid diagram 다이어그램 순서도',
      md: '```mermaid\n' + MERMAID_EXAMPLES[0].code + '\n```',
    },
  ];

  const popover = $('md-popover');
  let popoverAnchor: HTMLElement | null = null;

  const closePopover = () => {
    popover.hidden = true;
    popover.innerHTML = '';
    popoverAnchor?.setAttribute('aria-expanded', 'false');
    popoverAnchor = null;
  };

  const positionPopover = (anchor: HTMLElement) => {
    const tb = anchor.closest('.md-toolbar') as HTMLElement;
    const a = anchor.getBoundingClientRect();
    const base = tb.getBoundingClientRect();
    popover.style.left = `${Math.max(0, Math.min(a.left - base.left, base.width - 260))}px`;
    popover.style.top = `${a.bottom - base.top + 6}px`;
  };

  /** 검색창 + 항목 리스트로 팝오버를 구성한다. */
  const buildList = (
    items: { text: string; hint?: string; onPick: () => void }[],
    searchable: boolean,
    placeholder = '검색…',
  ) => {
    popover.innerHTML = '';
    let search: HTMLInputElement | null = null;
    if (searchable) {
      search = document.createElement('input');
      search.type = 'text';
      search.className = 'md-pop-search';
      search.placeholder = placeholder;
      popover.appendChild(search);
    }
    const listEl = document.createElement('div');
    listEl.className = 'md-pop-list';
    popover.appendChild(listEl);

    const render = (q: string) => {
      listEl.innerHTML = '';
      const ql = q.trim().toLowerCase();
      const shown = items.filter((it) => !ql || `${it.text} ${it.hint ?? ''}`.toLowerCase().includes(ql));
      if (shown.length === 0) {
        listEl.innerHTML = '<p class="md-pop-empty">결과가 없어요.</p>';
        return;
      }
      for (const it of shown) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'md-pop-item';
        b.innerHTML = `<span>${it.text}</span>${it.hint ? `<span class="md-pop-hint">${it.hint}</span>` : ''}`;
        b.addEventListener('click', () => {
          it.onPick();
          closePopover();
        });
        listEl.appendChild(b);
      }
    };
    render('');
    if (search) {
      search.addEventListener('input', () => render(search!.value));
      setTimeout(() => search!.focus(), 0);
    }
  };

  const escapeHtml = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  const openPopover = (kind: string, anchor: HTMLElement) => {
    if (popoverAnchor === anchor) return closePopover();
    closePopover();
    popoverAnchor = anchor;
    anchor.setAttribute('aria-expanded', 'true');

    if (kind === 'callout') {
      buildList(
        CALLOUT_META.map((c) => ({
          text: c.title,
          hint: c.keyword,
          onPick: () => insertBlock(`> [!${c.keyword}]\n> 내용을 적어요.`),
        })),
        false,
      );
    } else if (kind === 'code') {
      buildList(
        CODE_LANGS.map((lang) => ({
          text: lang,
          onPick: () => insertBlock('```' + lang + '\n코드\n```'),
        })),
        true,
        '언어 검색…',
      );
    } else if (kind === 'mermaid') {
      buildList(
        MERMAID_EXAMPLES.map((m) => ({
          text: m.label,
          onPick: () => insertBlock('```mermaid\n' + m.code + '\n```'),
        })),
        false,
      );
    } else if (kind === 'emoji') {
      buildList(
        EMOJIS.map((e) => ({
          text: `${e.glyph} :${e.code}:`,
          hint: e.kw,
          onPick: () => insertBlock(`:${e.code}:`),
        })),
        true,
        '이모지 검색…',
      );
    } else if (kind === 'latex') {
      buildList(
        LATEX_SNIPPETS.map((l) => ({
          text: l.label,
          hint: l.code,
          onPick: () => insertBlock('$' + l.code + '$'),
        })),
        true,
        '수식 기호 검색…',
      );
    } else if (kind === 'wiki') {
      const posts = state.index.posts ?? [];
      if (posts.length === 0) {
        popover.innerHTML = '<p class="md-pop-empty">연결할 발행 글이 아직 없어요.</p>';
      } else {
        buildList(
          posts.map((p: any) => ({
            text: escapeHtml(p.title),
            hint: p.slug,
            onPick: () => insertBlock(`[[${p.slug}]]`),
          })),
          true,
          '글 제목·슬러그 검색…',
        );
      }
    }

    positionPopover(anchor);
    popover.hidden = false;
  };

  document.querySelector('.md-toolbar')?.addEventListener('click', (ev) => {
    const btn = (ev.target as HTMLElement).closest('button') as HTMLButtonElement | null;
    if (!btn) return;
    if (btn.id === 'toolbar-image') return $('body-image').click();
    const md = btn.dataset.md;
    if (md) {
      if (md === 'footnote') insertFootnote();
      else insertBlock(SNIPPETS[md] ?? '');
      return;
    }
    const pop = btn.dataset.pop;
    if (pop) openPopover(pop, btn);
  });

  // 팝오버 바깥 클릭·ESC로 닫기
  document.addEventListener('pointerdown', (ev) => {
    if (popover.hidden) return;
    const t = ev.target as Node;
    if (!popover.contains(t) && t !== popoverAnchor && !popoverAnchor?.contains(t)) closePopover();
  });
  document.addEventListener('keydown', (ev) => {
    if (ev.key === 'Escape' && !popover.hidden) closePopover();
  });

  // 삽입 툴바가 sticky로 '고정'되면 .stuck을 켜 떠 있는 막대 스타일로 바꾼다.
  // 센티넬(툴바 바로 위)이 헤더 라인(top:66) 위로 사라지는 순간을 IntersectionObserver로 감지.
  (() => {
    const sentinel = document.querySelector('.md-toolbar-sentinel');
    const toolbar = document.querySelector('.md-toolbar');
    if (!sentinel || !toolbar || !('IntersectionObserver' in window)) return;
    const io = new IntersectionObserver(
      ([entry]) => {
        // 센티넬이 헤더 라인 '위로' 올라가 사라졌을 때만 고정 상태(아래 폴드 밖은 제외).
        const scrolledAbove = entry.boundingClientRect.top < 67;
        toolbar.classList.toggle('stuck', !entry.isIntersecting && scrolledAbove);
      },
      { rootMargin: '-67px 0px 0px 0px', threshold: [0] },
    );
    io.observe(sentinel);
  })();

  init();
</script>

<style is:global>
  /* ==========================================================================
     /write 에디터 — JS 생성 요소(점검·제안·달력)까지 한 벌로 입히기 위해
     전부 .write-root 아래의 전역 스타일로 정의한다.
     ========================================================================== */

  /* ---------- 컨트롤 공통 ---------- */
  .write-root input[type='text'],
  .write-root input[type='password'],
  .write-root select,
  .write-root textarea {
    font: inherit;
    font-size: 0.92rem;
    color: var(--text);
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.5em 0.8em;
    transition: border-color 0.15s ease;
  }

  .write-root input[type='text']:hover,
  .write-root input[type='password']:hover,
  .write-root select:hover,
  .write-root textarea:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  }

  .write-root input:focus-visible,
  .write-root select:focus-visible,
  .write-root textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  /* 셀렉트는 OS 화살표 대신 토큰 색 셰브론 */
  .write-root .select-wrap {
    position: relative;
    display: inline-flex;
  }

  .write-root .select-wrap select {
    appearance: none;
    padding-right: 2.1em;
    cursor: pointer;
  }

  /* 기존 글 수정 드롭다운은 제목을 보여 주므로 넉넉한 폭. 단 좁은 화면에선 칸을
     뚫지 않도록 줄어들고(min-width:0), 넘치는 제목은 …로 자른다(펼치면 전체가 보인다). */
  .write-root .top-actions .select-wrap {
    flex: 0 1 20rem;
    min-width: 0;
  }

  .write-root #post-picker {
    width: 100%;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .write-root .select-wrap::after {
    content: '';
    position: absolute;
    right: 0.85em;
    top: 50%;
    width: 7px;
    height: 7px;
    transform: translateY(-70%) rotate(45deg);
    border-right: 1.6px solid var(--text-muted);
    border-bottom: 1.6px solid var(--text-muted);
    pointer-events: none;
  }

  .write-root select.mini {
    font-size: 0.82rem;
    padding: 0.3em 1.9em 0.3em 0.7em;
  }

  .write-root button {
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text);
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.5em 1em;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      color 0.15s ease,
      background-color 0.15s ease,
      transform 0.12s ease;
  }

  .write-root button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .write-root button.primary {
    background-color: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .write-root button.primary:hover {
    color: #fff;
    opacity: 0.92;
  }

  .write-root button.primary:disabled {
    opacity: 0.55;
    cursor: progress;
  }

  .write-root button.primary.big {
    font-size: 0.98rem;
    padding: 0.72em 1.8em;
    border-radius: 12px;
  }

  .write-root button.danger {
    color: light-dark(#cf222e, #e5695e);
  }

  .write-root button.danger:hover {
    border-color: light-dark(#cf222e, #e5695e);
  }

  .write-root button.linklike {
    border: 0;
    background: none;
    padding: 0;
    font-weight: 400;
    font-size: 0.85rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    color: var(--text-muted);
  }

  .write-root button.linklike:hover {
    color: var(--accent);
  }

  .write-root .muted {
    color: var(--text-muted);
    font-weight: 400;
    font-size: 0.84em;
  }

  /* ---------- 카드 ---------- */
  .write-root .card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background-color: var(--surface);
  }

  .write-root .auth-card {
    max-width: var(--width-content);
    margin-inline: auto;
    padding: 1.8rem 2rem;
  }

  .write-root .auth-card h1 {
    margin: 0 0 0.6rem;
    font-size: 1.5rem;
    font-weight: 800;
  }

  .write-root .setup-steps {
    padding-inline-start: 1.3em;
    line-height: 1.8;
  }

  .write-root .token-row {
    display: flex;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .write-root .token-row input {
    flex: 1;
  }

  .write-root .error {
    color: light-dark(#cf222e, #e5695e);
    font-size: 0.9rem;
  }

  /* ---------- 에디터 상단 ---------- */
  .write-root .editor-top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 0.4rem 1.4rem;
  }

  .write-root .editor-top h1 {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .write-root .editor-sub {
    margin: 0.25rem 0 0;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .write-root .top-actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: nowrap;
    min-width: 0;
  }

  /* 새 글·삭제는 줄어들지도 다음 줄로 떨어지지도 않는다 */
  .write-root .top-actions button {
    flex-shrink: 0;
  }

  /* ---------- 섹션 카드 ---------- */
  .write-root .section {
    padding: 1.4rem 1.6rem;
    margin-bottom: 1.1rem;
  }

  .write-root .section-title {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 700;
  }

  .write-root .section-sub {
    margin: 0.2rem 0 0;
    font-size: 0.84rem;
    color: var(--text-muted);
  }

  .write-root .section-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .write-root .section > .section-title {
    margin-bottom: 0.9rem;
  }

  /* ---------- 글 정보 폼 ---------- */
  .write-root .fm-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 1.4rem;
  }

  .write-root .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }

  .write-root .field-name {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .write-root .fm-grid .span2 {
    grid-column: span 2;
  }

  /* 초안 스위치 */
  .write-root .switch-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 38px;
  }

  .write-root .switch-hint {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .write-root input[type='checkbox'][role='switch'] {
    appearance: none;
    width: 42px;
    height: 24px;
    margin: 0;
    border-radius: 999px;
    background-color: var(--border);
    position: relative;
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color 0.15s ease;
  }

  .write-root input[type='checkbox'][role='switch']::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background-color: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 25%);
    transition: transform 0.15s ease;
  }

  .write-root input[type='checkbox'][role='switch']:checked {
    background-color: var(--accent);
  }

  .write-root input[type='checkbox'][role='switch']:checked::after {
    transform: translateX(18px);
  }

  /* 썸네일 선택 */
  .write-root .cover-row {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  .write-root .cover-thumb {
    width: 56px;
    height: 40px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--border);
  }

  /* ---------- 발행일 달력 ---------- */
  .write-root .date-field {
    position: relative;
  }

  .write-root .date-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    width: 100%;
    justify-content: flex-start;
    font-weight: 500;
    font-size: 0.92rem;
    padding: 0.5em 0.9em;
  }

  .write-root .date-trigger svg {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .write-root .date-trigger:hover {
    color: var(--text);
  }

  .write-root .date-trigger:hover svg {
    color: var(--accent);
  }

  .write-root .date-popover {
    position: absolute;
    z-index: 40;
    top: calc(100% + 6px);
    left: 0;
    width: 286px;
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 0.9rem;
    box-shadow: 0 12px 32px rgb(0 0 0 / 14%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .write-root .date-popover:not([hidden]) {
      animation: dp-pop 0.14s ease-out;
    }
  }

  @keyframes dp-pop {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.98);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  .write-root .dp-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .write-root .dp-title {
    font-weight: 700;
    font-size: 0.95rem;
  }

  .write-root .dp-nav {
    border: 0;
    background: none;
    width: 32px;
    height: 32px;
    padding: 0;
    border-radius: 8px;
    font-size: 1.05rem;
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .write-root .dp-nav:hover {
    background-color: var(--surface);
    color: var(--accent);
    border: 0;
  }

  .write-root .dp-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
  }

  .write-root .dp-dow {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-muted);
    text-align: center;
    padding-block: 0.35em;
  }

  .write-root .dp-day {
    aspect-ratio: 1;
    border: 0;
    background: none;
    border-radius: 50%;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text);
    padding: 0;
  }

  .write-root .dp-day:hover {
    background-color: var(--accent-weak);
    color: var(--accent);
    border: 0;
  }

  .write-root .dp-day.today {
    box-shadow: inset 0 0 0 1.5px var(--accent);
  }

  .write-root .dp-day.selected {
    background-color: var(--accent);
    color: #fff;
    font-weight: 700;
  }

  .write-root .dp-day.selected:hover {
    background-color: var(--accent);
    color: #fff;
  }

  .write-root .dp-foot {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.55rem;
  }

  .write-root .dp-today {
    border: 0;
    background: none;
    padding: 0.25em 0.7em;
    border-radius: 8px;
    font-size: 0.82rem;
    color: var(--accent);
  }

  .write-root .dp-today:hover {
    background-color: var(--accent-weak);
    border: 0;
  }

  /* ---------- 본문 에디터(Milkdown) ---------- */
  .write-root .body-actions {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  /* 센티넬 — 툴바 바로 위 표식(1px, 음수 마진으로 레이아웃 영향 0).
     이게 헤더 라인 위로 사라지면 툴바가 '고정'됐다고 본다(IntersectionObserver). */
  .write-root .md-toolbar-sentinel {
    height: 1px;
    margin: 0 0 -1px;
    padding: 0;
    pointer-events: none;
  }

  /* 삽입 툴바 — 모바일에선 가로 스크롤, 넓은 화면에선 줄바꿈.
     sticky로 본문을 길게 써도 화면 위에 붙어 따라온다. top은 sticky 사이트 헤더(66px) 바로 아래.
     z-index는 헤더(50)보다 낮아 헤더가 위를 덮고, 본문 에디터보다는 위에 온다.
     position:sticky도 절대배치 자식의 기준이므로 .md-popover 위치 계산은 그대로 유효하다. */
  .write-root .md-toolbar {
    position: sticky;
    top: 66px;
    z-index: 40;
    padding: 0.5rem;
    border: 1px solid var(--border);
    border-bottom: 0;
    border-radius: 12px 12px 0 0;
    background-color: var(--surface);
    transition: box-shadow 0.2s ease, background-color 0.2s ease, border-radius 0.2s ease,
      border-color 0.2s ease, margin 0.2s ease;
  }

  /* 고정됐을 때 — 떠 있는 막대처럼. 사방을 둥글게, 아래 테두리·은은한 그림자로 본문과 분리하고,
     사이트 헤더와 같은 프로스트 배경으로 결을 맞춘다. 양옆을 살짝 좁혀 '떠오른' 느낌을 준다. */
  .write-root .md-toolbar.stuck {
    border: 1px solid var(--border);
    border-radius: 12px;
    margin-inline: 0.35rem;
    background-color: color-mix(in srgb, var(--surface) 90%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    -webkit-backdrop-filter: saturate(140%) blur(8px);
    box-shadow: 0 8px 24px rgb(0 0 0 / 12%);
  }

  /* 고정 중에는 툴바 아래 에디터 윗모서리도 직각이 되지 않게(틈이 자연스럽게 보이도록) */
  .write-root .md-toolbar.stuck + .md-editor {
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
  }

  @media (prefers-reduced-motion: reduce) {
    .write-root .md-toolbar {
      transition: none;
    }
  }

  /* 버튼 행 — 모바일에선 이 안쪽만 가로 스크롤. 팝오버(.md-toolbar 직속)는 클리핑 밖에 둔다. */
  .write-root .md-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .write-root .md-toolbar button {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.35em 0.7em;
    border-radius: 8px;
    background-color: var(--bg);
    white-space: nowrap;
  }

  /* 에디터 마운트 전 — 툴바 비활성(클릭이 텍스트영역 폴백으로 새지 않게) */
  .write-root .md-toolbar.pending {
    opacity: 0.5;
    pointer-events: none;
  }

  /* 툴바가 붙으면 에디터 위 모서리는 직각으로 이어 붙인다 */
  .write-root .md-toolbar + .md-editor,
  .write-root .md-toolbar ~ .md-editor {
    border-radius: 0 0 12px 12px;
  }

  .write-root .md-popover {
    position: absolute;
    z-index: 45;
    width: 260px;
    max-width: calc(100vw - 2rem);
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 12px 32px rgb(0 0 0 / 14%);
    padding: 0.5rem;
  }

  /* 슬래시(/) 메뉴 — JS가 document.body에 fixed로 붙이므로 .write-root 밖, 전역 선택자로 둔다.
     테마 토큰(:root)은 body에 상속되어 라이트/다크 모두 따라온다. */
  .injoy-slash {
    position: fixed;
    z-index: 1000;
    min-width: 200px;
    max-width: 240px;
    max-height: 280px;
    overflow-y: auto;
    padding: 4px;
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 10px 30px rgb(0 0 0 / 16%);
    font-size: 0.92rem;
  }
  .injoy-slash[hidden] {
    display: none;
  }
  .injoy-slash-item {
    display: block;
    width: 100%;
    text-align: start;
    padding: 7px 10px;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    font: inherit;
    white-space: nowrap;
  }
  .injoy-slash-item[aria-selected='true'] {
    background-color: var(--accent-weak);
  }
  .injoy-slash-empty {
    margin: 0;
    padding: 8px 10px;
    color: var(--text-muted);
  }

  /* 인라인 서식 버블(B/I/U/S) — 슬래시 메뉴처럼 document.body에 fixed로 붙으므로 전역 선택자. */
  .injoy-bubble {
    position: fixed;
    z-index: 1000;
    display: flex;
    gap: 2px;
    padding: 3px;
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 9px;
    box-shadow: 0 8px 24px rgb(0 0 0 / 18%);
  }
  .injoy-bubble[hidden] {
    display: none;
  }
  .injoy-bubble-btn {
    min-width: 30px;
    height: 28px;
    padding: 0 7px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    font-size: 0.9rem;
    line-height: 1;
  }
  .injoy-bubble-btn:hover {
    background-color: var(--surface);
  }
  .injoy-bubble-btn[aria-pressed='true'] {
    background-color: var(--accent-weak);
    color: var(--accent);
  }
  .injoy-bubble-btn.bb-b { font-weight: 800; }
  .injoy-bubble-btn.bb-i { font-style: italic; font-family: Georgia, 'Times New Roman', serif; }
  .injoy-bubble-btn.bb-u { text-decoration: underline; }
  .injoy-bubble-btn.bb-s { text-decoration: line-through; }

  /* 이미지 + alt 입력칸 (에디터 안 nodeView). 이미지를 누르면 아래 입력칸이 펼쳐진다. */
  .write-root .injoy-img {
    display: block;
    max-width: 100%;
  }
  /* 에디터 안 미리보기 — 이미지가 어느 쪽에 놓일지 보여 준다(발행처럼 글이 감기진 않고
     위치만). 이미지를 블록으로 두고 좌우 여백으로 가운데·왼쪽·오른쪽을 잡는다. */
  .write-root .injoy-img > img {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    cursor: pointer;
  }
  .write-root .injoy-img[data-align='center'] > img {
    margin-inline: auto;
  }
  .write-root .injoy-img[data-align='left'] > img {
    margin-inline: 0 auto;
  }
  .write-root .injoy-img[data-align='right'] > img {
    margin-inline: auto 0;
  }
  .write-root .injoy-img-panel[hidden] {
    display: none;
  }
  .write-root .injoy-img-align {
    display: flex;
    align-items: center;
    gap: 0.4em;
    margin-top: 0.35rem;
    padding: 0.3rem 0.55rem;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .write-root .injoy-img-align button {
    font-size: 0.8rem;
    padding: 0.15rem 0.55rem;
    border-radius: 6px;
    border: 1px solid var(--border);
    background-color: var(--bg);
    color: var(--text-muted);
    cursor: pointer;
  }
  .write-root .injoy-img-align button.is-active {
    background-color: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .write-root .injoy-img-alt {
    display: flex;
    align-items: center;
    gap: 0.45em;
    margin-top: 0.35rem;
    padding: 0.3rem 0.55rem;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .write-root .injoy-img-alt[hidden] {
    display: none;
  }
  .write-root .injoy-img-hint {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }
  .write-root .injoy-img-alt input[type='text'] {
    flex: 1;
    min-width: 0;
    font-size: 0.85rem;
    border: 0;
    background: transparent;
    padding: 0.1rem 0;
  }
  /* 캡션 줄 — alt 줄과 같은 모습(아래 figcaption으로 발행) */
  .write-root .injoy-img-caption {
    display: flex;
    align-items: center;
    gap: 0.45em;
    margin-top: 0.35rem;
    padding: 0.3rem 0.55rem;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .write-root .injoy-img-caption input[type='text'] {
    flex: 1;
    min-width: 0;
    font-size: 0.85rem;
    border: 0;
    background: transparent;
    padding: 0.1rem 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .write-root .md-popover:not([hidden]) {
      animation: dp-pop 0.13s ease-out;
    }
  }

  .write-root .md-pop-search {
    width: 100%;
    font-size: 0.85rem;
    margin-bottom: 0.4rem;
  }

  .write-root .md-pop-list {
    max-height: 240px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .write-root .md-pop-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    width: 100%;
    text-align: left;
    border: 0;
    background: none;
    border-radius: 8px;
    padding: 0.45em 0.6em;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text);
  }

  .write-root .md-pop-item:hover {
    background-color: var(--accent-weak);
    color: var(--accent);
    border: 0;
  }

  .write-root .md-pop-hint {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    flex-shrink: 0;
  }

  .write-root .md-pop-item:hover .md-pop-hint {
    color: var(--accent);
  }

  .write-root .md-pop-empty {
    margin: 0;
    padding: 0.5rem 0.6rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .write-root .md-editor {
    border: 1px solid var(--border);
    border-radius: 12px;
    background-color: var(--bg);
    min-height: 460px;
    transition: border-color 0.15s ease;
  }

  .write-root .md-editor:focus-within {
    border-color: var(--accent);
  }

  .write-root .md-loading {
    padding: 1.2rem;
    font-size: 0.9rem;
  }

  .write-root .md-loading.error {
    color: light-dark(#cf222e, #e5695e);
  }

  /* ProseMirror 본문 — 발행된 글(.prose)과 같은 톤으로 보이게 토큰으로 조판 */
  .write-root .milkdown {
    height: 100%;
  }

  .write-root .injoy-md.ProseMirror {
    outline: none;
    padding: 1.2rem 1.4rem;
    min-height: 460px;
    font-family: var(--font-sans);
    font-size: 0.98rem;
    line-height: 1.8;
    color: var(--text);
    word-break: keep-all;
    overflow-wrap: break-word;
  }

  .write-root .injoy-md.ProseMirror > :first-child {
    margin-block-start: 0;
  }

  .write-root .injoy-md.ProseMirror :is(h1, h2, h3, h4) {
    font-weight: 700;
    line-height: 1.4;
    margin-block: 1.6em 0.6em;
  }

  .write-root .injoy-md.ProseMirror h1 { font-size: 1.6em; }
  .write-root .injoy-md.ProseMirror h2 { font-size: 1.4em; }
  .write-root .injoy-md.ProseMirror h3 { font-size: 1.18em; }
  .write-root .injoy-md.ProseMirror h4 { font-size: 1.05em; }

  .write-root .injoy-md.ProseMirror p { margin-block: 0.9em; }

  .write-root .injoy-md.ProseMirror :is(ul, ol) {
    padding-inline-start: 1.4em;
  }

  .write-root .injoy-md.ProseMirror li { margin-block: 0.3em; }

  .write-root .injoy-md.ProseMirror blockquote {
    margin-inline: 0;
    padding: 0.4em 1.1em;
    border-inline-start: 3px solid var(--accent);
    background-color: var(--surface);
    border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--text-muted);
  }

  .write-root .injoy-md.ProseMirror :not(pre) > code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background-color: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.1em 0.35em;
  }

  .write-root .injoy-md.ProseMirror pre {
    font-family: var(--font-mono);
