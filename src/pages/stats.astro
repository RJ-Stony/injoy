---
/**
 * 블로그 통계 — 이 블로그가 지금까지 얼마나 쌓였는지 숫자와 기록 격자로 보여 준다.
 * 전부 빌드타임 집계(정적 사이트 유지). 기간 통계·기록 격자는 빌드 시점(new Date()) 기준이며,
 * 글을 발행할 때마다 재빌드되므로 항상 최신에 가깝다.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, getCategories, getSeriesGroups, postStats } from '../utils/post';
import { getGraph } from '../utils/graph';

const posts = await getPublishedPosts();
const graph = await getGraph();
const categories = await getCategories();
const seriesGroups = await getSeriesGroups();

// 작성한 글자 수(한글·CJK + 영문 단어)와 읽는 시간 총합
const totalChars = posts.reduce((n, p) => {
  const s = postStats(p);
  return n + s.cjkChars + s.latinWords;
}, 0);
const totalMinutes = posts.reduce((n, p) => n + postStats(p).minutes, 0);

// 글자 수 표기 — 1만 이상이면 "약 N.N만 자", 그 아래는 "N,NNN자"
const charDisplay =
  totalChars >= 10000
    ? `약 ${(totalChars / 10000).toFixed(1)}만 자`
    : `${totalChars.toLocaleString('ko-KR')}자`;

// 읽는 시간 표기 — 60분 이상이면 "N시간 M분", 그 아래는 "N분"
const hours = Math.floor(totalMinutes / 60);
const mins = totalMinutes % 60;
const timeDisplay =
  totalMinutes >= 60 ? (mins === 0 ? `${hours}시간` : `${hours}시간 ${mins}분`) : `${totalMinutes}분`;

// 대표 지표(크게) — 방문 수는 클라이언트에서 Abacus로 채운다
const heroTiles = [
  { label: '글', value: `${posts.length.toLocaleString('ko-KR')}편` },
  { label: '글 간의 연결', value: graph.stats.edges.toLocaleString('ko-KR') },
];
// 보조 지표(작게)
const subTiles = [
  { label: '작성한 글자 수', value: charDisplay },
  { label: '읽는 시간 총합', value: timeDisplay },
  { label: '태그', value: graph.stats.tags.toLocaleString('ko-KR') },
  { label: '카테고리', value: categories.length.toLocaleString('ko-KR') },
  { label: '시리즈', value: seriesGroups.length.toLocaleString('ko-KR') },
];

// 로컬 날짜(YYYY-MM-DD) — pubDate는 UTC 자정이라 KST에서도 같은 날, 오늘도 로컬 기준으로 통일한다.
const ymd = (d: Date) => {
  const y = d.getFullYear();
  const mo = String(d.getMonth() + 1).padStart(2, '0');
  const da = String(d.getDate()).padStart(2, '0');
  return `${y}-${mo}-${da}`;
};

// 날짜별 발행 수·수정 수 — 수정은 updatedDate가 있고 pubDate와 '다른 날'일 때만 센다.
const pubByDate = new Map<string, number>();
const modByDate = new Map<string, number>();
for (const p of posts) {
  const pk = ymd(p.data.pubDate);
  pubByDate.set(pk, (pubByDate.get(pk) ?? 0) + 1);
  const u = p.data.updatedDate;
  if (u && ymd(u) !== pk) {
    const uk = ymd(u);
    modByDate.set(uk, (modByDate.get(uk) ?? 0) + 1);
  }
}

const startOfDay = (d: Date) => new Date(d.getFullYear(), d.getMonth(), d.getDate());
const today = startOfDay(new Date());
const dayMs = 86_400_000;
// 며칠 전인가 — 0=오늘. 미래(음수)는 창에서 제외한다.
const dayDiff = (d: Date) => Math.round((today.getTime() - startOfDay(d).getTime()) / dayMs);

// 기간 통계 — 최근 1/7/30/90일 각각 발행·수정 수
const windows = [
  { days: 1, label: '1일' },
  { days: 7, label: '7일' },
  { days: 30, label: '30일' },
  { days: 90, label: '90일' },
].map(({ days, label }) => {
  let pub = 0;
  let mod = 0;
  for (const p of posts) {
    const g = dayDiff(p.data.pubDate);
    if (g >= 0 && g < days) pub++;
    const u = p.data.updatedDate;
    if (u && ymd(u) !== ymd(p.data.pubDate)) {
      const gu = dayDiff(u);
      if (gu >= 0 && gu < days) mod++;
    }
  }
  return { days, label, pub, mod };
});
const defaultWindowIdx = 1; // 기본 활성 = 7일

// 기록 격자 — 오늘 기준 최근 1년(365일). 주 시작(일요일)에 맞춰 앞을 당긴다.
const gridStartRaw = startOfDay(new Date(today.getTime() - 364 * dayMs));
const gridStart = new Date(gridStartRaw);
gridStart.setDate(gridStart.getDate() - gridStart.getDay());

// 범위 내 하루 최대 활동량(발행+수정) — level 0~3 산정 기준
let maxTotal = 1;
{
  const c = new Date(gridStart);
  while (c <= today) {
    if (c >= gridStartRaw) {
      const total = (pubByDate.get(ymd(c)) ?? 0) + (modByDate.get(ymd(c)) ?? 0);
      if (total > maxTotal) maxTotal = total;
    }
    c.setDate(c.getDate() + 1);
  }
}

interface Cell {
  date: string;
  level: number;
  inRange: boolean;
  title: string;
}
const columns: { days: Cell[]; monthLabel: string | null }[] = [];
let recordCount = 0; // 지난 1년 발행+수정 합(제목 문장에 쓴다)
let lastMonth = -1;
const cursor = new Date(gridStart);
while (cursor <= today) {
  const weekMonth = cursor.getMonth();
  const days: Cell[] = [];
  for (let i = 0; i < 7 && cursor <= today; i++) {
    const key = ymd(cursor);
    const inRange = cursor >= gridStartRaw;
    const pub = inRange ? (pubByDate.get(key) ?? 0) : 0;
    const mod = inRange ? (modByDate.get(key) ?? 0) : 0;
    const total = pub + mod;
    if (inRange) recordCount += total;
    const level = total === 0 ? 0 : Math.ceil((total / maxTotal) * 3);
    let title = key;
    if (total > 0) {
      const parts = [key];
      if (pub > 0) parts.push(`발행 ${pub}`);
      if (mod > 0) parts.push(`수정 ${mod}`);
      title = parts.join(' · ');
    }
    days.push({ date: key, level, inRange, title });
    cursor.setDate(cursor.getDate() + 1);
  }
  // 그 주에 월이 바뀌면 컬럼 위에 월 라벨을 단다(GitHub식).
  const monthLabel = weekMonth !== lastMonth ? `${weekMonth + 1}월` : null;
  lastMonth = weekMonth;
  columns.push({ days, monthLabel });
}
---

<BaseLayout
  title="블로그 통계"
  description="숫자로 보는 Injoy. 글과 방문, 연결, 지난 1년의 기록이에요."
>
  <section class="stats">
    <h1>블로그 통계</h1>
    <p class="stats-sub">지금까지 이 블로그가 어떻게 쌓였는지 숫자로 정리했어요.</p>

    <!-- 대표 지표 -->
    <div class="tiles-hero">
      <div class="tile tile-hero">
        <span class="tile-value">{heroTiles[0].value}</span>
        <span class="tile-label">{heroTiles[0].label}</span>
      </div>
      <div class="tile tile-hero" id="visits-tile">
        <span class="tile-value" id="visits-value"
          ><span class="stat-skeleton" aria-hidden="true"></span></span
        >
        <span class="tile-label">전체 방문</span>
      </div>
      <div class="tile tile-hero">
        <span class="tile-value">{heroTiles[1].value}</span>
        <span class="tile-label">{heroTiles[1].label}</span>
      </div>
    </div>

    <!-- 보조 지표 -->
    <div class="tiles-sub">
      {
        subTiles.map((t) => (
          <div class="tile">
            <span class="tile-value tile-value-sm">{t.value}</span>
            <span class="tile-label">{t.label}</span>
          </div>
        ))
      }
    </div>

    <!-- 기간 통계 -->
    <h2>최근 활동</h2>
    <div class="period">
      <div class="period-chips" role="group" aria-label="기간 선택">
        {
          windows.map((w, i) => (
            <button
              type="button"
              class="gf-chip period-chip"
              data-pub={w.pub}
              data-mod={w.mod}
              aria-pressed={i === defaultWindowIdx ? 'true' : 'false'}
            >
              {w.label}
            </button>
          ))
        }
      </div>
      <p class="period-readout" id="period-readout" aria-live="polite">
        발행 {windows[defaultWindowIdx].pub}편 · 수정 {windows[defaultWindowIdx].mod}번
      </p>
    </div>

    <!-- 기록 격자 -->
    <h2>지난 1년 동안 {recordCount.toLocaleString('ko-KR')}번 기록했어요</h2>
    <div
      class="grass-scroll"
      role="img"
      aria-label={`지난 1년 동안 ${recordCount}번 기록한 날짜별 격자`}
    >
      <div class="grass-inner">
        <div class="grass-months">
          {columns.map((c) => <span class="grass-month">{c.monthLabel}</span>)}
        </div>
        <div class="grass-grid">
          {
            columns.map((c) => (
              <div class="grass-col">
                {c.days.map((d) => (
                  <span
                    class:list={['grass-cell', d.inRange ? `lv${d.level}` : 'oob']}
                    title={d.title}
                  />
                ))}
              </div>
            ))
          }
        </div>
        <div class="grass-legend">
          <span>적음</span>
          <span class="grass-cell lv0"></span>
          <span class="grass-cell lv1"></span>
          <span class="grass-cell lv2"></span>
          <span class="grass-cell lv3"></span>
          <span>많음</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // 전체 방문 수 — 통계 페이지는 절대 hit 하지 않고 get만(BaseLayout이 세션당 hit 담당).
  const visitsValue = document.getElementById('visits-value');
  const visitsTile = document.getElementById('visits-tile');
  if (visitsValue && visitsTile) {
    fetch('https://abacus.jasoncameron.dev/get/injoy-rjstony/site-visits')
      .then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
      .then((data: { value: number }) => {
        if (typeof data.value !== 'number') throw new Error('no value');
        visitsValue.textContent = data.value.toLocaleString('ko-KR');
      })
      .catch(() => {
        // 카운터 불가 시 그 타일만 조용히 숨긴다
        visitsTile.hidden = true;
      });
  }

  // 기간 칩 토글 — 표시만 교체(수치는 빌드타임에 심어 둔 data 속성).
  const readout = document.getElementById('period-readout');
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.period-chip'));
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.setAttribute('aria-pressed', c === chip ? 'true' : 'false'));
      const pub = chip.dataset.pub ?? '0';
      const mod = chip.dataset.mod ?? '0';
      if (readout) readout.textContent = `발행 ${pub}편 · 수정 ${mod}번`;
    });
  });
</script>

<style>
  .stats {
    max-width: var(--width-content);
    margin: 0 auto;
  }
  .stats h1 {
    font-size: clamp(1.7rem, 5vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 0.4rem;
  }
  .stats-sub {
    margin: 0 0 2rem;
    color: var(--text-muted);
  }

  /* 타일 공통 */
  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.2rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background-color: var(--surface);
  }
  .tile[hidden] {
    display: none;
  }
  .tile-value {
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.02em;
  }
  .tile-label {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* 대표 지표(크게) */
  .tiles-hero {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.9rem;
    margin-bottom: 0.9rem;
  }
  .tile-hero .tile-value {
    font-size: 1.9rem;
    line-height: 1.15;
  }
  /* 값이 커서 좁은 화면에선 3열이 답답하다 — 세로로 쌓는다 */
  @media (max-width: 390px) {
    .tiles-hero {
      grid-template-columns: 1fr;
    }
  }

  /* 보조 지표(작게) */
  .tiles-sub {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 0.9rem;
  }
  .tile-value-sm {
    font-size: 1.3rem;
    line-height: 1.2;
  }

  /* 응답 전 방문 수 자리표시 — ViewCount의 vc-skeleton 결을 따른다 */
  .stat-skeleton {
    display: inline-block;
    width: 2.4em;
    height: 0.9em;
    border-radius: 5px;
    background: linear-gradient(90deg, var(--border), var(--surface), var(--border));
    background-size: 200% 100%;
    animation: stat-shimmer 1.2s linear infinite;
    vertical-align: -0.02em;
  }
  @keyframes stat-shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  .stats h2 {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 2.6rem 0 0.9rem;
  }

  /* 기간 통계 */
  .period-chips {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .period-chip {
    font: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text);
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.26em 0.85em;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }
  .period-chip:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .period-chip[aria-pressed='true'] {
    color: var(--accent);
    border-color: var(--accent);
    background-color: var(--accent-weak);
  }
  .period-readout {
    margin: 0.9rem 0 0;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  /* 기록 격자 */
  .grass-scroll {
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }
  .grass-inner {
    display: inline-block;
    min-width: min-content;
  }
  .grass-months {
    display: flex;
    gap: 3px;
    margin-bottom: 4px;
  }
  .grass-month {
    flex: 0 0 13px;
    font-size: 0.7rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: visible;
  }
  .grass-grid {
    display: flex;
    gap: 3px;
  }
  .grass-col {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .grass-cell {
    width: 13px;
    height: 13px;
    border-radius: 3px;
    background-color: var(--surface);
    border: 1px solid var(--border);
    flex-shrink: 0;
  }
  .grass-cell.oob {
    opacity: 0.35;
  }
  .grass-cell.lv1 {
    background-color: color-mix(in srgb, var(--accent) 35%, var(--surface));
    border-color: transparent;
  }
  .grass-cell.lv2 {
    background-color: color-mix(in srgb, var(--accent) 65%, var(--surface));
    border-color: transparent;
  }
  .grass-cell.lv3 {
    background-color: var(--accent);
    border-color: transparent;
  }
  .grass-legend {
    display: flex;
    align-items: center;
    gap: 3px;
    margin-top: 0.6rem;
    font-size: 0.72rem;
    color: var(--text-muted);
  }
  .grass-legend .grass-cell {
    width: 11px;
    height: 11px;
  }
  .grass-legend span:first-child {
    margin-right: 0.15rem;
  }
  .grass-legend span:last-child {
    margin-left: 0.15rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .stat-skeleton {
      animation: none;
    }
    .period-chip {
      transition: none;
    }
  }
</style>
