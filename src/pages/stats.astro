---
/**
 * 블로그 통계 — 이 블로그가 지금까지 얼마나 쌓였는지 숫자와 기록 격자로 보여 준다.
 * 전부 빌드타임 집계(정적 사이트 유지). 기록 격자는 빌드 시점(new Date()) 기준이며,
 * 글을 발행할 때마다 재빌드되므로 항상 최신에 가깝다.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, getCategories, getSeriesGroups, postStats } from '../utils/post';
import { getGraph } from '../utils/graph';
import { getGitActivity } from '../utils/git-activity';

const posts = await getPublishedPosts();
const graph = await getGraph();
const categories = await getCategories();
const seriesGroups = await getSeriesGroups();

// 발행·수정 기록은 커밋 기준(글 .md의 git 히스토리)이 진짜다 — updatedDate는 글당 하나뿐이라
// 여러 번 고친 걸 못 센다. git이 없거나 실패하면(얕은 클론 등) 아래 발행일/수정일 폴백을 쓴다.
const git = getGitActivity();

// 작성한 글자 수(한글·CJK + 영문 단어)와 읽는 시간 총합
const totalChars = posts.reduce((n, p) => {
  const s = postStats(p);
  return n + s.cjkChars + s.latinWords;
}, 0);
const totalMinutes = posts.reduce((n, p) => n + postStats(p).minutes, 0);

// 글자 수 표기 — 1만 이상이면 "약 N.N만 자", 그 아래는 "N,NNN자"
const charDisplay =
  totalChars >= 10000
    ? `약 ${(totalChars / 10000).toFixed(1)}만 자`
    : `${totalChars.toLocaleString('ko-KR')}자`;

// 읽는 시간 표기 — 60분 이상이면 "N시간 M분", 그 아래는 "N분"
const hours = Math.floor(totalMinutes / 60);
const mins = totalMinutes % 60;
const timeDisplay =
  totalMinutes >= 60 ? (mins === 0 ? `${hours}시간` : `${hours}시간 ${mins}분`) : `${totalMinutes}분`;

// 수정 횟수 — 커밋 기준(git.totalMod) 우선. 폴백은 updatedDate≠pubDate인 글 수(글당 최대 1).
const fallbackModTotal = posts.reduce((n, p) => {
  const u = p.data.updatedDate;
  const y = (d: Date) => `${d.getFullYear()}-${d.getMonth()}-${d.getDate()}`;
  return n + (u && y(u) !== y(p.data.pubDate) ? 1 : 0);
}, 0);
const modTotal = git ? git.totalMod : fallbackModTotal;

// 대표 지표(크게) — 방문 수는 클라이언트에서 Abacus로 채운다
const heroTiles = [
  { label: '전체 글 수', value: `${posts.length.toLocaleString('ko-KR')}편` },
  { label: '글 간의 연결', value: graph.stats.edges.toLocaleString('ko-KR') },
];
// 인라인 스탯 — muted 라벨 먼저·<strong> 값 뒤, · 로 구분(발행 수는 hero '전체 글 수' 카드가 담당)
const inlineStats = [
  { label: '작성한 글자', value: charDisplay },
  { label: '총 읽는 시간', value: timeDisplay },
  { label: '글 수정', value: `${modTotal.toLocaleString('ko-KR')}번` },
  { label: '태그', value: `${graph.stats.tags.toLocaleString('ko-KR')}개` },
  { label: '총 카테고리', value: `${categories.length.toLocaleString('ko-KR')}개` },
  { label: '시리즈', value: `${seriesGroups.length.toLocaleString('ko-KR')}개` },
];

// 로컬 날짜(YYYY-MM-DD) — pubDate는 UTC 자정이라 KST에서도 같은 날, 오늘도 로컬 기준으로 통일한다.
const ymd = (d: Date) => {
  const y = d.getFullYear();
  const mo = String(d.getMonth() + 1).padStart(2, '0');
  const da = String(d.getDate()).padStart(2, '0');
  return `${y}-${mo}-${da}`;
};

// 날짜별 발행 수·수정 수 — 커밋 기준(git)이 있으면 그걸 쓰고, 없으면 발행일/수정일로 폴백.
let pubByDate: Map<string, number>;
let modByDate: Map<string, number>;
if (git) {
  pubByDate = git.pubByDate;
  modByDate = git.modByDate;
} else {
  pubByDate = new Map<string, number>();
  modByDate = new Map<string, number>();
  for (const p of posts) {
    const pk = ymd(p.data.pubDate);
    pubByDate.set(pk, (pubByDate.get(pk) ?? 0) + 1);
    const u = p.data.updatedDate;
    if (u && ymd(u) !== pk) {
      const uk = ymd(u);
      modByDate.set(uk, (modByDate.get(uk) ?? 0) + 1);
    }
  }
}

const startOfDay = (d: Date) => new Date(d.getFullYear(), d.getMonth(), d.getDate());
const today = startOfDay(new Date());

// 기록 격자 — 올해 고정(1/1 ~ 12/31). 1월 1일이 낀 주의 일요일부터 시작해 무스크롤로 한눈에.
const year = today.getFullYear();
const yearStart = startOfDay(new Date(year, 0, 1));
const yearEnd = startOfDay(new Date(year, 11, 31));
const gridStart = new Date(yearStart);
gridStart.setDate(gridStart.getDate() - gridStart.getDay()); // 일요일까지 앞으로 당긴다

// 하루가 올해 범위 안이고 오늘 이전(미래 아님)일 때만 실제 기록 셀
const isActive = (d: Date) => d >= yearStart && d <= yearEnd && d <= today;

// 활성 범위 하루 최대 활동량(발행+수정) — level 0~3 산정 기준
let maxTotal = 1;
{
  const c = new Date(gridStart);
  while (c <= yearEnd) {
    if (isActive(c)) {
      const total = (pubByDate.get(ymd(c)) ?? 0) + (modByDate.get(ymd(c)) ?? 0);
      if (total > maxTotal) maxTotal = total;
    }
    c.setDate(c.getDate() + 1);
  }
}

interface Cell {
  date: string;
  level: number;
  active: boolean;
  inYear: boolean; // 올해 범위 안(미래 포함) — 툴팁 대상 여부. 범위 밖 패딩 셀은 false라 무반응.
  pub: number;
  mod: number;
}
const columns: { days: Cell[]; monthLabel: string | null }[] = [];
let recordCount = 0; // 올해 발행+수정 합(제목 문장에 쓴다)
let lastMonth = -1;
const cursor = new Date(gridStart);
while (cursor <= yearEnd) {
  // 월 라벨 기준 = 그 컬럼의 올해 범위 안 첫 날짜(첫 주 작년 12월 패딩이 "12월" 라벨을 만드는 것 방지)
  const weekMonth = (cursor < yearStart ? yearStart : cursor).getMonth();
  const days: Cell[] = [];
  for (let i = 0; i < 7 && cursor <= yearEnd; i++) {
    const key = ymd(cursor);
    const inYear = cursor >= yearStart && cursor <= yearEnd;
    const active = isActive(cursor);
    const pub = active ? (pubByDate.get(key) ?? 0) : 0;
    const mod = active ? (modByDate.get(key) ?? 0) : 0;
    const total = pub + mod;
    if (active) recordCount += total;
    const level = total === 0 ? 0 : Math.ceil((total / maxTotal) * 3);
    // 활성 셀은 발행/수정 수를 담고, 올해 안 미래 셀은 날짜만(pub·mod 0), 연 범위 밖 패딩 셀은 inYear=false
    days.push({ date: key, level, active, inYear, pub, mod });
    cursor.setDate(cursor.getDate() + 1);
  }
  // 그 주에 월이 바뀌면 컬럼 최상단 슬롯에 월 라벨을 단다(GitHub식).
  const monthLabel = weekMonth !== lastMonth ? `${weekMonth + 1}월` : null;
  lastMonth = weekMonth;
  columns.push({ days, monthLabel });
}
// 모바일에서 상·하반기 2줄로 자연 래핑시킬 절반 컬럼 수
const colsHalf = Math.ceil(columns.length / 2);
---

<BaseLayout
  title="블로그 통계"
  description="숫자로 보는 Injoy. 글과 방문, 연결, 올해의 기록이에요."
>
  <section class="stats">
    <h1>블로그 통계</h1>
    <p class="stats-sub">지금까지 이 블로그가 어떻게 쌓였는지 숫자로 정리했어요.</p>

    <!-- 대표 지표 -->
    <div class="tiles-hero">
      <div class="tile tile-hero">
        <span class="tile-value">{heroTiles[0].value}</span>
        <span class="tile-label">{heroTiles[0].label}</span>
      </div>
      <div class="tile tile-hero" id="visits-tile">
        <span class="tile-value" id="visits-value"
          ><span class="stat-skeleton" aria-hidden="true"></span></span
        >
        <span class="tile-label">전체 방문자 수</span>
      </div>
      <div class="tile tile-hero">
        <span class="tile-value">{heroTiles[1].value}</span>
        <span class="tile-label">{heroTiles[1].label}</span>
      </div>
    </div>

    <!-- 인라인 스탯 — 항목 사이 · 구분은 CSS ::before(장식)로 그린다 -->
    <p class="stat-line">
      {
        inlineStats.map((s) => (
          <span class="stat-item">
            {s.label} <strong>{s.value}</strong>
          </span>
        ))
      }
    </p>

    <!-- 기록 격자 -->
    <h2>올해 {recordCount.toLocaleString('ko-KR')}번 기록했어요</h2>
    <div
      class="grass"
      role="img"
      aria-label={`올해 ${recordCount}번 기록한 날짜별 격자`}
    >
      <div class="grass-grid" style={`--cols:${columns.length};--cols-half:${colsHalf}`}>
        {
          columns.map((c) => (
            <div class="grass-col">
              <span class="grass-month">{c.monthLabel}</span>
              {c.days.map((d) => (
                <span
                  class:list={['grass-cell', d.active ? `lv${d.level}` : 'oob']}
                  data-date={d.inYear ? d.date : undefined}
                  data-pub={d.inYear ? d.pub : undefined}
                  data-mod={d.inYear ? d.mod : undefined}
                />
              ))}
            </div>
          ))
        }
      </div>
      <div class="grass-legend">
        <span>적음</span>
        <span class="grass-cell lv0"></span>
        <span class="grass-cell lv1"></span>
        <span class="grass-cell lv2"></span>
        <span class="grass-cell lv3"></span>
        <span>많음</span>
      </div>
      <!-- 미니 툴팁 — 셀 hover(데스크톱)·탭(모바일) 시 그 날짜의 발행·수정 수를 아주 작게.
           격자가 이미 aria-label로 요약을 읽어 주므로 장식 취급(aria-hidden). -->
      <div id="grass-tip" aria-hidden="true" hidden></div>
    </div>
  </section>
</BaseLayout>

<script>
  // 전체 방문 수 — 통계 페이지는 절대 hit 하지 않고 get만(BaseLayout이 세션당 hit 담당).
  const visitsValue = document.getElementById('visits-value');
  const visitsTile = document.getElementById('visits-tile');
  if (visitsValue && visitsTile) {
    fetch('https://abacus.jasoncameron.dev/get/injoy-rjstony/site-visits')
      .then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
      .then((data: { value: number }) => {
        if (typeof data.value !== 'number') throw new Error('no value');
        visitsValue.textContent = data.value.toLocaleString('ko-KR');
      })
      .catch(() => {
        // 카운터 불가 시 그 타일만 조용히 숨긴다
        visitsTile.hidden = true;
      });
  }

  // 기록 격자 미니 툴팁 — 셀의 data 속성(date/pub/mod)을 읽어 아주 작게 띄운다.
  // 데스크톱은 hover, 모바일은 탭. 위치는 컨테이너(.grass) 기준 문서 좌표로 계산해 클램프한다.
  const grass = document.querySelector<HTMLElement>('.grass');
  const grid = document.querySelector<HTMLElement>('.grass-grid');
  const tip = document.getElementById('grass-tip');
  if (grass && grid && tip) {
    // 셀 data → 툴팁 문구. 활동 있으면 "M월 D일 · 발행 n · 수정 m"(0인 쪽 생략), 없으면 "M월 D일".
    const labelFor = (cell: HTMLElement) => {
      const date = cell.dataset.date;
      if (!date) return null; // 범위 밖 패딩 셀은 무반응
      const [, mo, da] = date.split('-');
      const parts = [`${Number(mo)}월 ${Number(da)}일`];
      const pub = Number(cell.dataset.pub) || 0;
      const mod = Number(cell.dataset.mod) || 0;
      if (pub > 0) parts.push(`발행 ${pub}`);
      if (mod > 0) parts.push(`수정 ${mod}`);
      return parts.join(' · ');
    };

    // 셀 위쪽 중앙에 배치하되 컨테이너 좌우로 넘치지 않게 클램프한다.
    const showFor = (cell: HTMLElement) => {
      const text = labelFor(cell);
      if (!text) {
        hide();
        return;
      }
      tip.textContent = text;
      tip.hidden = false;
      const host = grass.getBoundingClientRect();
      const c = cell.getBoundingClientRect();
      // 문서가 아닌 .grass(position:relative) 기준 좌표
      const cellLeft = c.left - host.left;
      const cellTop = c.top - host.top;
      const tipW = tip.offsetWidth;
      const tipH = tip.offsetHeight;
      let left = cellLeft + c.width / 2 - tipW / 2;
      left = Math.max(0, Math.min(left, host.width - tipW)); // 좌우 클램프
      const top = cellTop - tipH - 6; // 셀 위쪽, 살짝 띄움
      tip.style.left = `${left}px`;
      tip.style.top = `${Math.max(0, top)}px`;
    };

    const hide = () => {
      tip.hidden = true;
    };

    // 데스크톱: 격자에 마우스 위임(mouseover). 셀 밖으로 나가면 숨김.
    grid.addEventListener('mouseover', (e) => {
      const cell = (e.target as HTMLElement).closest<HTMLElement>('.grass-cell');
      if (cell) showFor(cell);
    });
    grid.addEventListener('mouseleave', hide);

    // 모바일: 셀 탭으로 표시, 다른 곳 탭하면 숨김.
    grid.addEventListener('click', (e) => {
      const cell = (e.target as HTMLElement).closest<HTMLElement>('.grass-cell');
      if (cell && cell.dataset.date) {
        e.stopPropagation();
        showFor(cell);
      } else {
        hide();
      }
    });
    document.addEventListener('click', (e) => {
      if (!grid.contains(e.target as Node)) hide();
    });
  }
</script>

<style>
  .stats {
    max-width: var(--width-content);
    margin: 0 auto;
  }
  .stats h1 {
    font-size: clamp(1.7rem, 5vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 0.4rem;
  }
  .stats-sub {
    margin: 0 0 2rem;
    color: var(--text-muted);
  }

  /* 타일 공통 */
  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.6rem 1.4rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background-color: var(--surface);
  }
  .tile[hidden] {
    display: none;
  }
  .tile-value {
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.02em;
  }
  .tile-label {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* 대표 지표(크게) — 값·라벨 가운데 정렬, 세 카드 높이를 맞춰 정돈되게 */
  .tiles-hero {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 1.2rem;
  }
  .tile-hero {
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.35rem;
    min-height: 7.5rem;
  }
  .tile-hero .tile-value {
    font-size: 2rem;
    line-height: 1.15;
  }
  .tile-hero .tile-label {
    word-break: keep-all; /* "전체 방문자 수"가 어색하게 안 끊기게 */
    line-height: 1.35;
  }
  /* 좁은 화면: 카드 여백·값 크기를 조금 줄여 세 카드가 한 줄에 깔끔히 들어오게 */
  @media (max-width: 560px) {
    .tiles-hero {
      gap: 0.6rem;
    }
    .tile-hero {
      padding: 1.2rem 0.7rem;
      min-height: 6.5rem;
    }
    .tile-hero .tile-value {
      font-size: 1.6rem;
    }
    .tile-hero .tile-label {
      font-size: 0.8rem;
    }
  }

  /* 인라인 스탯 — 그래프 페이지 헤더 결 */
  .stat-line {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.6rem;
    font-size: 0.92rem;
    color: var(--text-muted);
  }
  .stat-item {
    white-space: nowrap;
  }
  .stat-line strong {
    color: var(--accent);
    font-weight: 800;
  }
  /* 항목 사이 · 구분(첫 항목 제외). 라벨+값이 한 덩어리로 붙어 있어 · 는 항목 사이에만 온다. */
  .stat-item + .stat-item::before {
    content: '·';
    color: var(--border);
    margin-right: 0.6rem;
  }

  /* 모바일 — 인라인 대신 2열 그리드로 정렬(라벨 왼쪽·값 오른쪽). · 구분자는 숨겨 줄 앞 대롱거림 제거 */
  @media (max-width: 560px) {
    .stat-line {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.55rem 1.1rem;
      font-size: 0.88rem;
    }
    .stat-item {
      display: flex;
      justify-content: space-between;
      gap: 0.4rem;
      white-space: normal;
    }
    .stat-item + .stat-item::before {
      content: none;
    }
  }
  @media (max-width: 360px) {
    .stat-line {
      grid-template-columns: 1fr;
    }
  }

  /* 응답 전 방문 수 자리표시 — ViewCount의 vc-skeleton 결을 따른다 */
  .stat-skeleton {
    display: inline-block;
    width: 2.4em;
    height: 0.9em;
    border-radius: 5px;
    background: linear-gradient(90deg, var(--border), var(--surface), var(--border));
    background-size: 200% 100%;
    animation: stat-shimmer 1.2s linear infinite;
    vertical-align: -0.02em;
  }
  @keyframes stat-shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  .stats h2 {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 2.6rem 0 0.9rem;
  }

  /* 기록 격자 — 올해 고정, 무스크롤 fluid 격자 */
  .grass {
    position: relative; /* 미니 툴팁을 이 컨테이너 기준으로 절대 배치 */
  }

  /* 미니 툴팁 — 그래프 페이지 #graph-tooltip 결. muted 아니라 읽히는 본문색. */
  #grass-tip {
    position: absolute;
    z-index: 20;
    padding: 0.25em 0.6em;
    border: 1px solid var(--border);
    border-radius: 7px;
    background-color: var(--bg);
    color: var(--text);
    font-size: 0.72rem;
    line-height: 1.3;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.14);
    pointer-events: none;
  }
  #grass-tip[hidden] {
    display: none;
  }

  .grass-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 2px;
  }
  .grass-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  /* 월 라벨 — 각 컬럼 최상단 슬롯(그 주에 월이 바뀔 때만). 높이 고정으로 셀 정렬을 맞춘다. */
