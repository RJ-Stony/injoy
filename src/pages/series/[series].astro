---
// 책의 목차 — 시리즈 하나가 책 한 권이고, 글은 그 책에 실린 글이다. 홈 서가에서 책을 펼치면 여기로 온다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sheet from '../../components/Sheet.astro';
import PostRows from '../../components/PostRows.astro';
import { getBooks, seriesSlug } from '../../utils/books';
import { formatDateShort } from '../../utils/post';

export async function getStaticPaths() {
  const books = await getBooks();
  return books
    .filter((b) => !b.single)
    .map((book) => ({ params: { series: seriesSlug(book.title) }, props: { book } }));
}

const { book } = Astro.props;
const n = book.chapters.length;
const from = formatDateShort(book.chapters[0].data.pubDate);
const to = formatDateShort(book.chapters[n - 1].data.pubDate);
---

<BaseLayout title={book.title} description={`${book.title}: ${n}개의 글을 묶은 책`} wide>
  <Sheet rows title={book.title} cloth={book.cloth}>
    <Fragment slot="meta">
      <p>{n}개의 글</p>
      <p>{from} ~ {to}</p>
    </Fragment>
    <div class="toc-list">
      <PostRows posts={book.chapters} numbered />
    </div>
  </Sheet>
</BaseLayout>
