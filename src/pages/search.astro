---
/**
 * 검색 — Pagefind 정적 색인 위에 올린 커스텀 검색.
 * 기본 UI(PagefindUI) 대신 Pagefind JS API(pagefind.search)로 결과를 직접 그린다.
 *  · 글당 매칭 구간(sub-result)을 3개로 자르지 않고 전부 보여 준다(기본 UI는 3개 고정).
 *  · 결과 수를 "글 N개에서 M곳"으로 — N=맞은 글 수, M=맞은 구간 합.
 *  · 더보기로 글 10개씩 이어 본다.
 * 색인은 빌드 후 dist/pagefind/에만 생기므로(npm run build) 'astro dev'에는 없다 →
 * pagefind.js 로드가 실패하면 안내 문구로 우아하게 대체한다.
 * 결과 URL은 dist 기준(/posts/..)이라 base('/injoy')를 앞에 붙여 바로잡는다.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../utils/post';
import { withBase } from '../utils/url';

// 빈 검색 상태(B6)·랜덤 글(F28)에 쓸 목록을 빌드타임에 뽑는다.
const posts = await getPublishedPosts(); // 최신순
const recentPosts = posts.slice(0, 6).map((p) => ({
  title: p.data.title,
  url: withBase(`/posts/${p.id}/`),
}));
const allPosts = posts.map((p) => ({ title: p.data.title, url: withBase(`/posts/${p.id}/`) }));
---

<BaseLayout title="검색" description="Injoy의 글을 제목과 본문에서 찾아보세요.">
  <section class="search-page">
    <h1>검색</h1>
    <p class="search-sub">글 제목과 본문에서 찾아요.</p>

    <div class="search-box">
      <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
      <input
        id="search-input"
        type="search"
        autocomplete="off"
        placeholder="검색어를 입력하세요"
        aria-label="Injoy 검색"
      />
    </div>

    {/* 검색 중에만 보이는 정렬 토글(B4)·필터 칩(B5) */}
    <div id="search-tools" class="search-tools" hidden>
      <div class="sort-toggle" role="group" aria-label="정렬">
        <button type="button" class="sort-btn is-on" data-sort="relevance" aria-pressed="true">관련도순</button>
        <button type="button" class="sort-btn" data-sort="date" aria-pressed="false">최신순</button>
      </div>
      <div id="filter-chips" class="filter-chips" aria-label="필터"></div>
    </div>

    <p id="search-count" class="search-count" role="status" aria-live="polite"></p>
    <div id="search-results" class="search-results" aria-live="polite" aria-label="검색 결과"></div>
    <button id="search-more" class="search-more" type="button" hidden>결과 더 보기</button>

    {/* 입력 전 빈 상태(B6)·랜덤 글(F28) */}
    <div id="search-empty" class="search-empty">
      <div id="recent-terms" class="empty-block" hidden>
        <div class="empty-head">
          <h2>최근 검색어</h2>
          <button type="button" id="clear-terms" class="empty-clear">지우기</button>
        </div>
        <div id="recent-terms-list" class="term-chips"></div>
      </div>
      <div class="empty-block">
        <div class="empty-head">
          <h2>최근 글</h2>
          <button type="button" id="random-post" class="empty-clear random-post">🎲 아무 글이나</button>
        </div>
        <ul class="recent-posts">
          {recentPosts.map((p) => (
            <li><a href={p.url}>{p.title}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <script type="application/json" id="all-posts" set:html={JSON.stringify(allPosts)}></script>

    <p id="search-fallback" class="search-fallback" hidden>
      검색 색인은 빌드된 사이트에서만 동작해요. 로컬에서는
      <code>npm run build &amp;&amp; npm run preview</code>로 확인하세요.
    </p>
  </section>
</BaseLayout>

<script>
  // 배포 base('/injoy/') — Astro가 빌드 때 치환한다. 색인은 base 없이 만들어져
  // 결과 url이 '/posts/..'로 오므로 base를 앞에 붙여 바로잡는다.
  const BASE = import.meta.env.BASE_URL;
  const baseNoSlash = BASE.replace(/\/$/, ''); // '/injoy'
  const fixUrl = (u: string) =>
    u && u.startsWith('/') && !u.startsWith(baseNoSlash + '/') ? baseNoSlash + u : u;

  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const countEl = document.getElementById('search-count');
  const resultsEl = document.getElementById('search-results');
  const moreBtn = document.getElementById('search-more') as HTMLButtonElement | null;
  const fallbackEl = document.getElementById('search-fallback');
  const toolsEl = document.getElementById('search-tools');
  const filterChipsEl = document.getElementById('filter-chips');
  const emptyEl = document.getElementById('search-empty');
  const recentTermsEl = document.getElementById('recent-terms');
  const recentTermsListEl = document.getElementById('recent-terms-list');

  // 정렬(B4)·필터(B5) 상태
  let sortMode: 'relevance' | 'date' = 'relevance';
  const activeFilters = new Map<string, Set<string>>(); // key → 선택된 값들
  let filtersRendered = false;

  // 최근 검색어(B6) — localStorage
  const TERMS_KEY = 'injoy-recent-searches';
  const readTerms = (): string[] => {
    try { return JSON.parse(localStorage.getItem(TERMS_KEY) || '[]'); } catch { return []; }
  };
  const saveTerm = (t: string) => {
    const terms = [t, ...readTerms().filter((x) => x !== t)].slice(0, 8);
    try { localStorage.setItem(TERMS_KEY, JSON.stringify(terms)); } catch {}
  };
  function renderRecentTerms() {
    if (!recentTermsEl || !recentTermsListEl) return;
    const terms = readTerms();
    recentTermsEl.hidden = terms.length === 0;
    recentTermsListEl.innerHTML = '';
    for (const t of terms) {
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'term-chip';
      chip.textContent = t;
      chip.addEventListener('click', () => {
        if (input) { input.value = t; input.focus(); }
        run(t);
      });
      recentTermsListEl.appendChild(chip);
    }
  }
  document.getElementById('clear-terms')?.addEventListener('click', () => {
    try { localStorage.removeItem(TERMS_KEY); } catch {}
    renderRecentTerms();
  });

  // 랜덤 글(F28)
  document.getElementById('random-post')?.addEventListener('click', () => {
    try {
      const all = JSON.parse(document.getElementById('all-posts')?.textContent || '[]') as { url: string }[];
      if (all.length) location.href = all[Math.floor(Math.random() * all.length)].url;
    } catch {}
  });

  type SubResult = { title: string; url: string; excerpt: string };
  type PageData = { url: string; meta?: { title?: string }; excerpt: string; sub_results?: SubResult[] };

  // Pagefind 모듈(런타임 전용 경로라 Vite가 번들 분석을 하지 않게 @vite-ignore).
  let pagefind: any = null;
  let loadFailed = false;
  async function ensurePagefind() {
    if (pagefind || loadFailed) return;
    try {
      // BASE_URL이 '/injoy'(끝 슬래시 없이)로 올 수 있어 슬래시를 명시해 합친다.
      pagefind = await import(/* @vite-ignore */ `${baseNoSlash}/pagefind/pagefind.js`);
      await pagefind.init();
      await renderFilters();
    } catch {
      loadFailed = true;
      if (fallbackEl) fallbackEl.hidden = false;
    }
  }

  // 필터 칩(B5) — 인덱스에 있는 카테고리·시리즈 값을 Pagefind로부터 받아 그린다.
  const FILTER_LABELS: Record<string, string> = { category: '카테고리', series: '시리즈' };
  async function renderFilters() {
    if (filtersRendered || !filterChipsEl || !pagefind) return;
    let filters: Record<string, Record<string, number>> = {};
    try { filters = await pagefind.filters(); } catch { return; }
    filterChipsEl.innerHTML = '';
    for (const key of ['category', 'series']) {
      const values = filters[key];
      if (!values || Object.keys(values).length === 0) continue;
      const group = document.createElement('div');
      group.className = 'filter-group';
      const label = document.createElement('span');
      label.className = 'filter-label';
      label.textContent = FILTER_LABELS[key] || key;
      group.appendChild(label);
      for (const val of Object.keys(values)) {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'filter-chip';
        chip.textContent = val;
        chip.setAttribute('aria-pressed', 'false');
        chip.addEventListener('click', () => {
          const set = activeFilters.get(key) ?? new Set<string>();
          if (set.has(val)) set.delete(val); else set.add(val);
          if (set.size) activeFilters.set(key, set); else activeFilters.delete(key);
          chip.setAttribute('aria-pressed', set.has(val) ? 'true' : 'false');
          chip.classList.toggle('is-on', set.has(val));
          const term = input?.value.trim();
          if (term) run(term);
        });
        group.appendChild(chip);
      }
      filterChipsEl.appendChild(group);
    }
    filtersRendered = true;
  }

  // 정렬 토글(B4)
  document.querySelectorAll<HTMLButtonElement>('.sort-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.dataset.sort as 'relevance' | 'date';
      if (mode === sortMode) return;
      sortMode = mode;
      document.querySelectorAll<HTMLButtonElement>('.sort-btn').forEach((b) => {
        const on = b === btn;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-pressed', String(on));
      });
      const term = input?.value.trim();
      if (term) run(term);
    });
  });

  // 검색용 옵션 — 관련도순은 sort 미지정, 최신순만 date desc. 필터가 있으면 함께 건다.
  function searchOptions() {
    const opts: any = {};
    if (sortMode === 'date') opts.sort = { date: 'desc' };
    if (activeFilters.size) {
      opts.filters = {};
      for (const [k, set] of activeFilters) opts.filters[k] = [...set];
    }
    return opts;
  }
  // 입력에 포커스가 오면 미리 모듈을 받아 첫 검색을 빠르게 한다.
  input?.addEventListener('focus', ensurePagefind, { once: true });

  const BATCH = 10;
  let loaded: PageData[] = []; // 이번 검색의 전체 결과 데이터
  let shown = 0; // 지금까지 렌더한 글 수

  const escapeText = (s: string) => s; // textContent로 넣으므로 별도 이스케이프 불필요

  function renderBatch() {
    if (!resultsEl) return;
    const slice = loaded.slice(shown, shown + BATCH);
    let firstNew: HTMLElement | null = null;
    for (const d of slice) {
      const card = document.createElement('article');
      card.className = 'sr-result';

      const title = document.createElement('a');
      title.className = 'sr-title';
      title.href = fixUrl(d.url);
      title.textContent = d.meta?.title || d.url;
      card.appendChild(title);

      // Pagefind는 글 머리(첫 헤딩 앞) 매칭을 '앵커 없는' sub_result로, 각 섹션 매칭을
      // '#헤딩' sub_result로 준다. 글 머리는 리드 발췌로 한 번만(페이지 발췌와 중복 방지),
      // 헤딩 섹션들은 그 아래 목록으로 분리한다. innerHTML은 Pagefind가 이스케이프하고 <mark>만 넣음(안전).
      const subs = d.sub_results ?? [];
      const intro = subs.find((s) => !s.url.includes('#'));
      const sections = subs.filter((s) => s.url.includes('#'));

      const leadHtml = intro ? intro.excerpt : sections.length ? '' : d.excerpt;
      if (leadHtml) {
        const ex = document.createElement('p');
        ex.className = 'sr-excerpt';
        ex.innerHTML = leadHtml;
        card.appendChild(ex);
      }

      if (sections.length) {
        const list = document.createElement('div');
        list.className = 'sr-subs';
        for (const sr of sections) {
          const sub = document.createElement('div');
          sub.className = 'sr-sub';
          const st = document.createElement('a');
          st.className = 'sr-sub-title';
          st.href = fixUrl(sr.url);
          st.textContent = sr.title;
          const se = document.createElement('div');
          se.className = 'sr-sub-ex';
          se.innerHTML = sr.excerpt;
          sub.append(st, se);
          list.appendChild(sub);
        }
        card.appendChild(list);
      }
      resultsEl.appendChild(card);
      if (!firstNew) firstNew = card;
    }
    shown += slice.length;
    const done = shown >= loaded.length;
    // 마지막 묶음을 부르면 더보기 버튼을 숨긴다. 그런데 방금 그 버튼을 눌러 포커스가 거기 있고,
    // 포커스 잡은 요소가 display:none이 되면 포커스가 <body>로 떨어진다 → 브라우저가 그 포커스를
    // 따라 문서 맨 위로 스크롤한다(html scroll-behavior:smooth라 위로 미끄러져 올라가 보임).
    // 그래서 숨기기 전에 포커스를 방금 뜬 첫 결과로 옮긴다(preventScroll로 스크롤은 막는다).
    if (done && moreBtn?.contains(document.activeElement) && firstNew) {
      firstNew.querySelector<HTMLElement>('.sr-title')?.focus({ preventScroll: true });
    }
    if (moreBtn) moreBtn.hidden = done;
  }

  function reset() {
    loaded = [];
    shown = 0;
    if (resultsEl) resultsEl.innerHTML = '';
    if (countEl) countEl.textContent = '';
    if (moreBtn) moreBtn.hidden = true;
    if (toolsEl) toolsEl.hidden = true;
    if (emptyEl) emptyEl.hidden = false;
    renderRecentTerms();
  }

  async function run(term: string) {
    if (!term) {
      reset();
      return;
    }
    await ensurePagefind();
    if (loadFailed || !pagefind) return;
    // 입력이 있으면 빈 상태를 감추고 정렬·필터 도구를 보인다.
    if (emptyEl) emptyEl.hidden = true;
    if (toolsEl) toolsEl.hidden = false;
    saveTerm(term);
    // 정렬(관련도 기본, 최신순 토글)·필터를 옵션으로 넘긴다.
    const search = await pagefind.debouncedSearch(term, searchOptions(), 300);
    if (search === null) return; // 더 새 입력에 밀림 — 이 결과는 버린다
    // 맞은 글 전체의 데이터를 받아 글 수(N)와 구간 합(M)을 정직하게 센다.
    // ponytail: 전수 data() 로드는 수십 편까지 가볍다. 수백 편이면 배치 지연 로드로.
    loaded = await Promise.all(search.results.map((r: any) => r.data() as Promise<PageData>));
    shown = 0;
    if (resultsEl) resultsEl.innerHTML = '';

    const n = loaded.length;
    if (n === 0) {
      if (countEl) countEl.textContent = `‘${escapeText(term)}’에 대한 결과가 없어요`;
      if (moreBtn) moreBtn.hidden = true;
      return;
    }
    const m = loaded.reduce((sum, d) => sum + (d.sub_results?.length ?? 0), 0);
    if (countEl) {
      countEl.textContent =
        m > 0 ? `‘${term}’ 결과 · 글 ${n}개에서 ${m}곳` : `‘${term}’ 결과 · 글 ${n}개`;
    }
    renderBatch();
  }

  let timer: ReturnType<typeof setTimeout>;
  input?.addEventListener('input', () => {
    const term = input.value.trim();
    clearTimeout(timer);
    // pagefind.debouncedSearch가 자체 디바운스를 하지만, 빈 입력 초기화는 즉시.
    if (!term) {
      reset();
      return;
    }
    timer = setTimeout(() => run(term), 80);
  });

  moreBtn?.addEventListener('click', renderBatch);

  // 첫 진입: 빈 상태(최근 검색어·최근 글) 준비.
  renderRecentTerms();
</script>

<style>
  .search-page {
    max-width: var(--width-content);
    margin: 0 auto;
  }

  .search-page h1 {
    font-size: clamp(1.7rem, 5vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 0.4rem;
  }

  .search-sub {
    margin: 0 0 1.6rem;
    color: var(--text-muted);
  }

  /* 검색 입력 */
  .search-box {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background-color: var(--surface);
    padding: 0.7rem 0.95rem;
    transition: border-color 0.15s ease;
  }

  .search-box:focus-within {
    border-color: var(--accent);
  }

  .search-icon {
    flex-shrink: 0;
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 2;
    stroke-linecap: round;
  }

  #search-input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 1rem;
    padding: 0;
  }

  #search-input:focus {
    outline: none;
  }

  /* 결과 수 */
  .search-count {
    margin: 0;
    padding: 1.2rem 0 0.2rem;
    color: var(--text);
    font-weight: 700;
    font-size: 1rem;
  }

  .search-count:empty {
    padding: 0;
  }

  /* 더보기 */
  .search-more {
    width: 100%;
    margin-top: 1.6rem;
    height: 46px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: transparent;
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .search-more[hidden] {
    display: none;
  }

  .search-more:hover {
    background-color: var(--surface);
    border-color: var(--accent);
  }

  /* 정렬 토글(B4)·필터 칩(B5) */
  .search-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 1rem 0 0.2rem;
  }
  .search-tools[hidden] { display: none; }

  .sort-toggle {
    display: inline-flex;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 2px;
    background: var(--surface);
  }
  .sort-btn {
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .sort-btn.is-on {
    background: var(--accent);
    color: #fff;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.7rem;
    align-items: center;
  }
  .filter-group {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }
  .filter-label {
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 600;
  }
  .filter-chip {
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    padding: 0.24rem 0.62rem;
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .filter-chip:hover { border-color: var(--accent); }
  .filter-chip.is-on {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  /* 빈 검색 상태(B6)·랜덤(F28) */
  .search-empty { padding-top: 1.4rem; }
  .search-empty[hidden] { display: none; }
  .empty-block { margin-bottom: 1.8rem; }
  .empty-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.7rem;
  }
  .empty-head h2 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
  }
  .empty-clear {
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    cursor: pointer;
    padding: 0;
  }
  .empty-clear:hover { color: var(--accent); }
  .random-post { font-weight: 600; }

  .term-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .term-chip {
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .term-chip:hover { border-color: var(--accent); }

  .recent-posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .recent-posts a {
    color: var(--text);
    text-decoration: none;
    font-size: 0.98rem;
  }
  .recent-posts a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .search-fallback {
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .search-fallback code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background-color: var(--code-bg);
    padding: 0.1em 0.4em;
    border-radius: 6px;
  }
</style>

<!-- 결과 카드는 스크립트가 만들어 붙이므로(createElement) Astro 스코프 CSS가 안 붙는다.
     전역으로 두되 검색 결과 컨테이너(.search-results)에 한정한다. 기본 Pagefind UI 모양을 따른다. -->
<style is:global>
  .search-results .sr-result {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0 1.7rem;
  }

  .search-results .sr-title {
    color: var(--text);
    font-weight: 700;
    font-size: 1.2rem;
    line-height: 1.4;
    text-decoration: none;
  }

  .search-results .sr-title:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .search-results .sr-excerpt {
    margin: 0.45rem 0 0;
    color: var(--text);
    font-size: 0.92rem;
    line-height: 1.75;
  }

  /* 글 안 구간(sub-result) — 전부 보여 준다. 기본 UI처럼 ⤷로 들여쓴다(왼쪽 선 없음) */
  .search-results .sr-subs {
    margin-top: 0.85rem;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .search-results .sr-sub-title {
    color: var(--text);
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
  }

  .search-results .sr-sub-title::before {
    content: '⤷\00a0\00a0';
    color: var(--text-muted);
  }

  .search-results .sr-sub-title:hover {
    color: var(--accent);
  }

  .search-results .sr-sub-ex {
    margin-top: 0.15rem;
    color: var(--text-muted);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  /* 검색어 강조 — Pagefind excerpt의 <mark> */
  .search-results mark {
    background-color: #fde047;
    color: #1a1b1e;
    padding: 0 0.12em;
    border-radius: 2px;
  }
</style>
