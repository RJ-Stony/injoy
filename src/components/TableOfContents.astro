---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  /** box: 본문 상단 카드형(기본) / rail: 데스크톱 사이드바 / line: 모바일 우측 세로 라인 인디케이터 */
  variant?: 'box' | 'rail' | 'line';
}

const { headings, variant = 'box' } = Astro.props;
// footnote-label은 각주 섹션이 자동 생성하는 제목이므로 목차에서 제외
const items = headings.filter(
  (h) => (h.depth === 2 || h.depth === 3) && h.slug !== 'footnote-label',
);
---

{
  items.length > 0 && (
    <nav class:list={['toc', variant]} aria-label={variant === 'line' ? '섹션 바로가기' : '목차'}>
      {variant === 'rail' && <span class="toc-marker" aria-hidden="true" />}
      {variant !== 'line' && <p class="toc-title">목차</p>}
      <ul>
        {items.map((h) => (
          <li class={`depth-${h.depth}`}>
            <a href={`#${h.slug}`}>
              <span class="toc-dot" aria-hidden="true" />
              <span class="toc-label">{h.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc {
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .toc.box {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem 1.4rem;
  }

  .toc.rail {
    position: relative;
    border-inline-start: 2px solid var(--border);
    padding-inline-start: 1.1rem;
    font-size: 0.85rem;
  }

  /* 활성 항목 위치를 따라 세로선을 미끄러지는 마커 */
  .toc-marker {
    position: absolute;
    left: -2px;
    top: 0;
    width: 2px;
    height: 0;
    border-radius: 2px;
    background-color: var(--accent);
    transition: transform 0.25s ease, height 0.25s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-marker {
      transition: none;
    }
  }

  .toc-title {
    margin: 0 0 0.5rem;
    font-weight: 700;
    color: var(--text);
  }

  .toc ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc li {
    margin: 0.25rem 0;
  }

  .toc li.depth-3 {
    padding-inline-start: 1.1rem;
  }

  .toc a {
    color: var(--text-muted);
  }

  .toc a:hover {
    color: var(--accent);
  }

  /* 스크롤 스파이 — 지금 보고 있는 섹션의 목차 항목을 포인트 색으로 강조 */
  .toc a.active {
    color: var(--accent);
    font-weight: 600;
  }

  /* 라인은 line 변형에서만 — box·rail에선 제목 텍스트만 보인다 */
  .toc-dot {
    display: none;
  }

  /* ---------- line: 우측 가장자리 고정 세로 라인 인디케이터(모바일·태블릿) ---------- */
  .toc.line {
    position: fixed;
    top: 50%;
    right: 0.3rem;
    transform: translateY(-50%);
    z-index: 40;
    /* 라인 사이 빈 공간은 클릭이 본문으로 통과하게 — 라인만 잡는다 */
    pointer-events: none;
  }

  .toc.line ul {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
    align-items: flex-end;
  }

  .toc.line li {
    margin: 0;
  }

  /* line에선 하위 섹션 들여쓰기를 무시한다(라인 길이로 위계 구분) */
  .toc.line li.depth-3 {
    padding-inline-start: 0;
  }

  .toc.line a {
    pointer-events: auto;
    position: relative;
    display: flex;
    justify-content: flex-end;
    padding: 0.14rem 0.25rem;
  }

  /* 현재/일반 섹션을 짧은 세로 라인으로. 활성은 가로로 번지지 않고(scale·ring 없음) 라인만 또렷이. */
  .toc.line .toc-dot {
    display: block;
    width: 2px;
    height: 0.95rem;
    border-radius: 2px;
    background-color: var(--border);
    transition:
      background-color 0.15s ease,
      width 0.15s ease,
      height 0.15s ease;
  }

  .toc.line li.depth-3 .toc-dot {
    height: 0.55rem;
  }

  .toc.line a:hover .toc-dot,
  .toc.line a.active .toc-dot {
    background-color: var(--accent);
  }

  .toc.line a.active .toc-dot {
    width: 3px;
    height: 1.15rem;
  }

  .toc.line li.depth-3 a.active .toc-dot {
    height: 0.75rem;
  }

  /* 제목은 평소 숨고, 라인에 호버·포커스하면 왼쪽에 칩으로 뜬다(레이아웃엔 영향 없음) */
  .toc.line .toc-label {
    position: absolute;
    right: calc(100% + 0.3rem);
    top: 50%;
    max-width: 46vw;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    background-color: var(--text);
    color: var(--bg);
    font-size: 0.76rem;
    line-height: 1.3;
    opacity: 0;
    transform: translateY(-50%) translateX(0.3rem);
    transition:
      opacity 0.12s ease,
      transform 0.12s ease;
    pointer-events: none;
  }

  .toc.line a:hover .toc-label,
  .toc.line a:focus-visible .toc-label {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  /* 와이드 화면에선 우측 sticky 레일(.toc-aside)이 있으므로 라인 인디케이터는 숨긴다 */
  @media (min-width: 1100px) {
    .toc.line {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toc.line .toc-dot,
    .toc.line .toc-label {
      transition: none;
    }
  }
</style>

<script>
  // 목차 스크롤 스파이 — 본문을 스크롤할 때 '지금 보고 있는' 섹션의 목차 항목을 강조한다.
  // box·rail 두 목차가 한 페이지에 있을 수 있어 각 nav.toc를 독립으로 초기화한다.
  function initToc(nav: HTMLElement) {
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
    const entries = links
      .map((a) => ({ a, el: document.getElementById(decodeURIComponent(a.hash.slice(1))) }))
      .filter((e): e is { a: HTMLAnchorElement; el: HTMLElement } => !!e.el);
    if (entries.length === 0) return;

    // 활성 기준선: 고정 헤더(66px) 약간 아래. 이 선을 지난 마지막 heading이 '현재'.
    const LINE = 88;
    let raf = 0;
    const update = () => {
      raf = 0;
      let active = entries[0];
      for (const e of entries) {
        if (e.el.getBoundingClientRect().top <= LINE) active = e;
        else break;
      }
      for (const { a } of entries) a.classList.toggle('active', a === active.a);
      // rail 변형: 마커를 활성 항목 위치로 (transform이라 레이아웃 영향 0)
      const marker = nav.querySelector<HTMLElement>('.toc-marker');
      if (marker) {
        const ar = active.a.getBoundingClientRect();
        const nr = nav.getBoundingClientRect();
        marker.style.height = `${ar.height}px`;
        marker.style.transform = `translateY(${ar.top - nr.top}px)`;
      }
    };
    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }

  document.querySelectorAll<HTMLElement>('nav.toc').forEach(initToc);
</script>
