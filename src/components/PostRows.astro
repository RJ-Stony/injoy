---
// 글 목록의 줄 — 책의 목차, 카테고리, 태그 화면이 함께 쓴다. 번호(또는 갈래), 제목과 설명, 날짜와 읽는 시간.
import { formatDateShort, isoDate, readingMinutes, type Post } from '../utils/post';
import { withBase } from '../utils/url';

interface Props {
  posts: Post[];
  /** 책의 목차처럼 순서가 뜻이 있을 때 번호를 붙인다. 아니면 그 자리에 카테고리를 적는다 */
  numbered?: boolean;
  /** 번호가 시작하는 수(여러 쪽으로 나뉜 목록의 뒤쪽) */
  start?: number;
}

const { posts, numbered = false, start = 1 } = Astro.props;
---

<ol class:list={['rows', { numbered }]}>
  {
    posts.map((p, i) => (
      <li class="rise" style={`--i: ${Math.min(i, 12) + 2}`}>
        <a href={withBase(`/posts/${p.id}/`)}>
          <span class="n">{numbered ? String(start + i).padStart(2, '0') : p.data.category}</span>
          <span class="tt">
            {p.data.title}
            <small>{p.data.description}</small>
          </span>
          <span class="dt">
            <time datetime={isoDate(p.data.pubDate)}>{formatDateShort(p.data.pubDate).slice(2)}</time>
            <span>{readingMinutes(p)}분</span>
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li a {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) 82px;
    gap: 1rem;
    align-items: baseline;
    padding: 1.1rem 0.5rem;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
    transition:
      background-color 0.25s,
      padding 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .numbered li a {
    grid-template-columns: 34px minmax(0, 1fr) 82px;
  }

  li a:hover,
  li a:focus-visible {
    background-color: color-mix(in srgb, var(--cloth, var(--accent-weak)) 40%, transparent);
    padding-left: 1.1rem;
  }

  .n {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .numbered .n {
    font-size: 0.88rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .tt {
    font-size: 1.12rem;
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: -0.02em;
    word-break: keep-all;
    text-wrap: balance;
  }

  .tt small {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: 0;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  /* 날짜와 읽는 시간은 폭을 고정해 줄이 바뀌지 않게 한다 */
  .dt {
    display: grid;
    gap: 0.2rem;
    justify-items: end;
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 767px) {
    li a,
    .numbered li a {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.35rem;
    }

    .dt {
      display: flex;
      gap: 0.6rem;
      justify-items: start;
    }
  }
</style>
