---
/**
 * 홈 시리즈 폴더 — 같은 시리즈의 글을 폴더 하나로 묶는다.
 * 접히면 슬림한 한 줄(이름·편수·최근 글·미니 카드더미)만, 누르면 제자리에서 '커버플로우'로 편다.
 * 가운데 글이 크게 초점, 양옆은 3D로 물러난다. 한 번에 하나만 열린다(아코디언).
 *  - 열고 닫힘은 grid-rows 높이 애니메이션이라, 다른 폴더를 열면 하나는 부드럽게 닫히고
 *    하나는 부드럽게 열린다(예전 <details> 즉시 토글이 주던 '순간이동' 위화감 제거).
 *  - 카드는 썸네일(위) + 제목·메타(아래 솔리드)로 나뉘어, 다이어그램이 제목에 안 가린다.
 *  - ‹ ›·진행 바·좌우 방향키·드래그(모바일 스와이프)로 넘긴다.
 *
 * 성능: 커버플로우는 폴더를 처음 열 때 초기화(lazy). mermaid 썸네일은 '보이는 카드'(초점 ±2)만,
 *  그 카드로 넘어올 때 한 번 그린다(공용 렌더러 큐로 직렬화). 나머지는 :empty 스켈레톤.
 * 접근성: 헤더는 aria-expanded 버튼, 본문은 region. 스크립트로 도는 부분이라 전부 이 컴포넌트 스타일.
 */
import { Image } from 'astro:assets';
import { readingMinutes, firstDiagram, type Post } from '../utils/post';
import { withBase } from '../utils/url';
import ViewCount from './ViewCount.astro';

interface Props {
  series: string;
  posts: Post[]; // 읽는 순서(오래된 글 먼저)
}
const { series, posts } = Astro.props;
const latest = posts[posts.length - 1]; // 마지막 = 가장 최근 글
const cards = posts.map((p, i) => ({
  post: p,
  n: i + 1,
  href: withBase(`/posts/${p.id}/`),
  cover: p.data.cover,
  diagram: p.data.cover ? null : firstDiagram(p),
  minutes: readingMinutes(p),
}));
---

<section class="series-folder" data-open="false">
  <button type="button" class="folder-head" aria-expanded="false">
    <svg class="folder-ic" viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M3 7.6c0-1.2 1-2.1 2.2-2.1h3.3c.5 0 1 .2 1.4.6l.9 1c.3.4.8.6 1.3.6h6.5c1.2 0 2.2 1 2.2 2.1V17c0 1.2-1 2.2-2.2 2.2H5.2C4 19.2 3 18.2 3 17V7.6Z"
      ></path>
    </svg>
    <span class="folder-name">{series}</span>
    <span class="folder-count">{posts.length}편</span>
    <span class="folder-peek">
      <span class="folder-recent">최근 · {latest.data.title}</span>
      <span class="folder-mini" aria-hidden="true"><i></i><i></i><i></i></span>
    </span>
    <svg class="folder-caret" viewBox="0 0 16 16" aria-hidden="true">
      <path d="M4 6l4 4 4-4"></path>
    </svg>
  </button>

  <div class="sf-body">
    <div class="sf-body-in">
      <div class="cf">
        <div class="cf-stage">
          <div class="cf-track" role="list">
            {
              cards.map((c) => (
                <a class="cf-card" role="listitem" href={c.href} data-n={c.n}>
                  <span class="cf-thumb">
                    {c.cover ? (
                      <Image src={c.cover} alt="" width={320} height={200} />
                    ) : c.diagram ? (
                      <span class="mermaid-diagram" data-source={c.diagram} />
                    ) : (
                      <span class="cf-ph">{c.n}</span>
                    )}
                  </span>
                  <span class="cf-cap">
                    <span class="cf-titlerow">
                      <span class="cf-idx">{c.n}</span>
                      <span class="cf-title">{c.post.data.title}</span>
                    </span>
                    <span class="cf-meta">
                      <ViewCount slug={c.post.id} increment={false} />
                      <span class="cf-time">{c.minutes}분</span>
                    </span>
                  </span>
                </a>
              ))
            }
          </div>
        </div>
        <div class="cf-nav">
          <button type="button" class="cf-arrow cf-prev" aria-label="이전 글">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
          </button>
          <span class="cf-now" aria-live="polite">1 / {posts.length}</span>
          <div class="cf-bar" aria-hidden="true"><span></span></div>
          <button type="button" class="cf-arrow cf-next" aria-label="다음 글">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { renderMermaidDiagrams } from '../scripts/mermaid-render';

  const VISIBLE = 2; // 초점 ±2 = 5장 렌더
  const HIDE_BEYOND = 3; // ±3 넘으면 완전히 감춰 성능·잔상 방지

  // 펼침(높이 애니 0.34s)이 끝난 뒤 한가할 때 실행 — 무거운 mermaid 렌더가 펼침과 겹쳐
  // 버벅이지 않게 뒤로 미룬다(그 사이엔 :empty 스켈레톤만 돈다).
  const rIC = (
    window as unknown as {
      requestIdleCallback?: (cb: () => void, o?: { timeout: number }) => void;
    }
  ).requestIdleCallback;
  const deferAfterExpand = (fn: () => void) =>
    setTimeout(() => (rIC ? rIC(fn, { timeout: 500 }) : fn()), 380);

  type CF = {
    idx: number;
    position: () => void;
    draw: () => void;
    reopen: () => void;
    drawn: Set<HTMLElement>;
  };

  function initCoverflow(root: HTMLElement): CF {
    const track = root.querySelector<HTMLElement>('.cf-track')!;
    const cards = Array.from(track.querySelectorAll<HTMLElement>('.cf-card'));
    const now = root.querySelector<HTMLElement>('.cf-now')!;
    const bar = root.querySelector<HTMLElement>('.cf-bar span')!;
    const drawn = new Set<HTMLElement>();
    const state = { idx: 0, drawn } as CF;

    // 위치·회전·카운터만(가볍다, 즉시). transform만 건드려 GPU 합성.
    const position = () => {
      cards.forEach((c, i) => {
        const off = i - state.idx;
        c.style.setProperty('--off', String(off));
        c.style.setProperty('--abs', String(Math.abs(off)));
        c.dataset.hidden = Math.abs(off) > HIDE_BEYOND ? '1' : '0';
        c.classList.toggle('is-focus', off === 0);
        c.setAttribute('tabindex', off === 0 ? '0' : '-1');
      });
      now.textContent = `${state.idx + 1} / ${cards.length}`;
      bar.style.width = `${((state.idx + 1) / cards.length) * 100}%`;
    };

    // 초점 ±2 카드의 mermaid 썸네일을 한 번만 그린다(무겁다).
    const draw = () => {
      cards.forEach((c, i) => {
        if (Math.abs(i - state.idx) > VISIBLE) return;
        const el = c.querySelector<HTMLElement>('.mermaid-diagram');
        if (el && !drawn.has(el)) {
          drawn.add(el);
          renderMermaidDiagrams([el]);
        }
      });
    };

    const go = (n: number) => {
      state.idx = Math.max(0, Math.min(cards.length - 1, n));
      position(); // 위치는 즉시
      if (rIC) rIC(draw, { timeout: 500 }); // 썸네일은 한가할 때(넘기는 동안 안 버벅이게)
      else draw();
    };

    root.querySelector('.cf-prev')!.addEventListener('click', () => go(state.idx - 1));
    root.querySelector('.cf-next')!.addEventListener('click', () => go(state.idx + 1));

    cards.forEach((c, i) =>
      c.addEventListener('click', (e) => {
        if (i !== state.idx) {
          e.preventDefault();
          go(i);
        }
      }),
    );

    // 드래그 / 스와이프 — 끌면 카드가 한 장씩 따라 넘어간다(버튼 없이도, 모바일 스와이프 포함)
    const STEP = 90; // 이만큼 끌 때마다 한 장씩
    const stage = root.querySelector<HTMLElement>('.cf-stage')!;
    let dragging = false;
    let startX = 0;
    let startIdx = 0;
    let moved = false;

    stage.addEventListener('pointerdown', (e) => {
      dragging = true;
      startX = e.clientX;
      startIdx = state.idx;
      moved = false;
      stage.setPointerCapture?.(e.pointerId);
    });
    stage.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 6) moved = true;
      const ni = Math.max(0, Math.min(cards.length - 1, startIdx + Math.round(-dx / STEP)));
      if (ni !== state.idx) {
        state.idx = ni;
        position(); // 끄는 동안엔 위치만(가볍다). 썸네일은 놓을 때 그린다
      }
    });
    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      if (rIC) rIC(draw, { timeout: 500 });
      else draw();
    };
    stage.addEventListener('pointerup', endDrag);
    stage.addEventListener('pointercancel', endDrag);
    // 끌어서 넘긴 직후의 클릭(카드 링크 이동)은 취소한다
    stage.addEventListener(
      'click',
      (e) => {
        if (moved) {
          e.preventDefault();
          e.stopPropagation();
          moved = false;
        }
      },
      true,
    );

    state.position = position;
    state.draw = draw;
    // 다시 열릴 때도 위치는 즉시, 썸네일은 펼침이 끝난 뒤
    state.reopen = () => {
      position();
      deferAfterExpand(draw);
    };

    // 첫 열림: 위치는 즉시(펼침과 함께), 무거운 썸네일은 펼침이 끝난 뒤
    position();
    deferAfterExpand(draw);
    return state;
  }

  // 폴더 배선 — 아코디언(하나만, 부드러운 높이) + lazy 커버플로우 + 테마 재렌더
  const folders = Array.from(document.querySelectorAll<HTMLElement>('.series-folder'));
  const cfs = new WeakMap<HTMLElement, CF>();

  const setOpen = (f: HTMLElement, open: boolean) => {
    f.dataset.open = String(open);
    f.querySelector('.folder-head')!.setAttribute('aria-expanded', String(open));
    if (open) {
      if (!cfs.has(f)) {
        const cf = f.querySelector<HTMLElement>('.cf');
        if (cf) cfs.set(f, initCoverflow(cf));
      } else {
        cfs.get(f)!.reopen();
      }
    }
  };

  for (const f of folders) {
    f.querySelector('.folder-head')!.addEventListener('click', () => {
      const willOpen = f.dataset.open !== 'true';
      // 아코디언: 여는 순간, 열려 있던 다른 폴더는 부드럽게 닫는다(둘 다 높이 트랜지션이라 동시에 진행)
      if (willOpen) for (const o of folders) if (o !== f && o.dataset.open === 'true') setOpen(o, false);
      setOpen(f, willOpen);
    });
  }

  const rerender = () => {
    for (const f of folders) {
      const cf = cfs.get(f);
      if (cf && cf.drawn.size > 0) renderMermaidDiagrams(Array.from(cf.drawn));
    }
  };
  window.addEventListener('injoy:theme-change', rerender);
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', rerender);
</script>

<style>
  .series-folder {
    margin-bottom: 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background-color: var(--surface);
    overflow: hidden;
    transition:
      border-color 0.2s ease,
      box-shadow 0.25s ease;
  }

  .series-folder[data-open='true'] {
    border-color: color-mix(in srgb, var(--accent) 30%, var(--border));
    box-shadow: 0 8px 24px rgb(0 0 0 / 10%);
  }

  .folder-head {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.1rem;
    cursor: pointer;
    border: 0;
    background: transparent;
    color: inherit;
    font-family: inherit;
    text-align: left;
    transition: background-color 0.18s ease;
    -webkit-tap-highlight-color: transparent;
  }

  /* 프레스 효과는 심플하게 — 전역 button:active의 scale(0.96)(행 전체가 쪼그라들어 과함)을 끄고,
     은은한 배경 틴트만 부드럽게 준다. */
  .folder-head:active {
    transform: none;
    background-color: color-mix(in srgb, var(--accent) 7%, transparent);
  }

  .folder-ic {
    flex-shrink: 0;
    width: 1.3rem;
    height: 1.3rem;
    fill: var(--accent-weak);
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .folder-name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--text);
  }

  .folder-count {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .folder-peek {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
  }

  .folder-recent {
    font-size: 0.82rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 15rem;
  }

  /* 접힘 상태의 '미니 카드더미' — 안에 묶음이 있다는 정체성 */
  .folder-mini {
    position: relative;
    width: 2.3rem;
    height: 1.4rem;
    flex-shrink: 0;
  }
  .folder-mini i {
    position: absolute;
    width: 1rem;
    height: 1.4rem;
    border-radius: 3px;
    background-color: var(--bg);
    border: 1px solid var(--border);
  }
  .folder-mini i:nth-child(1) {
    left: 0;
    transform: rotate(-9deg);
  }
  .folder-mini i:nth-child(2) {
    left: 0.5rem;
    z-index: 1;
  }
  .folder-mini i:nth-child(3) {
    left: 1rem;
    transform: rotate(9deg);
  }

  .folder-caret {
    flex-shrink: 0;
    margin-left: 0.6rem;
    width: 0.85rem;
    height: 0.85rem;
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      transform 0.28s ease,
      stroke 0.15s ease;
  }

  .series-folder[data-open='true'] .folder-peek {
    display: none;
  }
  .series-folder[data-open='true'] .folder-caret {
    margin-left: auto;
    transform: rotate(180deg);
  }
  .folder-head:hover .folder-caret {
    stroke: var(--accent);
  }

  /* 부드러운 열고 닫힘 — grid-rows 0fr↔1fr (높이를 애니메이션해 아코디언 전환이 매끄럽다) */
  .sf-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.34s ease;
  }
  .series-folder[data-open='true'] .sf-body {
    grid-template-rows: 1fr;
  }
  .sf-body-in {
    overflow: hidden;
  }

  /* ===== 커버플로우 ===== */
  .cf {
    padding: 0.4rem 1.1rem 1rem;
  }

  .cf-stage {
    position: relative;
    height: 13.8rem;
    perspective: 1150px;
    overflow: hidden;
    cursor: grab;
    touch-action: pan-y; /* 가로 드래그는 커버플로우가, 세로는 페이지 스크롤이 갖게 한다(모바일) */
  }

  .cf-stage:active {
    cursor: grabbing;
  }

  .cf-track {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  .cf-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10rem;
    height: 12.8rem;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    background-color: var(--bg);
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    will-change: transform;
    /* --off(초점 기준 거리), --abs(절댓값)로 위치·회전·깊이·투명도(transform만 = GPU) */
    transform: translate(-50%, -50%)
      translateX(calc(var(--off, 0) * 8.6rem))
      translateZ(calc(var(--abs, 0) * -175px))
      rotateY(calc(var(--off, 0) * -33deg))
      scale(calc(1 - var(--abs, 0) * 0.055));
    opacity: calc(1 - var(--abs, 0) * 0.3);
    z-index: calc(50 - var(--abs, 0));
    filter: brightness(calc(1 - var(--abs, 0) * 0.13));
    transition:
      transform 0.45s cubic-bezier(0.3, 0.7, 0.3, 1),
      opacity 0.45s ease,
      filter 0.45s ease;
  }

  .cf-card[data-hidden='1'] {
    opacity: 0;
    pointer-events: none;
  }

  .cf-card.is-focus {
    box-shadow: 0 10px 28px rgb(0 0 0 / 18%);
  }

  /* 썸네일 — 카드 위쪽. 제목이 위에 겹치지 않아 LR 다이어그램도 안 가린다 */
  .cf-thumb {
    position: relative;
    height: 7rem;
    flex-shrink: 0;
    background-color: var(--surface);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    line-height: 0;
  }

  .cf-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cf-thumb .mermaid-diagram {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem;
    line-height: normal;
  }

  .cf-thumb .mermaid-diagram svg {
    max-width: 100%;
    max-height: 100%;
    height: auto;
    display: block;
  }

  /* 렌더 전 스켈레톤 — 초점으로 넘어와 그려지면 :empty가 풀려 저절로 사라진다(순수 CSS) */
  .cf-thumb .mermaid-diagram:empty {
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, var(--border), var(--surface), var(--border));
    background-size: 200% 100%;
    animation: cf-shimmer 1.2s linear infinite;
  }

  @keyframes cf-shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  .cf-ph {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--accent);
    opacity: 0.3;
    font-variant-numeric: tabular-nums;
  }

  /* 제목·메타 — 카드 아래쪽 솔리드 영역(썸네일과 분리, 겹침 없음) */
  .cf-cap {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.5rem 0.6rem 0.55rem;
    background-color: var(--bg);
    border-top: 1px solid var(--border);
  }

  /* 번호를 제목 앞에 두는 행(썸네일 위에 떠 있던 배지 대신, 제목과 함께 적절히 자리 잡는다) */
  .cf-titlerow {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .cf-idx {
    flex-shrink: 0;
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .cf-title {
    flex: 1;
    min-width: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.81rem;
    font-weight: 650;
    line-height: 1.3;
    color: var(--text);
  }

  /* 초점 카드는 제목을 더 넉넉히 보여 준다(데스크톱은 폭이 좁아 2줄로 잘리던 걸 3줄까지) */
  .cf-card.is-focus .cf-title {
    color: var(--accent);
    -webkit-line-clamp: 3;
  }

  .cf-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
  }

  .cf-meta :global(.meta-stat) {
    margin-left: 0;
    font-size: 0.7rem;
  }

  .cf-time {
    font-size: 0.7rem;
    color: var(--text-muted);
