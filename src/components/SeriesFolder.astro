---
/**
 * 홈 시리즈 폴더 — 같은 시리즈의 글을 폴더 하나로 묶는다.
 * 기본 닫힘(<details>). 폴더를 누르면 제자리에서 글들이 폴더 안에 파일처럼 펼쳐진다.
 * 펼치면 시리즈의 모든 글이 읽는 순서(오래된 글 먼저)로, 읽는 시간·조회수와 함께 보인다.
 */
import { readingMinutes, type Post } from '../utils/post';
import { withBase } from '../utils/url';
import ViewCount from './ViewCount.astro';

interface Props {
  series: string;
  posts: Post[]; // 읽는 순서(오래된 글 먼저)
}
const { series, posts } = Astro.props;
const latest = posts[posts.length - 1]; // 마지막 = 가장 최근 글
---

<details class="series-folder">
  <summary class="folder-head">
    <svg class="folder-ic" viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M3 7.6c0-1.2 1-2.1 2.2-2.1h3.3c.5 0 1 .2 1.4.6l.9 1c.3.4.8.6 1.3.6h6.5c1.2 0 2.2 1 2.2 2.1V17c0 1.2-1 2.2-2.2 2.2H5.2C4 19.2 3 18.2 3 17V7.6Z"
      ></path>
    </svg>
    <span class="folder-name">{series}</span>
    <span class="folder-count">{posts.length}편</span>
    <span class="folder-recent">최근 · {latest.data.title}</span>
    <svg class="folder-caret" viewBox="0 0 16 16" aria-hidden="true">
      <path d="M4 6l4 4 4-4"></path>
    </svg>
  </summary>
  <ol class="folder-list">
    {
      posts.map((p, i) => (
        <li class="folder-file">
          <a href={withBase(`/posts/${p.id}/`)}>
            <svg class="file-ic" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 3h8l4 4v14a0 0 0 0 1 0 0H6a0 0 0 0 1 0 0V3Z" />
              <path d="M14 3v4h4" />
            </svg>
            <span class="file-num">{i + 1}</span>
            <span class="file-title">{p.data.title}</span>
            <span class="file-meta">
              <ViewCount slug={p.id} increment={false} />
              <span class="file-time">{readingMinutes(p)}분</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</details>

<style>
  .series-folder {
    margin-bottom: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background-color: var(--surface);
  }

  .folder-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.1rem;
    cursor: pointer;
    list-style: none;
  }

  .folder-head::-webkit-details-marker {
    display: none;
  }

  /* 채운 폴더 — accent로 또렷하게 */
  .folder-ic {
    flex-shrink: 0;
    width: 1.3rem;
    height: 1.3rem;
    fill: var(--accent-weak);
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .folder-name {
    font-weight: 700;
    color: var(--text);
  }

  .folder-count {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* 닫혔을 때만 보이는 최근 글 미리보기 — 캐럿을 오른쪽으로 민다 */
  .folder-recent {
    margin-left: auto;
    font-size: 0.82rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 16rem;
  }

  .series-folder[open] .folder-recent {
    display: none;
  }

  /* 캐럿은 펼침·접힘 모두 맨 오른쪽 고정. 닫힘=최근 미리보기 뒤(0.6rem),
     펼침=최근이 사라지므로 캐럿이 auto로 직접 오른쪽을 잡는다. viewBox 중앙 셰브론이라 회전해도 대칭. */
  .folder-caret {
    flex-shrink: 0;
    margin-left: 0.6rem;
    width: 0.85rem;
    height: 0.85rem;
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      transform 0.2s ease,
      stroke 0.15s ease;
  }

  .series-folder[open] .folder-caret {
    margin-left: auto;
    transform: rotate(180deg);
  }

  .folder-head:hover .folder-caret {
    stroke: var(--accent);
  }

  /* 폴더 안 파일 목록 — 왼쪽 세로선으로 '안에 들어있는' 느낌 */
  .folder-list {
    list-style: none;
    margin: 0 0.8rem 0.5rem 1.5rem;
    padding: 0.2rem 0 0.2rem 0.7rem;
    border-left: 2px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .folder-file a {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.5rem;
    border-radius: 8px;
    color: var(--text-muted);
    text-decoration: none;
    line-height: 1.5;
  }

  .folder-file a:hover {
    background-color: var(--accent-weak);
    color: var(--accent);
    text-decoration: none;
  }

  .file-ic {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linejoin: round;
    opacity: 0.7;
  }

  .file-num {
    flex-shrink: 0;
    width: 1.1rem;
    text-align: right;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }

  .file-title {
    flex: 1;
    min-width: 0;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .folder-file a:hover .file-title {
    color: var(--accent);
  }

  /* 오른쪽: 조회수 + 읽는 시간 */
  .file-meta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .file-meta :global(.meta-stat) {
    margin-left: 0;
    font-size: 0.78rem;
  }

  .file-time {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 480px) {
    .folder-recent {
      display: none;
    }
    .folder-caret {
      margin-left: auto;
    }
  }
</style>
