---
/**
 * 홈 시리즈 폴더 — 같은 시리즈의 글을 폴더 하나로 묶는다.
 * 기본 닫힘(<details>). 폴더를 누르면 제자리에서 글들이 가로로 넘기는 카드로 펼쳐진다.
 * 각 카드는 썸네일(커버 > 본문 첫 다이어그램 > 번호 플레이스홀더) + 번호 + 제목 + 조회수.
 * 모바일은 손가락 스와이프, 데스크톱은 트랙패드·스크롤로 넘긴다.
 */
import { Image } from 'astro:assets';
import { readingMinutes, firstDiagram, type Post } from '../utils/post';
import { withBase } from '../utils/url';
import ViewCount from './ViewCount.astro';

interface Props {
  series: string;
  posts: Post[]; // 읽는 순서(오래된 글 먼저)
}
const { series, posts } = Astro.props;
const latest = posts[posts.length - 1]; // 마지막 = 가장 최근 글
const cards = posts.map((p, i) => ({
  post: p,
  n: i + 1,
  href: withBase(`/posts/${p.id}/`),
  cover: p.data.cover,
  diagram: p.data.cover ? null : firstDiagram(p),
  minutes: readingMinutes(p),
}));
---

<details class="series-folder">
  <summary class="folder-head">
    <svg class="folder-ic" viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M3 7.6c0-1.2 1-2.1 2.2-2.1h3.3c.5 0 1 .2 1.4.6l.9 1c.3.4.8.6 1.3.6h6.5c1.2 0 2.2 1 2.2 2.1V17c0 1.2-1 2.2-2.2 2.2H5.2C4 19.2 3 18.2 3 17V7.6Z"
      ></path>
    </svg>
    <span class="folder-name">{series}</span>
    <span class="folder-count">{posts.length}편</span>
    <span class="folder-recent">최근 · {latest.data.title}</span>
    <svg class="folder-caret" viewBox="0 0 16 16" aria-hidden="true">
      <path d="M4 6l4 4 4-4"></path>
    </svg>
  </summary>

  <div class="folder-track" role="list">
    {
      cards.map((c) => (
        <a class="s-card" role="listitem" href={c.href}>
          <span class="s-thumb">
            {c.cover ? (
              <Image src={c.cover} alt="" width={300} height={169} />
            ) : c.diagram ? (
              <span class="mermaid-diagram" data-source={c.diagram} />
            ) : (
              <span class="s-thumb-ph">{c.n}</span>
            )}
          </span>
          <span class="s-meta">
            <span class="s-num">{c.n}</span>
            <span class="s-title">{c.post.data.title}</span>
          </span>
          <span class="s-foot">
            <ViewCount slug={c.post.id} increment={false} />
            <span class="s-time">{c.minutes}분</span>
          </span>
        </a>
      ))
    }
  </div>
</details>

<script>
  // 캐러셀 카드의 mermaid 썸네일 — 화면(폴더)이 열려 보일 때만 렌더한다.
  // 공용 렌더러는 내부 큐로 직렬화되어 홈의 일반 카드 썸네일과 동시에 그려도 안전하다.
  import { renderMermaidDiagrams } from '../scripts/mermaid-render';
  import { SMOOTH_DURATION } from '../scripts/smooth-details';

  // 폴더를 펴면 펼침 애니메이션(SMOOTH_DURATION)과 mermaid 모듈 로드·SVG 렌더가
  // 메인스레드를 다퉈 버벅인다. 렌더를 펼침이 끝난 뒤(SMOOTH_DURATION)로 미루고, 그 뒤 한가할 때
  // 그린다 — 펼치는 동안엔 스켈레톤만 돌아 화면이 끊기지 않는다(idle이 일찍 와도 펼침 중엔 안 그림).
  const ric = (window as Window & { requestIdleCallback?: (cb: () => void, o?: { timeout: number }) => void }).requestIdleCallback;
  const deferAfterExpand = (fn: () => void) =>
    setTimeout(() => (ric ? ric(fn, { timeout: 500 }) : fn()), SMOOTH_DURATION + 80);

  const diagrams = Array.from(
    document.querySelectorAll<HTMLElement>('.series-folder .folder-track .mermaid-diagram'),
  );
  if (diagrams.length > 0) {
    const drawn: HTMLElement[] = [];
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement;
            drawn.push(el);
            obs.unobserve(el);
            deferAfterExpand(() => renderMermaidDiagrams([el]));
          }
        },
        { rootMargin: '200px' },
      );
      diagrams.forEach((d) => io.observe(d));
    } else {
      drawn.push(...diagrams);
      renderMermaidDiagrams(diagrams);
    }
    // 라이트/다크 전환 시 이미 그린 썸네일을 다시 그린다(글 카드와 같은 패턴).
    const rerender = () => {
      if (drawn.length > 0) renderMermaidDiagrams(drawn);
    };
    window.addEventListener('injoy:theme-change', rerender);
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', rerender);
  }
</script>

<style>
  .series-folder {
    margin-bottom: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background-color: var(--surface);
  }

  .folder-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.1rem;
    cursor: pointer;
    list-style: none;
  }

  .folder-head::-webkit-details-marker {
    display: none;
  }

  .folder-ic {
    flex-shrink: 0;
    width: 1.3rem;
    height: 1.3rem;
    fill: var(--accent-weak);
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .folder-name {
    font-weight: 700;
    color: var(--text);
  }

  .folder-count {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .folder-recent {
    margin-left: auto;
    font-size: 0.82rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 16rem;
  }

  .series-folder[open] .folder-recent {
    display: none;
  }

  .folder-caret {
    flex-shrink: 0;
    margin-left: 0.6rem;
    width: 0.85rem;
    height: 0.85rem;
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      transform 0.2s ease,
      stroke 0.15s ease;
  }

  .series-folder[open] .folder-caret {
    margin-left: auto;
    transform: rotate(180deg);
  }

  .folder-head:hover .folder-caret {
    stroke: var(--accent);
  }

  /* 가로로 넘기는 카드 트랙 */
  .folder-track {
    display: flex;
    gap: 0.7rem;
    margin: 0;
    padding: 0.2rem 1.1rem 1.05rem;
    overflow-x: auto;
    /* scroll-snap-align:start가 첫 카드를 스크롤포트 시작에 붙여 좌측 패딩(1.1rem)을 먹어 버린다.
       스냅 기준을 패딩만큼 안으로 밀어 첫 카드도 오른쪽 끝과 같은 여백을 갖게 한다. */
    scroll-padding-inline: 1.1rem;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .folder-track::-webkit-scrollbar {
    height: 6px;
  }
  .folder-track::-webkit-scrollbar-thumb {
    background-color: var(--border);
    border-radius: 999px;
  }

  .s-card {
    flex: 0 0 9.5rem;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 10px;
    background-color: var(--bg);
    overflow: hidden;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .s-card:hover {
    border-color: var(--accent);
    text-decoration: none;
    transform: translateY(-2px);
  }

  .s-thumb {
    height: 5.3rem;
    background-color: var(--surface);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    line-height: 0;
  }

  .s-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .s-thumb .mermaid-diagram {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.3rem;
    line-height: normal;
  }

  /* 렌더 전 스켈레톤 — 다이어그램은 idle에 미뤄 그리므로(아래 script), 그 사이 빈 칸 대신
     잔잔히 반짝이는 자리표시를 보인다. svg가 채워지면 :empty가 풀려 저절로 사라진다(순수 CSS). */
  .s-thumb .mermaid-diagram:empty {
    background: linear-gradient(90deg, var(--border), var(--surface), var(--border));
    background-size: 200% 100%;
    animation: s-thumb-shimmer 1.2s linear infinite;
  }

  @keyframes s-thumb-shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .s-thumb .mermaid-diagram:empty {
      animation: none;
    }
  }

  .s-thumb .mermaid-diagram svg {
    max-width: 100%;
    max-height: 100%;
    height: auto;
    display: block;
  }

  .s-thumb-ph {
    font-size: 1.7rem;
    font-weight: 800;
    color: var(--accent);
    opacity: 0.35;
    font-variant-numeric: tabular-nums;
  }

  .s-meta {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.55rem 0.6rem 0.25rem;
  }

  .s-num {
    flex-shrink: 0;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .s-title {
    font-size: 0.85rem;
    line-height: 1.35;
    color: var(--text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .s-card:hover .s-title {
    color: var(--accent);
  }

  .s-foot {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding: 0 0.65rem 0.6rem;
  }

  .s-foot :global(.meta-stat) {
    margin-left: 0;
    font-size: 0.72rem;
  }

  .s-time {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 480px) {
    .folder-recent {
      display: none;
    }
    .folder-caret {
      margin-left: auto;
    }
    .s-card {
      flex-basis: 8.5rem;
    }
  }
</style>
