---
import { Image } from 'astro:assets';
import PostMeta from './PostMeta.astro';
import { readingMinutes, type Post } from '../utils/post';
import { withBase } from '../utils/url';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const href = withBase(`/posts/${post.id}/`);
const cover = post.data.cover;
---

<article class="post-card">
  <div class="text">
    <PostMeta category={post.data.category} pubDate={post.data.pubDate} minutes={readingMinutes(post)} />
    <h2 class="title">
      <a href={href}>{post.data.title}</a>
    </h2>
    <p class="description">{post.data.description}</p>
  </div>
  {
    cover && (
      <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
        <Image src={cover} alt="" width={320} />
      </a>
    )
  }
</article>

<style>
  .post-card {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .post-card:last-of-type {
    border-bottom: 0;
  }

  .text {
    flex: 1;
    min-width: 0;
  }

  .thumb {
    flex-shrink: 0;
    border-radius: 10px;
    overflow: hidden;
    line-height: 0;
  }

  .thumb img {
    width: 128px;
    height: 88px;
    object-fit: cover;
    transition: transform 0.2s ease;
  }

  .post-card:hover .thumb img {
    transform: scale(1.03);
  }

  @media (max-width: 480px) {
    .thumb img {
      width: 96px;
      height: 72px;
    }
  }

  .title {
    margin: 0.6rem 0 0.4rem;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.45;
  }

  .title a {
    color: var(--text);
    transition: color 0.15s ease;
  }

  .title a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .description {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.975rem;
    line-height: 1.7;
  }
</style>
