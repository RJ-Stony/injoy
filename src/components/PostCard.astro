---
import { Image } from 'astro:assets';
import PostMeta from './PostMeta.astro';
import { readingMinutes, type Post } from '../utils/post';
import { withBase } from '../utils/url';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const href = withBase(`/posts/${post.id}/`);
const cover = post.data.cover;
---

<article class="post-card">
  <div class="text">
    <PostMeta category={post.data.category} pubDate={post.data.pubDate} minutes={readingMinutes(post)} />
    <h2 class="title">
      <a href={href}>{post.data.title}</a>
    </h2>
    <p class="description">{post.data.description}</p>
  </div>
  {
    cover && (
      <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
        <Image src={cover} alt="" width={360} height={203} />
      </a>
    )
  }
</article>

<style>
  .post-card {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .post-card:last-of-type {
    border-bottom: 0;
  }

  .text {
    flex: 1;
    min-width: 0;
  }

  .thumb {
    flex-shrink: 0;
    border-radius: 10px;
    overflow: hidden;
    line-height: 0;
  }

  .thumb img {
    /* 커버는 16:9 — 같은 비율로 보여 양옆이 잘리지 않게 한다 */
    width: 160px;
    aspect-ratio: 16 / 9;
    height: auto;
    object-fit: cover;
    transition: transform 0.2s ease;
  }

  .post-card:hover .thumb img {
    transform: scale(1.03);
  }

  /* 좁은 화면: 세로로 쌓되 본문(메타·제목·요약)을 먼저, 커버는 그 아래 전체 폭으로 둔다.
     커버 없는 카드는 .thumb가 없어 영향이 없다(메타는 그대로 한 줄). */
  @media (max-width: 480px) {
    .post-card {
      flex-direction: column;
      align-items: stretch;
      gap: 0.9rem;
    }

    .thumb img {
      width: 100%;
    }
  }

  .title {
    margin: 0.6rem 0 0.4rem;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.45;
  }

  .title a {
    color: var(--text);
    transition: color 0.15s ease;
  }

  .title a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .description {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.975rem;
    line-height: 1.7;
  }
</style>
