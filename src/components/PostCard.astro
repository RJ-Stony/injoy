---
import { Image } from 'astro:assets';
import PostMeta from './PostMeta.astro';
import { readingMinutes, firstDiagram, type Post } from '../utils/post';
import { withBase } from '../utils/url';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const href = withBase(`/posts/${post.id}/`);
const cover = post.data.cover;
// 커버가 없으면 본문 첫 다이어그램(mermaid)을 카드 썸네일로 그린다(둘 다 없으면 썸네일 없음).
const diagram = cover ? null : firstDiagram(post);
---

<article class="post-card">
  <div class="text">
    <PostMeta category={post.data.category} pubDate={post.data.pubDate} minutes={readingMinutes(post)} />
    <h2 class="title">
      <a href={href}>{post.data.title}</a>
    </h2>
    <p class="description">{post.data.description}</p>
  </div>
  {
    cover ? (
      <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
        <Image src={cover} alt="" width={360} height={203} />
      </a>
    ) : diagram ? (
      <a class="thumb thumb-mermaid" href={href} tabindex="-1" aria-hidden="true">
        <div class="mermaid-diagram" data-source={diagram}></div>
      </a>
    ) : null
  }
</article>

<style>
  .post-card {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .post-card:last-of-type {
    border-bottom: 0;
  }

  .text {
    flex: 1;
    min-width: 0;
  }

  .thumb {
    flex-shrink: 0;
    border-radius: 10px;
    overflow: hidden;
    line-height: 0;
  }

  .thumb img {
    /* 커버는 16:9 — 같은 비율로 보여 양옆이 잘리지 않게 한다 */
    width: 160px;
    aspect-ratio: 16 / 9;
    height: auto;
    object-fit: cover;
    transition: transform 0.2s ease;
  }

  .post-card:hover .thumb img {
    transform: scale(1.03);
  }

  /* 커버 없는 글의 썸네일 — 본문 첫 mermaid 다이어그램을 박스에 맞춰 그린다(클라이언트 렌더).
     박스는 커버와 같은 160px·16:9로 고정해 레이아웃이 튀지 않게 하고, SVG는 안에 가둔다. */
  .thumb-mermaid {
    width: 160px;
    aspect-ratio: 16 / 9;
    background-color: var(--surface);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem;
  }

  .thumb-mermaid .mermaid-diagram {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: normal;
  }

  .thumb-mermaid .mermaid-diagram svg {
    max-width: 100%;
    max-height: 100%;
    height: auto;
    display: block;
  }

  /* 좁은 화면: 세로로 쌓되 본문(메타·제목·요약)을 먼저, 커버는 그 아래 전체 폭으로 둔다.
     커버 없는 카드는 .thumb가 없어 영향이 없다(메타는 그대로 한 줄). */
  @media (max-width: 480px) {
    .post-card {
      flex-direction: column;
      align-items: stretch;
      gap: 0.9rem;
    }

    .thumb img {
      width: 100%;
    }

    .thumb-mermaid {
      width: 100%;
    }
  }

  .title {
    margin: 0.6rem 0 0.4rem;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.45;
  }

  .title a {
    color: var(--text);
    transition: color 0.15s ease;
  }

  .title a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .description {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.975rem;
    line-height: 1.7;
  }
</style>

<script>
  // 커버 없는 글의 카드 썸네일 = 본문 첫 mermaid 다이어그램. 글 상세와 같은 렌더러를 재사용한다.
  // 목록에 도식 글이 여럿이어도 부담 없게, 카드가 화면에 들어올 때만 그린다(지연 렌더).
  import { renderMermaidDiagrams } from '../scripts/mermaid-render';

  const thumbs = Array.from(
    document.querySelectorAll<HTMLElement>('.thumb-mermaid .mermaid-diagram'),
  );
  if (thumbs.length > 0) {
    const rendered: HTMLElement[] = [];
    const drawOne = (el: HTMLElement) => {
      renderMermaidDiagrams([el]);
      rendered.push(el);
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            drawOne(e.target as HTMLElement);
            obs.unobserve(e.target);
          }
        },
        { rootMargin: '200px' },
      );
      thumbs.forEach((t) => io.observe(t));
    } else {
      thumbs.forEach(drawOne);
    }

    // 라이트/다크 토글 시 이미 그린 썸네일은 색을 따라오도록 다시 그린다(글 상세와 같은 패턴).
    const rerender = () => {
      if (rendered.length > 0) renderMermaidDiagrams(rendered);
    };
    window.addEventListener('injoy:theme-change', rerender);
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', rerender);
  }
</script>
