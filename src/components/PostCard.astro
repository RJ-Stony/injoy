---
import { Image } from 'astro:assets';
import PostMeta from './PostMeta.astro';
import { readingMinutes, firstDiagram, type Post } from '../utils/post';
import { withBase } from '../utils/url';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const href = withBase(`/posts/${post.id}/`);
const cover = post.data.cover;
// 커버가 없으면 본문 첫 다이어그램(mermaid)을 카드 썸네일로 그린다(둘 다 없으면 썸네일 없음).
const diagram = cover ? null : firstDiagram(post);
---

<article class="post-card">
  <div class="text">
    <PostMeta
      category={post.data.category}
      pubDate={post.data.pubDate}
      minutes={readingMinutes(post)}
      updatedDate={post.data.updatedDate}
      viewSlug={post.id}
    />
    <h2 class="title">
      <a class="stretch" href={href}>{post.data.title}</a>
    </h2>
    <p class="description">{post.data.description}</p>
  </div>
  {
    cover ? (
      <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
        <Image src={cover} alt="" width={360} height={203} />
      </a>
    ) : diagram ? (
      <a class="thumb thumb-mermaid" href={href} tabindex="-1" aria-hidden="true">
        <div class="mermaid-diagram" data-source={diagram}></div>
      </a>
    ) : null
  }
</article>

<style>
  .post-card {
    position: relative;
    /* 좌우로 살짝 숨 쉬는 호버 배경 — 음수 margin으로 상위 main(좌우 1.25rem) 안에 머문다 */
    padding: 1.5rem 0.85rem;
    margin-inline: -0.85rem;
    border-radius: 12px;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    transition: background-color 0.15s ease;
  }

  /* 카드 사이에만 안쪽으로 들인 구분선 — 둥근 호버 배경과 어울리게 좌우를 inset 한다 */
  .post-card + .post-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0.85rem;
    right: 0.85rem;
    border-top: 1px solid var(--border);
  }

  /* 카드 전체 호버·키보드 포커스 피드백 — 썸네일 없는 카드도 반응한다 */
  .post-card:hover,
  .post-card:focus-within {
    background-color: var(--surface);
  }

  .post-card:hover .title a,
  .post-card:focus-within .title a {
    color: var(--accent);
  }

  .post-card:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .text {
    flex: 1;
    min-width: 0;
  }

  /* 메타의 카테고리 링크는 카드 전체 링크(stretched-link) 위에서 계속 클릭되게 띄운다 */
  .text :global(a.category) {
    position: relative;
    z-index: 1;
  }

  .thumb {
    flex-shrink: 0;
    /* stretched-link 위에 올려 겹침으로 인한 클릭 영역 혼선을 피한다(목적지는 같은 글) */
    position: relative;
    z-index: 1;
    border-radius: 10px;
    overflow: hidden;
    line-height: 0;
  }

  .thumb img {
    /* 커버는 16:9 — 같은 비율로 보여 양옆이 잘리지 않게 한다 */
    width: 160px;
    aspect-ratio: 16 / 9;
    height: auto;
    object-fit: cover;
    transition: transform 0.2s ease;
  }

  .post-card:hover .thumb img {
    transform: scale(1.03);
  }

  /* 커버 없는 글의 썸네일 — 본문 첫 mermaid 다이어그램을 박스에 맞춰 그린다(클라이언트 렌더).
     박스는 커버와 같은 160px·16:9로 고정해 레이아웃이 튀지 않게 하고, SVG는 안에 가둔다. */
  .thumb-mermaid {
    width: 160px;
    aspect-ratio: 16 / 9;
    background-color: var(--surface);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem;
  }

  .thumb-mermaid .mermaid-diagram {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: normal;
  }

  .thumb-mermaid .mermaid-diagram svg {
    max-width: 100%;
    max-height: 100%;
    height: auto;
    display: block;
  }

  /* 좁은 화면: 세로로 쌓되 본문(메타·제목·요약)을 먼저, 커버는 그 아래 전체 폭으로 둔다.
     커버 없는 카드는 .thumb가 없어 영향이 없다(메타는 그대로 한 줄). */
  @media (max-width: 480px) {
    .post-card {
      flex-direction: column;
      align-items: stretch;
      gap: 0.9rem;
    }

    .thumb img {
      width: 100%;
    }

    .thumb-mermaid {
      width: 100%;
    }
  }

  .title {
    margin: 0.5rem 0 0.45rem;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.45;
  }

  .title a {
    color: var(--text);
    transition: color 0.15s ease;
  }

  .title a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  /* 카드 전체를 덮는 stretched-link — 카드 어디를 눌러도 글로 이동한다.
     자신은 position:static이라 ::after는 position:relative인 .post-card를 기준으로 펼쳐진다.
     z-index를 두지 않아 카테고리·썸네일(z-index:1)만 위로 뚫고 나머지 영역은 글 링크가 된다. */
  .title a.stretch::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .description {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.975rem;
    line-height: 1.7;
    /* 긴 요약을 2줄에서 '…' 처리해 카드 높이를 고르게 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 움직임 줄이기 존중 — 색 전환만 남기고 확대/전환 애니메이션은 끈다 */
  @media (prefers-reduced-motion: reduce) {
    .post-card {
      transition: none;
    }

    .thumb img {
      transition: none;
    }

    .post-card:hover .thumb img {
      transform: none;
    }
  }
</style>

<script>
  // 커버 없는 글의 카드 썸네일 = 본문 첫 mermaid 다이어그램. 글 상세와 같은 렌더러를 재사용한다.
  // 목록에 도식 글이 여럿이어도 부담 없게, 카드가 화면에 들어올 때만 그린다(지연 렌더).
  import { renderMermaidDiagrams } from '../scripts/mermaid-render';

  const thumbs = Array.from(
    document.querySelectorAll<HTMLElement>('.thumb-mermaid .mermaid-diagram'),
  );
  if (thumbs.length > 0) {
    const rendered: HTMLElement[] = [];
    // 렌더를 직렬화한다 — mermaid는 단일 인스턴스라 동시 호출이 겹치면 일부가 실패한다.
    let chain: Promise<void> = Promise.resolve();
    const drawOne = (el: HTMLElement) => {
      rendered.push(el);
      chain = chain.then(() => renderMermaidDiagrams([el]));
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            drawOne(e.target as HTMLElement);
            obs.unobserve(e.target);
          }
        },
        { rootMargin: '200px' },
      );
      thumbs.forEach((t) => io.observe(t));
    } else {
      thumbs.forEach(drawOne);
    }

    // 라이트/다크 토글 시 이미 그린 썸네일은 색을 따라오도록 다시 그린다(글 상세와 같은 패턴).
    const rerender = () => {
      if (rendered.length > 0) chain = chain.then(() => renderMermaidDiagrams(rendered));
    };
    window.addEventListener('injoy:theme-change', rerender);
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', rerender);
  }
</script>
