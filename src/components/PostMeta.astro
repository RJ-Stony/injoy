---
/**
 * 시그니처 메타 라인 — 카테고리 라벨 + 발행일 + (수정일) + (통계 칩).
 * 날짜는 잔잔한 본문 글씨로, 통계(읽기·연결)는 아이콘 칩으로 위계를 준다.
 * 글 카드에선 통계를 함께 보여 주고(showStats=true), 글 상단에선 통계를 따로
 * 배치하므로 showStats=false로 카테고리·날짜만 그린다.
 */
import { formatDate, isoDate } from '../utils/post';
import { withBase } from '../utils/url';
import PostStats from './PostStats.astro';
import ViewCount from './ViewCount.astro';

interface Props {
  category: string;
  pubDate: Date;
  minutes: number;
  /** 글 상세에서만 넘긴다. 0이면 표시하지 않음 */
  connections?: number;
  /** 발행일과 다를 때만 '수정'으로 표시 */
  updatedDate?: Date;
  /** false면 통계 칩을 빼고 카테고리·날짜만 — 글 상단처럼 통계를 따로 배치할 때 */
  showStats?: boolean;
  /** 넘기면 읽기 시간 옆에 조회수 칩을 함께 — 홈 목록용(카운트는 올리지 않고 조회만) */
  viewSlug?: string;
}

const {
  category,
  pubDate,
  minutes,
  connections,
  updatedDate,
  showStats = true,
  viewSlug,
} = Astro.props;
// 수정 시각이 발행 시각과 다르면 표시한다. 새 수정은 시각까지 기록되므로 같은 날 수정도 발행(자정)과
// 달라 뜨고('몇 분 전 수정'을 클라이언트가 채움), 옛 날짜만 있던 글의 발행==수정(같은 자정)은 가려진다.
// 하루가 넘으면 아래 서버 날짜를 그대로 둔다.
const showUpdated = !!updatedDate && updatedDate.getTime() !== pubDate.getTime();
---

<div class="post-meta">
  <a class="category" href={withBase(`/categories/${category}/`)}>{category}</a>
  <time class="m-date" datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
  {
    showUpdated && (
      <time class="m-date m-upd" datetime={updatedDate!.toISOString()}>
        수정 {formatDate(updatedDate!)}
      </time>
    )
  }
  {showStats && <PostStats minutes={minutes} connections={connections} />}
  {showStats && viewSlug && <ViewCount slug={viewSlug} increment={false} />}
</div>

<style>
  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    column-gap: 0;
    row-gap: 0.4em;
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .category {
    color: var(--accent);
    background-color: var(--accent-weak);
    font-weight: 600;
    padding: 0.1em 0.6em;
    border-radius: 999px;
  }

  a.category:hover {
    background-color: color-mix(in srgb, var(--accent) 16%, var(--accent-weak));
    text-decoration: none;
  }

  /* 날짜 — 잔잔한 글씨. 항목 사이 가운뎃점은 ::before라 줄 맨 앞엔 오지 않는다 */
  .m-date {
    white-space: nowrap;
  }

  .m-date::before {
    content: '·';
    margin: 0 0.45em;
    color: var(--border);
  }
</style>

<script>
  // 하루 안의 수정은 '몇 초/분/시간 전 수정'으로, 하루가 넘으면 서버가 그린 '수정 M/D' 날짜 그대로.
  // 정적 사이트라 '지금'은 뷰 시점에만 알 수 있어 클라이언트에서 계산한다(datetime 속성=수정 시각).
  function relativeUpdated() {
    const now = Date.now();
    for (const el of document.querySelectorAll<HTMLTimeElement>('.m-upd[datetime]')) {
      const t = new Date(el.getAttribute('datetime') || '').getTime();
      if (Number.isNaN(t)) continue;
      const sec = Math.floor((now - t) / 1000);
      if (sec < 0 || sec >= 86400) continue; // 하루 이상은 서버 날짜를 둔다
      el.textContent =
        sec < 5 ? '방금 수정'
        : sec < 60 ? `${sec}초 전 수정`
        : sec < 3600 ? `${Math.floor(sec / 60)}분 전 수정`
        : `${Math.floor(sec / 3600)}시간 전 수정`;
    }
  }
  relativeUpdated();
  // 보는 동안 '방금'이 '1분 전'으로 자연히 넘어가게 가볍게 갱신한다.
  setInterval(relativeUpdated, 30000);
</script>
