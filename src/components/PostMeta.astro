---
/**
 * 시그니처 메타 라인 — 카테고리 라벨 + 발행일 + (수정일) + (통계 칩).
 * 날짜는 잔잔한 본문 글씨로, 통계(읽기·연결)는 아이콘 칩으로 위계를 준다.
 * 글 카드에선 통계를 함께 보여 주고(showStats=true), 글 상단에선 통계를 따로
 * 배치하므로 showStats=false로 카테고리·날짜만 그린다.
 */
import { formatDate, formatDateShort } from '../utils/post';
import { withBase } from '../utils/url';
import PostStats from './PostStats.astro';
import ViewCount from './ViewCount.astro';

interface Props {
  category: string;
  pubDate: Date;
  minutes: number;
  /** 글 상세에서만 넘긴다. 0이면 표시하지 않음 */
  connections?: number;
  /** 발행일과 다를 때만 '수정'으로 표시 */
  updatedDate?: Date;
  /** false면 통계 칩을 빼고 카테고리·날짜만 — 글 상단처럼 통계를 따로 배치할 때 */
  showStats?: boolean;
  /** 넘기면 읽기 시간 옆에 조회수 칩을 함께 — 홈 목록용(카운트는 올리지 않고 조회만) */
  viewSlug?: string;
}

const {
  category,
  pubDate,
  minutes,
  connections,
  updatedDate,
  showStats = true,
  viewSlug,
} = Astro.props;
// 날짜는 하나만, 라벨 없이 보여 준다 — 수정된 글이면 수정 시각을, 아니면 발행일을. ('수정'이라는 말은
// 만듦새 패널에서만 붙인다. 메타 줄엔 그냥 날짜/상대시간만.)
const edited = !!updatedDate && updatedDate.getTime() !== pubDate.getTime();
const shown = edited ? updatedDate! : pubDate;
---

<div class="post-meta">
  <a class="category" href={withBase(`/categories/${category}/`)}>{category}</a>
  <time
    class="m-date rel-time"
    datetime={shown.toISOString()}
    title={formatDate(shown)}
    data-fine={edited ? '1' : undefined}
  >
    {formatDateShort(shown)}
  </time>
  <script is:inline>
    window.injoyRel && window.injoyRel(document.currentScript.previousElementSibling);
  </script>
  {showStats && <PostStats minutes={minutes} connections={connections} />}
  {showStats && viewSlug && <ViewCount slug={viewSlug} increment={false} />}
</div>

<style>
  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    column-gap: 0;
    row-gap: 0.4em;
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .category {
    color: var(--accent);
    background-color: var(--accent-weak);
    font-weight: 600;
    padding: 0.1em 0.6em;
    border-radius: 999px;
  }

  a.category:hover {
    background-color: color-mix(in srgb, var(--accent) 16%, var(--accent-weak));
    text-decoration: none;
  }

  /* 날짜 — 잔잔한 글씨. 항목 사이 가운뎃점은 ::before라 줄 맨 앞엔 오지 않는다 */
  .m-date {
    white-space: nowrap;
  }

  .m-date::before {
    content: '·';
    margin: 0 0.45em;
    color: var(--border);
  }
</style>

<script>
  // 보는 동안 '방금'이 '1분 전'으로 넘어가게 가볍게 갱신한다. 처음 채우는 일은 날짜 바로 뒤의 인라인 스크립트가
  // 화면이 그려지기 전에 한다(함수는 BaseLayout의 window.injoyRel). 스크립트가 만든 날짜(검색 결과)도 여기서 채운다.
  const paintRelative = () => {
    const rel = (window as unknown as { injoyRel?: (el: Element) => void }).injoyRel;
    if (rel) document.querySelectorAll('.rel-time[datetime]').forEach(rel);
  };
  paintRelative();
  setInterval(paintRelative, 30000);
</script>
