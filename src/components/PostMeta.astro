---
/**
 * 시그니처 메타 라인 — 카테고리 라벨 + 발행일 + (수정일) + (통계 칩).
 * 날짜는 잔잔한 본문 글씨로, 통계(읽기·연결)는 아이콘 칩으로 위계를 준다.
 * 글 카드에선 통계를 함께 보여 주고(showStats=true), 글 상단에선 통계를 따로
 * 배치하므로 showStats=false로 카테고리·날짜만 그린다.
 */
import { formatDate, formatDateShort, isoDate } from '../utils/post';
import { withBase } from '../utils/url';
import PostStats from './PostStats.astro';
import ViewCount from './ViewCount.astro';

interface Props {
  category: string;
  pubDate: Date;
  minutes: number;
  /** 글 상세에서만 넘긴다. 0이면 표시하지 않음 */
  connections?: number;
  /** 발행일과 다를 때만 '수정'으로 표시 */
  updatedDate?: Date;
  /** false면 통계 칩을 빼고 카테고리·날짜만 — 글 상단처럼 통계를 따로 배치할 때 */
  showStats?: boolean;
  /** 넘기면 읽기 시간 옆에 조회수 칩을 함께 — 홈 목록용(카운트는 올리지 않고 조회만) */
  viewSlug?: string;
  /** 글 상세용 — 상대시간 대신 정확 날짜+라벨('작성'/'수정')로 또렷하게 보여 준다 */
  precise?: boolean;
}

const {
  category,
  pubDate,
  minutes,
  connections,
  updatedDate,
  showStats = true,
  viewSlug,
  precise = false,
} = Astro.props;
// 날짜는 하나만, 라벨 없이 보여 준다 — 수정된 글이면 수정 시각을, 아니면 발행일을. ('수정'이라는 말은
// 만듦새 패널에서만 붙인다. 메타 줄엔 그냥 날짜/상대시간만.)
const edited = !!updatedDate && updatedDate.getTime() !== pubDate.getTime();
const shown = edited ? updatedDate! : pubDate;
---

<div class="post-meta">
  <a class="category" href={withBase(`/categories/${category}/`)}>{category}</a>
  {
    precise ? (
      <time class="m-date" datetime={isoDate(shown)}>{formatDateShort(shown)}</time>
    ) : (
      <time
        class="m-date rel-time"
        datetime={shown.toISOString()}
        title={formatDate(shown)}
        data-fine={edited ? '1' : undefined}
      >
        {formatDateShort(shown)}
      </time>
    )
  }
  {showStats && <PostStats minutes={minutes} connections={connections} />}
  {showStats && viewSlug && <ViewCount slug={viewSlug} increment={false} />}
</div>

<style>
  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    column-gap: 0;
    row-gap: 0.4em;
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .category {
    color: var(--accent);
    background-color: var(--accent-weak);
    font-weight: 600;
    padding: 0.1em 0.6em;
    border-radius: 999px;
  }

  a.category:hover {
    background-color: color-mix(in srgb, var(--accent) 16%, var(--accent-weak));
    text-decoration: none;
  }

  /* 날짜 — 잔잔한 글씨. 항목 사이 가운뎃점은 ::before라 줄 맨 앞엔 오지 않는다 */
  .m-date {
    white-space: nowrap;
  }

  .m-date::before {
    content: '·';
    margin: 0 0.45em;
    color: var(--border);
  }
</style>

<script>
  // 카드의 날짜는 상대시간으로 — 정적 사이트라 '지금'은 뷰 시점에만 알 수 있어 클라이언트가 채운다.
  // datetime=대상 시각, data-prefix='수정 '(작성은 빈 문자열), data-fine='1'이면 24시간 안은 초/분/시 단위.
  // 정확한 날짜는 hover(title)와 글 상세(precise)에서 본다. (상세는 서버가 절대 날짜로 그려 이 스크립트가 건드리지 않음.)
  function rel(nowMs: number, tMs: number, fine: boolean): string {
    const sec = Math.floor((nowMs - tMs) / 1000);
    // 시각이 박힌 수정(<24h)은 절대 경과초로 — '방금/N분/N시간 전'.
    if (fine && sec >= 0 && sec < 86400) {
      if (sec < 5) return '방금';
      if (sec < 60) return `${sec}초 전`;
      if (sec < 3600) return `${Math.floor(sec / 60)}분 전`;
      return `${Math.floor(sec / 3600)}시간 전`;
    }
    // 일 단위는 '달력 날짜' 차로 — 로컬 자정 기준. (작성일은 date-only라 UTC 자정에 박혀,
    // 절대 경과초로 재면 KST에서 오늘/어제 경계가 9시간씩 밀린다. 로컬 자정 정규화로 바로잡는다.)
    const a = new Date(nowMs); a.setHours(0, 0, 0, 0);
    const b = new Date(tMs); b.setHours(0, 0, 0, 0);
    const day = Math.round((a.getTime() - b.getTime()) / 86400000);
    if (day <= 0) return '오늘'; // 미래(시계 틀어짐·발행 당일 새벽)도 '오늘'로 흡수
    if (day === 1) return '어제';
    if (day < 7) return `${day}일 전`;
    if (day < 30) return `${Math.floor(day / 7)}주 전`;
    if (day < 365) return `${Math.floor(day / 30)}개월 전`;
    // 1년이 넘으면 상대표기 대신 실제 날짜(YYYY.MM.DD)
    const d = new Date(tMs);
    return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
  }
  function paintRelative() {
    const now = Date.now();
    for (const el of document.querySelectorAll<HTMLTimeElement>('.rel-time[datetime]')) {
      const t = new Date(el.getAttribute('datetime') || '').getTime();
      if (Number.isNaN(t)) continue;
      el.textContent = (el.dataset.prefix || '') + rel(now, t, el.dataset.fine === '1');
    }
  }
  paintRelative();
  // 보는 동안 '방금'이 '1분 전'으로 자연히 넘어가게 가볍게 갱신한다.
  setInterval(paintRelative, 30000);
</script>
