---
/**
 * 글 조회수 — Abacus(무가입 카운터 API)로 집계해 눈 아이콘 칩으로 보여 준다.
 * 칸을 처음부터 잡아 두고(자리표시) 응답이 오면 숫자로 바꾼다 — 늦게 끼어들며 줄이 밀리지 않게.
 * 글 상세는 카운트를 올리고(hit, 로컬 미리보기는 get), 홈 목록은 올리지 않고 조회만 한다(increment=false → get).
 * API가 응답하지 않으면 그 칩만 조용히 사라져 본문 읽기에 영향을 주지 않는다.
 * PostMeta의 통계 칩(.meta-stat)과 같은 모습으로 메타 줄에 자연스럽게 합류한다.
 */
interface Props {
  slug: string;
  /** false면 카운트를 올리지 않고 조회만 — 홈 목록처럼 여러 글이 한 화면에 뜰 때 */
  increment?: boolean;
}

const { slug, increment = true } = Astro.props;
const safeKey = `post-${slug.replace(/[^a-zA-Z0-9_-]/g, '-')}`;
---

<span
  class="meta-stat view-count"
  data-key={safeKey}
  data-increment={increment ? '1' : '0'}
  aria-label="조회수"
>
  <svg class="ic" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z"></path>
    <circle cx="12" cy="12" r="3"></circle>
  </svg>
  <span class="value"><span class="vc-skeleton" aria-hidden="true"></span></span>
</span>

<script>
  const isLocal = ['localhost', '127.0.0.1'].includes(location.hostname);
  document.querySelectorAll<HTMLElement>('.view-count').forEach((el) => {
    const key = el.dataset.key;
    if (!key) return;
    // 홈 목록(increment=0)은 올리지 않고 조회만(get). 글 상세는 hit(로컬 미리보기는 get).
    const mode = el.dataset.increment === '0' || isLocal ? 'get' : 'hit';
    fetch(`https://abacus.jasoncameron.dev/${mode}/injoy-rjstony/${key}`)
      .then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
      .then((data: { value: number }) => {
        const value = el.querySelector('.value');
        if (value && typeof data.value === 'number') {
          const n = data.value.toLocaleString('ko-KR');
          value.textContent = n;
          el.setAttribute('aria-label', `조회수 ${n}`);
        }
      })
      .catch(() => {
        // 카운터 불가 시 그 칩만 감춘다(자리표시가 영원히 남지 않게)
        el.hidden = true;
      });
  });
</script>

<style>
  /* PostMeta의 통계 칩과 동일한 모습(아이콘 + 숫자) */
  .meta-stat {
    display: inline-flex;
    align-items: center;
    gap: 0.32em;
    margin-left: 0.85em;
    white-space: nowrap;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .meta-stat[hidden] {
    display: none;
  }

  .meta-stat .ic {
    width: 1.02em;
    height: 1.02em;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.7;
    flex-shrink: 0;
  }

  /* 응답 전 자리표시 — 숫자 폭만큼 잔잔히 반짝이는 칸. 처음부터 자리를 잡아 줄이 밀리지 않게 한다. */
  .view-count .vc-skeleton {
    display: inline-block;
    width: 1.5em;
    height: 0.8em;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--border), var(--surface), var(--border));
    background-size: 200% 100%;
    animation: vc-shimmer 1.2s linear infinite;
    vertical-align: -0.05em;
  }

  @keyframes vc-shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .view-count .vc-skeleton {
      animation: none;
    }
  }
</style>
