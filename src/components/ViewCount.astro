---
/**
 * 글 조회수 — 눈 아이콘 칩. 숫자는 빌드할 때 계산해 박아 둔다(src/utils/views.ts: 예전 계수기의 값 + GA4가 센 값).
 * 화면이 뜬 뒤에 받아 오지 않으므로 자리표시가 반짝이다가 숫자로 바뀌는 일이 없다. 하루에 한 번 갱신된다.
 * PostMeta의 통계 칩(.meta-stat)과 같은 모습으로 메타 줄에 자연스럽게 합류한다.
 */
import { getViews } from '../utils/views';

interface Props {
  slug: string;
  /** 예전 계수기 때의 속성. 지금은 쓰지 않는다(방문은 GA4가 센다) */
  increment?: boolean;
}

const { slug } = Astro.props;
const count = (await getViews()).post(slug).toLocaleString('ko-KR');
---

<span class="meta-stat view-count" aria-label={`조회수 ${count}`}>
  <svg class="ic" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z"></path>
    <circle cx="12" cy="12" r="3"></circle>
  </svg>
  <span class="value">{count}</span>
</span>

<style>
  /* PostMeta의 통계 칩과 동일한 모습(아이콘 + 숫자) */
  .meta-stat {
    display: inline-flex;
    align-items: center;
    gap: 0.32em;
    margin-left: 0.85em;
    white-space: nowrap;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .meta-stat[hidden] {
    display: none;
  }

  .meta-stat .ic {
    width: 1.02em;
    height: 1.02em;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.7;
    flex-shrink: 0;
  }

  /* 응답 전 자리표시 — 숫자 폭만큼 잔잔히 반짝이는 칸. 처음부터 자리를 잡아 줄이 밀리지 않게 한다. */
  .view-count .vc-skeleton {
    display: inline-block;
    width: 1.5em;
    height: 0.8em;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--border), var(--surface), var(--border));
    background-size: 200% 100%;
    animation: vc-shimmer 1.2s linear infinite;
    vertical-align: -0.05em;
  }

  @keyframes vc-shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .view-count .vc-skeleton {
      animation: none;
    }
  }
</style>
