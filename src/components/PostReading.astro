---
/**
 * 읽기 보조 — 글 상세에서만 1회 포함(src/pages/posts/[slug].astro).
 *  · 읽기 진행 막대: 화면 맨 위 가는 줄이 스크롤만큼 차오른다.
 *  · 우하단 스피드다이얼(FAB): 평소엔 버튼 하나(⋮). 누르면 위로 항목이 스르륵 펼쳐진다.
 *     - 집중 읽기: 헤더·목차·푸터 등 방해 요소를 감추고 본문만. Escape로 해제.
 *     - 공유: navigator.share(모바일 시트) 또는 링크 클립보드 복사.
 *     - 맨 위로: 한참 내렸을 때만 항목으로 등장.
 *     집중모드에선 FAB가 '집중 해제'(축소 아이콘) 하나로 바뀐다(다이얼 비활성).
 *  · 제목 링크: h2/h3에 호버하면 🔗가 떠 그 단락의 URL(#앵커)을 복사한다.
 * 스크립트로 주입하는 제목 버튼은 스코프 CSS가 안 먹어 전역 스타일로 둔다.
 */
---

<div class="reading-progress" aria-hidden="true"><span class="bar"></span></div>

<div class="reading-dial" data-open="false">
  <div class="rd-items">
    <button type="button" class="rd-item" data-act="focus" aria-label="집중 읽기 모드" tabindex="-1">
      <span class="rd-label">집중 읽기</span>
      <span class="rd-ic">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3"></path></svg>
      </span>
    </button>
    <button type="button" class="rd-item to-share" data-act="share" aria-label="이 글 공유" tabindex="-1">
      <span class="rd-label">공유</span>
      <span class="rd-ic">
        <svg class="ic-share" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7"></path><path d="M16 6l-4-4-4 4"></path><path d="M12 2v13"></path></svg>
        <svg class="ic-done" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l5 5 9-11"></path></svg>
      </span>
    </button>
    <button type="button" class="rd-item rd-top" data-act="top" aria-label="맨 위로" tabindex="-1" hidden>
      <span class="rd-label">맨 위로</span>
      <span class="rd-ic">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"></path></svg>
      </span>
    </button>
  </div>

  <button type="button" class="rd-fab" aria-haspopup="true" aria-expanded="false" aria-label="읽기 도구">
    <svg class="ic-menu" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="5" r="1.6"></circle><circle cx="12" cy="12" r="1.6"></circle><circle cx="12" cy="19" r="1.6"></circle></svg>
    <svg class="ic-close" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    <svg class="ic-compress" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 14h6v6M20 10h-6V4M14 10l7-7M3 21l7-7"></path></svg>
  </button>
</div>

<script>
  import { SMOOTH_DURATION } from '../scripts/smooth-details';
  import { markVisited, currentSlug } from '../scripts/reading-trace';

  // 0) 읽기 흔적(D13) — 이 글을 방문했다고 기록한다(그래프의 '읽은 글 점'이 이걸 쓴다).
  const slug = currentSlug();
  if (slug) {
    markVisited(slug);
  }

  // 1) 읽기 진행 막대 + 맨 위로 항목 노출 — 스크롤을 rAF로 묶어 한 프레임에 한 번만 계산
  const bar = document.querySelector<HTMLElement>('.reading-progress .bar');
  const topItem = document.querySelector<HTMLButtonElement>('.rd-top');
  let ticking = false;
  const update = () => {
    ticking = false;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    if (bar) bar.style.transform = `scaleX(${p})`;
    if (topItem) topItem.hidden = window.scrollY < window.innerHeight * 0.6;
  };
  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  update();

  // 2) 스피드다이얼 열고 닫기
  const dial = document.querySelector<HTMLElement>('.reading-dial');
  const fab = document.querySelector<HTMLButtonElement>('.rd-fab');
  const items = [...document.querySelectorAll<HTMLButtonElement>('.rd-item')];
  const isFocus = () => document.documentElement.dataset.focus === 'true';

  const setOpen = (open: boolean) => {
    if (!dial || !fab) return;
    dial.dataset.open = String(open);
    fab.setAttribute('aria-expanded', String(open));
    // 닫히면 항목은 탭 순서에서 빠지고, 열리면 키보드로 닿게 한다
    for (const it of items) it.tabIndex = open ? 0 : -1;
  };

  // 3) 집중 읽기 모드 — data-focus 토글. 숨김은 전역 CSS가 담당.
  //    상태를 localStorage에 남겨 글을 넘겨도 유지된다(BaseLayout이 첫 페인트 전 복원, 글 상세만).
  const setFocus = (on: boolean) => {
    if (on) {
      document.documentElement.dataset.focus = 'true';
      localStorage.setItem('focus-read', '1');
      setOpen(false); // 집중 진입 시 다이얼은 닫는다
    } else {
      delete document.documentElement.dataset.focus;
      localStorage.removeItem('focus-read');
    }
  };

  fab?.addEventListener('click', () => {
    // 집중모드에선 FAB가 '집중 해제' 버튼 — 바로 나간다(다이얼 안 엶)
    if (isFocus()) {
      setFocus(false);
      return;
    }
    setOpen(dial?.dataset.open !== 'true');
  });

  // 바깥 클릭으로 닫기
  document.addEventListener('click', (e) => {
    if (dial?.dataset.open === 'true' && !dial.contains(e.target as Node)) setOpen(false);
  });

  // Escape: 집중모드면 해제, 아니면 다이얼 닫기
  window.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (isFocus()) setFocus(false);
    else if (dial?.dataset.open === 'true') setOpen(false);
  });

  // 4) 항목 동작
  let shareTimer: ReturnType<typeof setTimeout>;
  const doShare = async (btn: HTMLButtonElement) => {
    const url = location.href;
    const title = document.title;
    if (navigator.share) {
      try {
        await navigator.share({ title, url });
      } catch {
        /* 사용자가 공유 시트를 취소 — 조용히 무시 */
      }
      return;
    }
    try {
      await navigator.clipboard.writeText(url);
      btn.classList.add('copied');
      clearTimeout(shareTimer);
      shareTimer = setTimeout(() => btn.classList.remove('copied'), 1600);
    } catch {
      /* 클립보드 거부(비보안 컨텍스트 등) — 조용히 무시 */
    }
  };

  for (const it of items) {
    it.addEventListener('click', async () => {
      const act = it.dataset.act;
      if (act === 'focus') {
        setFocus(true);
      } else if (act === 'share') {
        await doShare(it);
        // 공유(복사)는 완료 표시를 보여주려 다이얼을 잠깐 열어 둔다
        return;
      } else if (act === 'top') {
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      }
      setOpen(false);
    });
  }

  // 5) 제목 링크 복사 — .prose h2/h3(Astro가 부여한 id)에 링크 버튼을 붙인다
  const linkIcon =
    '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 15l6-6"></path><path d="M11 6l1-1a4 4 0 0 1 6 6l-1 1"></path><path d="M13 18l-1 1a4 4 0 0 1-6-6l1-1"></path></svg>';
  const baseUrl = location.origin + location.pathname;
  for (const h of document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]')) {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'heading-link';
    btn.setAttribute('aria-label', '이 단락 링크 복사');
    btn.innerHTML = linkIcon;
    let timer: ReturnType<typeof setTimeout>;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(`${baseUrl}#${h.id}`);
        btn.classList.add('copied');
        clearTimeout(timer);
        timer = setTimeout(() => btn.classList.remove('copied'), 1500);
      } catch {
        /* 클립보드 거부(비보안 컨텍스트 등) — 조용히 무시 */
      }
    });
    h.appendChild(btn);
  }

  // 모션 상수를 CSS로 넘겨 사이트 공통 결(SMOOTH_DURATION)과 맞춘다
  document.documentElement.style.setProperty('--rd-dur', `${SMOOTH_DURATION}ms`);
</script>

<style>
  .reading-progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 60;
    pointer-events: none;
  }

  .reading-progress .bar {
    display: block;
    height: 100%;
    background-color: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .reading-progress .bar {
      transition: transform 0.08s linear;
    }
  }

  /* 우하단 스피드다이얼 */
  .reading-dial {
    position: fixed;
    right: 1.1rem;
    bottom: 1.1rem;
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
  }

  /* 펼쳐지는 항목 목록 */
  .rd-items {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
  }

  .rd-item {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    /* 닫힘 기본값 — FAB 뒤에서 살짝 아래·작게 숨어 있다 */
    opacity: 0;
    transform: translateY(0.6rem) scale(0.9);
    pointer-events: none;
    transition:
      opacity var(--rd-dur, 260ms) cubic-bezier(0.33, 1, 0.68, 1),
      transform var(--rd-dur, 260ms) cubic-bezier(0.33, 1, 0.68, 1);
  }

  .rd-item[hidden] {
    display: none;
  }

  .reading-dial[data-open='true'] .rd-item {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  /* FAB에 가까운 항목부터 순서대로 뜨게 살짝 스태거 */
  .reading-dial[data-open='true'] .rd-item:nth-last-child(1) { transition-delay: 0ms; }
  .reading-dial[data-open='true'] .rd-item:nth-last-child(2) { transition-delay: 45ms; }
  .reading-dial[data-open='true'] .rd-item:nth-last-child(3) { transition-delay: 90ms; }

  /* 항목 라벨 — 늘 붙어 있어 무슨 버튼인지 바로 읽힌다 */
  .rd-label {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text);
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.3em 0.75em;
    box-shadow: 0 3px 12px rgb(0 0 0 / 14%);
    white-space: nowrap;
  }

  /* 항목의 원형 아이콘 — 기존 맨위로 버튼과 같은 결(테두리 원) */
  .rd-ic {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--surface);
    color: var(--text);
    border: 1px solid color-mix(in srgb, var(--text-muted) 30%, var(--border));
    box-shadow: 0 5px 16px rgb(0 0 0 / 18%);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .rd-item:hover .rd-ic,
  .rd-item:focus-visible .rd-ic {
    color: var(--accent);
    border-color: var(--accent);
  }

  .rd-ic svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 공유 완료(클립보드 복사) 표시 */
  .to-share .ic-done {
    display: none;
  }

  .to-share.copied .rd-ic {
    color: var(--accent);
    border-color: var(--accent);
  }

  .to-share.copied .ic-share {
    display: none;
  }

  .to-share.copied .ic-done {
    display: inline-block;
  }

  /* FAB — solid accent라 어느 배경에서도 또렷하게 보인다 */
  .rd-fab {
    width: 3.1rem;
    height: 3.1rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background-color: var(--accent);
    color: #fff;
    border: 0;
    box-shadow: 0 6px 18px rgb(0 0 0 / 22%);
    cursor: pointer;
    transition: transform 0.18s cubic-bezier(0.33, 1, 0.68, 1), filter 0.15s ease;
  }

  .rd-fab:hover {
    filter: brightness(1.06);
  }

  .rd-fab:active {
    transform: scale(0.94);
  }

  .rd-fab svg {
    grid-area: 1 / 1; /* 세 아이콘을 같은 칸에 겹쳐 놓고 opacity로 전환 */
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: opacity 0.15s ease, transform var(--rd-dur, 260ms) cubic-bezier(0.33, 1, 0.68, 1);
  }

  .rd-fab .ic-menu circle {
    fill: currentColor;
    stroke: none;
  }

  /* 아이콘 전환 — 닫힘=메뉴(⋮), 열림=닫기(×), 집중모드=축소 */
  .rd-fab .ic-close,
  .rd-fab .ic-compress {
    opacity: 0;
    transform: rotate(-90deg);
  }

  .reading-dial[data-open='true'] .rd-fab .ic-menu {
    opacity: 0;
    transform: rotate(90deg);
  }

  .reading-dial[data-open='true'] .rd-fab .ic-close {
    opacity: 1;
    transform: none;
  }

  /* 집중모드 FAB: 메뉴·닫기 숨기고 '축소'(집중 해제)만.
     스코프 블록에 둬야 스코프 기본 규칙(.rd-fab .ic-compress)의 specificity를 이긴다.
     is:global 규칙은 스코프 속성이 안 붙어 여기 기본 규칙에 져서 축소 아이콘이 안 켜졌다. */
  html[data-focus='true'] .rd-fab .ic-menu,
  html[data-focus='true'] .rd-fab .ic-close {
    opacity: 0;
  }

  html[data-focus='true'] .rd-fab .ic-compress {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .rd-item,
    .rd-fab,
    .rd-fab svg {
      transition: none;
    }
  }
</style>

<style is:global>
  /* 집중 읽기 모드 — 방해 요소를 감추고 본문만 남긴다. 상태는 <html data-focus="true">. */
  html[data-focus='true'] .site-header,
  html[data-focus='true'] .site-footer,
  html[data-focus='true'] .toc-inline,
  html[data-focus='true'] .toc-aside,
  html[data-focus='true'] .toc.line,
  html[data-focus='true'] .reading-dial .rd-items {
    display: none;
  }

  /* 목차 사이드바가 사라진 만큼 본문을 가운데로 모은다(빈 220px 칸 제거) */
  html[data-focus='true'] .post-grid {
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
  }

  /* 제목 앵커가 고정 헤더에 가리지 않게 + 링크 버튼 자리 */
  .prose h2,
  .prose h3 {
    scroll-margin-top: 5.5rem;
    position: relative;
  }

  /* 스크립트로 주입하는 제목 링크 버튼 — 호버 시 은은하게 */
  .prose .heading-link {
    border: 0;
    background: none;
    padding: 0 0.15em;
    margin-inline-start: 0.35em;
    cursor: pointer;
    vertical-align: middle;
    line-height: 1;
    color: var(--text-muted);
    opacity: 0;
    transition: opacity 0.15s ease, color 0.15s ease;
  }

  .prose .heading-link svg {
    /* 버튼 기본 글꼴(약 13px)에 묶이지 않게 rem로 — em로는 키워도 거의 안 보였다 */
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    vertical-align: baseline;
  }

  .prose h2:hover .heading-link,
  .prose h3:hover .heading-link,
  .prose .heading-link:focus-visible {
    opacity: 0.6;
  }

  .prose .heading-link:hover {
    opacity: 1;
    color: var(--accent);
  }

  .prose .heading-link.copied {
    opacity: 1;
    color: var(--accent);
  }

  .prose .heading-link.copied::after {
    content: ' 복사됨';
    font-size: 0.8rem;
    font-weight: 500;
  }

  /* 터치 환경: 호버가 없으니 은은하게 늘 보인다 */
  @media (hover: none) {
    .prose .heading-link {
      opacity: 0.4;
    }
  }
</style>
