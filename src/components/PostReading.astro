---
/**
 * 읽기 보조 — 글 상세에서만 1회 포함(src/pages/posts/[slug].astro).
 *  · 읽기 진행 막대: 화면 맨 위 가는 줄이 스크롤만큼 차오른다.
 *  · 맨 위로: 한참 내리면 우하단에 뜨고, 누르면 맨 위로 부드럽게.
 *  · 제목 링크: h2/h3에 호버하면 🔗가 떠 그 단락의 URL(#앵커)을 복사한다.
 * 스크립트로 주입하는 제목 버튼은 스코프 CSS가 안 먹어 전역 스타일로 둔다.
 */
---

<div class="reading-progress" aria-hidden="true"><span class="bar"></span></div>

<button type="button" class="to-top" aria-label="맨 위로" hidden>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"></path></svg>
</button>

<script>
  // 1) 읽기 진행 막대 + 맨 위로 노출 — 스크롤을 rAF로 묶어 한 프레임에 한 번만 계산
  const bar = document.querySelector<HTMLElement>('.reading-progress .bar');
  const toTop = document.querySelector<HTMLButtonElement>('.to-top');
  let ticking = false;
  const update = () => {
    ticking = false;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    if (bar) bar.style.transform = `scaleX(${p})`;
    if (toTop) toTop.hidden = window.scrollY < window.innerHeight * 0.6;
  };
  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  update();

  toTop?.addEventListener('click', () => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
  });

  // 2) 제목 링크 복사 — .prose h2/h3(Astro가 부여한 id)에 링크 버튼을 붙인다
  const linkIcon =
    '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 15l6-6"></path><path d="M11 6l1-1a4 4 0 0 1 6 6l-1 1"></path><path d="M13 18l-1 1a4 4 0 0 1-6-6l1-1"></path></svg>';
  const baseUrl = location.origin + location.pathname;
  for (const h of document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]')) {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'heading-link';
    btn.setAttribute('aria-label', '이 단락 링크 복사');
    btn.innerHTML = linkIcon;
    let timer: ReturnType<typeof setTimeout>;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(`${baseUrl}#${h.id}`);
        btn.classList.add('copied');
        clearTimeout(timer);
        timer = setTimeout(() => btn.classList.remove('copied'), 1500);
      } catch {
        /* 클립보드 거부(비보안 컨텍스트 등) — 조용히 무시 */
      }
    });
    h.appendChild(btn);
  }
</script>

<style>
  .reading-progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 60;
    pointer-events: none;
  }

  .reading-progress .bar {
    display: block;
    height: 100%;
    background-color: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .reading-progress .bar {
      transition: transform 0.08s linear;
    }
  }

  .to-top {
    position: fixed;
    right: 1.1rem;
    bottom: 1.1rem;
    z-index: 60;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg);
    color: var(--text-muted);
    border: 1px solid var(--border);
    box-shadow: 0 4px 14px rgb(0 0 0 / 12%);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .to-top[hidden] {
    display: none;
  }

  .to-top:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .to-top svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>

<style is:global>
  /* 제목 앵커가 고정 헤더에 가리지 않게 + 링크 버튼 자리 */
  .prose h2,
  .prose h3 {
    scroll-margin-top: 5.5rem;
    position: relative;
  }

  /* 스크립트로 주입하는 제목 링크 버튼 — 호버 시 은은하게 */
  .prose .heading-link {
    border: 0;
    background: none;
    padding: 0 0.15em;
    margin-inline-start: 0.35em;
    cursor: pointer;
    vertical-align: middle;
    line-height: 1;
    color: var(--text-muted);
    opacity: 0;
    transition: opacity 0.15s ease, color 0.15s ease;
  }

  .prose .heading-link svg {
    width: 0.62em;
    height: 0.62em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    vertical-align: baseline;
  }

  .prose h2:hover .heading-link,
  .prose h3:hover .heading-link,
  .prose .heading-link:focus-visible {
    opacity: 0.6;
  }

  .prose .heading-link:hover {
    opacity: 1;
    color: var(--accent);
  }

  .prose .heading-link.copied {
    opacity: 1;
    color: var(--accent);
  }

  .prose .heading-link.copied::after {
    content: ' 복사됨';
    font-size: 0.62em;
    font-weight: 500;
  }

  /* 터치 환경: 호버가 없으니 은은하게 늘 보인다 */
  @media (hover: none) {
    .prose .heading-link {
      opacity: 0.4;
    }
  }
</style>
