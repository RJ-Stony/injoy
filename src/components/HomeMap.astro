---
// 홈의 그래프 — 글(점)과 연결(선)을 빌드할 때 계산한 자리에 그린다. 점의 색은 그 글이 든 책의 표지 색이다.
// 점을 고르면 옆 칸에 그 글의 요약과 이어진 글이 나온다. 스크립트가 없으면 점은 그냥 글 링크다.
import { getHomeMap, MAP_W, MAP_H } from '../utils/home-map';
import { withBase } from '../utils/url';

const map = await getHomeMap();
const at = new Map(map.nodes.map((n) => [n.id, n]));
const first = map.nodes[0]; // 최신 글
const postUrl = (id: string) => withBase(`/posts/${id}/`);
// 바탕의 잔별: 난수를 쓰지 않고 번호에서 자리를 만든다(빌드할 때마다 같은 하늘이 나온다)
const frac = (v: number) => v - Math.floor(v);
const dust = Array.from({ length: 90 }, (_, i) => ({
  x: Math.round(frac(Math.sin(i * 12.9898) * 43758.5453) * MAP_W),
  y: Math.round(frac(Math.sin(i * 78.233) * 12543.123) * MAP_H),
  r: (0.6 + frac(Math.sin(i * 3.7) * 9123.7) * 1.1).toFixed(2),
  twinkle: i % 4 === 0,
  delay: (frac(Math.sin(i * 5.1) * 331.7) * 5).toFixed(1),
}));
// 글 하나가 별 하나. 별자리 지도의 관례대로 빛살 없이 점으로 그리고, 밝은 별(연결이 많은 글)일수록 점이 크다.
const rs = map.nodes.map((n) => n.r);
const [rMin, rMax] = [Math.min(...rs), Math.max(...rs)];
const starR = (r: number) => +(1.9 + ((r - rMin) / Math.max(1, rMax - rMin)) * 3.9).toFixed(2);
---

<section class="hm" id="graph" aria-label="그래프">
  <span class="rule"></span>
  <div class="hm-head">
    <h2>그래프</h2>
    <a class="hm-more" href={withBase('/graph/')}>전체 그래프 →</a>
  </div>

  <div class="hm-body">
    <div class="hm-canvas">
      <div class="hm-tip" hidden></div>
      <div class="hm-zoom" hidden>
        <button type="button" data-z="in" aria-label="확대" title="확대">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" /></svg>
        </button>
        <button type="button" data-z="out" aria-label="축소" title="축소">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10" /></svg>
        </button>
        <button type="button" data-z="fit" aria-label="처음 크기로" title="처음 크기로">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.2 8a4.8 4.8 0 1 0 1.5-3.5M3 2.6v2.6h2.6" /></svg>
        </button>
      </div>
      <svg viewBox={`0 0 ${MAP_W} ${MAP_H}`} role="group" aria-label="글과 글의 연결">
        <defs>
          <filter id="hm-blur" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="20" />
          </filter>
        </defs>
        {/* 책마다 그 색의 물감이 번진 자리. 같은 책의 글이 한 덩어리로 읽힌다 */}
        <g class="hm-wash" filter="url(#hm-blur)" aria-hidden="true">
          {map.nodes.map((n) => <circle cx={n.x} cy={n.y} r="46" fill={n.hue} data-w={n.id} />)}
        </g>
        <g class="hm-dust" aria-hidden="true">
          {
            dust.map((d) => (
              <circle cx={d.x} cy={d.y} r={d.r} class={d.twinkle ? 'tw' : undefined} style={`--dl: ${d.delay}s`} />
            ))
          }
        </g>
        <g class="hm-edges" aria-hidden="true">
          {
            map.edges.map((e) => (
              <line
                x1={at.get(e.from)!.x}
                y1={at.get(e.from)!.y}
                x2={at.get(e.to)!.x}
                y2={at.get(e.to)!.y}
                data-a={e.from}
                data-b={e.to}
                style={`--c: var(--edge-${e.type}, var(--edge-related))`}
              />
            ))
          }
        </g>
        <g class="hm-nodes">
          {
            map.nodes.map((n, i) => (
              <a
                class="hm-node"
                href={postUrl(n.id)}
                data-id={n.id}
                aria-label={n.title}
                style={`--hue: ${n.hue}`}
              >
                <circle class="hm-hit" cx={n.x} cy={n.y} r={Math.max(n.r + 6, 13)} />
                <g class="hm-ray-at" transform={`translate(${n.x} ${n.y})`} style={`--dl: ${((i * 0.37) % 4).toFixed(2)}s`}>
                  <circle class="hm-halo" r={starR(n.r) * 3.4} />
                  <circle class="hm-ring" r={starR(n.r) + 7} />
                </g>
                <circle class="hm-dot" cx={n.x} cy={n.y} r={starR(n.r)} />
              </a>
            ))
          }
        </g>
        <g class="hm-groups" aria-hidden="true">
          {
            map.labels.map((l) => {
              // 14px 굵은 글씨의 반 폭(한글 한 자가 13px쯤, 띄어쓰기는 그 3분의 1)
              const hw = [...l.name].reduce((sum, ch) => sum + (ch === ' ' ? 2.2 : 6.6), 0);
              return (
                <g>
                  <rect x={l.x - hw - 16} y={l.y - 19} width={hw * 2 + 34} height="28" rx="14" />
                  <circle cx={l.x - hw - 2} cy={l.y - 5} r="5" fill={l.hue} />
                  <text x={l.x + 9} y={l.y} text-anchor="middle">
                    {l.name}
                  </text>
                </g>
              );
            })
          }
        </g>
        <text class="hm-label" aria-hidden="true"></text>
      </svg>
    </div>

    <aside class="hm-panel" aria-live="polite">
      <p class="hm-meta">{first.category} / {first.date} / {first.minutes}분</p>
      <h3><a href={postUrl(first.id)}>{first.title}</a></h3>
      <p class="hm-desc">{first.description}</p>
      <a class="hm-read" href={postUrl(first.id)}>읽기 →</a>
    </aside>
  </div>

  <script
    type="application/json"
    id="hm-data"
    set:html={JSON.stringify({ base: withBase('/posts/'), nodes: map.nodes }).replace(/</g, '\\u003c')}
  />
</section>

<script>
  interface Conn {
    id: string;
    phrase: string;
    type: string;
    note?: string;
  }
  interface Node {
    id: string;
    x: number;
    y: number;
    r: number;
    title: string;
    description: string;
    category: string;
    date: string;
    minutes: number;
    conns: Conn[];
  }

  const root = document.querySelector<HTMLElement>('.hm');
  const raw = document.getElementById('hm-data')?.textContent;
  if (root && raw) {
    const { base, nodes } = JSON.parse(raw) as { base: string; nodes: Node[] };
    const byId = new Map(nodes.map((n) => [n.id, n]));
    const panel = root.querySelector<HTMLElement>('.hm-panel')!;
    const label = root.querySelector<SVGTextElement>('.hm-label')!;
    const dots = [...root.querySelectorAll<SVGAElement>('.hm-node')];
    const lines = [...root.querySelectorAll<SVGLineElement>('.hm-edges line')];
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls: string, text?: string) => {
      const node = document.createElement(tag);
      node.className = cls;
      if (text) node.textContent = text;
      return node;
    };
    let selected = nodes[0].id;

    // 점의 이름표: 지도 위에 따로 띄우는 알약 모양 표지. 점이나 선과 겹쳐도 글자가 묻히지 않는다.
    const tip = root.querySelector<HTMLElement>('.hm-tip')!;
    const mapSvg = root.querySelector<SVGSVGElement>('.hm-canvas > svg')!;
    let tipNode: Node | null = null;
    const placeTip = () => {
      if (!tipNode) return;
      const vb = mapSvg.viewBox.baseVal;
      const fx = (tipNode.x - vb.x) / vb.width;
      const fy = (tipNode.y - vb.y) / vb.height;
      tip.textContent = tipNode.title;
      tip.hidden = fx < 0 || fx > 1 || fy < 0 || fy > 1;
      tip.style.left = `${fx * 100}%`;
      tip.style.top = `${fy * 100}%`;
      // 가장자리에서는 지도 밖으로 나가지 않게 안쪽으로 붙인다
      tip.dataset.side = fx < 0.2 ? 'l' : fx > 0.8 ? 'r' : '';
      tip.dataset.below = fy < 0.16 ? '1' : '';
    };

    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let lit = '';
    let shown = '';
    // 지도 위의 표시(점, 선, 이름표)만 바꾼다. 마우스를 올렸을 때는 여기까지만 한다.
    const paint = (id: string) => {
      const n = byId.get(id);
      if (!n) return;
      // 다른 점으로 옮겨 갈 때만 이름표가 미끄러져 간다(끌거나 확대할 때는 점에 붙어 있어야 한다)
      tip.classList.toggle('is-glide', lit !== '' && lit !== id);
      lit = id;
      const near = new Set(n.conns.map((c) => c.id));
      for (const d of dots) {
        const did = d.dataset.id!;
        d.classList.toggle('is-on', did === id);
        d.classList.toggle('is-near', near.has(did));
      }
      for (const l of lines) l.classList.toggle('is-on', l.dataset.a === id || l.dataset.b === id);
      root.classList.add('has-pick');

      tipNode = n;
      placeTip();
    };

    // 옆 칸의 내용을 바꾼다. 점을 눌러 골랐을 때만 한다(올릴 때마다 칸이 바뀌면 어지럽다).
    const fill = (id: string) => {
      const n = byId.get(id);
      if (!n || shown === id) return;
      const first = shown === '';
      shown = id;
      const url = `${base}${n.id}/`;
      const title = el('h3', '');
      const titleLink = el('a', '', n.title);
      titleLink.href = url;
      title.append(titleLink);
      const read = el('a', 'hm-read', '읽기 →');
      read.href = url;
      const parts: HTMLElement[] = [
        el('p', 'hm-meta', `${n.category} / ${n.date} / ${n.minutes}분`),
        title,
        el('p', 'hm-desc', n.description),
        read,
      ];
      if (n.conns.length > 0) {
        const list = el('ul', 'hm-conns');
        for (const c of n.conns) {
          const item = el('li', '');
          const chip = el('span', 'hm-chip', c.phrase);
          item.style.setProperty('--c', `var(--edge-${c.type}, var(--edge-related))`);
          const go = el('button', 'hm-go', byId.get(c.id)?.title ?? c.id);
          go.type = 'button';
          go.dataset.id = c.id;
          item.append(chip, go);
          if (c.note) item.title = c.note; // 관계의 설명은 마우스를 올리면 보인다(칸을 글로 채우지 않는다)
          list.append(item);
        }
        parts.push(el('p', 'hm-conns-head', `연결된 글 ${n.conns.length}편`), list);
      }
      panel.replaceChildren(...parts);
      panel.scrollTop = 0;
      if (first || calm) return;
      // 새 내용은 한 줄씩 올라온다. 이어진 글은 하나씩 따라온다.
      const rows = [...parts.slice(0, 5), ...panel.querySelectorAll<HTMLElement>('.hm-conns li')];
      rows.forEach((row, k) =>
        row.animate(
          [
            { opacity: 0, transform: 'translateY(10px)' },
            { opacity: 1, transform: 'none' },
          ],
          { duration: 420, delay: Math.min(k, 9) * 35, easing: 'cubic-bezier(.2,.8,.2,1)', fill: 'backwards' },
        ),
      );
    };

    const pick = (id: string) => {
      const again = selected === id && shown === id;
      selected = id;
      paint(id);
      fill(id);
      // 고른 점에서 고리가 한 번 퍼진다
      const dot = dots.find((d) => d.dataset.id === id)?.querySelector('.hm-dot');
      if (!calm && !again) {
        dot?.animate(
          [
            { strokeWidth: 10, strokeOpacity: 0.2 },
            { strokeWidth: 2.5, strokeOpacity: 1 },
          ],
          { duration: 520, easing: 'ease-out' },
        );
      }
    };

    for (const d of dots) {
      d.setAttribute('role', 'button');
      d.addEventListener('click', (e) => {
        // 새 탭으로 여는 클릭은 링크 그대로 둔다
        if (e.ctrlKey || e.metaKey || e.shiftKey) return;
        e.preventDefault();
        pick(d.dataset.id!);
      });
      d.addEventListener('mouseenter', () => paint(d.dataset.id!));
      d.addEventListener('mouseleave', () => paint(selected));
      d.addEventListener('focus', () => paint(d.dataset.id!));
    }
    panel.addEventListener('click', (e) => {
      const go = (e.target as HTMLElement).closest<HTMLElement>('.hm-go');
      if (go) pick(go.dataset.id!);
    });
    pick(selected);

    // 확대와 이동: 단추, Ctrl(⌘)+휠과 트랙패드 벌리기, 두 번 누르기로 확대하고 끌어서 옮긴다.
    // 그냥 휠은 페이지를 내리는 데 쓰도록 건드리지 않는다.
    const svg = root.querySelector<SVGSVGElement>('.hm-canvas > svg')!;
    const zoomBox = root.querySelector<HTMLElement>('.hm-zoom')!;
    const [FW, FH] = svg.getAttribute('viewBox')!.split(' ').slice(2).map(Number);
    const view = { x: 0, y: 0, w: FW };
    const apply = () => {
      view.w = Math.min(FW, Math.max(FW / 5, view.w));
      const h = (view.w * FH) / FW;
      view.x = Math.min(FW - view.w, Math.max(0, view.x));
      view.y = Math.min(FH - h, Math.max(0, view.y));
      svg.setAttribute('viewBox', `${view.x} ${view.y} ${view.w} ${h}`);
      svg.classList.toggle('is-zoomed', view.w < FW - 1);
      placeTip();
    };
    // 화면의 한 점(cx, cy: 0~1)을 그대로 둔 채 배율을 바꾼다
    const zoomAt = (factor: number, cx = 0.5, cy = 0.5) => {
      const h = (view.w * FH) / FW;
      const px = view.x + view.w * cx;
      const py = view.y + h * cy;
      view.w = Math.min(FW, Math.max(FW / 5, view.w * factor));
      view.x = px - view.w * cx;
      view.y = py - ((view.w * FH) / FW) * cy;
      apply();
    };
    // 단추와 두 번 누르기로 바꿀 때는 뚝 바뀌지 않고 이어서 움직인다(휠과 끌기는 손을 바로 따라간다)
    let zoomRaf = 0;
    const glideTo = (to: { x: number; y: number; w: number }) => {
      cancelAnimationFrame(zoomRaf);
      if (calm) {
        Object.assign(view, to);
        return apply();
      }
      const from = { ...view };
      const t0 = performance.now();
      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / 320);
        const k = 1 - Math.pow(1 - p, 3);
        view.w = from.w + (to.w - from.w) * k;
        view.x = from.x + (to.x - from.x) * k;
        view.y = from.y + (to.y - from.y) * k;
        apply();
        if (p < 1) zoomRaf = requestAnimationFrame(step);
      };
      zoomRaf = requestAnimationFrame(step);
    };
    const glideZoom = (factor: number, cx = 0.5, cy = 0.5) => {
      const h = (view.w * FH) / FW;
      const w = Math.min(FW, Math.max(FW / 5, view.w * factor));
      glideTo({ w, x: view.x + view.w * cx - w * cx, y: view.y + h * cy - ((w * FH) / FW) * cy });
    };
    const at = (e: MouseEvent) => {
      const r = svg.getBoundingClientRect();
      return [(e.clientX - r.left) / r.width, (e.clientY - r.top) / r.height] as const;
    };
    zoomBox.hidden = false;
    zoomBox.addEventListener('click', (e) => {
      const z = (e.target as HTMLElement).closest<HTMLElement>('button')?.dataset.z;
      if (z === 'in') glideZoom(0.7);
      if (z === 'out') glideZoom(1 / 0.7);
      if (z === 'fit') glideTo({ x: 0, y: 0, w: FW });
    });
    svg.addEventListener(
      'wheel',
      (e) => {
        if (!e.ctrlKey && !e.metaKey) return;
        e.preventDefault();
        zoomAt(Math.exp(e.deltaY * 0.01), ...at(e));
      },
      { passive: false },
    );
    svg.addEventListener('dblclick', (e) => {
      if ((e.target as Element).closest('.hm-node')) return;
      glideZoom(0.6, ...at(e));
    });
    // 끌기: 점을 잡으면 그 점이 따라오고(선도 함께), 빈 곳을 잡으면 확대한 지도가 움직인다.
    const linesOf = new Map<string, { line: SVGLineElement; end: 1 | 2 }[]>();
    for (const l of lines) {
      for (const [id, end] of [[l.dataset.a!, 1], [l.dataset.b!, 2]] as const) {
        if (!linesOf.has(id)) linesOf.set(id, []);
        linesOf.get(id)!.push({ line: l, end });
      }
    }
    const moveNode = (id: string, x: number, y: number) => {
      const n = byId.get(id)!;
      n.x = Math.min(FW - 12, Math.max(12, x));
      n.y = Math.min(FH - 12, Math.max(12, y));
      const el = dots.find((d) => d.dataset.id === id)!;
      el.querySelector('.hm-ray-at')?.setAttribute('transform', `translate(${n.x} ${n.y})`);
      for (const c of el.querySelectorAll('.hm-hit, .hm-dot')) {
        c.setAttribute('cx', String(n.x));
        c.setAttribute('cy', String(n.y));
      }
      const wash = root.querySelector(`.hm-wash [data-w="${CSS.escape(id)}"]`);
      wash?.setAttribute('cx', String(n.x));
      wash?.setAttribute('cy', String(n.y));
      for (const { line, end } of linesOf.get(id) ?? []) {
        line.setAttribute(`x${end}`, String(n.x));
        line.setAttribute(`y${end}`, String(n.y));
      }
    };
    let grab: { x: number; y: number; vx: number; vy: number; id?: string; nx: number; ny: number } | null = null;
    let moved = false;
    svg.addEventListener('pointerdown', (e) => {
      const node = (e.target as Element).closest<SVGAElement>('.hm-node');
      if (!node && view.w >= FW - 1) return;
      const n = node ? byId.get(node.dataset.id!)! : null;
      grab = { x: e.clientX, y: e.clientY, vx: view.x, vy: view.y, id: n?.id, nx: n?.x ?? 0, ny: n?.y ?? 0 };
      moved = false;
    });
    window.addEventListener('pointermove', (e) => {
      if (!grab) return;
      const r = svg.getBoundingClientRect();
      const dx = ((e.clientX - grab.x) / r.width) * view.w;
      const dy = ((e.clientY - grab.y) / r.height) * ((view.w * FH) / FW);
      if (Math.abs(e.clientX - grab.x) + Math.abs(e.clientY - grab.y) > 5) moved = true;
      if (!moved) return;
      if (grab.id) {
        moveNode(grab.id, grab.nx + dx, grab.ny + dy);
        paint(grab.id);
      } else {
        view.x = grab.vx - dx;
        view.y = grab.vy - dy;
        apply();
      }
    });
    window.addEventListener('pointerup', () => {
      if (grab?.id && moved) paint(selected);
      grab = null;
    });
    // 끌고 난 끝의 클릭 한 번은 버린다(끌었는데 글이 바뀌지 않게)
    svg.addEventListener(
      'click',
      (e) => {
        if (!moved) return;
        e.preventDefault();
        e.stopPropagation();
        moved = false;
      },
      true,
    );
    for (const d of dots) d.setAttribute('draggable', 'false');
  }
</script>

<style is:global>
  /* 칸 안의 내용은 스크립트가 만들기 때문에 전역 스타일로 두고 .hm- 접두어로 가둔다. */
  .hm {
    margin: 5rem 0 2rem;
    scroll-margin-top: 5rem;
  }
  .hm-head {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin-bottom: 0.9rem;
  }
  .hm-head h2 {
    margin: 0;
    font-size: 1.7rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .hm-head p {
    margin: 0;
    flex: 1;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .hm-more {
    flex-shrink: 0;
    font-size: 0.88rem;
    color: var(--accent);
    text-decoration: none;
  }
  .hm-more:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .hm-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    background-color: var(--surface);
  }
  .hm-canvas {
    position: relative;
  }
  .hm-canvas svg {
    display: block;
    width: 100%;
    height: auto;
    touch-action: pan-y;
  }
  .hm-canvas svg.is-zoomed {
    cursor: grab;
    touch-action: none;
  }
  .hm-zoom {
    position: absolute;
    left: 12px;
    top: 12px;
    z-index: 1;
    display: flex;
    border: 1px solid var(--border);
    border-radius: 999px;
    overflow: hidden;
    background-color: var(--bg);
  }
  .hm-zoom button {
    min-width: 34px;
    height: 30px;
    padding: 0 10px;
    border: 0;
    background: none;
    color: var(--text);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
  }
  .hm-zoom button + button {
    border-left: 1px solid var(--border);
  }
  .hm-zoom button:hover {
    background-color: var(--text);
    color: var(--bg);
  }
  /* 시리즈 이름이 점이나 선과 겹쳐도 읽히게 글자 둘레를 바탕색으로 두른다 */
  .hm-groups text {
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 5px;
    stroke-linejoin: round;
  }

  .hm-edges line {
    stroke: var(--c);
    stroke-width: 1.2;
    opacity: 0.28;
    transition: opacity 0.15s ease;
  }
  .hm.has-pick .hm-edges line {
    opacity: 0.1;
  }
  .hm.has-pick .hm-edges line.is-on {
    opacity: 0.95;
    stroke-width: 1.8;
  }

  .hm-groups text {
    fill: var(--text);
    font-size: 15px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .hm-node {
    cursor: grab;
    outline: none;
    -webkit-user-drag: none;
  }
  .hm-canvas svg {
    user-select: none;
  }
  .hm-hit {
    fill: transparent;
  }
  .hm-dot {
    fill: var(--hue);
    stroke: var(--text);
    stroke-width: 1.2;
    transition:
      opacity 0.15s ease,
      r 0.15s ease;
  }
  .hm.has-pick .hm-node:not(.is-on):not(.is-near) .hm-dot {
    opacity: 0.55;
  }
  .hm-node.is-on .hm-dot {
    stroke: var(--text);
    stroke-width: 2.5;
  }
  .hm-node:focus-visible .hm-dot {
    stroke: var(--accent);
    stroke-width: 3;
  }
  .hm-label {
    fill: var(--text);
    font-size: 15px;
    font-weight: 700;
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 5px;
    stroke-linejoin: round;
    pointer-events: none;
  }

  .hm-panel {
    padding: 1.25rem 1.25rem 1.4rem;
    border-left: 1px solid var(--border);
    background-color: var(--bg);
    /* 칸의 높이는 지도를 따르고, 내용이 넘치면 칸 안에서만 스크롤한다 */
    contain: size;
    overflow-y: auto;
  }
  .hm-meta {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .hm-panel h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: -0.02em;
    word-break: keep-all;
  }
  .hm-panel h3 a {
    color: inherit;
    text-decoration: none;
  }
  .hm-panel h3 a:hover {
    color: var(--accent);
  }
  .hm-desc {
    margin: 0.55rem 0 0.9rem;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-muted);
    word-break: keep-all;
  }
  .hm-read {
    display: inline-block;
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    background-color: var(--accent);
    color: #fff;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
  }
  .hm-conns-head {
    margin: 1.4rem 0 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted);
  }
  .hm-conns {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  .hm-chip {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--c);
  }
  .hm-go {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.45;
    text-align: left;
    word-break: keep-all;
    cursor: pointer;
  }
  .hm-go:hover {
    color: var(--accent);
  }
  .hm-note {
    margin: 0.15rem 0 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--text-muted);
    word-break: keep-all;
  }

  /* 좁은 화면: 지도는 옆으로 밀어 보고, 고른 글은 그 아래에 쌓는다 */
  @media (max-width: 860px) {
    .hm-head {
      flex-wrap: wrap;
      gap: 0.3rem 0.9rem;
    }
    .hm-head p {
      flex-basis: 100%;
      order: 3;
    }
    .hm-body {
      grid-template-columns: minmax(0, 1fr);
    }
    .hm-canvas {
      overflow-x: auto;
    }
    .hm-canvas svg {
      min-width: 640px;
    }
    .hm-panel {
      contain: none;
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }

  .hm-label {
    display: none;
  }
  .hm-tip {
    position: absolute;
    z-index: 1;
    max-width: 62%;
    padding: 5px 11px;
    border-radius: 999px;
    background-color: var(--text);
    color: var(--bg);
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    pointer-events: none;
    translate: -50% calc(-100% - 16px);
  }
  .hm-tip[data-below='1'] {
    translate: -50% 16px;
  }
  .hm-tip[data-side='l'] {
    translate: -12px calc(-100% - 16px);
  }
  .hm-tip[data-side='r'] {
    translate: calc(-100% + 12px) calc(-100% - 16px);
  }
  .hm-tip[data-side='l'][data-below='1'] {
    translate: -12px 16px;
  }
  .hm-tip[data-side='r'][data-below='1'] {
    translate: calc(-100% + 12px) 16px;
  }

  /* 옆 칸: 설명은 두 줄까지, 이어진 글은 관계와 제목만 */
  .hm-desc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ---- 2026-11 개편: 옆 칸을 읽기 좋게. 관계는 색 띠로만 구분하고 글자는 차분하게 둔다 ---- */
  .hm-panel {
    padding: 1.6rem 1.5rem 1.8rem;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }
  .hm-panel h3 {
    font-size: 1.28rem;
  }
  .hm-read {
    background-color: var(--text);
    color: var(--bg);
    transition: background-color 0.25s;
  }
  .hm-read:hover {
    background-color: var(--accent);
    color: #fff;
  }
  .hm-conns-head {
    margin: 1.6rem 0 0.9rem;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }
  .hm-conns {
    gap: 0.5rem;
  }
  .hm-go {
    display: -webkit-box !important;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hm-conns li {
    padding: 0.55rem 0.8rem 0.6rem 0.9rem;
    border-left: 3px solid var(--c);
    border-radius: 0 10px 10px 0;
    background-color: var(--surface);
  }
  .hm-chip {
    margin-bottom: 0.25rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-muted);
  }
  .hm-go {
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.4;
  }
  .hm-note {
    margin-top: 0.3rem;
    font-size: 0.82rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ---- 그래프는 본문 폭(1080px)보다 넓게 쓴다. 지도가 넓어야 점과 이름이 덜 겹친다 ---- */
  .hm {
    --hm-w: min(1360px, calc(100vw - 4rem));
    width: var(--hm-w);
    margin-inline: calc((100% - var(--hm-w)) / 2);
  }
  .hm-body {
    grid-template-columns: minmax(0, 1fr) 430px;
  }
  .hm-groups {
    pointer-events: none;
  }

  /* 확대 단추: 세 칸의 높이와 가운데 정렬을 맞춘다 */
  .hm-zoom {
    padding: 3px;
    gap: 2px;
    border-radius: 12px;
  }
  .hm-zoom button,
  .hm-zoom button + button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 30px;
    padding: 0 9px;
    border: 0;
    border-radius: 9px;
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1;
  }
  .hm-zoom button[data-z='in'],
  .hm-zoom button[data-z='out'] {
    width: 32px;
    padding: 0;
    font-size: 1rem;
  }

  /* 좁은 화면: 지도를 화면 폭에 맞추고(옆으로 밀지 않는다) 단추와 두 손가락으로 확대한다. 고른 글은 지도 아래에 */
  @media (max-width: 860px) {
    .hm {
      --hm-w: 100%;
      margin-top: 3.5rem;
    }
    .hm-body {
      grid-template-columns: minmax(0, 1fr);
    }
    .hm-canvas {
      overflow: hidden;
    }
    .hm-canvas svg {
      min-width: 0;
    }
    .hm-groups text {
      font-size: 22px;
    }
    .hm-tip {
      max-width: 80%;
      font-size: 0.74rem;
    }
    .hm-panel {
      padding: 1.25rem 1.1rem 1.4rem;
    }
    .hm-zoom button {
      min-width: 40px;
      height: 36px;
    }
    /* 단추가 위쪽의 점과 이름표를 가리지 않게 아래로 내린다 */
    .hm-zoom {
      top: auto;
      bottom: 10px;
    }
  }

  /* 확대 단추: 같은 크기의 네모 칸 세 개에 아이콘을 가운데로 */
  .hm-zoom button,
  .hm-zoom button + button,
  .hm-zoom button[data-z='in'],
  .hm-zoom button[data-z='out'] {
    display: grid;
    place-items: center;
    width: 32px;
    min-width: 32px;
    height: 32px;
    padding: 0;
  }
  .hm-zoom svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 읽기 단추는 요약의 오른쪽 아래에 */
  .hm-read {
    display: flex;
    width: fit-content;
    margin-left: auto;
  }

  /* ---- 고르고 올릴 때의 움직임: 점은 살짝 커지고, 선과 이름표는 이어서 바뀐다 ---- */
  .hm-dot {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 0.25s ease,
      transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
      stroke-width 0.25s ease;
  }
  .hm-node.is-near .hm-dot {
    transform: scale(1.12);
  }
  .hm-node:hover .hm-dot {
    transform: scale(1.22);
  }
  .hm-node.is-on .hm-dot {
    transform: scale(1.35);
  }
  .hm-edges line {
    transition:
      opacity 0.3s ease,
      stroke-width 0.3s ease;
  }
  .hm-tip.is-glide {
    transition:
      left 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
      top 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .hm-go {
    transition: color 0.2s;
  }
  .hm-conns li {
    transition:
      background-color 0.2s,
      translate 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .hm-conns li:hover {
    background-color: color-mix(in srgb, var(--c) 9%, var(--surface));
    translate: 3px 0;
  }
  /* ---- 다른 화면과 같은 결: 맨 위 구분선, 큰 제목, 지도만 칸에 담고 옆 칸은 테두리 없이 줄로 나눈다 ---- */
  .hm {
    margin-top: 6.5rem;
  }
  .hm-head {
    align-items: flex-end;
    justify-content: space-between;
    margin: 2.4rem 0 1.8rem;
  }
  .hm-head h2 {
    font-size: clamp(1.9rem, 3.4vw, 2.9rem);
    line-height: 1.2;
    letter-spacing: -0.04em;
  }
  .hm-more {
    padding-bottom: 0.45rem;
    font-weight: 700;
    color: var(--text);
  }
  .hm-more:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .hm-body {
    gap: 0 2.6rem;
    border: 0;
    border-radius: 0;
    overflow: visible;
    background: none;
  }
  .hm-canvas {
    border: 1px solid var(--border);
    border-radius: 18px;
    overflow: hidden;
    background-color: var(--surface);
  }
  .hm-panel {
    padding: 0.5rem 0.2rem 0 0;
    border-left: 0;
    background: none;
  }
  .hm-panel h3 {
    font-size: 1.5rem;
    line-height: 1.3;
    letter-spacing: -0.03em;
  }
  .hm-conns-head {
    margin: 1.8rem 0 0;
    padding: 1.3rem 0 0.7rem;
    border-top: 1px solid var(--text);
    color: var(--text);
  }
  .hm-conns {
    gap: 0;
  }
  .hm-conns li {
    padding: 0.8rem 0.4rem 0.85rem;
    border-left: 0;
    border-top: 1px solid var(--border);
    border-radius: 0;
    background: none;
  }
  .hm-chip::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 0.45em;
    border-radius: 50%;
    background-color: var(--c);
  }

  /* 점은 책의 색을 그대로 또렷하게 칠하고, 테두리는 같은 색의 짙은 쪽으로. 선은 평소에는 옅은 먹색, 고른 글의 선만 관계의 색 */
  .hm-dot {
    stroke: color-mix(in srgb, var(--hue) 55%, #26272b);
    stroke-width: 1.4;
  }
  .hm.has-pick .hm-node:not(.is-on):not(.is-near) .hm-dot {
    opacity: 0.9;
  }
  .hm-node.is-on .hm-dot {
    stroke: var(--text);
    stroke-width: 2.6;
  }
  .hm-edges line,
  .hm.has-pick .hm-edges line {
    stroke: var(--text);
    stroke-width: 1;
    opacity: 0.13;
  }
  .hm.has-pick .hm-edges line.is-on {
    stroke: var(--c);
    stroke-width: 2.2;
    opacity: 1;
  }
  .hm-groups text {
    font-size: 16px;
  }

  /* ---- 지도의 결: 옅은 점 격자 위에 책의 색이 번지고, 글은 흰 테를 두른 구슬로 놓인다 ---- */
  .hm-canvas {
    background-image: radial-gradient(color-mix(in srgb, var(--text) 13%, transparent) 1px, transparent 1.5px);
    background-size: 22px 22px;
    background-position: 11px 11px;
  }
  .hm-wash {
    opacity: 0.34;
  }
  :root[data-theme='dark'] .hm-wash {
    opacity: 0.16;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .hm-wash {
      opacity: 0.16;
    }
  }
  .hm-dot {
    stroke: var(--surface);
    stroke-width: 2.6;
    filter: drop-shadow(0 1px 1.5px rgba(40, 36, 30, 0.38));
  }
  .hm-node.is-near .hm-dot {
    stroke: color-mix(in srgb, var(--hue) 45%, #26272b);
    stroke-width: 2;
  }
  .hm-node.is-on .hm-dot {
    stroke: var(--text);
    stroke-width: 2.8;
  }
  .hm-edges line,
  .hm.has-pick .hm-edges line {
    opacity: 0.16;
  }
  /* 책 이름표: 바탕색 알약에 그 책의 색 점 */
  .hm-groups rect {
    fill: var(--bg);
    stroke: var(--border);
    stroke-width: 1;
  }
  .hm-groups circle {
    stroke: color-mix(in srgb, var(--text) 30%, transparent);
    stroke-width: 1;
  }
  .hm-groups text {
    stroke: none;
    font-size: 14px;
    font-weight: 700;
  }
  .hm-zoom {
    left: 14px;
    top: 14px;
    border-radius: 999px;
    box-shadow: 0 1px 2px rgba(40, 36, 30, 0.08);
  }
  .hm-zoom button,
  .hm-zoom button + button {
    border-radius: 50%;
  }

  /* ---- 별자리: 글은 별, 연결은 별자리의 선. 바탕에는 잔별이 깔리고 몇 개는 느리게 반짝인다 ---- */
  .hm-canvas {
    background-image: none;
  }
  .hm-dust circle {
    fill: var(--text);
    opacity: 0.22;
  }
  .hm-ray {
    fill: color-mix(in srgb, var(--hue) 62%, var(--text));
    opacity: 0.85;
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .hm-node:hover .hm-ray,
  .hm-node.is-near .hm-ray {
    transform: scale(1.25);
  }
  .hm-node.is-on .hm-ray {
    fill: var(--text);
    transform: scale(1.55) rotate(45deg);
  }
  .hm-dot {
    filter: drop-shadow(0 0 3.5px color-mix(in srgb, var(--hue) 80%, transparent));
  }
  .hm-edges line,
  .hm.has-pick .hm-edges line {
    stroke-width: 0.8;
    opacity: 0.3;
  }
  @keyframes hm-twinkle {
    50% {
      opacity: 0.75;
      scale: 1.5;
    }
  }
  @keyframes hm-glint {
    50% {
      opacity: 0.45;
      scale: 0.82;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hm-dust .tw {
      transform-box: fill-box;
      transform-origin: center;
      animation: hm-twinkle 4.6s ease-in-out var(--dl) infinite;
    }
    .hm-node:not(.is-on):not(:hover) .hm-ray {
      animation: hm-glint 4.2s ease-in-out var(--dl) infinite;
    }
  }

  /* ---- 별: 테두리 두른 구슬이 아니라, 작게 빛나는 심과 번지는 빛, 가늘고 긴 빛살 ----
     밝은 바탕에서는 심과 빛살을 책의 색보다 짙게 칠해 종이 위의 별 그림처럼, 어두운 바탕에서는 흰빛에 가깝게 칠한다. */
  .hm {
    --star-mix: var(--text);
    --star-amt: 38%;
  }
  .hm-dot,
  .hm-node.is-near .hm-dot,
  .hm-node.is-on .hm-dot {
    stroke: none;
    fill: color-mix(in srgb, var(--star-mix) var(--star-amt), var(--hue));
    filter: none;
    transform: scale(0.42);
    opacity: 1 !important;
  }
  .hm-node.is-near .hm-dot,
  .hm-node:hover .hm-dot {
    transform: scale(0.52);
  }
  .hm-node.is-on .hm-dot {
    transform: scale(0.62);
  }
  .hm-halo {
    fill: var(--hue);
    opacity: 0.6;
    filter: blur(5px);
    transition: opacity 0.35s;
  }
  .hm-ray,
  .hm-node:hover .hm-ray,
  .hm-node.is-near .hm-ray {
    fill: color-mix(in srgb, var(--star-mix) var(--star-amt), var(--hue));
    opacity: 0.9;
    transform: none;
  }
  .hm-ray-at {
    transform-box: fill-box;
    transform-origin: center;
  }
  .hm-node:hover .hm-ray,
  .hm-node.is-near .hm-ray {
    transform: scale(1.2);
  }
  .hm-node.is-on .hm-ray {
    fill: var(--text);
    transform: scale(1.7);
  }
  .hm-node.is-on .hm-halo,
  .hm-node:hover .hm-halo {
    opacity: 1;
  }
  .hm-node.is-on .hm-dot {
    fill: var(--text);
  }
  .hm-edges line,
  .hm.has-pick .hm-edges line {
    stroke-width: 0.6;
    opacity: 0.32;
  }
  .hm.has-pick .hm-edges line.is-on {
    stroke-width: 1.4;
  }
  .hm-wash {
    opacity: 0.2;
  }
  @keyframes hm-glint {
    50% {
      opacity: 0.4;
      scale: 0.7;
    }
  }
